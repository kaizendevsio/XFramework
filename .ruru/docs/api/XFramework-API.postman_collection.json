            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"00000000-0000-0000-0000-000000000001\",\n  \"name\": \"Updated Product\",\n  \"description\": \"Updated description\",\n  \"sku\": \"PROD-001\",\n  \"price\": 34.99,\n  \"stockQuantity\": 150,\n  \"isActive\": true,\n  \"tenantId\": \"{{tenant_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/products/:id?tenantId={{tenant_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", ":id"],
              "query": [
                {
                  "key": "tenantId",
                  "value": "{{tenant_id}}"
                }
              ],
              "variable": [
