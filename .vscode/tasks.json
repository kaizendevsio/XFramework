            },
            "presentation": {"reveal": "always","panel": "dedicated","group": "smsgateway"}
        },
        {
            "label": "Run Community Task",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/Modules/XFramework.Community/Community.Api/Community.Api.csproj"
            ],
            "isBackground": true,
            "dependsOn": ["Run SmsGateway Task"],
            "problemMatcher": {
                "owner": "csharp",
                "fileLocation": "absolute",
