            ],
            "isBackground": true,
            "dependsOn": ["Run Wallets Task"],
            "problemMatcher": {
                "owner": "csharp",
                "fileLocation": "absolute",
                "pattern": {"regexp": "^.*\\bNow listening on:\\s+(https?://\\S+)","file": 1,"message": 1},
                "background": {"activeOnStart": true,"beginsPattern": "^.*\\bApplication started\\. Press Ctrl\\+C to shut down\\.\\b.*$","endsPattern": "^.*\\bApplication is shutting down\\.\\.\\.\\b.*$"}
            },
            "presentation": {"reveal": "always","panel": "dedicated","group": "messaging"}
        },
        {
            "label": "Run SmsGateway Task",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
