# -- Environment -----------------------------------------------
# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# -- Database --------------------------------------------------
# For local dev, "postgres" resolves to the compose postgres container.
# For staging/prod, set to your external DB host.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=XFramework
DB_USER=dbAdmin
DB_PASSWORD=change-me-local-db-password

# User token signing. Only IdentityServer receives the private key; other services receive the public key.
USER_JWT_GENERATION_ID=local-user-jwt-g1
IDENTITY_USER_JWT_PRIVATE_KEY_PATH=./.secrets/identityserver/user-jwt-private-key.pem
IDENTITY_USER_JWT_PUBLIC_KEY_PATH=./.secrets/identityserver/user-jwt-public-key.pem
# Rollback-only until the first centralized-identity LKG is sealed. New services do not receive this value.
BOLT_SIGNATURE=change-me-legacy-rollback-bolt-signature-with-at-least-64-characters
JWT_ISSUER=xframework
JWT_AUDIENCE=xframework
# Service-client credential rotation. This is independent from user JWT signing generations.
SERVICE_CREDENTIAL_GENERATION_ID=local-development-g1
SERVICE_CREDENTIAL_SECONDARY_GENERATION_ID=
SERVICE_CREDENTIAL_SECONDARY_VALID_UNTIL_UTC=
BOLT_SIGNATURE_SECONDARY=

# -- Service transport -----------------------------------------
# Hub and IdentityServer are HTTP-only container backends published on host loopback.
IDENTITYSERVER_BOLT_TRANSPORT_TOKEN_PATH=/api/service-identity/bolt-transport-token
BOLT_SYNTHETIC_TENANT_ID=00000000-0000-0000-0000-000000000000
BOLT_SYNTHETIC_CREDENTIAL_ID=00000000-0000-0000-0000-000000000000
BOLT_SYNTHETIC_DEVICE_ID=phase0-deployment-gate
BOLT_SYNTHETIC_TARGET=wss://xeon-dev.tailed40e.ts.net:7000/bolt/ws
BOLT_SYNTHETIC_COMMUNICATIONS_TRANSPORT_TOKEN_PATH=./.secrets/bolt-phase0/communications-transport-token
BOLT_SYNTHETIC_COMMUNICATIONS_IDENTITY_SERVICE_TOKEN_PATH=./.secrets/bolt-phase0/communications-identity-service-token
BOLT_SYNTHETIC_PORTAL_TRANSPORT_TOKEN_PATH=./.secrets/bolt-phase0/portal-transport-token
BOLT_SYNTHETIC_PORTAL_IDENTITY_SERVICE_TOKEN_PATH=./.secrets/bolt-phase0/portal-identity-service-token
BOLT_SYNTHETIC_USER_ACTOR_TOKEN_PATH=./.secrets/bolt-phase0/user-actor-token
BOLT_SYNTHETIC_EXPIRY_TRANSPORT_TOKEN_PATH=./.secrets/bolt-phase0/expiry-transport-token
BOLT_SYNTHETIC_IDENTITYSERVER_BASE_URL=https://xeon-dev.tailed40e.ts.net:8261
BOLT_SYNTHETIC_USER_USERNAME=bolt-phase0-synthetic
BOLT_SYNTHETIC_USER_PASSWORD=change-me-local-synthetic-user-password
BOLT_SYNTHETIC_USER_ROLE_ID=00000000-0000-0000-0000-000000000000
BOLT_SYNTHETIC_USER_AUTHORIZATION_TYPE=Default
BOLT_SYNTHETIC_MIN_TOKEN_LIFETIME_SECONDS=60

# Service identity client secrets.
# These are explicit client credentials registered with IdentityServer in docker-compose.yml.
# Use distinct high-entropy values per service; do not reuse one shared development fallback secret.
IDENTITYSERVER_SERVICE_IDENTITY_SECRET=change-me-local-identityserver-service-identity-secret-with-at-least-64-characters
IDENTITYSERVER_SERVICE_IDENTITY_SECRET_SECONDARY=
BOLT_HUB_SERVICE_IDENTITY_SECRET=change-me-local-bolthub-service-identity-secret-with-at-least-64-characters
BOLT_HUB_SERVICE_IDENTITY_SECRET_SECONDARY=
COMMUNICATIONS_SERVICE_IDENTITY_SECRET=change-me-local-communications-service-identity-secret-with-at-least-64-characters
COMMUNICATIONS_SERVICE_IDENTITY_SECRET_SECONDARY=
NOTIFICATIONS_SERVICE_IDENTITY_SECRET=change-me-local-notifications-service-identity-secret-with-at-least-64-characters
NOTIFICATIONS_SERVICE_IDENTITY_SECRET_SECONDARY=
STORAGE_SERVICE_IDENTITY_SECRET=change-me-local-storage-service-identity-secret-with-at-least-64-characters
STORAGE_SERVICE_IDENTITY_SECRET_SECONDARY=
ATTENDANCE_SERVICE_IDENTITY_SECRET=change-me-local-attendance-service-identity-secret-with-at-least-64-characters
ATTENDANCE_SERVICE_IDENTITY_SECRET_SECONDARY=
SMSGATEWAY_SERVICE_IDENTITY_SECRET=change-me-local-smsgateway-service-identity-secret-with-at-least-64-characters
SMSGATEWAY_SERVICE_IDENTITY_SECRET_SECONDARY=
WALLETS_SERVICE_IDENTITY_SECRET=change-me-local-wallets-service-identity-secret-with-at-least-64-characters
WALLETS_SERVICE_IDENTITY_SECRET_SECONDARY=
INVENTARIO_SERVICE_IDENTITY_SECRET=change-me-local-inventario-service-identity-secret-with-at-least-64-characters
INVENTARIO_SERVICE_IDENTITY_SECRET_SECONDARY=
POS_SERVICE_IDENTITY_SECRET=change-me-local-pos-service-identity-secret-with-at-least-64-characters
POS_SERVICE_IDENTITY_SECRET_SECONDARY=
PORTAL_SERVICE_IDENTITY_SECRET=change-me-local-portal-service-identity-secret-with-at-least-64-characters
PORTAL_SERVICE_IDENTITY_SECRET_SECONDARY=
OPERATIONS_DASHBOARD_SERVICE_IDENTITY_SECRET=change-me-local-operations-dashboard-service-identity-secret-with-at-least-64-characters
OPERATIONS_DASHBOARD_SERVICE_IDENTITY_SECRET_SECONDARY=

# Optional app-level secrets used by gateway/coins when those services are enabled.
ENCRYPTION_SECRET=change-me-local-encryption-secret
PADDED_ENCRYPTION_SECRET=change-me-local-padded-encryption-secret
COINS_WALLET_PASSWORD=change-me-local-wallet-password

# -- StreamFlow ------------------------------------------------
# For local dev, "streamflow" resolves to the compose container.
# For staging/prod, set to your StreamFlow server host.
STREAMFLOW_HOST=streamflow
STREAMFLOW_PORT=8080

# -- Migration -------------------------------------------------
# Set to "true" in Docker (migrations handled by init container).
# Omit or set to "false" for local dev (services self-migrate).
SKIP_DB_MIGRATION=true

# -- Exposed Ports (host-side) ---------------------------------
DB_EXPOSE_PORT=5432
STREAMFLOW_EXPOSE_PORT=7000
BOLT_HUB_EXPOSE_PORT=7000
IDENTITYSERVER_EXPOSE_PORT=8261
COMMUNICATIONS_EXPOSE_PORT=5148
NOTIFICATIONS_EXPOSE_PORT=5166
ATTENDANCE_EXPOSE_PORT=5182
SMSGATEWAY_EXPOSE_PORT=5274
WALLETS_EXPOSE_PORT=9696
INVENTARIO_EXPOSE_PORT=8105
STORAGE_EXPOSE_PORT=5190
PORTAL_EXPOSE_PORT=5000
OPERATIONS_DASHBOARD_EXPOSE_PORT=5050
MINIO_API_EXPOSE_PORT=9000
MINIO_CONSOLE_EXPOSE_PORT=9001

# Storage / MinIO (S3-compatible local backend)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
STORAGE_DEFAULT_PROVIDER=S3Compatible
STORAGE_PROVIDER_PROFILE_NAME=default
STORAGE_BUCKET_PREFIX=xframework-dev
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
STORAGE_S3_USE_PATH_STYLE=true
STORAGE_S3_PUBLIC_BASE_URL=http://localhost:9000
STORAGE_AZURE_BLOB_CONNECTION_STRING=
