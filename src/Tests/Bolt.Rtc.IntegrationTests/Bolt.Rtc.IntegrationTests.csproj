<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Real browsers against the relay's WebRTC endpoint (the bolt-rtc sidecar driven by Bolt.Rtc) through a real
    TURN server (coturn). Needs BOLT_RTC_SIDECAR, BOLT_RTC_TURN_HOST and BOLT_RTC_TURN_SECRET; without them every
    test is skipped. CI runs it in .github/workflows/call-udp-integration.yml.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright.NUnit" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Bolt\Bolt.Rtc\Bolt.Rtc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real browser module under test, served to the page as-is. -->
    <None Include="..\..\Libraries\Bolt\Bolt.Media.Browser\wwwroot\bolt-rtc.js" Link="bolt-rtc.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
