{
  "ConnectionStrings": {
    "DefaultDatabaseConnection": "Host=postgres;Port=5432;Database=XFramework;Username=dbAdmin;Password=CHANGE_ME_DB_PASSWORD_USE_ENVIRONMENT"
  },
  "BoltConfiguration": {
    "ServerUrls": [ "ws://bolt-hub:8080/bolt/ws" ],
    "RequireSecureTransport": false
  },
  "Storage": {
    "DefaultProvider": "S3Compatible",
    "ProviderProfileName": "default",
    "BucketPrefix": "xframework-dev",
    "DefaultChunkSizeBytes": 5242880,
    "SessionTtlMinutes": 1440,
    "SignedUrlExpirationMinutes": 15,
    "RetentionDays": 30,
    "UnclaimedFileTtlMinutes": 1440,
    "MaintenancePollSeconds": 30,
    "MaintenanceBatchSize": 100,
    "AutoCreateBuckets": true,
    "S3": {
      "Endpoint": "http://minio:9000",
      "Region": "us-east-1",
      "AccessKeyId": "minioadmin",
      "SecretAccessKey": "minioadmin",
      "UsePathStyle": true,
      "PublicBaseUrl": "http://localhost:9000"
    }
  },
  "Seq": {
    "Url": "http://seq:80"
  },
  "SKIP_DB_MIGRATION": true
}
