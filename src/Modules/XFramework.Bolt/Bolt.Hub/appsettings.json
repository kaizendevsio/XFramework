{
  "SwaggerOptions": {
    "JsonRoute": "swagger/{documentName}/swagger.json",
    "Description": "Bolt Hub API",
    "UIEndpoint": "/swagger.json",
    "Title": "Bolt Hub Api",
    "Version": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DatabaseConnection": "Host=localhost;Database=XFramework;Username=dbAdmin;Password=CHANGE_ME_DB_PASSWORD_USE_ENVIRONMENT"
  },
  "Application": {
    "DefaultUID": "3902761a-822d-4c6b-8e2d-323fd501bcd6",
    "MemoryLimit": "1000MB"
  },
  "JwtOptions": {
    "ValidAudience": "http://localhost:5001",
    "ValidIssuer": "http://localhost:5001",
    "GenerationId": "local-development-g1",
    "SigningPublicKeyPath": ".data/identity/user-jwt-public-key.pem",
    "AccessTokenLifespan": "00:30:00",
    "RefreshTokenLifespan": "00:30:00"
  },
  "BoltTransportAuthentication": {
    "MetadataAddress": "http://localhost:8261/.well-known/openid-configuration",
    "Issuer": "XFramework.IdentityServer",
    "Audience": "XFramework.Bolt.Hub",
    "RequireHttpsMetadata": false
  },
  "BoltConfiguration": {
    "QueueDepth": 256,
    "QueueMessages": true,
    "SendQueueByteCapacity": 16777216,
    "MediaEnabled": false,
    "MaxFrameBytes": 8388608,
    "RpcRequestsPerSecond": 800000,
    "RpcRequestBurst": 200000,
    "RpcInboundBytesPerSecond": 1342177280,
    "RpcInboundByteBurst": 268435456,
    "RequireTopicAuthorization": true,
    "RegistrationIdentityBindingMode": "Enforce"
  }
}
