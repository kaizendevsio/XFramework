<MudDialog>
    <DialogContent>
        <EditForm Model="NewColumn" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <MudTextField @bind-Value="NewColumn.Name" Label="Name" Required="true" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Submit</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // TODO: Update for MudBlazor 8.5.1 dialog API
    // [CascadingParameter]
    // MudDialogInstance Dialog { get; set; }

    private EntityColumn NewColumn { get; set; } = new EntityColumn();

    private void Submit()
    {
        DbContext.EntityColumns.Add(NewColumn);
        DbContext.SaveChanges();
        // TODO: Implement dialog close for MudBlazor 8.5.1
        // Dialog?.Close(DialogResult.Ok(NewColumn));
    }

    private void Cancel()
    {
        // TODO: Implement dialog close for MudBlazor 8.5.1
        // Dialog?.Close();
    }
}
