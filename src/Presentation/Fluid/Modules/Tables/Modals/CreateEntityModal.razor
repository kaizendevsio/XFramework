@using Fluid.Core.Models
@using MudBlazor

<MudDialog>
    <DialogContent>
        <EditForm Model="NewEntity" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudTextField @bind-Value="NewEntity.Name" Label="Name" Required="true" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Submit</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // TODO: Update for MudBlazor 8.5.1 dialog API
    // [CascadingParameter]
    // MudDialogInstance Dialog { get; set; }

    private Entity NewEntity { get; set; } = new Entity();

    private void Submit()
    {
        DbContext.Entities.Add(NewEntity);
        DbContext.SaveChanges();
        // TODO: Implement dialog close for MudBlazor 8.5.1
        // Dialog?.Close(DialogResult.Ok(NewEntity));
    }

    private void Cancel()
    {
        // TODO: Implement dialog close for MudBlazor 8.5.1
        // Dialog?.Close();
    }
}
