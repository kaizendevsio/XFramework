@page "/settings"
@attribute [Authorize]
<PageTitle>Settings · Yap</PageTitle>
<ScrollSurface><Header><div class="appbar plain liquid-glass"><GlassLayer /><a class="iconbtn" href="/" aria-label="Back to conversations"><YapIcon Name="back" /></a><h1 class="t1">Your space</h1><span class="sp"></span><ThemeToggle /></div></Header><ChildContent>
    <div class="body settings-body"><AuthorizeView><Authorized Context="auth"><div class="profile-card"><Avatar Initials="@ChatMessage.InitialsFor(auth.User.Identity?.Name)" Size="a64" /><h2>@auth.User.Identity?.Name</h2><p>A little closer to your people.</p></div></Authorized></AuthorizeView>
        <div class="sectionhead">About Yap</div><p>Private workspace conversations, together in one place.</p><p>Use the theme button above to switch between light and dark. Attach files up to 20 MB, reply to messages, and pick up conversations where you left off.</p>
        <InstallHelp />
        <form method="post" action="/auth/logout" data-enhance="false"><AntiforgeryToken /><button class="btn ghost" type="submit"><YapIcon Name="logout" Size="18" />Sign out</button></form>
    </div>
</ChildContent></ScrollSurface>
