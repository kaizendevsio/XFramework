@inject IJSRuntime JS
<BbButton Class="iconbtn" Variant="ButtonVariant.Ghost" OnClick="ToggleTheme" aria-label="@(dark ? "Switch to light mode" : "Switch to dark mode")">
    <YapIcon Name="@(dark ? "sun" : "moon")" Size="20" />
</BbButton>
@code {
    private bool dark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        dark = await JS.InvokeAsync<string>("yap.getTheme") == "dark";
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        dark = !dark;
        await JS.InvokeVoidAsync("yap.setTheme", dark ? "dark" : "light");
    }
}
