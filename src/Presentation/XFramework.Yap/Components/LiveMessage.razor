<div class="msg @(Message.Mine ? "out" : "in")" id="message-@Message.Id" tabindex="-1">
    @if (!Message.Mine) { <Avatar Initials="@Message.Initials" Size="a34" /> }
    <div class="col">
        @if (!Message.Mine) { <span class="who">@Message.Sender</span> }
        <button class="bub liquid-glass" @onclick="() => OnSelect.InvokeAsync(Message)" aria-label="@($"Message from {Message.Sender}: {Message.Text}. Open actions")"><GlassLayer /><span class="bubble-content">
            @if (Message.ParentId is not null) { <span class="quote"><span class="qn">@(Parent?.Sender ?? "Reply")</span>@(Parent?.Text ?? "Earlier message")</span> }
            @Message.Text
        </span></button>
        @if (Message.Reactions.Count > 0)
        {
            <div class="message-reactions" aria-label="Message reactions">
                @foreach (var reaction in Message.Reactions)
                {
                    <BbButton Class="reaction-chip" Variant="ButtonVariant.Ghost" Disabled="Busy" aria-label="@($"{reaction.Name}, {reaction.Count} reactions")" aria-pressed="@(reaction.MyReactionId is not null ? "true" : "false")" OnClick="() => OnReact.InvokeAsync((Message, reaction.TypeId))">@reaction.Emoji @reaction.Count</BbButton>
                }
            </div>
        }
        <div class="meta">@if (Message.Pinned) { <span aria-label="Pinned"><YapIcon Name="pin" Size="12" /></span> } @Message.Time @if (Message.Mine) { <span title="Sent" aria-label="Sent">✓</span> } <button class="message-reply" aria-label="@($"Reply to {Message.Sender}")" @onclick="() => OnReply.InvokeAsync(Message)">Reply</button></div>
    </div>
</div>
@code {
    [Parameter, EditorRequired] public ChatMessage Message { get; set; } = default!;
    [Parameter] public ChatMessage? Parent { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnSelect { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnReply { get; set; }
    [Parameter] public EventCallback<(ChatMessage Message, Guid TypeId)> OnReact { get; set; }
    [Parameter] public bool Busy { get; set; }
}
