<div class="scroll-surface" data-scroll-surface>
    <div class="scroll-content">@ChildContent</div>
    <div class="scroll-header" data-scroll-header>@Header</div>
    @if(Footer is not null){<div class="scroll-footer" data-scroll-footer>@Footer</div>}
</div>
@code {
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
