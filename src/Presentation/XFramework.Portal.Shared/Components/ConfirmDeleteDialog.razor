<BbAlertDialog Open="@Open" OpenChanged="@OpenChanged">
    <BbAlertDialogContent>
        <BbAlertDialogHeader>
            <BbAlertDialogTitle>Are you sure?</BbAlertDialogTitle>
            <BbAlertDialogDescription>
                @if (string.IsNullOrEmpty(Message))
                {
                    <text>This action cannot be undone. This will permanently delete this record.</text>
                }
                else
                {
                    @Message
                }
            </BbAlertDialogDescription>
        </BbAlertDialogHeader>
        <BbAlertDialogFooter>
            <BbAlertDialogCancel>
                <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
            </BbAlertDialogCancel>
            <BbAlertDialogAction>
                <BbButton Variant="ButtonVariant.Destructive" OnClick="@Confirm">Delete</BbButton>
            </BbAlertDialogAction>
        </BbAlertDialogFooter>
    </BbAlertDialogContent>
</BbAlertDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private async Task Confirm()
    {
        await OnConfirm.InvokeAsync();
    }
}
