    private async Task LoadCredentials()
    {
        try
        {
            _credentials = (await DataContext.Query<IdentityCredential>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(x => x.IdentityInfoId == Id)
                    .OrderByDescending(x => x.CreatedAt)
                    .Take(100)
                    .ToListAsync())
                .ToList();
        }
        catch { _credentials = []; }
    }

    private async Task LoadRoles()
    {
        try
        {
            var tenantId = _user?.TenantId ?? Guid.Empty;
            var credentialIds = _credentials
                .Where(credential => credential.TenantId == tenantId)
                .Select(credential => credential.Id)
                .ToArray();
            _roles = credentialIds.Length == 0
                ? []
                : (await DataContext.Query<IdentityRole>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(role => role.TenantId == tenantId)
                    .Where(role => credentialIds.Contains(role.CredentialId))
                    .Include(x => x.Type)
                    .OrderByDescending(x => x.CreatedAt)
                    .Take(10_000)
                    .ToListAsync())
                .ToList();
        }
        catch { _roles = []; }
