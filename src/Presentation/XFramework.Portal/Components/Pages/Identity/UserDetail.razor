                ToastService.Success("Credential created.", "Credential saved");
                _createCredDialogOpen = false;
                await LoadCredentials();
            }
            else
            {
                ToastService.Error("Credential creation failed.", "Credential failed");
            }
        }
        catch
        {
            ToastService.Error("Credential creation failed.", "Credential failed");
        }
        finally
        {
