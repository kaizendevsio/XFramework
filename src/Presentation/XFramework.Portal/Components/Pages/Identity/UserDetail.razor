@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string? Section { get; set; }

    [Inject] private global::XFramework.Domain.Shared.DataContext.IDataContext DataContext { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private TenantModuleNavigationService ModuleNavigation { get; set; } = default!;
    [Inject] private AttendancePortalReadService AttendanceReadService { get; set; } = default!;
    [Inject] private IIdentityServerServiceWrapper IdentityServer { get; set; } = default!;
    [Inject] private ILogger<UserDetail> Logger { get; set; } = default!;

    // Main data
    private IdentityInformation? _user;
    private List<IdentityCredential> _credentials = [];
    private List<IdentityRole> _roles = [];
    private List<IdentityContact> _contacts = [];
    private List<IdentityAddress> _addresses = [];
    private List<Session> _sessions = [];
    private List<AuthorizationLog> _authLogs = [];
    private List<Wallet> _wallets = [];
    private List<AttendanceUserParticipationRow> _attendanceParticipations = [];
    private List<AttendanceUserRecordRow> _attendanceRecords = [];

    // Lookup data
    private List<IdentityRoleType> _roleTypes = [];
    private List<IdentityContactType> _contactTypes = [];
    private List<IdentityContactGroup> _contactGroups = [];

    // State
    private bool _loading = true;
    private bool _saving;
    private bool _outsideTenantContext;
    private bool _attendanceModuleEnabled;
    private Guid? _loadedId;
    private string? _loadedSection;
    private string _attendanceCredentialFilter = AllAttendanceCredentialsValue;
    private string CurrentSection => NormalizeSection(Section);

    // Editable form
    private EditableForm<IdentityInformation>? _editableForm;
    private string? _editFirstName;
    private string? _editMiddleName;
    private string? _editLastName;
    private string? _editSuffix;
    private string? _editIdentityName;
    private string? _editBirthDate;
    private string? _editGender;
    private string? _editCivilStatus;

    // Select options
    private List<SelectOption<string>> _genderOptions = Enum.GetValues<Gender>().Select(g => new SelectOption<string>(g.ToString(), g.ToString())).ToList();
    private List<SelectOption<string>> _civilStatusOptions = Enum.GetValues<CivilStatus>().Select(cs => new SelectOption<string>(cs.ToString(), cs.ToString())).ToList();
    private List<SelectOption<string>> CredentialOptions =>
        _credentials.Select(x => new SelectOption<string>(x.Id.ToString(), GetCredentialLabel(x))).ToList();
    private List<SelectOption<string>> RoleTypeOptions =>
        _roleTypes.Select(x => new SelectOption<string>(x.Id.ToString(), GetRoleTypeLabel(x))).ToList();
    private List<SelectOption<string>> ContactTypeOptions =>
        _contactTypes.Select(x => new SelectOption<string>(x.Id.ToString(), GetContactTypeLabel(x))).ToList();
    private const string AllAttendanceCredentialsValue = "all";
    private static readonly DateTime NoRoleExpirationUtc = new(9999, 12, 31, 23, 59, 59, DateTimeKind.Utc);

    // Create Credential dialog
    private bool _createCredDialogOpen;
    private CredentialForm _credForm = new();
    private bool _credentialAvatarDialogOpen;
    private IdentityCredential? _avatarCredential;
    private List<FileUploadItem> _credentialAvatarFiles = [];
    private const string AvatarAccept = "image/png,image/jpeg,image/webp";

    // Assign Role dialog
    private bool _assignRoleDialogOpen;
    private RoleForm _roleForm = new();
    private bool _rolePermissionDialogOpen;
    private bool _loadingRolePermissions;
    private Guid? _loadingRolePermissionsRoleId;
    private bool _savingRolePermissions;
    private long _rolePermissionOperationVersion;
    private bool _rolePermissionOverridesLoaded;
    private Guid _rolePermissionConcurrencyStamp;
    private IdentityRole? _permissionRole;
    private CancellationTokenSource? _rolePermissionLoadCts;
