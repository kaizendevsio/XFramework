    protected override async Task OnParametersSetAsync()
    {
        var normalizedSection = NormalizeSection(Section);
        if (_loadedId != Id || !string.Equals(normalizedSection, "roles", StringComparison.OrdinalIgnoreCase))
        {
            InvalidateRolePermissionDialogState();
        }

        if (ShouldCanonicalizeSection(normalizedSection))
        {
            Navigation.NavigateTo(GetSectionHref(normalizedSection), replace: true);
        }

        if (_loadedId == Id
            && string.Equals(_loadedSection, normalizedSection, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _loadedId = Id;
        _loadedSection = normalizedSection;
        await ReloadAllData();
    }

    private bool ShouldCanonicalizeSection(string normalizedSection) =>
        Section is not null
        && (!string.Equals(Section, normalizedSection, StringComparison.OrdinalIgnoreCase)
            || normalizedSection == "summary");

    private string GetSectionHref(string section) =>
        section == "summary" ? $"/identity/users/{Id}" : $"/identity/users/{Id}/{section}";

    private static string NormalizeSection(string? section)
    {
        if (string.IsNullOrWhiteSpace(section) || section.Equals("info", StringComparison.OrdinalIgnoreCase))
        {
            return "summary";
        }

        var normalized = section.ToLowerInvariant();
        return normalized is "summary"
            or "credentials"
            or "roles"
            or "contacts"
            or "addresses"
            or "sessions"
            or "auth-logs"
            or "attendance"
            or "wallets"
            ? normalized
            : "summary";
    }

    private void OnTenantFilterChanged()
    {
        InvalidateRolePermissionDialogState();
        _ = InvokeAsync(async () =>
        {
            await ReloadAllData();
            StateHasChanged();
        });
    }

    private async Task ReloadAllData()
    {
        InvalidateRolePermissionDialogState();
        _loading = true;
        try
        {
            ClearChildData();
            _outsideTenantContext = false;
            _user = await DataContext.Query<IdentityInformation>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id)
                .FirstOrDefaultAsync();

            if (_user is null)
            {
                ClearChildData();
                return;
            }
            _outsideTenantContext = TenantFilter.SelectedTenantId is Guid tenantId && tenantId != _user.TenantId;
            if (_outsideTenantContext)
            {
                ClearChildData();
                return;
            }

            SyncEditFields();
            await LoadActiveSectionData(CurrentSection);
        }
        catch
        {
            ToastService.Error("The user data could not be loaded.", "Load failed");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadActiveSectionData(string section)
    {
        switch (section)
        {
            case "summary":
                break;
            case "credentials":
                await LoadCredentials();
                break;
            case "roles":
                await LoadCredentials();
                await LoadRoles();
                await LoadRoleTypes();
                break;
            case "contacts":
                await LoadCredentials();
                await LoadContacts();
                await LoadContactLookups();
                break;
            case "addresses":
                await LoadAddresses();
                break;
            case "sessions":
                await LoadCredentials();
                await LoadSessions();
                break;
            case "auth-logs":
                await LoadCredentials();
                await LoadAuthLogs();
                break;
            case "attendance":
                await ModuleNavigation.EnsureLoadedAsync();
                _attendanceModuleEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Attendance);
                await LoadCredentials();
                await LoadAttendance();
                break;
            case "wallets":
                await LoadCredentials();
                await LoadWallets();
                break;
        }
    }

