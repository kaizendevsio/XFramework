    private void SyncEditFields()
    {
        if (_user is null) return;
        _editFirstName = _user.FirstName;
        _editMiddleName = _user.MiddleName;
        _editLastName = _user.LastName;
        _editSuffix = _user.Suffix;
        _editIdentityName = _user.IdentityName;
        _editBirthDate = _user.BirthDate?.ToString("yyyy-MM-dd") ?? "";
        _editGender = _user.Gender?.ToString() ?? "";
        _editCivilStatus = _user.CivilStatus?.ToString() ?? "";
    }

    private void DiscardUserEdit() => SyncEditFields();

    private async Task SaveUserEdit()
    {
        _saving = true;
        try
        {
            if (_user is null)
                return;

            var result = await IdentityServer.UpdateIdentityProfile(new UpdateIdentityProfileRequest
            {
                IdentityId = _user.Id,
                ExpectedConcurrencyStamp = _user.ConcurrencyStamp,
                FirstName = _editFirstName,
                MiddleName = _editMiddleName,
                LastName = _editLastName,
                Suffix = _editSuffix,
                IdentityName = _editIdentityName,
                IdentityDescription = _user.IdentityDescription,
                BirthDate = DateOnly.TryParse(_editBirthDate, out var d) ? d : null,
                Gender = Enum.TryParse<Gender>(_editGender, out var g) ? g : null,
                CivilStatus = Enum.TryParse<CivilStatus>(_editCivilStatus, out var cs) ? cs : null,
                Metadata = new RequestMetadata { RequestedTenantId = _user.TenantId }
            });

            if (result.IsSuccess)
            {
                ToastService.Success("User updated successfully.", "User saved");
                if (result.Response is { } updated)
                    ApplyIdentityResponse(_user, updated);
                SyncEditFields();
                _editableForm?.ExitEditMode();
            }
            else
            {
                ToastService.Error("User could not be updated.", "Save failed");
            }
        }
        catch
        {
            ToastService.Error("User could not be updated.", "Save failed");
        }
        finally
        {
            _saving = false;
        }
    }

    private static void ApplyIdentityResponse(
        IdentityInformation target,
        IdentityAdministrationResponse source)
    {
        target.FirstName = source.FirstName;
        target.MiddleName = source.MiddleName;
        target.LastName = source.LastName;
        target.Suffix = source.Suffix;
        target.IdentityName = source.IdentityName;
        target.IdentityDescription = source.IdentityDescription;
        target.BirthDate = source.BirthDate;
        target.Gender = source.Gender;
        target.CivilStatus = source.CivilStatus;
        target.IsVerified = source.IsVerified;
        target.IsEnabled = source.IsEnabled;
        target.ConcurrencyStamp = source.ConcurrencyStamp;
        target.ModifiedAt = source.ModifiedAt;
    }

