    private async Task UploadCredentialAvatar()
    {
        if (_avatarCredential is null)
            return;

        var uploadItem = _credentialAvatarFiles.FirstOrDefault();
        var file = uploadItem?.File;
        if (file is null)
        {
            ToastService.Warning("Choose an image file.", "Missing image");
            return;
        }

        if (!CredentialAvatarPolicy.IsAllowedContentType(file.ContentType))
        {
            ToastService.Warning("Use a PNG, JPEG, or WebP image.", "Unsupported image");
            return;
        }

        if (file.Size > CredentialAvatarPolicy.MaxFileSizeBytes)
        {
            ToastService.Warning("Avatar image must be 5 MB or smaller.", "Image too large");
            return;
        }

        _saving = true;
        try
        {
            await using var stream = file.OpenReadStream(CredentialAvatarPolicy.MaxFileSizeBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var result = await IdentityServer.UploadCredentialAvatar(new UploadCredentialAvatarRequest
            {
                CredentialId = _avatarCredential.Id,
                FileName = file.Name,
                ContentType = file.ContentType,
                FileBytes = buffer.ToArray(),
                Metadata = CreateMetadata(_avatarCredential.TenantId)
            });

            if (result.IsSuccess)
            {
                ToastService.Success("Credential avatar uploaded.", "Avatar saved");
                CloseCredentialAvatarDialog();
                await LoadCredentials();
            }
            else
            {
                ToastService.Error("Credential avatar could not be uploaded.", "Upload failed");
            }
        }
        catch
        {
            ToastService.Error("Credential avatar could not be uploaded.", "Upload failed");
        }
        finally
        {
            _saving = false;
        }
    }

