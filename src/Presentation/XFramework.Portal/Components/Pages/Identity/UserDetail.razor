            .Select(x => new { x.GroupId, Label = x.Group?.Name ?? x.GroupId.ToString()[..8] })
            .DistinctBy(x => x.GroupId)
            .OrderBy(x => x.Label)
            .Select(x => new XfEntityPickerFilterOption(x.GroupId.ToString(), x.Label))
