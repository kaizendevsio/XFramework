@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout
@inject PortalLoginSites LoginSites
@inject NavigationManager Navigation

<PageTitle>Sign in - Portal</PageTitle>

<section class="login-panel" aria-label="Sign in">
    <div class="login-card">
        <div class="login-brand">
            @if (_interactive && !string.IsNullOrWhiteSpace(_site?.LogoUrl) && !_logoFailed)
            {
                <img src="@_site.LogoUrl" alt="@_site.BrandName" class="login-logo" referrerpolicy="no-referrer" @onerror="() => _logoFailed = true" />
            }
            else
            {
                <span class="login-wordmark">@(_site?.BrandName ?? "XSystems")</span>
            }
        </div>

        @if (_site is null)
        {
            <div class="login-error" role="alert">Sign-in is not configured for this address.</div>
        }
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="login-error" role="alert">@Error</div>
        }

        <form method="post" action="/auth/login" class="login-form">
            <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />

            <label>
                <span>Username</span>
                <input name="username" autocomplete="username" required autofocus disabled="@(!_interactive || _site is null)" />
            </label>

            <label>
                <span>Password</span>
                <input name="password" type="password" autocomplete="current-password" required disabled="@(!_interactive || _site is null)" />
            </label>

            <button type="submit" disabled="@(!_interactive || _site is null)">
                <span>Sign in</span>
                <LucideIcon Name="arrow-right" class="login-submit-icon" />
            </button>
        </form>
    </div>

</section>

@code {
    private bool _interactive;
    private bool _logoFailed;
    private PortalLoginSite? _site;

    protected override void OnInitialized() => _site = LoginSites.Resolve(new Uri(Navigation.Uri).Host);

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Prerendered fields are replaced when the interactive circuit starts.
            _interactive = true;
            StateHasChanged();
        }
    }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string SafeReturnUrl => IsSafeReturnUrl(ReturnUrl) ? ReturnUrl! : "/";

    private static bool IsSafeReturnUrl(string? returnUrl) =>
        !string.IsNullOrWhiteSpace(returnUrl) &&
        returnUrl.StartsWith('/') &&
        !returnUrl.StartsWith("//") &&
        !returnUrl.StartsWith('\\');
}

