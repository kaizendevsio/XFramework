        {
            Logger.LogError(ex, "Wallet close request failed.");
            ToastService.Error("Wallet close could not be requested.", "Wallets");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantFilterChanged;
    }
}
