@page "/finance/wallets/{Id:guid}"
@page "/finance/wallets/{Id:guid}/{Section}"
@using System.Globalization
@using global::Wallets.Domain.Shared.Enums
@using global::Wallets.Integration.Drivers
@using XFramework.Domain.Shared.BusinessObjects
@using XFramework.Domain.Shared.Contracts
@using XFramework.Domain.Shared.DataContext
@implements IDisposable

<PageTitle>Wallet Detail - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (_wallet is null)
{
    <BbTypographyMuted>Wallet not found.</BbTypographyMuted>
}
else if (_outsideTenantContext)
{
    <div class="space-y-4">
        <BbButton Variant="ButtonVariant.Ghost" OnClick="@GoBack">
            <LucideIcon Name="arrow-left" class="mr-2 h-4 w-4" />
            Back to Wallets
        </BbButton>
        <BbAlert>
            <BbAlertTitle>Wallet Outside Active Tenant</BbAlertTitle>
            <BbAlertDescription>Switch to All Tenants or the wallet's tenant to view this record.</BbAlertDescription>
        </BbAlert>
    </div>
}
else
{
    <FadeInContent>
    <div class="space-y-6">
        @* Header *@
        <div class="xf-page-header">
            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                      AriaLabel="Back to wallets"
                      OnClick="@GoBack">
                <LucideIcon Name="arrow-left" class="h-4 w-4" />
            </BbButton>
            <div class="flex-1">
                <BbTypographyH3>
                    Wallet: @(_wallet.AccountNumber ?? _wallet.Id.ToString()[..8] + "...")
                </BbTypographyH3>
                <BbTypographyMuted>
                    Type: @(_wallet.WalletType?.Name ?? "N/A") - @WalletsPortalDisplayService.ShortId(_wallet.Id)
                </BbTypographyMuted>
            </div>
            <div class="xf-page-actions">
                @if (_wallet.Status == WalletStatus.Active)
                {
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@FreezeWallet">
                        <LucideIcon Name="lock" class="mr-2 h-4 w-4" />
                        Request Freeze
                    </BbButton>
                }
                else if (_wallet.Status == WalletStatus.Frozen)
                {
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@UnfreezeWallet">
                        <LucideIcon Name="lock-open" class="mr-2 h-4 w-4" />
                        Request Unfreeze
                    </BbButton>
                }
                @if (_wallet.Status != WalletStatus.Closed)
                {
                    <BbButton Variant="ButtonVariant.Destructive" OnClick="@CloseWallet">
                        <LucideIcon Name="x" class="mr-2 h-4 w-4" />
                        Request Close
                    </BbButton>
                }
            </div>
        </div>

        @if (CurrentSection == "summary")
        {
        @* Wallet Summary Card *@
        <BbCard>
            <BbCardHeader>
                <div class="flex items-center justify-between">
                    <div>
                        <BbCardTitle>Wallet Summary</BbCardTitle>
                        <BbCardDescription>
                            Credential: @WalletsPortalDisplayService.ShortId(_wallet.CredentialId)
                        </BbCardDescription>
                    </div>
                    <StatusBadge Text="@_wallet.Status.ToString()" Status="@GetStatusKey(_wallet.Status)" />
                </div>
            </BbCardHeader>
            <BbCardContent>
                <div class="xf-summary-grid xf-summary-grid-4">
                    <BbCard>
                        <BbCardContent>
                            <div class="space-y-1 pt-4">
                                <BbTypographyMuted>Balance</BbTypographyMuted>
                                <BbTypographyH3>@_wallet.Balance.ToString("N2")</BbTypographyH3>
                            </div>
                        </BbCardContent>
                    </BbCard>
                    <BbCard>
                        <BbCardContent>
                            <div class="space-y-1 pt-4">
                                <BbTypographyMuted>Available Balance</BbTypographyMuted>
                                <BbTypographyH3 Class="@(_wallet.AvailableBalance < 0 ? "text-red-500" : "")">
                                    @_wallet.AvailableBalance.ToString("N2")
                                </BbTypographyH3>
                            </div>
                        </BbCardContent>
                    </BbCard>
                    <BbCard>
                        <BbCardContent>
                            <div class="space-y-1 pt-4">
                                <BbTypographyMuted>Debit On Hold</BbTypographyMuted>
                                <BbTypographyH3 Class="@(_wallet.DebitOnHoldBalance > 0 ? "text-yellow-600" : "")">
                                    @_wallet.DebitOnHoldBalance.ToString("N2")
                                </BbTypographyH3>
                            </div>
                        </BbCardContent>
                    </BbCard>
                    <BbCard>
                        <BbCardContent>
                            <div class="space-y-1 pt-4">
                                <BbTypographyMuted>Credit On Hold</BbTypographyMuted>
                                <BbTypographyH3 Class="@(_wallet.CreditOnHoldBalance > 0 ? "text-yellow-600" : "")">
                                    @_wallet.CreditOnHoldBalance.ToString("N2")
                                </BbTypographyH3>
                            </div>
                        </BbCardContent>
                    </BbCard>
                </div>

                <div class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-4">
                    <div class="space-y-1">
                        <BbTypographyMuted>Total Balance</BbTypographyMuted>
                        <BbTypographyLarge>@(_wallet.TotalBalance?.ToString("N2") ?? "N/A")</BbTypographyLarge>
                    </div>
                    <div class="space-y-1">
                        <BbTypographyMuted>Transferable Balance</BbTypographyMuted>
                        <BbTypographyLarge>@_wallet.TransferableBalance.ToString("N2")</BbTypographyLarge>
                    </div>
                    <div class="space-y-1">
                        <BbTypographyMuted>Account Number</BbTypographyMuted>
                        <BbTypographyLarge>@(_wallet.AccountNumber ?? "N/A")</BbTypographyLarge>
                    </div>
                    <div class="space-y-1">
                        <BbTypographyMuted>Created</BbTypographyMuted>
                        <BbTypographyLarge>@_wallet.CreatedAt.ToString("g")</BbTypographyLarge>
                    </div>
                </div>
            </BbCardContent>
        </BbCard>
        }

        else if (CurrentSection == "workflows")
        {
        @* Admin Operations *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Admin Operations</BbCardTitle>
                <BbCardDescription>Create wallet workflow requests. Settlement and sensitive changes require approval.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <BbTabs DefaultValue="add-funds">
                    <BbTabsList>
                        <BbTabsTrigger Value="add-funds">Deposit Request</BbTabsTrigger>
                        <BbTabsTrigger Value="withdraw-funds">Withdrawal Request</BbTabsTrigger>
                        <BbTabsTrigger Value="adjust-balance">Adjustment Approval</BbTabsTrigger>
                    </BbTabsList>

                    <BbTabsContent Value="add-funds" Class="xf-fade-in">
                        <div class="grid gap-4 py-4 md:grid-cols-2 xl:grid-cols-5">
                            <BbFormFieldCurrencyInput @bind-Value="_addFundsAmount"
                                                      Label="Amount"
                                                      ShowSymbol="false"
                                                      Min="0"
                                                      Required="true" />
                            <XfEntityPicker TItem="PaymentGateway"
                                            Label="Gateway"
                                            Value="@_addFundsGatewayId"
                                            ValueChanged="@(value => _addFundsGatewayId = value ?? NoSelectionValue)"
                                            Items="@_gateways"
                                            ValueSelector="@GetGatewayPickerValue"
                                            TextSelector="@BuildGatewayLabel"
                                            SearchTextSelector="@GetGatewaySearchText"
                                            AdvancedColumns="@GatewayAdvancedColumns"
                                            AdvancedFilters="@GatewayAdvancedFilters"
                                            AdvancedSearchScope="Searches gateway name, category/provider, enabled state, service charge, convenience fee, discount, and description."
                                            Placeholder="Select gateway"
                                            SearchPlaceholder="Search gateways..."
                                            EmptyMessage="No gateways found."
                                            AllowClear="true"
                                            ClearText="Clear gateway"
                                            AdvancedSearchTitle="Find Payment Gateway"
                                            AdvancedSearchDescription="Search configured payment gateways for this deposit request." />
                            <XfEntityPicker TItem="global::Wallets.Domain.Shared.Contracts.CurrencyType"
                                            Label="Currency"
                                            Value="@_addFundsCurrencyId"
                                            ValueChanged="@(value => _addFundsCurrencyId = value ?? NoSelectionValue)"
                                            Items="@_currencies"
                                            ValueSelector="@GetCurrencyPickerValue"
                                            TextSelector="@BuildCurrencyLabel"
                                            SearchTextSelector="@GetCurrencySearchText"
                                            AdvancedColumns="@CurrencyAdvancedColumns"
                                            AdvancedFilters="@CurrencyAdvancedFilters"
                                            AdvancedSearchScope="Searches currency ISO code, name, type, tenant scope, and description."
                                            Placeholder="Default wallet currency"
                                            SearchPlaceholder="Search currencies..."
                                            EmptyMessage="No currencies found."
                                            AllowClear="true"
                                            ClearText="Default wallet currency"
                                            AdvancedSearchTitle="Find Currency"
                                            AdvancedSearchDescription="Search tenant and global currencies available to Wallets." />
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_addFundsRef"
                                              Label="External Reference"
                                              Placeholder="REF-001" />
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_addFundsRemarks"
                                              Label="Remarks"
                                              Placeholder="Admin credit" />
                        </div>
                        <BbButton OnClick="@AddFunds" Disabled="@MoneyOperationsDisabled">
                            @if (_isProcessing)
                            {
                                <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                            }
                            <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                            Create Deposit
                        </BbButton>
                    </BbTabsContent>

                    <BbTabsContent Value="withdraw-funds" Class="xf-fade-in">
                        <div class="grid gap-4 py-4 md:grid-cols-2 xl:grid-cols-5">
                            <BbFormFieldCurrencyInput @bind-Value="_withdrawAmount"
                                                      Label="Amount"
                                                      ShowSymbol="false"
                                                      Min="0"
                                                      Required="true" />
                            <XfEntityPicker TItem="PaymentGateway"
                                            Label="Gateway"
                                            Value="@_withdrawGatewayId"
                                            ValueChanged="@(value => _withdrawGatewayId = value ?? NoSelectionValue)"
                                            Items="@_gateways"
                                            ValueSelector="@GetGatewayPickerValue"
                                            TextSelector="@BuildGatewayLabel"
                                            SearchTextSelector="@GetGatewaySearchText"
                                            AdvancedColumns="@GatewayAdvancedColumns"
                                            AdvancedFilters="@GatewayAdvancedFilters"
                                            AdvancedSearchScope="Searches gateway name, category/provider, enabled state, service charge, convenience fee, discount, and description."
                                            Placeholder="No provider"
                                            SearchPlaceholder="Search gateways..."
                                            EmptyMessage="No gateways found."
                                            AllowClear="true"
                                            ClearText="No provider"
                                            AdvancedSearchTitle="Find Payout Gateway"
                                            AdvancedSearchDescription="Search configured payment gateways for this withdrawal request." />
                            <XfEntityPicker TItem="global::Wallets.Domain.Shared.Contracts.CurrencyType"
                                            Label="Currency"
                                            Value="@_withdrawCurrencyId"
                                            ValueChanged="@(value => _withdrawCurrencyId = value ?? NoSelectionValue)"
                                            Items="@_currencies"
                                            ValueSelector="@GetCurrencyPickerValue"
                                            TextSelector="@BuildCurrencyLabel"
                                            SearchTextSelector="@GetCurrencySearchText"
                                            AdvancedColumns="@CurrencyAdvancedColumns"
                                            AdvancedFilters="@CurrencyAdvancedFilters"
                                            AdvancedSearchScope="Searches currency ISO code, name, type, tenant scope, and description."
                                            Placeholder="Default wallet currency"
                                            SearchPlaceholder="Search currencies..."
                                            EmptyMessage="No currencies found."
                                            AllowClear="true"
                                            ClearText="Default wallet currency"
                                            AdvancedSearchTitle="Find Currency"
                                            AdvancedSearchDescription="Search tenant and global currencies available to Wallets." />
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_withdrawRef"
                                              Label="External Reference"
                                              Placeholder="REF-001" />
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_withdrawRemarks"
                                              Label="Remarks"
                                              Placeholder="Admin debit" />
                        </div>
                        <BbButton Variant="ButtonVariant.Destructive" OnClick="@WithdrawFunds" Disabled="@MoneyOperationsDisabled">
                            @if (_isProcessing)
                            {
                                <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                            }
                            <LucideIcon Name="minus" class="mr-2 h-4 w-4" />
                            Create Withdrawal
                        </BbButton>
                    </BbTabsContent>

                    <BbTabsContent Value="adjust-balance" Class="xf-fade-in">
                        <BbAlert Variant="AlertVariant.Warning" class="mb-4">
                            <BbAlertTitle>Approval Required</BbAlertTitle>
                            <BbAlertDescription>
                                Balance adjustment creates a maker-checker approval request. Funds are not changed from this screen.
                            </BbAlertDescription>
                        </BbAlert>
                        <div class="grid gap-4 py-4 md:grid-cols-2">
                            <BbFormFieldCurrencyInput @bind-Value="_adjustBalance"
                                                      Label="New Balance"
                                                      ShowSymbol="false"
                                                      Min="0"
                                                      Required="true" />
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_adjustRemarks"
                                              Label="Remarks"
                                              Placeholder="Admin balance adjustment" />
                        </div>
                        <BbButton Variant="ButtonVariant.Outline" OnClick="@AdjustBalance" Disabled="@MoneyOperationsDisabled">
                            @if (_isProcessing)
                            {
                                <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                            }
                            <LucideIcon Name="settings" class="mr-2 h-4 w-4" />
                            Request Adjustment
                        </BbButton>
                    </BbTabsContent>
                </BbTabs>
            </BbCardContent>
        </BbCard>
        }

        else if (CurrentSection == "transactions")
        {
        @* Transaction History *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Transaction History</BbCardTitle>
                <BbCardDescription>@_transactions.Count transaction(s) recorded for this wallet</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <BbDataGrid Items="@_transactions" ShowPagination="true" InitialPageSize="20">
                    <Columns>
                        <BbDataGridTemplateColumn Title="Amount" Sortable="true" Filterable="true" FilterBy="@(item => item.Amount)">
                            <ChildContent Context="item">
                                <span class="font-semibold @(item.TransactionType == TransactionType.Credit ? "text-green-600" : "text-red-600")">
                                    @(item.TransactionType == TransactionType.Credit ? "+" : "")@item.Amount.ToString("N2")
                                </span>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Type" Filterable="true" FilterBy="@(item => GetTransactionTypeText(item))">
                            <ChildContent Context="item">
                                @if (item.TransactionType == TransactionType.Credit)
                                {
                                    <BbBadge Variant="BadgeVariant.Default">Credit</BbBadge>
                                }
                                else if (item.TransactionType == TransactionType.Debit)
                                {
                                    <BbBadge Variant="BadgeVariant.Destructive">Debit</BbBadge>
                                }
                                else
                                {
                                    <BbBadge Variant="BadgeVariant.Secondary">Unknown</BbBadge>
                                }
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Fee" Sortable="true" Filterable="true" FilterBy="@(item => item.TransactionFee)">
                            <ChildContent Context="item">
                                @if (item.TransactionFee > 0)
                                {
                                    <span class="text-yellow-600">@item.TransactionFee.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted-foreground">0.00</span>
                                }
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Held" Filterable="true" FilterBy="@(item => item.Held)">
                            <ChildContent Context="item">
                                <BbBadge Variant="@(item.Held ? BadgeVariant.Outline : BadgeVariant.Secondary)">
                                    @(item.Held ? "Held" : "No")
                                </BbBadge>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Released" Filterable="true" FilterBy="@(item => item.Released)">
                            <ChildContent Context="item">
                                <BbBadge Variant="@(item.Released ? BadgeVariant.Default : BadgeVariant.Secondary)">
                                    @(item.Released ? "Released" : "No")
                                </BbBadge>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Reference" Filterable="true" FilterBy="@(item => item.ReferenceNumber ?? string.Empty)">
                            <ChildContent Context="item">
                                <span class="font-mono text-xs">@(item.ReferenceNumber ?? "N/A")</span>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Remarks" Filterable="true" FilterBy="@(item => item.Remarks ?? string.Empty)">
                            <ChildContent Context="item">
                                @if (!string.IsNullOrEmpty(item.Remarks))
                                {
                                    <span title="@item.Remarks">
                                        @(item.Remarks.Length > 30 ? item.Remarks[..30] + "..." : item.Remarks)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted-foreground">--</span>
                                }
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Running Balance" Sortable="true" Filterable="true" FilterBy="@(item => item.RunningBalance)">
                            <ChildContent Context="item">
                                @(item.RunningBalance?.ToString("N2") ?? "N/A")
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
                        <BbDataGridTemplateColumn Title="Actions">
                            <ChildContent Context="item">
                                <div class="flex flex-wrap gap-1">
                                    @if (item.Held && !item.Released)
                                    {
                                        <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => ReleaseTransaction(item))" Disabled="@_isProcessing">
                                            Release
                                        </BbButton>
                                    }
                                    <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => ReverseTransaction(item))" Disabled="@_isProcessing">
                                        Reverse
                                    </BbButton>
                                </div>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                    </Columns>
                    <EmptyTemplate>
                        <BbEmpty Title="No transactions found" Description="Wallet transactions will appear here." />
                    </EmptyTemplate>
                </BbDataGrid>
            </BbCardContent>
        </BbCard>
        }

        else if (CurrentSection == "rules")
        {
        @* Wallet Rules *@
        <BbCard>
            <BbCardHeader>
                <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <div>
                        <BbCardTitle>Wallet Rules</BbCardTitle>
                        <BbCardDescription>Transfer and balance rules configured for this wallet</BbCardDescription>
                    </div>
                    @if (!_editingRules)
                    {
                        <BbButton Variant="ButtonVariant.Outline" OnClick="@StartEditRules">
                            <LucideIcon Name="settings" class="mr-2 h-4 w-4" />
                            Edit Rules
                        </BbButton>
                    }
                </div>
            </BbCardHeader>
            <BbCardContent>
                @if (_editingRules)
                {
                    <div class="space-y-4">
                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            <div class="space-y-3">
                                <BbFormFieldSwitch @bind-Value="_rulesMinTransferEnabled" Label="Use Min Transfer Rule" />
                                @if (_rulesMinTransferEnabled)
                                {
                                    <BbFormFieldCurrencyInput @bind-Value="_rulesMinTransfer"
                                                              Label="Min Transfer Rule"
                                                              ShowSymbol="false"
                                                              Min="0" />
                                }
                            </div>
                            <div class="space-y-3">
                                <BbFormFieldSwitch @bind-Value="_rulesMaxTransferEnabled" Label="Use Max Transfer Rule" />
                                @if (_rulesMaxTransferEnabled)
                                {
                                    <BbFormFieldCurrencyInput @bind-Value="_rulesMaxTransfer"
                                                              Label="Max Transfer Rule"
                                                              ShowSymbol="false"
                                                              Min="0" />
                                }
                            </div>
                            <div class="space-y-3">
                                <BbFormFieldSwitch @bind-Value="_rulesBondBalanceEnabled" Label="Use Bond Balance Rule" />
                                @if (_rulesBondBalanceEnabled)
                                {
                                    <BbFormFieldCurrencyInput @bind-Value="_rulesBondBalance"
                                                              Label="Bond Balance Rule"
                                                              ShowSymbol="false"
                                                              Min="0" />
                                }
                            </div>
                            <div class="space-y-3">
                                <BbFormFieldSwitch @bind-Value="_rulesMaintainingBalanceEnabled" Label="Use Maintaining Balance Rule" />
                                @if (_rulesMaintainingBalanceEnabled)
                                {
                                    <BbFormFieldCurrencyInput @bind-Value="_rulesMaintainingBalance"
                                                              Label="Maintaining Balance Rule"
                                                              ShowSymbol="false"
                                                              Min="0" />
                                }
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center justify-end gap-2">
                            <BbButton Variant="ButtonVariant.Outline" OnClick="@CancelEditRules" Disabled="@_savingRules">
                                <LucideIcon Name="x" class="mr-2 h-4 w-4" />
                                Cancel
                            </BbButton>
                            <BbButton OnClick="@SaveRules" Disabled="@_savingRules">
                                @if (_savingRules)
                                {
                                    <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                                }
                                else
                                {
                                    <LucideIcon Name="save" class="mr-2 h-4 w-4" />
                                }
                                Save Rules
                            </BbButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
                        <div class="space-y-1">
                            <BbTypographyMuted>Min Transfer Rule</BbTypographyMuted>
                            <BbTypographyLarge>
                                @(_wallet.MinTransferRule?.ToString("N2") ?? "Not set")
                            </BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Max Transfer Rule</BbTypographyMuted>
                            <BbTypographyLarge>
                                @(_wallet.MaxTransferRule?.ToString("N2") ?? "Not set")
                            </BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Bond Balance Rule</BbTypographyMuted>
                            <BbTypographyLarge>
                                @(_wallet.BondBalanceRule?.ToString("N2") ?? "Not set")
                            </BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Maintaining Balance Rule</BbTypographyMuted>
                            <BbTypographyLarge>
                                @(_wallet.MaintainingBalanceRule?.ToString("N2") ?? "Not set")
                            </BbTypographyLarge>
                        </div>
                    </div>
                }
            </BbCardContent>
        </BbCard>
        }
    </div>
    </FadeInContent>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string? Section { get; set; }
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Inject] private NavigationHistoryService NavigationHistory { get; set; } = default!;
    [Inject] private IWalletsServiceWrapper WalletsService { get; set; } = default!;
    [Inject] private WalletsAdminBackendContractService WalletsAdminContracts { get; set; } = default!;
    [Inject] private RequestMetadata RequestMetadata { get; set; } = default!;
    [Inject] private DialogService DialogService { get; set; } = default!;
    [Inject] private ILogger<WalletDetail> Logger { get; set; } = default!;

    private const string NoSelectionValue = "__none";
    private Wallet? _wallet;
    private List<WalletTransaction> _transactions = [];
    private List<global::Wallets.Domain.Shared.Contracts.CurrencyType> _currencies = [];
    private List<PaymentGateway> _gateways = [];
    private bool _loading = true;
    private bool _isProcessing;
    private bool _outsideTenantContext;
    private bool MoneyOperationsDisabled => _isProcessing || _wallet?.Status == WalletStatus.Closed;

    // Add Funds form
    private decimal _addFundsAmount;
    private string _addFundsRef = "";
    private string _addFundsRemarks = "";
    private string _addFundsGatewayId = NoSelectionValue;
    private string _addFundsCurrencyId = NoSelectionValue;

    // Withdraw Funds form
    private decimal _withdrawAmount;
    private string _withdrawRef = "";
    private string _withdrawRemarks = "";
    private string _withdrawGatewayId = NoSelectionValue;
    private string _withdrawCurrencyId = NoSelectionValue;

    // Adjust Balance form
    private decimal _adjustBalance;
    private string _adjustRemarks = "";
    private Guid? _loadedId;
    private bool _editingRules;
    private bool _savingRules;
    private bool _rulesMinTransferEnabled;
    private bool _rulesMaxTransferEnabled;
    private bool _rulesBondBalanceEnabled;
    private bool _rulesMaintainingBalanceEnabled;
    private decimal _rulesMinTransfer;
    private decimal _rulesMaxTransfer;
    private decimal _rulesBondBalance;
    private decimal _rulesMaintainingBalance;
    private string CurrentSection => NormalizeSection(Section);

    private static string NormalizeSection(string? section) =>
        string.IsNullOrWhiteSpace(section)
            ? "summary"
            : section.ToLowerInvariant() switch
            {
                "activity" => "transactions",
                "history" => "transactions",
                "operations" => "workflows",
                "workflow" => "workflows",
                "limits" => "rules",
                "rules" => "rules",
                "transactions" => "transactions",
                "workflows" => "workflows",
                _ => "summary"
            };

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantFilterChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await ReloadWalletDetail();
    }

    private void OnTenantFilterChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await ReloadWalletDetail();
            StateHasChanged();
        });
    }

    private async Task ReloadWalletDetail()
    {
        _loading = true;
        try
        {
            _transactions = [];
            await LoadWallet();
            if (_wallet is not null && !_outsideTenantContext)
            {
                await LoadWorkflowOptions(_wallet.TenantId);
                await LoadTransactions();
            }
            else
            {
                ResetWorkflowOptions();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load wallet detail.");
            ToastService.Error("Could not load wallet details.", "Wallets");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadWallet()
    {
        _outsideTenantContext = false;
        _wallet = await DataContext.Query<Wallet>()
            .IgnoreQueryFilters()
            .NoCache()
            .Include(x => x.WalletType)
            .Where(x => x.Id == Id && !x.IsDeleted)
            .FirstOrDefaultAsync();
        _outsideTenantContext = _wallet is not null
            && TenantFilter.SelectedTenantId is Guid tenantId
            && tenantId != _wallet.TenantId;
    }

    private async Task LoadTransactions()
    {
        if (_wallet is null)
        {
            _transactions = [];
            return;
        }

        var walletTenantId = _wallet.TenantId;
        _transactions = await DataContext.Query<WalletTransaction>()
            .IgnoreQueryFilters()
            .NoCache()
            .Where(x => x.WalletId == Id && x.TenantId == walletTenantId && !x.IsDeleted)
            .OrderByDescending(x => x.CreatedAt)
            .Take(100)
            .ToListAsync();
    }

    private string GetStatusKey(WalletStatus status) => status switch
    {
        WalletStatus.Active => "active",
        WalletStatus.Frozen => "frozen",
        WalletStatus.Suspended => "suspended",
        WalletStatus.Closed => "closed",
        _ => "inactive"
    };

    private async Task GoBack()
    {
        if (!NavigationHistory.CanGoBack)
        {
            NavigationManager.NavigateTo("/finance/wallets");
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("history.back");
        }
        catch (JSException)
        {
            NavigationManager.NavigateTo(NavigationHistory.PreviousUri ?? "/finance/wallets", replace: true);
        }
        catch (InvalidOperationException)
        {
            NavigationManager.NavigateTo(NavigationHistory.PreviousUri ?? "/finance/wallets", replace: true);
        }
    }

    private void StartEditRules()
    {
        if (_wallet is null)
        {
            return;
        }

        _rulesMinTransferEnabled = _wallet.MinTransferRule.HasValue;
        _rulesMaxTransferEnabled = _wallet.MaxTransferRule.HasValue;
        _rulesBondBalanceEnabled = _wallet.BondBalanceRule.HasValue;
        _rulesMaintainingBalanceEnabled = _wallet.MaintainingBalanceRule.HasValue;
        _rulesMinTransfer = _wallet.MinTransferRule ?? 0;
        _rulesMaxTransfer = _wallet.MaxTransferRule ?? 0;
        _rulesBondBalance = _wallet.BondBalanceRule ?? 0;
        _rulesMaintainingBalance = _wallet.MaintainingBalanceRule ?? 0;
        _editingRules = true;
    }

    private void CancelEditRules()
    {
        _editingRules = false;
    }

    private async Task SaveRules()
    {
        var minTransfer = _rulesMinTransferEnabled ? _rulesMinTransfer : (decimal?)null;
        var maxTransfer = _rulesMaxTransferEnabled ? _rulesMaxTransfer : (decimal?)null;
        var bondBalance = _rulesBondBalanceEnabled ? _rulesBondBalance : (decimal?)null;
        var maintainingBalance = _rulesMaintainingBalanceEnabled ? _rulesMaintainingBalance : (decimal?)null;

        if (!ValidateRule(minTransfer, "Min transfer rule", out var error)
            || !ValidateRule(maxTransfer, "Max transfer rule", out error)
            || !ValidateRule(bondBalance, "Bond balance rule", out error)
            || !ValidateRule(maintainingBalance, "Maintaining balance rule", out error))
        {
            ToastService.Warning(error, "Validation");
            return;
        }

        if (minTransfer is not null && maxTransfer is not null && minTransfer > maxTransfer)
        {
            ToastService.Warning("Min transfer rule cannot be greater than max transfer rule.", "Validation");
            return;
        }

        _savingRules = true;
        try
        {
            ToastService.Info("Wallet rule changes require the backend policy workflow and were not saved.", "Wallets");
            _editingRules = false;
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Wallet rule update failed.");
            ToastService.Error("Wallet rules could not be updated.", "Wallets");
        }
        finally
        {
            _savingRules = false;
        }
    }

    private RequestMetadata BuildCommandMetadata(Guid tenantId) => new()
    {
        RequestedTenantId = tenantId,
        RequestId = Guid.NewGuid(),
        OperationName = RequestMetadata.OperationName ?? "Portal",
        DeviceName = RequestMetadata.DeviceName,
        UserAgent = RequestMetadata.UserAgent,
        IpAddress = RequestMetadata.IpAddress
    };

    private static bool ValidateRule(decimal? value, string label, out string error)
    {
        error = "";

        if (value is null)
        {
            return true;
        }

        if (value < 0)
        {
            error = $"{label} cannot be negative.";
            return false;
        }

        return true;
    }

    private async Task LoadWorkflowOptions(Guid tenantId)
    {
        _currencies = await DataContext.Query<global::Wallets.Domain.Shared.Contracts.CurrencyType>()
            .IgnoreQueryFilters()
            .NoCache()
            .Where(x => !x.IsDeleted)
            .OrderBy(x => x.CurrencyIsoCode3)
            .Take(100)
            .ToListAsync();
        _currencies = _currencies
            .Where(x => x.TenantId == tenantId || x.TenantId == Guid.Empty)
            .ToList();

        await LoadPaymentGateways(tenantId);
    }

    private async Task LoadPaymentGateways(Guid tenantId)
    {
        try
        {
            _gateways = await DataContext.Query<PaymentGateway>()
                .IgnoreQueryFilters()
                .NoCache()
                .Include(x => x.PaymentGatewayCategory)
                .Where(x => !x.IsDeleted)
                .OrderBy(x => x.Name)
                .Take(100)
                .ToListAsync();
            _gateways = _gateways
                .Where(x => x.TenantId == tenantId || x.TenantId == Guid.Empty)
                .ToList();
        }
        catch (InvalidOperationException ex) when (IsMissingPaymentGatewayWrapper(ex))
        {
            _gateways = [];
        }
    }

    private void ResetWorkflowOptions()
    {
        _currencies = [];
        _gateways = [];
        _addFundsGatewayId = NoSelectionValue;
        _addFundsCurrencyId = NoSelectionValue;
        _withdrawGatewayId = NoSelectionValue;
        _withdrawCurrencyId = NoSelectionValue;
    }

    private async Task AddFunds()
    {
        if (_addFundsAmount <= 0)
        {
            ToastService.Warning("Please enter a valid positive amount.", "Validation");
            return;
        }

        if (!Guid.TryParse(_addFundsGatewayId, out var gatewayId))
        {
            ToastService.Warning("Select a payment gateway for the deposit request.", "Validation");
            return;
        }

        _isProcessing = true;
        try
        {
            var fresh = await DataContext.Query<Wallet>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id && !x.IsDeleted)
                .FirstOrDefaultAsync();

            if (fresh is null)
            {
                ToastService.Warning("Wallet not found.", "Wallets");
                return;
            }

            if (!HasWalletType(fresh))
            {
                return;
            }

            var response = await WalletsAdminContracts.CreateDepositAsync(new CreateDepositWorkflowRequest
            {
                CredentialId = fresh.CredentialId,
                WalletId = fresh.Id,
                CurrencyId = ParseOptionalGuid(_addFundsCurrencyId),
                GatewayId = gatewayId,
                Amount = _addFundsAmount,
                ExternalReference = string.IsNullOrWhiteSpace(_addFundsRef) ? null : _addFundsRef.Trim(),
                Remarks = string.IsNullOrWhiteSpace(_addFundsRemarks) ? "Admin credit" : _addFundsRemarks.Trim(),
                IdempotencyKey = $"portal-deposit-{Guid.NewGuid():N}"
            });

            if (response.IsSuccess)
            {
                ToastService.Success($"Deposit request created for {_addFundsAmount:N2}.", "Wallets");
                _addFundsAmount = 0;
                _addFundsRef = "";
                _addFundsRemarks = "";
                _addFundsGatewayId = NoSelectionValue;
                _addFundsCurrencyId = NoSelectionValue;
                await ReloadWalletDetail();
            }
            else
            {
                Logger.LogWarning("Deposit request creation failed: {Message}", response.Message);
                ToastService.Error("Deposit request could not be created.", "Wallets");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Deposit request creation failed.");
            ToastService.Error("Deposit request could not be created.", "Wallets");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task WithdrawFunds()
    {
        if (_withdrawAmount <= 0)
        {
            ToastService.Warning("Please enter a valid positive amount.", "Validation");
            return;
        }

        _isProcessing = true;
        try
        {
            var fresh = await DataContext.Query<Wallet>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id && !x.IsDeleted)
                .FirstOrDefaultAsync();

            if (fresh is null)
            {
                ToastService.Warning("Wallet not found.", "Wallets");
                return;
            }

            if (!HasWalletType(fresh))
            {
                return;
            }

            if (fresh.AvailableBalance < _withdrawAmount)
            {
                ToastService.Warning($"Insufficient balance. Available: {fresh.AvailableBalance:N2}, requested: {_withdrawAmount:N2}", "Validation");
                return;
            }

            var response = await WalletsAdminContracts.CreateWithdrawalAsync(new CreateWithdrawalWorkflowRequest
            {
                CredentialId = fresh.CredentialId,
                WalletId = fresh.Id,
                GatewayId = ParseOptionalGuid(_withdrawGatewayId),
                CurrencyId = ParseOptionalGuid(_withdrawCurrencyId),
                Amount = _withdrawAmount,
                ExternalReference = string.IsNullOrWhiteSpace(_withdrawRef) ? null : _withdrawRef.Trim(),
                Remarks = string.IsNullOrWhiteSpace(_withdrawRemarks) ? "Admin debit" : _withdrawRemarks.Trim(),
                IdempotencyKey = $"portal-withdrawal-{Guid.NewGuid():N}"
            });

            if (response.IsSuccess)
            {
                ToastService.Success($"Withdrawal request created for {_withdrawAmount:N2}.", "Wallets");
                _withdrawAmount = 0;
                _withdrawRef = "";
                _withdrawRemarks = "";
                _withdrawGatewayId = NoSelectionValue;
                _withdrawCurrencyId = NoSelectionValue;
                await ReloadWalletDetail();
            }
            else
            {
                Logger.LogWarning("Withdrawal request creation failed: {Message}", response.Message);
                ToastService.Error("Withdrawal request could not be created.", "Wallets");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Withdrawal request creation failed.");
            ToastService.Error("Withdrawal request could not be created.", "Wallets");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task AdjustBalance()
    {
        if (_adjustBalance < 0)
        {
            ToastService.Warning("Please enter a valid balance amount.", "Validation");
            return;
        }

        _isProcessing = true;
        try
        {
            // Fetch fresh wallet state
            var fresh = await DataContext.Query<Wallet>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id && !x.IsDeleted)
                .FirstOrDefaultAsync();

            if (fresh is null)
            {
                ToastService.Warning("Wallet not found.", "Wallets");
                return;
            }

            if (!HasWalletType(fresh))
            {
                return;
            }

            var difference = _adjustBalance - fresh.Balance;
            if (difference == 0)
            {
                ToastService.Info("Balance is already at the requested amount.", "Wallets");
                return;
            }

            var referenceNumber = $"ADJ-{DateTime.UtcNow:yyyyMMddHHmmss}";
            var remarks = string.IsNullOrWhiteSpace(_adjustRemarks)
                ? $"Admin balance adjustment: {fresh.Balance:N2} -> {_adjustBalance:N2}"
                : _adjustRemarks.Trim();

            var response = await WalletsAdminContracts.CreateWalletApprovalAsync(
                WalletOperationType.ManualAdjustment,
                fresh.Id,
                Math.Abs(difference),
                $"{remarks}; reference={referenceNumber}");

            if (response.IsSuccess)
            {
                ToastService.Success($"Balance adjustment approval requested for {_adjustBalance:N2}.", "Wallets");
                _adjustBalance = 0;
                _adjustRemarks = "";
            }
            else
            {
                Logger.LogWarning("Balance adjustment request failed: {Message}", response.Message);
                ToastService.Error("Balance adjustment could not be requested.", "Wallets");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Balance adjustment request failed.");
            ToastService.Error("Balance adjustment could not be requested.", "Wallets");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private bool HasWalletType(Wallet wallet)
    {
        if (wallet.WalletTypeId is Guid value && value != Guid.Empty)
        {
            return true;
        }

        ToastService.Warning("This wallet has no wallet type. Assign a wallet type before submitting money operations.", "Wallets");
        return false;
    }

