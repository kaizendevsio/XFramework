@page "/attendance/contexts"
@using XFramework.Domain.Shared.BusinessObjects
@implements IDisposable

<PageTitle>Attendance Contexts - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_hasTenant)
{
    <ModuleUnavailable ModuleName="Attendance" RequiresTenant="true" />
}
else if (!_moduleEnabled)
{
    <ModuleUnavailable ModuleName="Attendance" />
}
else
{
    <FadeInContent>
        <div class="space-y-6">
            <div class="xf-page-header">
                <div>
                    <BbTypographyH3>Attendance Contexts</BbTypographyH3>
                    <BbTypographyMuted>Manage reusable attendance containers for classes, shifts, projects, events, gates, and departments.</BbTypographyMuted>
                </div>
                <div class="xf-page-actions">
                    <BbButton OnClick="@OpenCreateDialog">
                        <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                        Create Context
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@Reload">
                        <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                        Refresh
                    </BbButton>
                </div>
            </div>

            <div class="xf-summary-grid xf-summary-grid-4">
                <BbCard>
                    <BbCardHeader><BbCardTitle>Total</BbCardTitle><BbCardDescription>Loaded contexts</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_contexts.Count</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader><BbCardTitle>Active</BbCardTitle><BbCardDescription>Available for sessions</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_contexts.Count(x => x.IsActive)</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader><BbCardTitle>Participants</BbCardTitle><BbCardDescription>Active assignments</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_contexts.Sum(x => x.ActiveParticipantCount)</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader><BbCardTitle>Sessions</BbCardTitle><BbCardDescription>Scheduled windows</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_contexts.Sum(x => x.SessionCount)</BbTypographyH2></BbCardContent>
                </BbCard>
            </div>

            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Context List</BbCardTitle>
                    <BbCardDescription>@_contexts.Count context(s) loaded</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataGrid Items="@_contexts"
                                ShowPagination="true"
                                InitialPageSize="20"
                                ShowSearch="true"
                                SearchPlaceholder="Search contexts..."
                                OnRowClick="@((AttendanceContextRow item) => OpenSessions(item))"
                                Class="cursor-pointer">
                        <Columns>
                            <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" Filterable="true" />
                            <BbDataGridTemplateColumn Title="Code" Sortable="true" Filterable="true" FilterBy="@(item => item.Code ?? string.Empty)">
                                <ChildContent Context="item">@(item.Code ?? "N/A")</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Type" Sortable="true" Filterable="true" FilterBy="@(item => item.ContextType.ToString())">
                                <ChildContent Context="item">@AttendancePortalReadService.FormatEnumLabel(item.ContextType)</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Status" Filterable="true" FilterBy="@(item => item.IsActive ? "Active" : "Inactive")">
                                <ChildContent Context="item">
                                    <StatusBadge Text="@(item.IsActive ? "Active" : "Inactive")" Status="@(item.IsActive ? "active" : "inactive")" />
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.ActiveParticipantCount)" Title="Participants" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.SessionCount)" Title="Sessions" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
                            <BbDataGridTemplateColumn Title="Actions">
                                <ChildContent Context="item">
                                    <div class="flex items-center gap-1" @onclick:stopPropagation="true">
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Open sessions" OnClick="@(() => OpenSessions(item))">
                                            <LucideIcon Name="calendar-clock" class="h-4 w-4" />
                                        </BbButton>
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Edit context" OnClick="@(() => OpenEditDialog(item))">
                                            <LucideIcon Name="pencil" class="h-4 w-4" />
                                        </BbButton>
                                    </div>
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                        </Columns>
                        <EmptyTemplate>
                            <BbEmpty Title="No attendance contexts" Description="Create a context before scheduling attendance sessions." />
                        </EmptyTemplate>
                    </BbDataGrid>
                </BbCardContent>
            </BbCard>
        </div>
    </FadeInContent>
}

<BbDialog Open="@_dialogOpen" OpenChanged="@(value => _dialogOpen = value)">
    <BbDialogContent Class="xf-dialog-wide">
        <BbDialogHeader>
            <BbDialogTitle>@(_editingContextId is Guid ? "Edit Attendance Context" : "Create Attendance Context")</BbDialogTitle>
            <BbDialogDescription>Contexts define who can be scheduled into attendance sessions.</BbDialogDescription>
        </BbDialogHeader>
        <div class="grid gap-4 py-4">
            <div class="grid gap-3 md:grid-cols-2">
                <BbFormFieldInput TValue="string" @bind-Value="_form.Name" Label="Name" Required="true" />
                <BbFormFieldInput TValue="string" @bind-Value="_form.Code" Label="Code" />
            </div>
            <BbFormFieldSelect TValue="string" @bind-Value="_form.ContextType" Label="Context Type">
                @foreach (var type in Enum.GetValues<AttendanceContextType>())
                {
                    <BbSelectItem Value="@type.ToString()">@AttendancePortalReadService.FormatEnumLabel(type)</BbSelectItem>
                }
            </BbFormFieldSelect>
            <BbFormFieldTextarea Value="@_form.Description"
                                 ValueChanged="@((string? value) => _form.Description = value ?? string.Empty)"
                                 Label="Description" />
            <BbFormFieldSwitch Checked="@_form.IsActive"
                               CheckedChanged="@((bool value) => _form.IsActive = value)"
                               Label="Active context" />
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@CloseDialog">Cancel</BbButton>
            <BbButton OnClick="@SaveContext" Disabled="@_saving">
                @if (_saving)
                {
                    <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                }
                Save
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Inject] private AttendancePortalReadService AttendanceReadService { get; set; } = default!;
    [Inject] private IAttendanceServiceWrapper Attendance { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private TenantModuleNavigationService ModuleNavigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private RequestMetadata RequestMetadata { get; set; } = default!;
    [Inject] private ILogger<Contexts> Logger { get; set; } = default!;

    private readonly ContextForm _form = new();
    private List<AttendanceContextRow> _contexts = [];
    private bool _loading = true;
    private bool _hasTenant;
    private bool _moduleEnabled;
    private bool _dialogOpen;
    private bool _saving;
    private Guid? _editingContextId;

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        ModuleNavigation.OnChanged += OnTenantChanged;
    }

    protected override async Task OnInitializedAsync() => await Reload();

    private void OnTenantChanged() => _ = InvokeAsync(Reload);

    private async Task Reload()
    {
        _loading = true;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _moduleEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Attendance);
            _contexts = [];

            if (!_hasTenant || !_moduleEnabled)
            {
                return;
            }

            _contexts = (await AttendanceReadService.LoadContextRowsAsync(TenantFilter.SelectedTenantId!.Value)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load attendance contexts.");
            ToastService.Error("Attendance contexts could not be loaded.", "Attendance");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void OpenCreateDialog()
    {
        _editingContextId = null;
        _form.Reset();
        _dialogOpen = true;
    }

    private void OpenEditDialog(AttendanceContextRow row)
    {
        _editingContextId = row.Id;
        _form.Name = row.Name;
        _form.Code = row.Code ?? string.Empty;
        _form.ContextType = row.ContextType.ToString();
        _form.Description = row.Description ?? string.Empty;
        _form.IsActive = row.IsActive;
        _dialogOpen = true;
    }

    private void CloseDialog() => _dialogOpen = false;

    private async Task SaveContext()
    {
        if (TenantFilter.SelectedTenantId is not Guid tenantId)
        {
            ToastService.Warning("Select a tenant before saving an attendance context.", "Validation");
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            ToastService.Warning("Context name is required.", "Validation");
            return;
        }

        if (!Enum.TryParse<AttendanceContextType>(_form.ContextType, out var contextType))
        {
            ToastService.Warning("Select a valid context type.", "Validation");
            return;
        }

        _saving = true;
        try
        {
            var metadata = BuildMetadata(tenantId);
            var response = _editingContextId is Guid contextId
                ? await Attendance.UpdateAttendanceContext(new UpdateAttendanceContextRequest
                {
                    TenantId = tenantId,
                    ContextId = contextId,
                    Name = _form.Name.Trim(),
                    Code = NullIfEmpty(_form.Code),
                    ContextType = contextType,
                    Description = NullIfEmpty(_form.Description),
                    IsActive = _form.IsActive,
                    Metadata = metadata
                })
                : await Attendance.CreateAttendanceContext(new CreateAttendanceContextRequest
                {
                    TenantId = tenantId,
                    Name = _form.Name.Trim(),
                    Code = NullIfEmpty(_form.Code),
                    ContextType = contextType,
                    Description = NullIfEmpty(_form.Description),
                    IsActive = _form.IsActive,
                    Metadata = metadata
                });

            if (response.IsSuccess)
            {
                ToastService.Success("Attendance context saved.", "Attendance");
                _dialogOpen = false;
                await Reload();
            }
            else
            {
                Logger.LogWarning("Attendance context save failed with status {StatusCode}", response.HttpStatusCode);
                ToastService.Error("Attendance context could not be saved.", "Attendance");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Attendance context save failed.");
            ToastService.Error("Attendance context could not be saved.", "Attendance");
        }
        finally
        {
            _saving = false;
        }
    }

    private void OpenSessions(AttendanceContextRow row) =>
        Navigation.NavigateTo($"/attendance/sessions?contextId={row.Id}");

    private RequestMetadata BuildMetadata(Guid tenantId) => new()
    {
        TenantId = tenantId,
        CredentialId = RequestMetadata.CredentialId,
        SessionId = RequestMetadata.SessionId,
        RequestId = Guid.NewGuid(),
        Name = RequestMetadata.Name ?? "Portal",
        DeviceName = RequestMetadata.DeviceName,
        DeviceAgent = RequestMetadata.DeviceAgent,
        IpAddress = RequestMetadata.IpAddress
    };

    private static string? NullIfEmpty(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantChanged;
        ModuleNavigation.OnChanged -= OnTenantChanged;
    }

    private sealed class ContextForm
    {
        public string Name { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public string ContextType { get; set; } = AttendanceContextType.General.ToString();
        public string Description { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;

        public void Reset()
        {
            Name = string.Empty;
            Code = string.Empty;
            ContextType = AttendanceContextType.General.ToString();
            Description = string.Empty;
            IsActive = true;
        }
    }
}
