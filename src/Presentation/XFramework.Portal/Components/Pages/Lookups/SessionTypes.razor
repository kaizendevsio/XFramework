@page "/lookups/session-types"
@using XFramework.Domain.Shared.DataContext

<PageTitle>Session Types - Portal</PageTitle>

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <BbTypographyH3>Session Types</BbTypographyH3>
    </div>

    @if (_loading)
    {
        <CenteredSpinner />
    }
    else
    {
    <BbDataGrid Items="@_items" ShowPagination="true" InitialPageSize="20">
        <Columns>
            <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Reference ID" Sortable="true" />
        </Columns>
    </BbDataGrid>
    }
</div>

@code {
    [Inject] private IDataContext DataContext { get; set; } = default!;

    private List<SessionType> _items = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _items = await DataContext.Query<SessionType>()
                .NoCache()
                .Take(100)
                .ToListAsync();
        }
        finally
        {
            _loading = false;
        }
    }
}
