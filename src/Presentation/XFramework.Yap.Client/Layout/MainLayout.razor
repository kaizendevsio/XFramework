@inherits LayoutComponentBase
@implements IDisposable
@inject ChatState State
@inject NavigationManager Nav
@inject IJSRuntime JS
<main class="app-shell">
    <div class="screen">@Body</div>
    <ToastHost />
    <div id="app-update" class="update-notice" role="status" hidden><span>A new version of Yap is ready.</span><button @onclick="UpdateAsync">Update app</button></div>
</main>
@code {
    private IDisposable? navigation;
    protected override void OnInitialized()
    {
        State.Changed += Changed;
        navigation = Nav.RegisterLocationChangingHandler(async context => await JS.InvokeVoidAsync("yap.motion.begin", Nav.Uri, context.TargetLocation));
    }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    { await JS.InvokeVoidAsync("yap.motion.complete"); await JS.InvokeVoidAsync("yap.device.checkUpdate"); }
    private async Task UpdateAsync() { await State.SaveBeforeUpdateAsync(); await JS.InvokeVoidAsync("yap.device.update"); }
    public void Dispose() { State.Changed -= Changed; navigation?.Dispose(); }
}
