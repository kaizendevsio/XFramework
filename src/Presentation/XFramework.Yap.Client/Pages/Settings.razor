@page "/settings"
@page "/settings/{Section}"
@implements IDisposable
@inject ChatState State
@inject NavigationManager Nav
@inject IJSRuntime JS
<PageTitle>Settings · Yap</PageTitle>
<ScrollSurface>
<Header><div class="appbar plain liquid-glass"><GlassLayer />@if (Section is not null) { <a class="iconbtn" href="/settings" aria-label="Back to settings"><Icon Name="back" /></a> }<h1>@SectionTitle</h1><span class="sp"></span></div></Header>
<ChildContent>
<div class="body settings">

    @if (Section is null)
    {
    <section class="identity-card">
        <Avatar Initials="@ChatMessage.InitialsFor(State.User?.Name)" ImageUrl="@State.User?.AvatarUrl" Size="a48" />
        <div class="identity-summary">
        <h2>@(State.User?.Name ?? "Not signed in")</h2>
        @if (State.User is not null) { <PhotoPicker Uploaded="State.RefreshProfileAsync" /> }
        @if (State.User is null || State.NeedsLogin) { <a class="btn h46" href="/login">Sign in</a> }
        </div>
    </section>

    <nav class="settings-menu" aria-label="Settings categories">
        @foreach (var item in Categories)
        { <a class="set-row" href="@($"/settings/{item.Route}")"><span class="settings-category-icon"><Icon Name="@item.Icon" /></span><span class="set-label">@item.Title<small>@item.Description</small></span><Icon Name="arrow" Size="17" /></a> }
    </nav>
    }
    @if (Section == "appearance")
    {
    <h3 class="set-group">Appearance</h3>
    <div class="set-list">
        <div class="set-row">
            <span class="set-key"><Icon Name="moon" Size="19" /><span class="set-label">Theme</span></span>
            <span class="segmented" role="group" aria-label="Theme">
                @foreach (var option in new[] { ("system", "Auto"), ("light", "Light"), ("dark", "Dark") })
                {
                    <button type="button" class="@(theme == option.Item1 ? "on" : "")" aria-pressed="@((theme == option.Item1).ToString().ToLowerInvariant())" @onclick="() => ThemeAsync(option.Item1)">@option.Item2</button>
                }
            </span>
        </div>
        <label class="set-row">
            <span class="set-key"><Icon Name="image" Size="19" /><span class="set-label">Accent color<small>Choose your favorite color for this device</small></span></span>
            <input class="accent-picker" type="color" aria-label="Accent color" value="@accent" @oninput="AccentAsync" />
        </label>
        <div class="accent-swatches" role="group" aria-label="Accent color presets">
            @foreach (var option in new[] { ("#d5f879", "Lime"), ("#82b5ff", "Blue"), ("#c5a0ff", "Purple"), ("#ffb4cf", "Pink"), ("#ffc582", "Peach") })
            {
                <button aria-label="@option.Item2" aria-pressed="@((accent == option.Item1).ToString().ToLowerInvariant())" style="background:@option.Item1" @onclick="() => SetAccentAsync(option.Item1)"></button>
            }
        </div>
        <button type="button" class="set-row set-action" @onclick="() => glass = !glass" aria-expanded="@glass.ToString().ToLowerInvariant()">
            <span class="set-key"><Icon Name="image" Size="19" /><span class="set-label">Glass<small>Blur, refraction and tint for this browser</small></span></span>
            <Icon Name="arrow" Size="17" Class="@(glass ? "set-chevron open" : "set-chevron")" />
        </button>
        @if (glass) { <div class="set-stack"><GlassControls /></div> }
        <button type="button" class="set-row set-action" disabled="@(!canVibrate)" aria-pressed="@haptics.ToString().ToLowerInvariant()" @onclick="ToggleHapticsAsync">
            <span class="set-key"><Icon Name="phone" Size="19" /><span class="set-label">Haptics<small>@HapticsDetail</small></span></span>
            <span class="set-value">@(!canVibrate ? "—" : haptics ? "On" : "Off")</span>
        </button>
    </div>

    }
    @if (Section == "privacy") { <EncryptionSettings /> }
    @if (Section == "calls") { <CallSettings /> }
    @if (Section == "storage")
    {
    <h3 class="set-group">Storage and sync</h3>
    <div class="set-list">
        <div class="set-row">
            <span class="set-key"><Icon Name="wifi" Size="19" /><span class="set-label">Waiting to sync<small>@(State.Online ? State.NeedsLogin ? "Sign in to resume" : "Connected" : "Reconnecting…")</small></span></span>
            <span class="set-value">@State.PendingCount</span>
        </div>
        <button type="button" class="set-row set-action" @onclick="SyncAsync">
            <span class="set-key"><Icon Name="arrow" Size="19" /><span class="set-label">Sync now<small>Send anything queued on this device</small></span></span>
            @if (State.Busy) { <span class="spinner set-value"></span> }
        </button>
        <button type="button" class="set-row set-action" @onclick="PersistAsync">
            <span class="set-key"><Icon Name="shield" Size="19" /><span class="set-label">Keep data on this device<small>@(persistNotice ?? "Ask the browser not to evict offline messages")</small></span></span>
        </button>
    </div>

    }
    @if (Section == "app")
    {
    <h3 class="set-group">App</h3>
    <div class="set-list">
        @if (installed)
        {
            <div class="set-row">
                <span class="set-key"><Icon Name="check" Size="19" /><span class="set-label">Installed<small>Yap is running as an app on this device</small></span></span>
            </div>
        }
        <button type="button" class="set-row set-action" @onclick="() => changes = !changes" aria-expanded="@changes.ToString().ToLowerInvariant()">
            <span class="set-key"><Icon Name="info" Size="19" /><span class="set-label">Version @Yap.Client.AppRelease.Version<small>What's new in Yap</small></span></span>
            <Icon Name="arrow" Size="17" />
        </button>
        @if (changes)
        {
            <div class="set-note release-notes">
                @foreach (var release in Yap.Client.AppRelease.History)
                {
                    <h3>@release.Version</h3><p>@release.Date</p>
                    <ul>@foreach (var note in release.Notes) { <li>@note</li> }</ul>
                }
            </div>
        }
        @if (!installed)
        {
            <button type="button" class="set-row set-action" @onclick="InstallAsync">
                <span class="set-key"><Icon Name="download" Size="19" /><span class="set-label">Install Yap<small>Add Yap to your home screen</small></span></span>
            </button>
        }
        <button type="button" class="set-row set-action" @onclick="() => gestures = !gestures" aria-expanded="@gestures.ToString().ToLowerInvariant()">
            <span class="set-key"><Icon Name="info" Size="19" /><span class="set-label">Gestures<small>How to reply, react and navigate</small></span></span>
            <Icon Name="arrow" Size="17" Class="@(gestures ? "set-chevron open" : "set-chevron")" />
        </button>
        @if (gestures)
        {
            <div class="set-note">
                <p><b>Swipe a message right</b> to reply to it.</p>
                <p><b>Press and hold, or tap, a message</b> to open its actions.</p>
                <p><b>Press and hold a conversation</b> to favorite, rename or delete it.</p>
                <p><b>Pull a sheet down by its handle</b> to close it.</p>
            </div>
        }
    </div>

    }
    @if (Section == "help")
    {
    <h3 class="set-group">Troubleshooting</h3>
    <div class="set-list"><button class="set-row set-action" aria-expanded="@diagnostics.ToString().ToLowerInvariant()" @onclick="() => diagnostics = !diagnostics"><span class="set-key"><Icon Name="info" Size="19" /><span class="set-label">Diagnostics<small>Collect and share troubleshooting logs</small></span></span><Icon Name="arrow" Size="17" Class="@(diagnostics ? "set-chevron open" : "set-chevron")" /></button>@if(diagnostics){<DiagnosticsControls />}</div>
    <p class="set-footnote">Loaded conversations, replies, drafts and opened attachments stay available offline. Messages and uploads you send while offline are saved here and sync when you reconnect.</p>

    }
    @if (State.User is not null && Section is null)
    {
        <div class="set-list">
                <button type="button" class="set-row set-action danger" @onclick="() => signOut = true">
                <span class="set-key"><Icon Name="trash" Size="19" /><span class="set-label">Sign out<small>Removes this account's offline data from this device</small></span></span>
            </button>
        </div>
    }

    @if (Section == "notifications")
    {
    <h3 class="set-group">Notifications</h3>
    <div class="set-list">
        <button type="button" class="set-row set-action" disabled="@(!PushAvailable || pushBusy)" aria-pressed="@pushSubscribed.ToString().ToLowerInvariant()" @onclick="TogglePushAsync">
            <span class="set-key"><Icon Name="alert" Size="19" /><span class="set-label">Push notifications<small>@PushDetail</small></span></span>
            <span class="set-value">@(pushBusy ? "…" : pushSubscribed ? "On" : "Off")</span>
        </button>
        <button type="button" class="set-row set-action" disabled="@(State.User is null)" aria-pressed="@previewText.ToString().ToLowerInvariant()" @onclick="TogglePreviewAsync">
            <span class="set-key"><Icon Name="shield" Size="19" /><span class="set-label">Show message text<small>@PreviewDetail</small></span></span>
            <span class="set-value">@(previewText ? "On" : "Off")</span>
        </button>
        @if (pushNotice is not null) { <div class="set-note" role="status">@pushNotice</div> }
    </div>
    <p class="set-footnote">A notification only wakes this device. Your messages stay end-to-end encrypted, so the server has nothing readable to put in one and never sends message text to Apple, Google or Mozilla. When message text is shown, this device decrypts it itself after the banner appears. Your phone's own "show previews" setting still decides what is visible while it is locked.</p>
    }
</div>
</ChildContent>
</ScrollSurface>
@if (signOut)
{
    <BottomSheet Title="Sign out" OnClose="() => signOut = false">
        <div class="picker">
            <p>Sign out and remove this account's offline data from this device? @if (State.PendingCount > 0) { <strong>@State.PendingCount queued messages and uploads will be discarded.</strong> }</p>
            <button class="btn" @onclick="LogoutAsync">Sign out and clear device data</button>
        </div>
    </BottomSheet>
}
@code {
    [Parameter] public string? Section { get; set; }
    private string SectionTitle => Categories.FirstOrDefault(x => x.Route == Section).Title ?? "Settings";
    private static readonly (string Route, string Title, string Icon, string Description)[] Categories = [
        ("appearance", "Appearance", "moon", "Theme, colors, glass and haptics"),
        ("notifications", "Notifications", "alert", "Alerts while Yap is closed"),
        ("privacy", "Privacy and security", "shield", "Encryption, recovery and devices"),
        ("calls", "Calls", "phone", "Microphone, ringtone and volume"),
        ("storage", "Storage and sync", "wifi", "Offline messages and pending sends"),
        ("app", "About Yap", "info", "Updates, installation and gestures"),
        ("help", "Help and diagnostics", "settings", "Troubleshooting and logs")];
    private bool signOut, gestures, glass, changes, canInstall, installed, diagnostics;
    private bool haptics = true, canVibrate;
    private string theme = "system";
    private string accent = "#d5f879";
    private string? persistNotice;

    protected override void OnInitialized() => State.Changed += Changed;
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= Changed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        theme = await JS.InvokeAsync<string>("yap.themePreference");
        accent = await JS.InvokeAsync<string>("yap.accentPreference");
        canVibrate = await JS.InvokeAsync<bool>("yap.haptics.supported");
        haptics = await JS.InvokeAsync<bool>("yap.haptics.enabled");
        canInstall = await JS.InvokeAsync<bool>("yap.device.canInstall");
        installed = await JS.InvokeAsync<bool>("yap.device.isInstalled");
        await LoadPushAsync();
        await LoadPreviewAsync();
        StateHasChanged();
    }

    private async Task ThemeAsync(string preference)
    {
        theme = preference;
        await JS.InvokeVoidAsync("yap.setThemePreference", preference);
    }

    // Safari has never shipped the Vibration API on iPhone or iPad, and no script can add it,
    // so the row says why it is dead rather than offering a switch that does nothing.
    private string HapticsDetail => !canVibrate
        ? "This browser cannot vibrate. iPhone and iPad never can, in Safari or as an installed app."
        : "A brief tap when menus, sheets and gestures land on this device";
    private async Task ToggleHapticsAsync()
    {
        haptics = await JS.InvokeAsync<bool>("yap.haptics.setEnabled", !haptics);
        if (haptics) await JS.InvokeVoidAsync("yap.haptics.buzz", "commit");
    }

    private Task AccentAsync(ChangeEventArgs args) => SetAccentAsync(args.Value?.ToString() ?? accent);
    private async Task SetAccentAsync(string color) { accent = color; await JS.InvokeVoidAsync("yap.setAccent", color); }
    private Task SyncAsync() => State.RetryAsync();

    private async Task PersistAsync()
    {
        persistNotice = await JS.InvokeAsync<bool>("yap.device.persist")
            ? "The browser granted persistent storage."
            : "The browser manages storage automatically. Keep enough free space for offline data.";
    }

    private async Task InstallAsync()
    {
        await JS.InvokeVoidAsync("yap.installSupport.open");
        canInstall = await JS.InvokeAsync<bool>("yap.device.canInstall");
    }

    private async Task LogoutAsync() { await State.LogoutAsync(); Nav.NavigateTo("/login"); }
}
