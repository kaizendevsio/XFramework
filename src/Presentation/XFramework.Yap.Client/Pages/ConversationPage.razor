@page "/chat/{Id:guid}"
@page "/chat/{Id:guid}/details"
@page "/thread/{Id:guid}/{ParentId:guid}"
@implements IDisposable
@inject ChatState State
@inject BrowserTime Times
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject VoiceState Voice
<PageTitle>@(ParentId.HasValue ? "Thread" : State.Selected?.Name ?? "Conversation") · Yap</PageTitle>
@if (State.User is null) { <div class="body"><p>Sign in to open this conversation.</p><a class="btn" href="/login">Sign in</a></div> }
else
{
    var chat = State.Selected?.Id == Id ? State.Selected : State.Conversations.FirstOrDefault(x => x.Id == Id) ?? new Conversation { Id = Id };
    <div class="conversation-screen" hidden="@(ShowingDetails || Searching)"><ScrollSurface><Header><div class="appbar liquid-glass"><GlassLayer /><a class="iconbtn" href="@(ParentId.HasValue ? $"/chat/{Id}" : "/")" aria-label="Go back"><Icon Name="back" /></a>
        @if (!ParentId.HasValue) { <button class="conversation-avatar" aria-label="Conversation details" @onclick="OpenDetails"><Avatar Initials="@chat.Initials" ImageUrl="@chat.AvatarUrl" Color="@chat.Color" /></button> }
        <button class="mid conversation-title" aria-label="Conversation settings" @onclick="OpenDetails"><h1 style="font-size:16px">@(ParentId.HasValue ? "Thread" : chat.Name)</h1><span class="muted" style="font-size:12px">@(ParentId.HasValue ? $"{chat.Name} · {Parent?.ReplyTotal ?? 0} replies" : State.ConversationSubtitle(chat))</span></button>
        <button class="iconbtn" aria-label="Search messages" @onclick="OpenSearch"><Icon Name="search" /></button>
        @if(Voice.VideoAvailable){<button class="iconbtn" aria-label="Start video call" disabled="@(!State.Online || State.NeedsLogin || Voice.IsCalling)" @onclick="() => CallAsync(true)"><Icon Name="video" /></button>}
        @if(Voice.Enabled){<button class="iconbtn" aria-label="Start voice call" disabled="@(!State.Online || State.NeedsLogin || Voice.IsCalling)" @onclick="() => CallAsync(false)"><Icon Name="phone" /></button>}
    </div></Header>
    <ChildContent>
    @if (ParentId.HasValue)
    {
        @if (Parent is { } parent)
        {
            <MessageWindow @key="ParentId" Items="parent.Replies" Visible="() => State.ReadVisibleAsync(Id, ParentId)" HasMore="State.HasEarlierReplies(parent)" Earlier="() => State.LoadRepliesAsync(parent)" HasNewer="State.HasNewerReplies" Newer="() => State.LoadRepliesAsync(parent, true)">
                <Header><div class="threadhead"><div class="parentmsg"><Avatar Initials="@parent.Initials" ImageUrl="@parent.AvatarUrl" Color="@parent.Color" Size="a34" /><div class="mid"><div class="nm">@parent.Sender </div><div class="tx">@parent.Text</div><MessageMedia Message="parent" /></div></div><div class="replycount">@parent.ReplyTotal replies</div></div></Header>
                <ChildContent Context="message"><MessageBubble Message="message" Latest="MessageReceipts.IsLatest(message, parent.Replies)" ShowTime="@(!State.HasNewerReplies && parent.Replies.LastOrDefault()?.Id == message.Id)" Readers="MessageReceipts.Readers(message, parent.Replies)" ShowSender="true" OnSelect="Select" OnReply="ReplyTo" OnThread="OpenThreadAsync" OnReact='emoji => State.ActionAsync(message, "react", emoji: emoji)' /></ChildContent>
            </MessageWindow>
        }
        else if (State.OpeningConversation) { <MessageSkeleton /> }
        else { <p class="empty">This message is not saved on this device.</p> }
    }
    else
    {
        <MessageWindow @key="Id" Items="chat.Messages" Opening="State.OpeningConversation" Visible="() => State.ReadVisibleAsync(Id)" HasMore="State.HasEarlierMessages" Earlier="State.LoadEarlierAsync" HasNewer="State.HasNewerMessages" Newer="State.LoadNewerAsync">
            <ChildContent Context="message"><MessageBubble Message="message" Latest="MessageReceipts.IsLatest(message, chat.Messages)" ShowTime="@(!State.HasNewerMessages && chat.Messages.LastOrDefault()?.Id == message.Id)" Readers="MessageReceipts.Readers(message, chat.Messages)" ShowSender="chat.Group" OnSelect="Select" OnReply="ReplyTo" OnThread="OpenThreadAsync" OnReact='emoji => State.ActionAsync(message, "react", emoji: emoji)' /></ChildContent>
        </MessageWindow>
    }
    </ChildContent><Footer><Composer @key="@(ParentId ?? Id)" ThreadId="Id" ParentId="ParentId" Reply="reply" Cancel="() => reply = null" RestoreReply="message => reply ??= message" /></Footer></ScrollSurface></div>
    @if (Searching)
    {
        @* Search is a screen of its own, not a sheet: a sheet leaves a phone keyboard barely two results of room. *@
        <ScrollSurface><Header><div class="appbar liquid-glass search-appbar"><GlassLayer /><button class="iconbtn" aria-label="Close search" @onclick="CloseSearch"><Icon Name="back" /></button>
            <label class="searchbar liquid-glass search-field"><GlassLayer /><Icon Name="search" Size="18" /><input @ref="searchInput" type="search" enterkeyhint="search" autocomplete="off" aria-label="Search messages" placeholder="Search this conversation" @bind="query" @bind:event="oninput" @onkeydown="SearchKeyDown" />
            @if (query.Length > 0) { <button class="iconbtn search-clear" aria-label="Clear search" @onclick="ClearSearch"><Icon Name="close" Size="16" /></button> }</label>
        </div></Header><ChildContent><div class="body"><MessageSearch Query="@query" Thread="Id" FullScreen="true" OnOpen="hit => ShowHitAsync(hit.MessageId)" /></div></ChildContent></ScrollSurface>
    }
    @if (ShowingDetails)
    {
        <ScrollSurface><Header><div class="appbar plain"><a class="iconbtn" href="@($"/chat/{Id}")" aria-label="Back to conversation"><Icon Name="back" /></a><h1>Chat details</h1></div></Header><ChildContent><div class="body details-body"><ConversationSettings Conversation="chat" Search="SearchFromDetails" Call="CallFromDetails" CanCall="@(Voice.Enabled && State.Online && !Voice.IsCalling)" Locate="LocateFromDetails" /></div></ChildContent></ScrollSurface>
    }
}
@if (mode == "message" && selected is not null)
{
<MessageMenu Message="selected" OnClose="() => mode = null">
    @if (State.Selected?.Allows(ChatFeature.Reactions) != false) { <div class="menu-reactions">@foreach (var reaction in State.Defaults?.Reactions ?? []) { <button aria-label="@($"React {reaction.Emoji}")" disabled="@(!State.Online || State.NeedsLogin)" @onclick="() => ReactAsync(reaction.Emoji)">@reaction.Emoji</button> }</div> }
    <div class="menu-message-preview"><span data-menu-photo></span><span class="menu-preview-label">@(selected.HasAttachments ? selected.Attachments.Any(MessageMedia.IsVideo) ? "Video" : "Attachment" : selected.Text)</span></div>
    <time class="menu-message-time" datetime="@BrowserTime.Iso(selected.CreatedAt)">@Times.Full(selected.CreatedAt)</time>
    <div class="menu-actions">
    @if (State.Selected?.Allows(ChatFeature.Replies) != false) { <button @onclick="() => ReplyTo(selected)">Reply<Icon Name="reply" Size="20" /></button> }
    @if (!selected.HasAttachments) { <button @onclick="CopyAsync">Copy<Icon Name="file" Size="20" /></button> }
    @if (selected.Mine) { <button class="danger" @onclick='() => mode = "delete"'>Delete<Icon Name="trash" Size="20" /></button> }
    <button aria-expanded="@moreActions.ToString().ToLowerInvariant()" @onclick="() => moreActions = !moreActions">More<Icon Name="more" Size="20" /></button>
    @if (moreActions) {
    @if (State.Selected?.Allows(ChatFeature.Threads) != false) { <button class="sheetitem" @onclick="() => OpenThreadAsync(selected)"><Icon Name="thread" Size="20" />Reply in thread</button> }
    <button class="sheetitem" @onclick='() => mode = "forward"'><Icon Name="arrow" Size="20" />Forward text</button>
    <button class="sheetitem" @onclick="CopyAsync"><Icon Name="file" Size="20" />Copy text</button>
    <button class="sheetitem" @onclick="FilesAsync"><Icon Name="file" Size="20" />Attachments</button>
    <button class="sheetitem" @onclick='() => ActionAsync(selected.Pinned ? "unpin" : "pin")'><Icon Name="plus" Size="20" />@(selected.Pinned ? "Unpin message" : "Pin message")</button>
    <button class="sheetitem" @onclick='() => ActionAsync(selected.Saved ? "unsave" : "save")'><Icon Name="file" Size="20" />@(selected.Saved ? "Unsave message" : "Save message")</button>
    @if (selected.Mine && !selected.HasAttachments && State.CanEditMessage(selected)) { <button class="sheetitem" @onclick='() => { edit = selected.Text; mode = "edit"; }'><Icon Name="edit" Size="20" />Edit message</button> }
    }
    </div>
</MessageMenu>
}
@if (mode is not null && mode is not ("message" or "search"))
{
<BottomSheet Title="@(mode == "details" ? "Conversation" : mode == "files" ? "Attachments" : mode == "edit" ? "Edit message" : "Message actions")" OnClose="() => mode = null">
@if (mode == "files" && selected is not null)
{ <div class="picker">@foreach (var file in selected.Attachments) { <button class="row" @onclick="() => State.OpenFileAsync(selected, file)"><Icon Name="file" /><span>@file.Name <small>@(file.Size / 1024) KB</small></span></button> }<p class="muted">Opened files are saved on this device for offline use.</p></div> }
else if (mode == "edit")
{ <div class="picker"><textarea aria-label="Edit message" @bind="edit" @bind:event="oninput" maxlength="4000"></textarea><button class="btn" @onclick='() => ActionAsync("edit", edit)'>Save changes</button></div> }
else if (mode == "delete")
{ <div class="picker"><p>Delete this message for everyone?</p><button class="btn" @onclick='() => ActionAsync("delete")'>Delete message</button></div> }
else if (mode == "forward")
{ <div class="picker">@foreach (var target in State.Conversations) { <button class="row" @onclick="() => ForwardAsync(target.Id)"><Avatar Initials="@target.Initials" Size="a34" />@target.Name</button> }</div> }
</BottomSheet>
}
@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public Guid? ParentId { get; set; }
    [SupplyParameterFromQuery(Name = "message")] public Guid? FocusMessage { get; set; }
    private ChatMessage? Parent => State.Selected?.Messages.FirstOrDefault(x => x.Id == ParentId);
    private ChatMessage? reply, selected;
    private string? mode;
    private bool ShowingDetails => new Uri(Nav.Uri).AbsolutePath.EndsWith("/details", StringComparison.Ordinal);
    private void OpenDetails() { mode = null; Nav.NavigateTo($"/chat/{Id}/details"); }
    private bool Searching => mode == "search";
    private void OpenSearch() { mode = "search"; query = ""; focusSearch = true; }
    private void CloseSearch() { mode = null; query = ""; }
    private void ClearSearch() { query = ""; focusSearch = true; }
    private void SearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") CloseSearch(); }
    private void SearchFromDetails() { Nav.NavigateTo($"/chat/{Id}"); OpenSearch(); }
    private async Task CallFromDetails() { Nav.NavigateTo($"/chat/{Id}"); await CallAsync(false); }
    private async Task LocateFromDetails(Guid message) { Nav.NavigateTo($"/chat/{Id}"); await ShowHitAsync(message); }
    private string edit = "";
    private Guid loaded;
    private Guid? loadedParent;
    private Guid? focus;
    private string query = "";
    private ElementReference searchInput;
    private bool focusSearch;
    private bool moreActions;
    protected override void OnInitialized() { State.Changed += Changed; State.ConversationRemoved += Removed; Voice.Changed += Changed; Nav.LocationChanged += LocationChanged; }
    // Both routes have identical component parameters. Blazor can skip their render,
    // so changes to the URI-derived details view must explicitly invalidate it.
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) => Changed();
    private void Removed(Guid id) { if (id == Id) _ = InvokeAsync(() => Nav.NavigateTo("/")); }
    protected override async Task OnParametersSetAsync()
    {
        if (State.User is not null && loaded != Id) { loaded = Id; await State.SelectAsync(Id); }
        if (ParentId.HasValue && loadedParent != ParentId)
        {
            await State.LocateAsync(ParentId.Value);
            if (Parent is { } parent) await State.LoadRepliesAsync(parent);
            loadedParent = ParentId;
        }
        if (!ParentId.HasValue) loadedParent = null;
        if (FocusMessage.HasValue) { await State.LocateAsync(FocusMessage.Value); focus = FocusMessage; }
    }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("yap.motion.complete");
        // Opening search should land on a live keyboard, the way a native search screen does.
        if (focusSearch && Searching) { focusSearch = false; try { await searchInput.FocusAsync(); } catch (Exception ex) { State.Report(ex); } }
        if (focus.HasValue) { var id = focus; focus = null; await JS.InvokeVoidAsync("yap.showMessage", id); }
    }
    private void Select(ChatMessage message) { selected = message; moreActions = false; mode = "message"; _ = ExpireEditAsync(message); }
    // A borderline message must lose Edit while the menu is still open. One timer per
    // selection is enough: the deadline never moves once the message exists.
    private async Task ExpireEditAsync(ChatMessage message)
    {
        editExpiry?.Cancel(); editExpiry?.Dispose(); editExpiry = null;
        if (State.EditExpiry(message) - DateTime.UtcNow is not { } left || left <= TimeSpan.Zero || left > TimeSpan.FromHours(1)) return;
        var source = editExpiry = new CancellationTokenSource();
        try { await Task.Delay(left + TimeSpan.FromSeconds(1), source.Token); if (selected == message) await InvokeAsync(StateHasChanged); }
        catch (OperationCanceledException) { }
    }
    private CancellationTokenSource? editExpiry;
    private void ReplyTo(ChatMessage message) { if (State.Selected?.Allows(ChatFeature.Replies) == false) return; reply = message; mode = null; }
    private Task OpenThreadAsync(ChatMessage message) { if (State.Selected?.Allows(ChatFeature.Threads) != false) { mode = null; Nav.NavigateTo($"/thread/{Id}/{message.Id}"); } return Task.CompletedTask; }
    private async Task CopyAsync() { mode = null; try { await JS.InvokeVoidAsync("yap.copy", selected!.Text); } catch (Exception ex) { State.Report(ex); } }
    private async Task FilesAsync() { mode = "files"; try { await State.OpenAttachmentsAsync(selected!); } catch (Exception ex) { State.Report(ex); } }
    private Task ReactAsync(string emoji) { mode = null; return State.ActionAsync(selected!, "react", emoji: emoji); }
    private Task ActionAsync(string action, string? text = null) { mode = null; return State.ActionAsync(selected!, action, text); }
    private async Task ForwardAsync(Guid target) { var text = selected!.Text; mode = null; Nav.NavigateTo($"/chat/{target}"); try { await State.SendAsync(target, text, null, $"forward:{Guid.NewGuid()}"); } catch (Exception ex) { State.Report(ex); } }
    private async Task ShowHitAsync(Guid id) { mode = null; query = ""; await State.LocateAsync(id); focus = id; }
    private async Task CallAsync(bool video)
    {
        if (State.Selected is not { } conversation) return;
        mode = null;
        await Voice.StartGroupAsync(Id, conversation.Name, conversation.People, video);
    }
    public void Dispose() { editExpiry?.Cancel(); editExpiry?.Dispose(); Nav.LocationChanged -= LocationChanged; State.Changed -= Changed; State.ConversationRemoved -= Removed; Voice.Changed -= Changed; State.LeaveConversation(loaded); }
}
