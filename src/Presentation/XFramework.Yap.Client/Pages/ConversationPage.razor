@page "/chat/{Id:guid}"
@page "/thread/{Id:guid}/{ParentId:guid}"
@implements IDisposable
@inject ChatState State
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject VoiceState Voice
<PageTitle>@(ParentId.HasValue ? "Thread" : State.Selected?.Name ?? "Conversation") · Yap</PageTitle>
@if (State.User is null) { <div class="body"><p>Sign in to open this conversation.</p><a class="btn" href="/login">Sign in</a></div> }
else if (State.Selected is not { } chat || chat.Id != Id) { <div class="empty">Opening conversation…</div> }
else
{
    <ScrollSurface><Header><div class="appbar liquid-glass"><GlassLayer /><a class="iconbtn" href="@(ParentId.HasValue ? $"/chat/{Id}" : "/")" aria-label="Go back"><Icon Name="back" /></a>
        @if (!ParentId.HasValue) { <Avatar Initials="@chat.Initials" ImageUrl="@chat.AvatarUrl" Color="@chat.Color" /> }
        <button class="mid conversation-title" aria-label="Conversation settings" @onclick='() => mode = "details"'><h1 style="font-size:16px">@(ParentId.HasValue ? "Thread" : chat.Name)</h1><span class="muted" style="font-size:12px">@(ParentId.HasValue ? $"{chat.Name} · {Parent?.ReplyTotal ?? 0} replies" : State.ConversationSubtitle(chat))</span></button>
        <button class="iconbtn" aria-label="Search messages" @onclick='() => mode = "search"'><Icon Name="search" /></button>
        @if(Voice.Enabled){<button class="iconbtn" aria-label="Start voice call" disabled="@(!State.Online || State.NeedsLogin || Voice.IsCalling)" @onclick="CallAsync"><Icon Name="phone" /></button>}
    </div></Header>
    <ChildContent>
    @if (ParentId.HasValue)
    {
        @if (Parent is { } parent)
        {
            <MessageWindow @key="ParentId" Items="parent.Replies" Visible="() => State.ReadVisibleAsync(Id, ParentId)" HasMore="State.HasEarlierReplies(parent)" Earlier="() => State.LoadRepliesAsync(parent)" HasNewer="State.HasNewerReplies" Newer="() => State.LoadRepliesAsync(parent, true)">
                <Header><div class="threadhead"><div class="parentmsg"><Avatar Initials="@parent.Initials" ImageUrl="@parent.AvatarUrl" Color="@parent.Color" Size="a34" /><div class="mid"><div class="nm">@parent.Sender </div><div class="tx">@parent.Text</div><MessageMedia Message="parent" /></div></div><div class="replycount">@parent.ReplyTotal replies</div></div></Header>
                <ChildContent Context="message"><MessageBubble Message="message" Latest="MessageReceipts.IsLatest(message, parent.Replies)" ShowTime="@(!State.HasNewerReplies && parent.Replies.LastOrDefault()?.Id == message.Id)" Readers="MessageReceipts.Readers(message, parent.Replies)" ShowSender="true" OnSelect="Select" OnReply="ReplyTo" OnThread="OpenThreadAsync" OnReact='emoji => State.ActionAsync(message, "react", emoji: emoji)' /></ChildContent>
            </MessageWindow>
        }
        else { <p class="empty">This message is not saved on this device.</p> }
    }
    else
    {
        <MessageWindow @key="Id" Items="chat.Messages" Visible="() => State.ReadVisibleAsync(Id)" HasMore="State.HasEarlierMessages" Earlier="State.LoadEarlierAsync" HasNewer="State.HasNewerMessages" Newer="State.LoadNewerAsync">
            <ChildContent Context="message"><MessageBubble Message="message" Latest="MessageReceipts.IsLatest(message, chat.Messages)" ShowTime="@(!State.HasNewerMessages && chat.Messages.LastOrDefault()?.Id == message.Id)" Readers="MessageReceipts.Readers(message, chat.Messages)" ShowSender="chat.Group" OnSelect="Select" OnReply="ReplyTo" OnThread="OpenThreadAsync" OnReact='emoji => State.ActionAsync(message, "react", emoji: emoji)' /></ChildContent>
        </MessageWindow>
    }
    </ChildContent><Footer><Composer @key="@(ParentId ?? Id)" ThreadId="Id" ParentId="ParentId" Reply="reply" Cancel="() => reply = null" /></Footer></ScrollSurface>
}
@if (mode == "message" && selected is not null)
{
<MessageMenu Message="selected" OnClose="() => mode = null">
    @if (State.Selected?.Allows(ChatFeature.Reactions) != false) { <div class="menu-reactions">@foreach (var reaction in State.Defaults?.Reactions ?? []) { <button aria-label="@($"React {reaction.Emoji}")" disabled="@(!State.Online || State.NeedsLogin)" @onclick="() => ReactAsync(reaction.Emoji)">@reaction.Emoji</button> }</div> }
    <div class="menu-message-preview"><span data-menu-photo></span><span class="menu-preview-label">@(selected.HasAttachments ? selected.Attachments.Any(MessageMedia.IsVideo) ? "Video" : "Attachment" : selected.Text)</span></div>
    <time class="menu-message-time" datetime="@selected.CreatedAt.ToUniversalTime().ToString("O")">@selected.CreatedAt.ToLocalTime().ToString("f")</time>
    <div class="menu-actions">
    @if (State.Selected?.Allows(ChatFeature.Replies) != false) { <button @onclick="() => ReplyTo(selected)">Reply<Icon Name="reply" Size="20" /></button> }
    @if (!selected.HasAttachments) { <button @onclick="CopyAsync">Copy<Icon Name="file" Size="20" /></button> }
    @if (selected.Mine) { <button class="danger" @onclick='() => mode = "delete"'>Delete<Icon Name="trash" Size="20" /></button> }
    <button aria-expanded="@moreActions.ToString().ToLowerInvariant()" @onclick="() => moreActions = !moreActions">More<Icon Name="more" Size="20" /></button>
    @if (moreActions) {
    @if (State.Selected?.Allows(ChatFeature.Threads) != false) { <button class="sheetitem" @onclick="() => OpenThreadAsync(selected)"><Icon Name="thread" Size="20" />Reply in thread</button> }
    <button class="sheetitem" @onclick='() => mode = "forward"'><Icon Name="arrow" Size="20" />Forward text</button>
    <button class="sheetitem" @onclick="CopyAsync"><Icon Name="file" Size="20" />Copy text</button>
    <button class="sheetitem" @onclick="FilesAsync"><Icon Name="file" Size="20" />Attachments</button>
    <button class="sheetitem" @onclick='() => ActionAsync(selected.Pinned ? "unpin" : "pin")'><Icon Name="plus" Size="20" />@(selected.Pinned ? "Unpin message" : "Pin message")</button>
    <button class="sheetitem" @onclick='() => ActionAsync(selected.Saved ? "unsave" : "save")'><Icon Name="file" Size="20" />@(selected.Saved ? "Unsave message" : "Save message")</button>
    @if (selected.Mine && !selected.HasAttachments) { <button class="sheetitem" @onclick='() => { edit = selected.Text; mode = "edit"; }'><Icon Name="edit" Size="20" />Edit message</button> }
    }
    </div>
</MessageMenu>
}
@if (mode is not null && mode != "message")
{
<BottomSheet Title="@(mode == "details" ? "Conversation" : mode == "files" ? "Attachments" : mode == "edit" ? "Edit message" : "Message actions")" OnClose="() => mode = null">
@if (mode == "files" && selected is not null)
{ <div class="picker">@foreach (var file in selected.Attachments) { <button class="row" @onclick="() => State.OpenFileAsync(selected, file)"><Icon Name="file" /><span>@file.Name <small>@(file.Size / 1024) KB</small></span></button> }<p class="muted">Opened files are saved on this device for offline use.</p></div> }
else if (mode == "edit")
{ <div class="picker"><textarea aria-label="Edit message" @bind="edit" @bind:event="oninput" maxlength="4000"></textarea><button class="btn" @onclick='() => ActionAsync("edit", edit)'>Save changes</button></div> }
else if (mode == "delete")
{ <div class="picker"><p>Delete this message for everyone?</p><button class="btn" @onclick='() => ActionAsync("delete")'>Delete message</button></div> }
else if (mode == "details" && State.Selected is { } details)
{ <ConversationSettings Conversation="details" /> }
else if (mode == "forward")
{ <div class="picker">@foreach (var target in State.Conversations) { <button class="row" @onclick="() => ForwardAsync(target.Id)"><Avatar Initials="@target.Initials" Size="a34" />@target.Name</button> }</div> }
else if (mode == "search")
{ <div class="picker"><label class="field"><span class="lab">Search messages</span><span class="inp"><input aria-label="Search messages" placeholder="@(State.EncryptionEnabled ? "Search saved messages" : "Search this conversation")" @bind="query" @bind:event="oninput" @bind:after="SearchAsync" /></span></label>@if (State.EncryptionEnabled) { <p class="muted">Search covers messages downloaded on this device. Scroll back to load older messages.</p> }<p class="muted" role="status">@(searching ? "Searching..." : query.Trim().Length < 2 ? "Type at least two characters." : hits.Count == 0 ? "No matching messages." : $"{hits.Count} matching messages")</p>@foreach (var hit in hits) { <button class="row search-hit" @onclick="() => ShowHitAsync(hit.MessageId)"><span>@hit.Text</span><small>@hit.CreatedAt.ToLocalTime().ToString("MMM d, HH:mm")</small></button> }</div> }
</BottomSheet>
}
@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public Guid? ParentId { get; set; }
    [SupplyParameterFromQuery(Name = "message")] public Guid? FocusMessage { get; set; }
    private ChatMessage? Parent => State.Selected?.Messages.FirstOrDefault(x => x.Id == ParentId);
    private ChatMessage? reply, selected;
    private string? mode;
    private string edit = "";
    private Guid loaded;
    private Guid? loadedParent;
    private Guid? focus;
    private string query = "";
    private List<SearchHit> hits = [];
    private bool searching;
    private bool moreActions;
    protected override void OnInitialized() { State.Changed += Changed; State.ConversationRemoved += Removed; Voice.Changed += Changed; }
    private void Removed(Guid id) { if (id == Id) _ = InvokeAsync(() => Nav.NavigateTo("/")); }
    protected override async Task OnParametersSetAsync()
    {
        if (State.User is not null && loaded != Id) { loaded = Id; await State.SelectAsync(Id); }
        if (ParentId.HasValue && loadedParent != ParentId)
        {
            await State.LocateAsync(ParentId.Value);
            if (Parent is { } parent) await State.LoadRepliesAsync(parent);
            loadedParent = ParentId;
        }
        if (!ParentId.HasValue) loadedParent = null;
        if (FocusMessage.HasValue) { await State.LocateAsync(FocusMessage.Value); focus = FocusMessage; }
    }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focus.HasValue) { var id = focus; focus = null; await JS.InvokeVoidAsync("yap.showMessage", id); }
    }
    private void Select(ChatMessage message) { selected = message; moreActions = false; mode = "message"; }
    private void ReplyTo(ChatMessage message) { if (State.Selected?.Allows(ChatFeature.Replies) == false) return; reply = message; mode = null; }
    private Task OpenThreadAsync(ChatMessage message) { if (State.Selected?.Allows(ChatFeature.Threads) != false) { mode = null; Nav.NavigateTo($"/thread/{Id}/{message.Id}"); } return Task.CompletedTask; }
    private async Task CopyAsync() { try { await JS.InvokeVoidAsync("yap.copy", selected!.Text); mode = null; } catch (Exception ex) { State.Report(ex); } }
    private async Task FilesAsync() { await State.OpenAttachmentsAsync(selected!); mode = "files"; }
    private async Task ReactAsync(string emoji) { await State.ActionAsync(selected!, "react", emoji: emoji); mode = null; }
    private async Task ActionAsync(string action, string? text = null) { await State.ActionAsync(selected!, action, text); mode = null; }
    private async Task ForwardAsync(Guid target) { try { await State.SendAsync(target, selected!.Text, null, $"forward:{Guid.NewGuid()}"); mode = null; Nav.NavigateTo($"/chat/{target}"); } catch (Exception ex) { State.Report(ex); } }
    private async Task SearchAsync() { var text = query; searching = text.Trim().Length >= 2; try { await Task.Delay(200); if(text != query) return; var result = await State.SearchAsync(text, Id); if (text == query) hits = result; } catch (Exception ex) { State.Report(ex); } finally { if(text == query) searching = false; } }
    private async Task ShowHitAsync(Guid id) { await State.LocateAsync(id); mode = null; focus = id; }
    private async Task CallAsync()
    {
        if (State.Selected is not { } conversation) return;
        mode = null;
        await Voice.StartGroupAsync(Id, conversation.Name, conversation.People);
    }
    public void Dispose() { State.Changed -= Changed; State.ConversationRemoved -= Removed; Voice.Changed -= Changed; State.LeaveConversation(loaded); }
}
