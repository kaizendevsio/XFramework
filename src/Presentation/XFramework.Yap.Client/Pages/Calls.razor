@page "/calls"
@implements IDisposable
@inject ChatState State
@inject VoiceState Voice
<PageTitle>Calls · Yap</PageTitle>
<ScrollSurface><Header><div class="appbar plain liquid-glass"><GlassLayer /><h1>Calls</h1><span class="sp"></span><a class="iconbtn" href="/new" aria-label="Start a conversation"><Icon Name="edit" /></a></div></Header>
<ChildContent><div class="body calls-panel">
@if (State.User is null)
{
    <div class="calls-empty"><span class="calls-empty-mark"><Icon Name="phone" Size="30" /></span><h2>Your calls live here</h2><p>Sign in to see the voice and video calls you've made and received.</p><a class="calls-empty-action" href="/login">Sign in</a></div>
}
else if (loading && items.Count == 0)
{
    <div class="calls-skeleton" aria-label="Loading calls">@for (var n = 0; n < 4; n++) { <span class="calls-skeleton-row"><i></i><b></b></span> }</div>
}
else if (items.Count == 0)
{
    <div class="calls-empty"><span class="calls-empty-mark"><Icon Name="phone" Size="30" /></span><h2>No calls yet</h2><p>Voice and video calls you make or receive will show up here.</p><a class="calls-empty-action" href="/new">Start a conversation</a></div>
}
@if (State.User is not null && !State.Online) { <p class="calls-offline">Offline · showing saved call history</p> }
<CallList Items="items" @bind-Expanded="expanded" />
@if (items.Count < total && State.Online) { <button class="btn ghost calls-more" disabled="@loading" @onclick="MoreAsync">Load more calls</button> }
</div></ChildContent></ScrollSurface>
@code {
    private List<CallHistoryItem> items = [];
    private Guid? expanded;
    private int page, total;
    private bool loading, live, wasCalling, disposed, reload;
    private string scope = "", calls = "";
    private Timer? clock;
    private string CallStamp => string.Join(',', State.Conversations.Where(c => c.LastMessage?.IsCallSummary == true).Select(c => c.LastMessage!.Id).Order());
    protected override Task OnInitializedAsync()
    {
        State.Changed += Changed; Voice.Changed += CallChanged; scope = State.Scope; calls = CallStamp; live = State.SessionReady && State.Online; wasCalling = Voice.IsCalling;
        // "12 min ago" and the Today/Yesterday headings move on their own; nothing else would redraw them.
        clock = new Timer(_ => _ = InvokeAsync(() => { if (!disposed) StateHasChanged(); }), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
        return LoadAsync(true);
    }
    private void Changed() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        var nowLive = State.SessionReady && State.Online;
        var stamp = CallStamp;
        var refresh = scope != State.Scope || (!live && nowLive) || calls != stamp;
        if (scope != State.Scope) { items.Clear(); total = 0; expanded = null; }
        scope = State.Scope; live = nowLive; calls = stamp;
        if (refresh) await LoadAsync(true);
        StateHasChanged();
    });
    // Voice state changes many times a second during a call; only starting or ending one changes this page.
    private void CallChanged()
    {
        var calling = Voice.IsCalling;
        if (calling == wasCalling) return;
        wasCalling = calling;
        _ = InvokeAsync(() => { if (!disposed) StateHasChanged(); });
        if (!calling) _ = RefreshAfterCallAsync();
    }
    private async Task RefreshAfterCallAsync() { await Task.Delay(1000); if (!disposed) await InvokeAsync(async () => { await LoadAsync(true); StateHasChanged(); }); }
    private Task MoreAsync() => LoadAsync(false);
    private async Task LoadAsync(bool reset)
    {
        if (disposed) return;
        if (loading) { reload |= reset; return; }
        loading = true;
        var account = State.Scope;
        try
        {
            var requestedPage = reset ? 0 : page + 1;
            var result = await State.CallsAsync(requestedPage);
            if (!disposed && account == State.Scope) { page = requestedPage; total = result.TotalCount; items = reset ? result.Items : items.Concat(result.Items).DistinctBy(x => x.Message.Id).ToList(); }
        }
        catch(Exception ex) { State.Report(ex); }
        finally { loading = false; }
        if (reload) { reload = false; await LoadAsync(true); }
    }
    public void Dispose() { disposed = true; clock?.Dispose(); State.Changed -= Changed; Voice.Changed -= CallChanged; }
}
