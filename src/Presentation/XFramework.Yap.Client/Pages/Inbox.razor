@page "/"
@implements IDisposable
@inject ChatState State
@inject BrowserTime Times
@inject NavigationManager Nav
@inject IJSRuntime JS
<PageTitle>Yap · A little closer.</PageTitle>
@if (State.User is null) { <div class="authbody"><div class="authbrand"><Brand /><p>A little closer.</p></div><h1>Good conversations start here.</h1><p>Your people, one conversation away.</p><a class="btn" href="/login">Sign in</a><a class="btn ghost" href="/register">Create an account</a></div> }
else
{
<ScrollSurface><Header><div class="appbar plain liquid-glass inbox-header"><GlassLayer /><Brand /><span class="sp"></span><button class="iconbtn" aria-label="Search conversations" aria-expanded="@searchVisible.ToString().ToLowerInvariant()" @onclick="ToggleSearch"><Icon Name="search" /></button></div>
@if (searchVisible) { <label class="searchbar liquid-glass search-field"><GlassLayer /><Icon Name="search" Size="18" /><input @ref="searchInput" type="search" enterkeyhint="search" autocomplete="off" aria-label="Search conversations and messages" placeholder="Search conversations and messages" @bind="search" @bind:event="oninput" @onkeydown="SearchKeyDown" />@if (search.Length > 0) { <button class="iconbtn search-clear" aria-label="Clear search" @onclick="ClearSearch"><Icon Name="close" Size="16" /></button> }</label> }

</Header><ChildContent><div class="body inbox-panel" aria-label="Conversations">
@* While searching, favourites stop being a useful split: everything on screen is a match. *@
@foreach (var section in Filtered.GroupBy(chat => search.Length == 0 && chat.IsFavorite))
{
<h2 class="inbox-section">@(search.Length > 0 ? "Conversations" : section.Key ? "Favorites" : "Messages")</h2>
@foreach (var chat in section)
{
    <div class="inbox-item" data-conversation-menu @oncontextmenu="e => OpenMenu(chat, e)" @oncontextmenu:preventDefault>
    <a class="row" href="@($"/chat/{chat.Id}")"><Avatar Initials="@chat.Initials" ImageUrl="@chat.AvatarUrl" Color="@chat.Color" Size="a48" /><span class="mid"><span class="t1">@if(chat.IsFavorite){<span class="favorite-mark" aria-label="Favorite">&#9733;</span>}@chat.Name @if (chat.Group) { <span class="tag">@chat.Members</span> }</span><span class="t2 @(chat.Unread > 0 ? "unread" : "")">@chat.Preview</span></span><span class="end"><span class="time">@(chat.LastMessageAt is { } at ? Times.Clock(at) : "")</span>@if (chat.Unread > 0) { <span class="badge">@chat.Unread</span> }</span></a>
    <button class="inbox-menu-trigger iconbtn" aria-label="@($"Options for {chat.Name}")" @onclick="e => OpenMenu(chat, e)"><Icon Name="more" Size="18" /></button>
    </div>
}
}
@if (!Filtered.Any() && search.Length == 0) { <p class="empty">No conversations yet. Start one with your people.</p> }
<MessageSearch Query="@search" OnOpen="OpenHit" />
@if (State.HasMoreConversations) { <button class="btn ghost" disabled="@(!State.Online || State.Busy)" @onclick="State.LoadMoreConversationsAsync">Load more conversations</button> }
</div></ChildContent><Footer><TabBar Current="inbox" /></Footer></ScrollSurface>
<button class="fab liquid-glass" aria-label="New conversation" disabled="@(!State.Online || State.NeedsLogin)" @onclick='() => Nav.NavigateTo("/new")'><GlassLayer /><Icon Name="edit" /></button>
}
@if (menu is { } chosen)
{
    <div class="conversation-menu-dismiss" @onclick="() => menu = null"></div>
    <div class="conversation-menu" @ref="menuElement" tabindex="-1" role="menu" aria-label="Conversation actions" style="left:clamp(12px,@(menuX)px,calc(100vw - 202px));top:clamp(12px,@(menuY)px,calc(100dvh - 172px))" @onkeydown="MenuKeyDown">
        <button role="menuitem" @onclick="() => FavoriteAsync(chosen)">@(chosen.IsFavorite ? "Remove favorite" : "Favorite")</button>
        <button role="menuitem" disabled="@(!State.Online || State.NeedsLogin)" @onclick="() => BeginRenameAsync(chosen)">Rename</button>
        <button role="menuitem" class="danger" disabled="@(!State.Online || State.NeedsLogin)" @onclick="() => BeginDeleteAsync(chosen)">Delete</button>
    </div>
}
@if (renaming is { } rename)
{
    <BottomSheet Title="Rename conversation" OnClose="() => renaming = null"><div class="picker"><label class="field"><span class="lab">Conversation name</span><span class="inp"><input aria-label="Conversation name" @bind="newTitle" @bind:event="oninput" maxlength="100" /></span></label><p class="muted">Everyone in this conversation will see this name.</p><button class="btn" disabled="@(working || string.IsNullOrWhiteSpace(newTitle))" @onclick="RenameAsync">Save name</button></div></BottomSheet>
}
@if (deleting is { } remove)
{
    <BottomSheet Title="Delete conversation" OnClose="() => deleting = null"><div class="picker"><p>@(deleteEveryone ? "Delete this conversation for everyone? This cannot be undone." : $"Remove {remove.Name} from your list? Other members keep their conversation.")</p><button class="btn danger" disabled="@working" @onclick="DeleteAsync">@(deleteEveryone ? "Confirm delete for everyone" : "Delete for me")</button>@if(remove.CanManage && !deleteEveryone){<button class="btn ghost danger" @onclick="() => deleteEveryone = true">Delete for everyone</button>}</div></BottomSheet>
}
@code {
    private string search = "";
    private void MenuKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") menu = null; }
    private ElementReference menuElement;
    private bool focusMenu;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusMenu && menu is not null) { focusMenu = false; await JS.InvokeVoidAsync("yap.focusSheet", menuElement); }
        // Revealing the field should also raise the keyboard, or the tap costs two gestures.
        if (focusSearch && searchVisible) { focusSearch = false; try { await searchInput.FocusAsync(); } catch (Exception ex) { State.Report(ex); } }
    }
    private Conversation? menu, renaming, deleting;
    private double menuX, menuY;
    private string newTitle = "";
    private bool working, deleteEveryone;
    private async Task BeginDeleteAsync(Conversation chat) { menu = null; deleteEveryone = false; deleting = chat; try { var detail = await State.ConversationDetailsAsync(chat.Id); if (deleting?.Id == chat.Id) deleting = detail; } catch(Exception ex) { State.Report(ex); } }
    private void OpenMenu(Conversation chat, MouseEventArgs e) { menu = chat; focusMenu = true; menuX = Math.Max(12, e.ClientX - 170); menuY = Math.Max(12, e.ClientY - 70); }
    private async Task FavoriteAsync(Conversation chat) { menu = null; try { await State.ToggleFavoriteAsync(chat); } catch(Exception ex) { State.Report(ex); } }
    private async Task BeginRenameAsync(Conversation chat)
    {
        menu = null;
        newTitle = chat.Name; renaming = chat;
        try { var detail = await State.ConversationDetailsAsync(chat.Id); if(!detail.CanManage && renaming?.Id == chat.Id) { renaming = null; State.Report(new InvalidOperationException("Only conversation admins can rename this conversation.")); } }
        catch(Exception ex) { State.Report(ex); }
    }
    private async Task RenameAsync() { var chat = renaming!; var title = newTitle; renaming = null; working = true; try { await State.UpdateConversationAsync(new(chat.Id, Name: title)); } catch(Exception ex) { State.Report(ex); } finally { working = false; } }
    private async Task DeleteAsync() { var chat = deleting!; deleting = null; working = true; try { await State.DeleteConversationAsync(chat.Id, deleteEveryone); } catch(Exception ex) { State.Report(ex); } finally { working = false; } }
    private bool searchVisible;
    private ElementReference searchInput;
    private bool focusSearch;
    private void ToggleSearch() { searchVisible = !searchVisible; search = ""; focusSearch = searchVisible; }
    private void ClearSearch() { search = ""; focusSearch = true; }
    private void SearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") ToggleSearch(); }
    private void OpenHit(SearchHit hit) => Nav.NavigateTo($"/chat/{hit.ThreadId}?message={hit.MessageId}");
    private IEnumerable<Conversation> Filtered => State.Conversations.Where(c => !c.Removed && c.Name.Contains(search, StringComparison.OrdinalIgnoreCase)).OrderByDescending(c => c.IsFavorite).ThenByDescending(c => c.LastMessageAt);
    protected override void OnInitialized() => State.Changed += Changed;
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= Changed;
}
