@page "/"
@implements IDisposable
@inject ChatState State
@inject NavigationManager Nav
@inject IJSRuntime JS
<PageTitle>Yap · A little closer.</PageTitle>
@if (State.User is null) { <div class="authbody"><div class="authbrand"><Brand /><p>A little closer.</p></div><h1>Good conversations start here.</h1><p>Your people, one conversation away.</p><a class="btn" href="/login">Sign in</a><a class="btn ghost" href="/register">Create an account</a></div> }
else
{
<ScrollSurface><Header><div class="appbar plain liquid-glass inbox-header"><GlassLayer /><Brand /><span class="sp"></span><button class="iconbtn" aria-label="Search conversations" @onclick="() => searchVisible = !searchVisible"><Icon Name="search" /></button></div>
@if (searchVisible) { <label class="searchbar liquid-glass"><GlassLayer /><Icon Name="search" Size="18" /><input aria-label="Search conversations and messages" placeholder="Search conversations and messages" @bind="search" @bind:event="oninput" @bind:after="SearchMessagesAsync" /></label> }

</Header><ChildContent><div class="body inbox-panel" aria-label="Conversations">
@foreach (var section in Filtered.GroupBy(chat => chat.IsFavorite))
{
<h2 class="inbox-section">@(section.Key ? "Favorites" : "Messages")</h2>
@foreach (var chat in section)
{
    <div class="inbox-item" data-conversation-menu @oncontextmenu="e => OpenMenu(chat, e)" @oncontextmenu:preventDefault>
    <a class="row" href="@($"/chat/{chat.Id}")"><Avatar Initials="@chat.Initials" Color="@chat.Color" Size="a48" /><span class="mid"><span class="t1">@if(chat.IsFavorite){<span class="favorite-mark" aria-label="Favorite">&#9733;</span>}@chat.Name @if (chat.Group) { <span class="tag">@chat.Members</span> }</span><span class="t2 @(chat.Unread > 0 ? "unread" : "")">@chat.Preview</span></span><span class="end"><span class="time">@chat.LastMessageAt?.ToLocalTime().ToString("HH:mm")</span>@if (chat.Unread > 0) { <span class="badge">@chat.Unread</span> }</span></a>
    <button class="inbox-menu-trigger iconbtn" aria-label="@($"Options for {chat.Name}")" @onclick="e => OpenMenu(chat, e)"><Icon Name="more" Size="18" /></button>
    </div>
}
}
@if (!Filtered.Any()) { <p class="empty">No conversations yet. Start one with your people.</p> }
@if (search.Length >= 2)
{
    <div class="sectionhead">@(State.Online ? "Messages" : "Saved messages on this device")</div>
    @foreach (var hit in hits) { <a class="row" href="@($"/chat/{hit.ThreadId}?message={hit.MessageId}")"><Icon Name="search" /><span class="mid"><span class="t1">@State.Conversations.FirstOrDefault(x => x.Id == hit.ThreadId)?.Name</span><span class="t2">@hit.Text</span></span></a> }
}
@if (State.HasMoreConversations) { <button class="btn ghost" disabled="@(!State.Online || State.Busy)" @onclick="State.LoadMoreConversationsAsync">Load more conversations</button> }
</div></ChildContent><Footer><TabBar Current="inbox" /></Footer></ScrollSurface>
<button class="fab liquid-glass" aria-label="New conversation" disabled="@(!State.Online || State.NeedsLogin)" @onclick="() => choosing = true"><GlassLayer /><Icon Name="edit" /></button>
}
@if (choosing)
{
<BottomSheet Title="New conversation" OnClose="() => choosing = false"><div class="picker"><label class="field"><span class="lab">Find people</span><span class="inp"><input aria-label="Find people" placeholder="Name or username" @bind="peopleSearch" @bind:event="oninput" @bind:after="SearchAsync" /></span></label>
@if(members.Count > 0){<div class="selected-people" aria-label="Selected people">@foreach(var id in members){<button class="selected-person" aria-label="@($"Remove {names[id]}")" @onclick="() => Toggle(id)"><Avatar Initials="@ChatMessage.InitialsFor(names[id])" Size="a28" /><span>@names[id]</span><Icon Name="close" Size="14" /></button>}</div>}
@foreach (var person in people) { <label class="row"><input type="checkbox" checked="@members.Contains(person.Id)" @onchange="() => Toggle(person.Id)" /><Avatar Initials="@ChatMessage.InitialsFor(person.Name)" ImageUrl="@person.AvatarUrl" Size="a34" /><span>@person.Name <small class="muted">@person.UserName</small></span></label> }
@if (members.Count > 1) { <label class="field"><span class="lab">Group name (optional)</span><span class="inp"><input aria-label="Group name" @bind="groupName" @bind:event="oninput" maxlength="100" /></span></label> }
<button class="btn" disabled="@(members.Count == 0 || creating)" @onclick="CreateAsync">Start conversation</button></div></BottomSheet>
}
@if (menu is { } chosen)
{
    <div class="conversation-menu-dismiss" @onclick="() => menu = null"></div>
    <div class="conversation-menu" @ref="menuElement" tabindex="-1" role="menu" aria-label="Conversation actions" style="left:clamp(12px,@(menuX)px,calc(100vw - 202px));top:clamp(12px,@(menuY)px,calc(100dvh - 172px))" @onkeydown="MenuKeyDown">
        <button role="menuitem" @onclick="() => FavoriteAsync(chosen)">@(chosen.IsFavorite ? "Remove favorite" : "Favorite")</button>
        <button role="menuitem" disabled="@(!State.Online || State.NeedsLogin)" @onclick="() => BeginRenameAsync(chosen)">Rename</button>
        <button role="menuitem" class="danger" disabled="@(!State.Online || State.NeedsLogin)" @onclick="() => BeginDeleteAsync(chosen)">Delete</button>
    </div>
}
@if (renaming is { } rename)
{
    <BottomSheet Title="Rename conversation" OnClose="() => renaming = null"><div class="picker"><label class="field"><span class="lab">Conversation name</span><span class="inp"><input aria-label="Conversation name" @bind="newTitle" @bind:event="oninput" maxlength="100" /></span></label><p class="muted">Everyone in this conversation will see this name.</p><button class="btn" disabled="@(working || string.IsNullOrWhiteSpace(newTitle))" @onclick="RenameAsync">Save name</button></div></BottomSheet>
}
@if (deleting is { } remove)
{
    <BottomSheet Title="Delete conversation" OnClose="() => deleting = null"><div class="picker"><p>@(deleteEveryone ? "Delete this conversation for everyone? This cannot be undone." : $"Remove {remove.Name} from your list? Other members keep their conversation.")</p><button class="btn danger" disabled="@working" @onclick="DeleteAsync">@(deleteEveryone ? "Confirm delete for everyone" : "Delete for me")</button>@if(remove.CanManage && !deleteEveryone){<button class="btn ghost danger" @onclick="() => deleteEveryone = true">Delete for everyone</button>}</div></BottomSheet>
}
@code {
    private string search = "", peopleSearch = "", groupName = "";
    private void MenuKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") menu = null; }
    private ElementReference menuElement;
    private bool focusMenu;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (focusMenu && menu is not null) { focusMenu = false; await JS.InvokeVoidAsync("yap.focusSheet", menuElement); } }
    private Conversation? menu, renaming, deleting;
    private double menuX, menuY;
    private string newTitle = "";
    private bool working, deleteEveryone;
    private async Task BeginDeleteAsync(Conversation chat) { menu = null; deleteEveryone = false; try { deleting = await State.ConversationDetailsAsync(chat.Id); } catch(Exception ex) { State.Report(ex); } }
    private void OpenMenu(Conversation chat, MouseEventArgs e) { menu = chat; focusMenu = true; menuX = Math.Max(12, e.ClientX - 170); menuY = Math.Max(12, e.ClientY - 70); }
    private async Task FavoriteAsync(Conversation chat) { menu = null; try { await State.ToggleFavoriteAsync(chat); } catch(Exception ex) { State.Report(ex); } }
    private async Task BeginRenameAsync(Conversation chat)
    {
        menu = null;
        try { var detail = await State.ConversationDetailsAsync(chat.Id); if(!detail.CanManage) { State.Report(new InvalidOperationException("Only conversation admins can rename this conversation.")); return; } newTitle = detail.Name; renaming = chat; }
        catch(Exception ex) { State.Report(ex); }
    }
    private async Task RenameAsync() { working = true; try { await State.UpdateConversationAsync(new(renaming!.Id, Name: newTitle)); renaming = null; } catch(Exception ex) { State.Report(ex); } finally { working = false; } }
    private async Task DeleteAsync() { working = true; try { await State.DeleteConversationAsync(deleting!.Id, deleteEveryone); deleting = null; } catch(Exception ex) { State.Report(ex); } finally { working = false; } }
    private bool searchVisible, choosing, creating;
    private List<Person> people = [];
    private List<SearchHit> hits = [];
    private readonly HashSet<Guid> members = [];
    private readonly Dictionary<Guid, string> names = [];
    private IEnumerable<Conversation> Filtered => State.Conversations.Where(c => c.Name.Contains(search, StringComparison.OrdinalIgnoreCase)).OrderByDescending(c => c.IsFavorite).ThenByDescending(c => c.LastMessageAt);
    protected override void OnInitialized() => State.Changed += Changed;
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    private async Task SearchAsync()
    { var query = peopleSearch; try { var result = await State.SearchPeopleAsync(query); if (query == peopleSearch) people = result.Where(x => x.Id != State.User?.CredentialId).ToList(); } catch (Exception ex) { State.Report(ex); } }
    private async Task SearchMessagesAsync()
    { var query = search; try { var result = await State.SearchAsync(query); if (query == search) hits = result; } catch (Exception ex) { State.Report(ex); } }
    private void Toggle(Guid id) { if (!members.Remove(id)) members.Add(id); foreach (var person in people) names[person.Id] = person.Name; }
    private async Task CreateAsync()
    {
        creating = true;
        try { var title = members.Count > 1 ? (string.IsNullOrWhiteSpace(groupName) ? string.Join(", ", members.Select(id => names[id])) : groupName.Trim()) : names[members.Single()]; var id = await State.CreateAsync(title[..Math.Min(title.Length, 100)], members.ToList(), members.Count > 1); Nav.NavigateTo($"/chat/{id}"); }
        catch (Exception ex) { State.Report(ex); }
        finally { creating = false; }
    }
    public void Dispose() => State.Changed -= Changed;
}
