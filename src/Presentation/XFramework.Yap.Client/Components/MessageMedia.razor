@implements IAsyncDisposable
@inject ChatState State
@inject IJSRuntime JS
@if (Message.HasAttachments || Message.Attachments.Count > 0)
{
    <div class="message-media">
    @foreach (var file in Message.Attachments)
    {
        @if (urls.TryGetValue(file.Id, out var url))
        {
            @if (IsImage(file))
            {
                <div class="photo-preview @(ready.Contains(file.Id) ? "" : "photo-pending")">
                    @if (!ready.Contains(file.Id)) { <div class="photo-skeleton" role="status" aria-label="Loading photo"><span class="spinner"></span></div> }
                    <button id="@PhotoId(file)" class="photo-open" disabled="@(!ready.Contains(file.Id))" aria-label="@($"View photo {file.Name}")" @onclick="() => viewing = file" @oncontextmenu="() => OnActions.InvokeAsync()" @oncontextmenu:preventDefault><img src="@url" alt="@file.Name" draggable="false" @onload="() => ready.Add(file.Id)" @onerror="() => ImageFailedAsync(file, url)" /></button>
                    @if (Message.LocalFileKey is null) { <button class="photo-download" aria-label="Download original photo" title="Download original" @onclick="() => State.OpenFileAsync(Message, file)"><Icon Name="download" Size="20" /></button> }
                </div>
            }
            else if (IsVideo(file)) {
                <div class="photo-preview">
                    <button id="@PhotoId(file)" class="photo-open" aria-label="@($"Play video {file.Name}")" @onclick="() => viewing = file" @oncontextmenu="() => OnActions.InvokeAsync()" @oncontextmenu:preventDefault><VideoPreview @key="url" Url="@url" Name="@file.Name" OnError="() => PlaybackFailedAsync(file)" /></button>
                </div>
                @if (playbackFailed.Contains(file.Id)) { <button class="media-open" @onclick="() => State.OpenFileAsync(Message, file)"><Icon Name="download" Size="20" /><span>This video cannot play here. Download to watch.</span></button> }
            }
            else { <VoiceMessage @key="url" Url="@url" Name="@file.Name" /> }
        }
        else if (IsImage(file) || IsVideo(file) || IsAudio(file)) {
            @if (waitingForConnection) { <div class="photo-skeleton" role="status"><span>Available when you’re back online</span></div> }
            else if (!failed) { <div class="photo-skeleton @(IsAudio(file) ? "voice-skeleton" : "")" role="status" aria-label="@(IsAudio(file) ? "Loading voice message" : IsVideo(file) ? "Loading video" : "Loading photo")"><span class="spinner"></span></div> }
        }
        else { <button class="media-open" disabled="@(loading || WaitingForLinks)" @onclick="() => OpenAsync(file)"><Icon Name="@(file.ContentType.StartsWith("audio/") ? "mic" : "file")" Size="20" /><span>@file.Name</span><small>@(file.Size / 1024) KB</small></button> }
    }
    @if (loading && Message.Attachments.Count == 0) { <span class="spinner" role="status" aria-label="Loading attachment"></span> }
    @if (waitingForConnection && Message.Attachments.Count == 0) { <span>Attachment available when you’re back online</span> }
    @if (failed) { <button class="media-open" @onclick="LoadAsync">Attachment unavailable · retry</button> }
    </div>
}
@if (viewing is { } media && urls.TryGetValue(media.Id, out var mediaUrl))
{
    <PhotoViewer Url="@mediaUrl" Name="@media.Name" IsVideo="@IsVideo(media)" SourceId="@PhotoId(media)" OnClose="() => viewing = null" CanDownload="@(Message.LocalFileKey is null)" OnDownload="() => State.OpenFileAsync(Message, media)" />
}
@code {
    [Parameter, EditorRequired] public ChatMessage Message { get; set; } = default!;
    [Parameter] public EventCallback MetadataLoaded { get; set; }
    [Parameter] public EventCallback OnActions { get; set; }
    /// <summary>Raised when nothing can be shown, so a caller that replaced a file row with this preview can put it back.</summary>
    [Parameter] public EventCallback PreviewFailed { get; set; }
    [Parameter] public string SourcePrefix { get; set; } = "";
    private ChatAttachment? viewing;
    private readonly Dictionary<Guid, string> urls = [];
    private readonly HashSet<Guid> ready = [];
    private readonly HashSet<Guid> playbackFailed = [];
    private string PhotoId(ChatAttachment file) => $"{SourcePrefix}photo-{Message.Id}-{file.Id}";
    private bool loading, failed, disposed, waitingForConnection;
    private bool WaitingForLinks => Message.EncryptedEnvelope is not null && Message.LocalFileKey is null && !Message.AttachmentLinksReady;
    private string? loaded;
    private int version;
    public static bool IsImage(ChatAttachment file) => ChatMedia.IsInlineImage(file.ContentType, file.Name);
    public static bool IsVideo(ChatAttachment file) => ChatMedia.IsInlineVideo(file.ContentType, file.Name);
    public static bool IsAudio(ChatAttachment file) => ChatMedia.IsInlineAudio(file.ContentType, file.Name);
    private static string MediaType(ChatAttachment file) => ChatMedia.ContentType(file.ContentType, file.Name);
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Message.Id}:{Message.LocalFileKey}:{Message.HasAttachments}:{Message.AttachmentLinksReady}:{string.Join(',', Message.Attachments.Select(f => f.Id))}";
        if (key != loaded) { loaded = key; await LoadAsync(); }
        else if (waitingForConnection && State.Online && !loading) await LoadAsync();
    }
    private async Task LoadAsync()
    {
        if (disposed || !Message.HasAttachments && Message.Attachments.Count == 0) return;
        var request = ++version;
        var message = Message;
        loading = true; failed = false; waitingForConnection = false;
        try
        {
            await ReleaseAsync();
            if (WaitingForLinks) return;
            if (message.Attachments.Count == 0 && !State.Online) { waitingForConnection = true; return; }
            if (message.Attachments.Count == 0) { await State.LoadAttachmentMetadataAsync(message); await MetadataLoaded.InvokeAsync(); }
            if (request != version || disposed) return;
            // Received voice clips need a URL too, or the recipient only ever sees a file row.
            foreach (var file in message.Attachments.Where(f => IsImage(f) || IsVideo(f) || IsAudio(f))) await OpenAsync(message, file, request);
        }
        catch (Exception ex) { await FailedAsync("attachment-metadata", ex, request); }
        finally { if (request == version) loading = false; }
    }
    private Task OpenAsync(ChatAttachment file) => OpenAsync(Message, file, version);
    private async Task OpenAsync(ChatMessage message, ChatAttachment file, int request)
    {
        var phase = "attachment-prepare";
        try
        {
            var encrypted = message.EncryptedEnvelope is not null && message.LocalFileKey is null;
            var key = encrypted ? await State.PrepareEncryptedFileAsync(message, file) : message.LocalFileKey ?? $"{State.Scope.Replace(':', '-')}-{file.Id:N}";
            phase = "attachment-preview";
            var url = await JS.InvokeAsync<string?>("yap.device.mediaUrl", key,
                $"api/chat/conversations/{message.ThreadId}/messages/{message.Id}/attachments/{file.Id}", State.Scope,
                State.Online && !State.NeedsLogin, MediaType(file), message.LocalFileKey is not null || encrypted, file.Name);
            if (url is null) { await State.OpenFileAsync(message, file); return; }
            if (disposed || request != version) await JS.InvokeVoidAsync("yap.device.releaseMedia", url);
            else { if (urls.Remove(file.Id, out var old)) await JS.InvokeVoidAsync("yap.device.releaseMedia", old); urls[file.Id] = url; }
        }
        catch (Exception ex) { await FailedAsync(phase, ex, request); }
    }
    private async Task PlaybackFailedAsync(ChatAttachment file)
    {
        playbackFailed.Add(file.Id);
        await PreviewFailed.InvokeAsync();
    }
    private async Task FailedAsync(string phase, Exception error, int request)
    {
        if (disposed || request != version) return;
        if (ChatState.IsConnectionFailure(error)) State.Report(error);
        if (!State.Online) { waitingForConnection = true; return; }
        failed = true;
        await PreviewFailed.InvokeAsync();
        await LogFailureAsync(phase, error);
    }
    private async Task LogFailureAsync(string phase, Exception? error = null)
    {
        try { await JS.InvokeVoidAsync("yap.diagnostics.record", "attachment.failed", new { phase, type = error?.GetType().Name ?? "ImageDecodeError" }); }
        catch { /* Diagnostics must not prevent retry or disposal. */ }
    }
    private async Task ImageFailedAsync(ChatAttachment file, string url)
    {
        if (urls.TryGetValue(file.Id, out var current) && current == url)
        { urls.Remove(file.Id); failed = true; await PreviewFailed.InvokeAsync(); await LogFailureAsync("image-decode"); await JS.InvokeVoidAsync("yap.device.releaseMedia", url); }
    }
    private async Task ReleaseAsync() { var previous = urls.Values.ToArray(); urls.Clear(); ready.Clear(); foreach (var url in previous) await JS.InvokeVoidAsync("yap.device.releaseMedia", url); }
    public async ValueTask DisposeAsync() { disposed = true; await ReleaseAsync(); }
}
