@implements IAsyncDisposable
@inject ChatState State
@inject IJSRuntime JS
@if (Message.HasAttachments || Message.Attachments.Count > 0)
{
    <div class="message-media">
    @foreach (var file in Message.Attachments)
    {
        @if (urls.TryGetValue(file.Id, out var url))
        {
            @if (IsImage(file))
            {
                <div class="photo-preview">
                    <button class="photo-open" aria-label="@($"View photo {file.Name}")" @onclick="() => viewing = file" @oncontextmenu="() => OnActions.InvokeAsync()" @oncontextmenu:preventDefault><img src="@url" alt="@file.Name" draggable="false" @onerror="() => ImageFailedAsync(file, url)" /></button>
                    @if (Message.LocalFileKey is null) { <button class="photo-download" aria-label="Download original photo" title="Download original" @onclick="() => State.OpenFileAsync(Message, file)"><Icon Name="download" Size="20" /></button> }
                </div>
            }
            else if (file.ContentType.StartsWith("video/")) { <video src="@url" controls playsinline preload="metadata" aria-label="@file.Name"></video> }
            else { <audio src="@url" controls preload="metadata" aria-label="Voice message"></audio> }
        }
        else { <button class="media-open" disabled="@loading" @onclick="() => OpenAsync(file)"><Icon Name="@(file.ContentType.StartsWith("audio/") ? "mic" : "file")" Size="20" /><span>@file.Name</span><small>@(file.Size / 1024) KB</small></button> }
    }
    @if (loading && Message.Attachments.Count == 0) { <span class="spinner" role="status" aria-label="Loading attachment"></span> }
    @if (failed) { <button class="media-open" @onclick="LoadAsync">Attachment unavailable · retry</button> }
    </div>
}
@if (viewing is { } photo && urls.TryGetValue(photo.Id, out var photoUrl))
{
    <PhotoViewer Url="@photoUrl" Name="@photo.Name" OnClose="() => viewing = null" CanDownload="@(Message.LocalFileKey is null)" OnDownload="() => State.OpenFileAsync(Message, photo)" />
}
@code {
    [Parameter, EditorRequired] public ChatMessage Message { get; set; } = default!;
    [Parameter] public EventCallback MetadataLoaded { get; set; }
    [Parameter] public EventCallback OnActions { get; set; }
    private ChatAttachment? viewing;
    private readonly Dictionary<Guid, string> urls = [];
    private bool loading, failed, disposed;
    private string? loaded;
    private int version;
    private static bool IsHeif(ChatAttachment file) => file.ContentType.StartsWith("image/heic", StringComparison.OrdinalIgnoreCase) || file.ContentType.StartsWith("image/heif", StringComparison.OrdinalIgnoreCase) || Path.GetExtension(file.Name).ToLowerInvariant() is ".heic" or ".heif";
    public static bool IsImage(ChatAttachment file) => IsHeif(file) || file.ContentType.Split(';')[0].ToLowerInvariant() is "image/jpeg" or "image/png" or "image/gif" or "image/webp" or "image/avif";
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Message.Id}:{Message.LocalFileKey}:{Message.HasAttachments}:{string.Join(',', Message.Attachments.Select(f => f.Id))}";
        if (key != loaded) { loaded = key; await LoadAsync(); }
    }
    private async Task LoadAsync()
    {
        if (disposed || !Message.HasAttachments && Message.Attachments.Count == 0) return;
        var request = ++version;
        var message = Message;
        loading = true; failed = false;
        try
        {
            await ReleaseAsync();
            if (message.Attachments.Count == 0) { await State.LoadAttachmentMetadataAsync(message); await MetadataLoaded.InvokeAsync(); }
            if (request != version || disposed) return;
            foreach (var file in message.Attachments.Where(f => IsImage(f) || message.LocalFileKey is not null && (f.ContentType.StartsWith("audio/") || f.ContentType.StartsWith("video/")))) await OpenAsync(message, file, request);
        }
        catch { if (request == version) failed = true; }
        finally { if (request == version) loading = false; }
    }
    private Task OpenAsync(ChatAttachment file) => OpenAsync(Message, file, version);
    private async Task OpenAsync(ChatMessage message, ChatAttachment file, int request)
    {
        try
        {
            var url = await JS.InvokeAsync<string?>("yap.device.mediaUrl", message.LocalFileKey ?? $"{State.Scope.Replace(':', '-')}-{file.Id:N}",
                $"api/chat/conversations/{message.ThreadId}/messages/{message.Id}/attachments/{file.Id}", State.Scope,
                State.Online && !State.NeedsLogin, file.ContentType, message.LocalFileKey is not null, file.Name);
            if (url is null) { await State.OpenFileAsync(message, file); return; }
            if (disposed || request != version) await JS.InvokeVoidAsync("yap.device.releaseMedia", url);
            else { if (urls.Remove(file.Id, out var old)) await JS.InvokeVoidAsync("yap.device.releaseMedia", old); urls[file.Id] = url; }
        }
        catch { if (request == version) failed = true; }
    }
    private async Task ImageFailedAsync(ChatAttachment file, string url)
    {
        if (urls.TryGetValue(file.Id, out var current) && current == url)
        { urls.Remove(file.Id); failed = true; await JS.InvokeVoidAsync("yap.device.releaseMedia", url); }
    }
    private async Task ReleaseAsync() { var previous = urls.Values.ToArray(); urls.Clear(); foreach (var url in previous) await JS.InvokeVoidAsync("yap.device.releaseMedia", url); }
    public async ValueTask DisposeAsync() { disposed = true; await ReleaseAsync(); }
}
