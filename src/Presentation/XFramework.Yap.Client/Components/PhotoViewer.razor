@implements IAsyncDisposable
@inject IJSRuntime JS
<dialog class="photo-viewer" aria-label="Photo viewer" @ref="dialog">
    <div class="photo-toolbar">
        <button aria-label="Close photo" @onclick="() => OnClose.InvokeAsync()"><Icon Name="close" /></button>
        <span class="photo-viewer-title">Photo</span>
        <button aria-label="Zoom out" @onclick="() => ZoomAsync(-1)">−</button>
        <button aria-label="Zoom in" @onclick="() => ZoomAsync(1)">+</button>
        <button aria-label="Reset zoom" @onclick="ResetAsync">Reset</button>
        @if (CanDownload) { <button aria-label="Download original photo" @onclick="() => OnDownload.InvokeAsync()"><Icon Name="download" /></button> }
    </div>
    <div class="photo-stage"><img src="@Url" alt="@Name" draggable="false" /></div>
    <p class="photo-hint">Pinch or double-tap to zoom</p>
</dialog>
@code {
    [Parameter, EditorRequired] public string Url { get; set; } = "";
    [Parameter] public string Name { get; set; } = "Photo";
    [Parameter] public bool CanDownload { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnDownload { get; set; }
    private ElementReference dialog;
    private DotNetObjectReference<PhotoViewer>? reference;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        reference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("yap.photoViewer.open", dialog, reference);
    }
    [JSInvokable] public Task CloseAsync() => OnClose.InvokeAsync();
    private Task ZoomAsync(int direction) => JS.InvokeVoidAsync("yap.photoViewer.zoom", dialog, direction).AsTask();
    private Task ResetAsync() => JS.InvokeVoidAsync("yap.photoViewer.reset", dialog).AsTask();
    public async ValueTask DisposeAsync() { await JS.InvokeVoidAsync("yap.photoViewer.dispose", dialog); reference?.Dispose(); }
}
