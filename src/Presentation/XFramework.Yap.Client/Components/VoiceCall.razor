@implements IAsyncDisposable
@inject VoiceState Voice
@inject IJSRuntime JS
@if(Voice.IsCalling)
{
    @if(Voice.Minimized)
    { <button class="active-call" data-update-busy="true" @onclick="Expand"><Icon Name="phone" Size="18" />@Voice.Name · @Elapsed</button> }
    else
    {
    <dialog class="voice-dialog" @ref="dialog" data-update-busy="true" aria-label="Voice call">
        <div class="callscreen"><div class="callbg"></div><div class="callinner">
            <div class="call-top"><button class="iconbtn" aria-label="Back to chat" @onclick="Minimize"><Icon Name="back" /></button><span class="callenc"><Icon Name="lock" Size="14" />Yap voice call</span></div>
            <div class="call-center"><Avatar Initials="@ChatMessage.InitialsFor(Voice.Name)" ImageUrl="@Voice.AvatarUrl" Size="a92" /><h1 class="callname">@Voice.Name</h1><p class="callstate" role="status">@Elapsed</p></div>
            @if(Voice.Incoming)
            { <div class="callrow2"><button class="cbtn end" @onclick="() => Voice.EndAsync()"><span class="k"><Icon Name="phone" Class="rot135" Size="26" /></span>Decline</button><button class="cbtn accept" @onclick="Voice.AcceptAsync"><span class="k"><Icon Name="phone" Size="26" /></span>Accept</button></div> }
            else
            { <div class="callrow2"><button class="cbtn @(Voice.Muted ? "on" : "")" disabled="@(Voice.ConnectedAt is null)" aria-pressed="@Voice.Muted" @onclick="Voice.ToggleMuteAsync"><span class="k"><Icon Name="mic" Size="24" /></span>@(Voice.Muted ? "Unmute" : "Mute")</button><button class="cbtn end" @onclick="() => Voice.EndAsync()"><span class="k"><Icon Name="phone" Class="rot135" Size="26" /></span>End</button></div> }
            <p class="call-footer">Encrypted connection through Yap</p>
        </div></div>
    </dialog>
    }
}
@if(Voice.Error is { } error)
{ <BottomSheet Title="Voice call" OnClose="Voice.DismissError"><div class="picker"><p role="alert">@error</p><button class="btn" @onclick="Voice.DismissError">Close</button></div></BottomSheet> }
@code {
    private ElementReference dialog;
    private readonly CancellationTokenSource lifetime = new();
    private bool shown;
    private string Elapsed => Voice.ConnectedAt is { } time ? (DateTimeOffset.UtcNow - time).ToString(@"mm\:ss") : Voice.Status;
    protected override void OnInitialized(){ Voice.Changed += Changed; _ = Tick(); }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    private async Task Tick(){ try { while(!lifetime.IsCancellationRequested){await Task.Delay(1000,lifetime.Token);if(Voice.ConnectedAt is not null)await InvokeAsync(StateHasChanged);} }catch(OperationCanceledException){} }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    { if(Voice.IsCalling && !Voice.Minimized && !shown){shown=true;await JS.InvokeVoidAsync("yap.openCall",dialog);} if(!Voice.IsCalling || Voice.Minimized)shown=false; }
    private void Minimize(){Voice.Minimized=true;shown=false;}
    private void Expand(){Voice.Minimized=false;shown=false;}
    public ValueTask DisposeAsync(){Voice.Changed-=Changed;lifetime.Cancel();lifetime.Dispose();return ValueTask.CompletedTask;}
}
