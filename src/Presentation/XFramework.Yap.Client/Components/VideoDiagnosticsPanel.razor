@using Bolt.Media.Browser
<aside class="video-debug" aria-label="Video diagnostics">
    <div class="debug-heading"><strong>Video diagnostics</strong><button type="button" @onclick="OnClose" aria-label="Hide video diagnostics">Hide</button></div>
    @if (Snapshot is { } info)
    {
        <div class="debug-stream">
            <strong>Transport: @(string.IsNullOrEmpty(info.Transport) ? "—" : info.Transport)</strong>
            @if (info.TransportReason is { Length: > 0 } reason) { <div>On the WebSocket: @reason</div> }
            <div>Route: @info.Topology</div>
            <div>Uplink repairs: @info.UplinkResent fragments since transport start</div>
            @if (info.TransportRttMs is { } rtt) { <div>Round trip: @Number(rtt) ms@(info.AudioRedundancy ? " · audio sent twice" : "")</div> }
        </div>
        @if (info.TotalBudgetKbps is { } budget)
        {
            <div class="debug-stream">
                <strong>Congestion: @info.Congestion@(info.VideoSuspended ? " ? video suspended" : "")</strong>
                <div>Budget: @budget kbps total / @info.VideoBudgetKbps video / @info.AudioBitrateKbps Opus</div>
                <div>Queue delay: @info.QueueDelayMs ms</div>
                @if (info.RateDetails is { } rate)
                {
                    <div>Reason: @rate.Cause; source: @rate.DelaySource</div>
                    <div>Actual sent: @rate.SentKbps kbps; application limited: @rate.ApplicationLimited</div>
                    <div>Feedback age receiver / transport: @rate.ReceiverAgeMs / @rate.TransportAgeMs ms</div>
                    <div>Delays local / uplink / relay / receiver: @rate.LocalDelayMs / @Number(rate.TransportDelayMs) / @Number(rate.RelayDelayMs) / @Number(rate.ReceiverDelayMs) ms</div>
                    <div>Uplink loss: @Number(rate.UplinkLossPercent)% · measured capacity: @(rate.CapacityKbps > 0 ? $"{rate.CapacityKbps} kbps" : "—")</div>
                    @if (rate.LastCut is { } cut)
                    {
                        <div>At cut: @cut.Source; local / transport / receiver @cut.LocalMs / @cut.TransportMs / @cut.ReceiverMs ms; sent @cut.SentKbps kbps</div>
                    }
                    @if (rate.LastCutAgeMs is { } age)
                    {
                        <div>Last cut: @rate.LastCutFromKbps → @rate.LastCutToKbps kbps (@rate.LastCutCause), @Number(age / 1000.0)s ago</div>
                    }
                }
            </div>
        }
        @if (info.EncryptionCosts is { } costs)
        {
            <div>Crypto + interop this window: @costs.Operations packets / @Number(costs.ProcessingMs) ms processing / @Number(costs.WaitingMs) ms waiting (both directions)</div>
        }
        <div>Main thread: max scheduling delay @Number(info.EventLoopLagMs) ms</div>
        <div class="debug-stream">
            <strong>Outgoing · @(info.Capturing ? "camera on" : "camera off")</strong>
            <div>Requested: @(RequestedHeight)p / @RequestedFps fps</div>
            @if (info.Capturing)
            {
                <div>Camera: @Size(info.CameraWidth, info.CameraHeight) / @Number(info.CameraFps) fps setting</div>
                <div>Encoder: @Size(info.Width, info.Height) / @Number(info.TargetFps) fps · @info.Codec</div>
                <div>Capture → encoded: @Number(info.CaptureFps) → @Number(info.EncodedFps) fps</div>
                <div>Encoded: @Number(info.EncodedKbps) kbps · last encode: @Number(info.EncoderDelayMs) ms</div>
                <div>Queue: encoder @info.EncoderQueue / send @info.SendQueue · capture pressure drops: @info.Dropped</div>
                <div>Path: @info.Strategy · @info.Acceleration</div>
                @if (info.CaptureFallback is { } fallback) { <div>Worker unavailable: @fallback</div> }
                <div>Average capture preparation: @Number(info.CapturePrepareMs) ms · encoded copy: @Number(info.EncodedCopyMs) ms</div>
                <div>Preparation draw / frame snapshot: @Number(info.CapturePaintMs) / @Number(info.CaptureFrameMs) ms</div>
                <div>Orientation: @(string.IsNullOrEmpty(info.Orientation) ? "—" : info.Orientation)</div>
            }
        </div>
        @for (var i = 0; i < info.Remotes.Length; i++)
        {
            var remote = info.Remotes[i];
            <div class="debug-stream" @key="remote.StreamId">
                <strong>Incoming @(i + 1) · @Size(remote.Width, remote.Height) · @remote.Codec</strong>
                <div>Received → rendered: @Number(remote.ReceivedFps) → @Number(remote.RenderedFps) fps</div>
                <div>Received: @Number(remote.ReceivedKbps) kbps · last decode: @Number(remote.DecoderDelayMs) ms</div>
                <div>Queue: decoder @remote.DecoderQueue / pending @remote.PendingFrames · resets: @remote.Resets</div>
                <div>Waiting for keyframe: @(remote.WaitingForKeyframe ? "yes" : "no") · recovery requests: @remote.RecoveryRequests</div>
                @if (remote.Recovery is { } recovery)
                {
                    <div>Recovery window: @recovery.RecoveryMs ms ? counters since stream start</div>
                    <div>NACKs: @recovery.Nacked ? recovered: @recovery.Recovered ? abandoned: @recovery.Abandoned ? declined: @recovery.Declined</div>
                    <div>Pictures: @recovery.Pictures released / @recovery.Incomplete incomplete / @recovery.Skipped skipped</div>
                    <div>Fragments: @recovery.Fragments received ? local backlog drops: @recovery.LocalDrops</div>
                }
                <div>Average render submission: @Number(remote.RenderMs) ms</div>
                <div>Decoder preference: @remote.Acceleration</div>
                <div>Rotation applied: @(string.IsNullOrEmpty(remote.Rotation) ? "—" : remote.Rotation)</div>
            </div>
        }
        @if (info.Remotes.Length == 0) { <div>No incoming video stream.</div> }
    }
    else { <div>Collecting video measurements…</div> }
    <p>Updates every second. — means no sample. Hardware preference does not confirm GPU use. Rates exclude transport overhead; codec delays include queueing, not CPU usage or call latency. Preparation/copy/render are submission costs, not GPU completion times. Timings run while this panel is open or live sharing is enabled in Settings.</p>
</aside>
@code {
    [Parameter] public VideoDiagnostics? Snapshot { get; set; }
    [Parameter] public int RequestedHeight { get; set; }
    [Parameter] public int RequestedFps { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private static string Number(double? value) => value is { } number ? number.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) : "—";
    private static string Size(int width, int height) => width > 0 && height > 0 ? $"{width}×{height}" : "—";
}
