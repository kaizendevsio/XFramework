@inject ChatState State
@inject BrowserTime Times
@implements IDisposable
@if (Message.IsCallSummary)
{
    <div class="call-history" data-message-id="@Message.Id">
        <Icon Name="phone" Size="18" />
        <span>@(Message.Mine && Message.Text == "Missed voice call" ? "Unanswered voice call" : Message.Text)<small>@Times.Clock(Message.CreatedAt)</small></span>
    </div>
}
else
{
<div class="msg @(Message.Mine ? "out" : "in")" data-message-id="@Message.Id" data-swipe-reply>
    @if (State.Selected?.Allows(ChatFeature.Replies) != false) { <button class="gesture-reply" aria-label="@($"Reply to {Message.Sender}: {Message.Text}")" @onclick="() => OnReply.InvokeAsync(Message)"><Icon Name="reply" Size="18" /></button> }
    @if (!Message.Mine) { <Avatar ImageUrl="@Message.AvatarUrl" Initials="@Message.Initials" Color="@Message.Color" Size="a34" /> }
    <div class="col">
        @if (ShowSender && !Message.Mine) { <span class="who">@Message.Sender</span> }
        @if (ShowText || Message.Quote is not null)
        {
        <button class="bub" @onclick="() => OnSelect.InvokeAsync(Message)" aria-label="@($"Message from {Message.Sender}: {Message.Text}. Open actions")"><span class="bubble-content">
            @if (Message.Quote is not null) { <span class="quote"><span class="qn">@Message.Quote.Sender</span>@Message.Quote.Text</span> }
            @if (ShowText) { @Message.Text }
        </span></button>
        }
        <MessageMedia Message="Message" MetadataLoaded="RefreshCaption" OnActions="() => OnSelect.InvokeAsync(Message)" />
        @if (!ShowText && Message.Quote is null && Message.Attachments.Count > 0 && !Message.Attachments.Any(f => MessageMedia.IsImage(f) || MessageMedia.IsVideo(f))) { <button class="media-actions" aria-label="Attachment message actions" @onclick="() => OnSelect.InvokeAsync(Message)"><Icon Name="more" Size="18" /></button> }
        @if (State.Selected?.Allows(ChatFeature.Reactions) != false && Message.Reactions.Count > 0) { <div class="reacts">@foreach (var reaction in Message.Reactions) { <button class="react @(Message.MyReactionIds.ContainsKey(reaction.Key) ? "mine" : "")" aria-label="@($"React {reaction.Key}")" aria-pressed="@Message.MyReactionIds.ContainsKey(reaction.Key).ToString().ToLowerInvariant()" @onclick="() => OnReact.InvokeAsync(reaction.Key)">@reaction.Key <span>@reaction.Value</span></button> }</div> }
        @if (State.Selected?.Allows(ChatFeature.Threads) != false && Message.ReplyTotal > 0) { <button class="threadlink" @onclick="() => OnThread.InvokeAsync(Message)">@if (Message.Replies.Count > 0) { <span class="fc">@foreach (var reply in Message.Replies.Take(3)) { <Avatar Initials="@reply.Initials" Color="@reply.Color" Size="a28" /> }</span> }@Message.ReplyTotal replies <Icon Name="arrow" Size="13" /></button> }
        @if (ShowTime || Message.Pinned || HasReaders || ShowDelivery)
        {
            <div class="meta">
                @if (Message.Pinned) { <span aria-label="Pinned">📌</span> }
                @if (ShowTime) { <time datetime="@BrowserTime.Iso(Message.CreatedAt)">@Times.Clock(Message.CreatedAt)</time> }
                @if (HasReaders) { <ReaderAvatars People="Readers" /> }
                else if (ShowDelivery) { <span class="rd" aria-label="@DeliveryLabel">@DeliveryLabel</span> }
            </div>
        }
        @if (Message.Mine && Message.PendingEncryptionCount > 0) { <div class="meta" role="status">Waiting for @Message.PendingEncryptionCount @(Message.PendingEncryptionCount == 1 ? "member" : "members") to finish setup</div> }
    </div>
</div>
}
@code {
    [Parameter, EditorRequired] public ChatMessage Message { get; set; } = default!;
    [Parameter] public bool ShowSender { get; set; }
    [Parameter] public bool Latest { get; set; }
    [Parameter] public bool ShowTime { get; set; }
    [Parameter] public List<Person> Readers { get; set; } = [];
    private CancellationTokenSource? sendingDelay;
    protected override void OnParametersSet()
    {
        sendingDelay?.Cancel(); sendingDelay?.Dispose(); sendingDelay = null;
        var remaining = Message.CreatedAt.AddSeconds(5) - DateTime.UtcNow;
        if (Message.Mine && MessageReceipts.IsSending(Message) && remaining > TimeSpan.Zero)
        {
            sendingDelay = new();
            _ = RevealSendingAsync(remaining, sendingDelay.Token);
        }
    }
    private async Task RevealSendingAsync(TimeSpan delay, CancellationToken cancellation)
    {
        try { await Task.Delay(delay, cancellation); await InvokeAsync(StateHasChanged); }
        catch (OperationCanceledException) { }
    }
    public void Dispose() { sendingDelay?.Cancel(); sendingDelay?.Dispose(); }
    [Parameter] public EventCallback<ChatMessage> OnSelect { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnThread { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnReply { get; set; }
    [Parameter] public EventCallback<string> OnReact { get; set; }
    private bool ShowText => !Message.HasAttachments && Message.Attachments.Count == 0 || Message.Attachments.Count > 0 && !Message.Attachments.Any(f => f.Name == Message.Text);
    private bool HasReaders => Message.Mine && State.Selected?.Allows(ChatFeature.ReadReceipts) != false && Readers.Count > 0 && !MessageReceipts.IsSending(Message);
    private bool ShowDelivery => !HasReaders && MessageReceipts.ShowStatus(Message, Latest, DateTime.UtcNow);
    private string DeliveryLabel => Message.Delivery switch
    {
        "Sending · waiting for recipient setup" => Message.Delivery,
        "Queued" or "Sending" => !State.Online ? "Sending · offline" : State.NeedsLogin ? "Sending · sign in" : "Sending",
        "Sent" when State.Selected?.Allows(ChatFeature.ReadReceipts) != false && Message.ReadCount > 0 => "Read",
        "Sent" when Message.DeliveredCount > 0 => State.Selected?.Group == true ? $"Delivered to {Message.DeliveredCount}" : "Delivered",
        "Sent" => "Sent",
        _ => "Not sent · retry"
    };
    private Task RefreshCaption() => InvokeAsync(StateHasChanged);
}
