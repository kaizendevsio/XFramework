@inject ChatState State
@inject NavigationManager Nav
<div class="conversation-details">
    <section class="details-identity">
        <Avatar Initials="@Conversation.Initials" ImageUrl="@Conversation.AvatarUrl" Color="@Conversation.Color" Size="a80" />
        <h1>@Conversation.Name</h1>
        <p class="muted">@State.ConversationSubtitle(Conversation)</p>
        @if (Conversation.Group && !Locked) { <PhotoPicker Path="@($"api/chat/conversations/{Conversation.Id}/photo")" Uploaded="State.SynchronizeAsync" /> }
    </section>
    <nav class="details-shortcuts" aria-label="Conversation shortcuts">
        @if (CanCall) { <button @onclick="Call"><span><Icon Name="phone" /></span>Call</button> }
        <button @onclick="Search"><span><Icon Name="search" /></span>Search</button>
        <button disabled="@(!State.Online || State.NeedsLogin)" @onclick="State.MuteAsync"><span><Icon Name="volume" /></span>@(Conversation.Muted ? "Unmute" : "Mute")</button>
    </nav>
    <h2 class="set-group">Chat info</h2>
    <div class="details-list">
        <details class="detail-section">
            <summary @onclick="() => mediaOpen = !mediaOpen"><Icon Name="image" /><span>Media and files</span><Icon Name="arrow" Size="17" /></summary>
            <div class="detail-content">
                @if (mediaOpen)
                {
                <div class="details-media">
                @foreach (var message in Conversation.Messages.Where(x => x.HasAttachments).TakeLast(12))
                { <MessageMedia @key="message.Id" Message="message" SourcePrefix="details" /> }
                </div>
                @if (!Conversation.Messages.Any(x => x.HasAttachments)) { <p class="muted">No media in the loaded messages.</p> }
                @if (State.HasEarlierMessages) { <button class="btn ghost" @onclick="State.LoadEarlierAsync">Load older messages</button> }
                }
            </div>
        </details>
        <details class="detail-section">
            <summary><Icon Name="file" /><span>Pinned messages</span><Icon Name="arrow" Size="17" /></summary>
            <div class="detail-content">
            @foreach (var message in Conversation.Messages.Where(x => x.Pinned))
            { <button class="row" @onclick="() => Locate.InvokeAsync(message.Id)"><span class="mid">@(message.HasAttachments ? "Attachment" : message.Text)</span><Icon Name="arrow" Size="17" /></button> }
            @if (!Conversation.Messages.Any(x => x.Pinned)) { <p class="muted">No pinned messages in the loaded history.</p> }
            @if (State.HasEarlierMessages) { <button class="btn ghost" @onclick="State.LoadEarlierAsync">Load older messages</button> }
            </div>
        </details>
        <details class="detail-section">
            <summary><Icon Name="users" /><span>Members<span class="detail-count">@Conversation.Members</span></span><Icon Name="arrow" Size="17" /></summary>
            <div class="detail-content">
    @foreach (var person in Conversation.People)
    {
        <div class="conversation-member" @key="person.Id">
            <div class="row"><Avatar Initials="@ChatMessage.InitialsFor(person.Name)" ImageUrl="@person.AvatarUrl" Size="a34" /><span class="mid"><b>@person.Name</b><small>@(person.Role is "Admin" or "Owner" ? "Admin" : "Member")@(State.IsActive(person) ? " · Active now" : "")</small></span>
            @if (!Locked) { <button class="iconbtn" aria-label="@($"Edit {person.Name}")" @onclick="() => Edit(person)"><Icon Name="edit" Size="18" /></button> }</div>
            @if (editing == person.Id)
            {
                <label class="field"><span class="lab">Nickname in this conversation</span><span class="inp"><input aria-label="Nickname" @bind="nickname" @bind:event="oninput" maxlength="80" /></span></label>
                <div class="member-actions"><button class="btn ghost" disabled="@Locked" @onclick="() => SaveNicknameAsync(person)">Save nickname</button>
                <button class="btn ghost" disabled="@(Locked || LastAdmin(person))" @onclick='() => MemberAsync(person, "role", person.Role is "Admin" or "Owner" ? "Member" : "Admin")'>@(person.Role is "Admin" or "Owner" ? "Make member" : "Make admin")</button></div>
                @if (LastAdmin(person)) { <p class="muted">Promote another admin before stepping down or leaving.</p> }
                @if (removing == person.Id) { <p>Remove @person.Name from this conversation?</p><button class="btn danger" disabled="@Locked" @onclick='() => MemberAsync(person, "remove")'>Confirm removal</button> }
                else { <button class="sheetitem danger" disabled="@(Locked || LastAdmin(person))" @onclick="() => removing = person.Id">Remove member</button> }
            }
        </div>
    }
    @if (Conversation.CanManage)
    {
        <h3>Add members</h3>
        @if (!Conversation.Group) { <p class="muted">Adding someone turns this direct conversation into a group.</p> }
        <label class="field"><span class="inp"><input aria-label="Find a member" placeholder="Search people" @bind="search" @bind:event="oninput" @bind:after="SearchAsync" disabled="@Locked" /></span></label>
        @foreach (var person in results.Where(p => Conversation.People.All(m => m.Id != p.Id)))
        { <button class="row" disabled="@Locked" @onclick='() => MemberAsync(person, "add")'><Avatar Initials="@ChatMessage.InitialsFor(person.Name)" ImageUrl="@person.AvatarUrl" Size="a34" /><span class="mid">@person.Name</span><Icon Name="plus" Size="18" /></button> }
    }

            </div>
        </details>
        @if (Conversation.CanManage)
        {
        <details class="detail-section">
            <summary><Icon Name="edit" /><span>Conversation name</span><Icon Name="arrow" Size="17" /></summary>
            <div class="detail-content"><label class="field"><span class="lab">Name</span><span class="inp"><input aria-label="Conversation name" @bind="title" @bind:event="oninput" maxlength="100" disabled="@Locked" /></span></label><button class="btn ghost" disabled="@(Locked || string.IsNullOrWhiteSpace(title))" @onclick="RenameAsync">Save name</button></div>
        </details>
        }
    </div>
    <h2 class="set-group">Privacy and preferences</h2>
    <div class="details-list">
        <label class="setting-toggle"><span>Share active status<small>Active now and last seen in this chat</small></span><input type="checkbox" role="switch" checked="@Conversation.ShareActiveStatus" disabled="@(!State.Online || State.NeedsLogin || busy)" @onchange="e => RunAsync(() => State.SetActiveStatusAsync(Conversation.Id, e.Value is true))" /><span class="switch-track" aria-hidden="true"></span></label>
        <details class="detail-section">
            <summary><Icon Name="settings" /><span>Message permissions<small>@(Conversation.CanManage ? "Manage features for everyone" : "Managed by conversation admins")</small></span><Icon Name="arrow" Size="17" /></summary>
            <div class="detail-content">
            @foreach (var (feature, label) in Features)
            { <label class="setting-toggle"><span>@label</span><input type="checkbox" role="switch" checked="@Conversation.Allows(feature)" disabled="@Locked" @onchange="e => ToggleAsync(feature, e.Value is true)" /><span class="switch-track" aria-hidden="true"></span></label> }
            </div>
        </details>
        @if (State.EncryptionEnabled) { <div class="detail-security"><Icon Name="lock" /><span>End-to-end encryption<small>Messages are encrypted on your devices</small></span></div> }
    </div>
    <button class="details-delete danger" disabled="@(!State.Online || State.NeedsLogin || busy)" @onclick="() => deleting = true"><Icon Name="trash" />Delete conversation</button>
    @if (deleting)
    {
        <div class="set-note" role="group" aria-label="Confirm conversation deletion">
            @if (deleteEveryone)
            {
                <p>Delete this conversation for everyone? Members will lose access to its messages in Yap. Their cached chat and unsent messages will be removed when they reconnect. This cannot be undone.</p>
            }
            else { <p>Remove this conversation from your chat list? Other members keep their conversation. Starting this conversation again restores its history.</p> }
            @if (deleteError is not null) { <p role="alert">@deleteError</p> }
            @if (deleteEveryone) { <button class="btn danger" disabled="@busy" @onclick="DeleteAsync">Confirm delete for everyone</button> }
            else
            {
                <button class="btn danger" disabled="@busy" @onclick="DeleteAsync">Delete for me</button>
                @if (Conversation.CanManage) { <button class="btn danger" disabled="@busy" @onclick="() => deleteEveryone = true">Delete for everyone</button> }
            }
            <button class="btn ghost" disabled="@busy" @onclick="() => { deleting = false; deleteEveryone = false; }">Cancel</button>
        </div>
    }

</div>
@code {
    [Parameter, EditorRequired] public Conversation Conversation { get; set; } = default!;
    private string title = "";
    [Parameter] public EventCallback Search { get; set; }
    [Parameter] public EventCallback Call { get; set; }
    [Parameter] public EventCallback<Guid> Locate { get; set; }
    [Parameter] public bool CanCall { get; set; }
    protected override void OnInitialized() => title = Conversation.Name;
    private Task RenameAsync() => RunAsync(() => State.UpdateConversationAsync(new(Conversation.Id, Name: title)));
    private bool busy, mediaOpen;
    private bool deleting;
    private bool deleteEveryone;
    private string? deleteError;
    private bool Locked => busy || !Conversation.CanManage || !State.Online || State.NeedsLogin;
    private Guid? editing, removing;
    private string nickname = "", search = "";
    private List<Person> results = [];
    private static readonly (ChatFeature Feature, string Label)[] Features = [
        (ChatFeature.ReadReceipts, "Read receipts"), (ChatFeature.Typing, "Typing indicators"),
        (ChatFeature.Threads, "Threads"), (ChatFeature.Reactions, "Reactions"), (ChatFeature.Replies, "Replies"),
        (ChatFeature.Voice, "Voice messages"), (ChatFeature.Attachments, "Media and attachments")];
    private bool LastAdmin(Person person) => person.Role is "Admin" or "Owner" && Conversation.People.Count(p => p.Role is "Admin" or "Owner") <= 1;
    private void Edit(Person person) { editing = editing == person.Id ? null : person.Id; nickname = person.Nickname ?? ""; removing = null; }
    private Task ToggleAsync(ChatFeature feature, bool enabled) => RunAsync(() => State.UpdateConversationAsync(new(Conversation.Id,
        enabled ? Conversation.Features | (int)feature : Conversation.Features & ~(int)feature)));
    private Task SaveNicknameAsync(Person person) => RunAsync(() => State.UpdateConversationAsync(new(Conversation.Id, NicknameMemberId: person.MemberId, Nickname: nickname)));
    private Task MemberAsync(Person person, string action, string? role = null) => RunAsync(() => State.ChangeMemberAsync(new(Conversation.Id, person.Id, person.MemberId, action, role)));
    private async Task RunAsync(Func<Task> action) { busy = true; editing = removing = null; try { await action(); } catch (Exception ex) { State.Report(ex); } finally { busy = false; } }
    private async Task SearchAsync() { var query = search; try { var people = await State.SearchPeopleAsync(query); if (query == search) results = people; } catch (Exception ex) { State.Report(ex); } }
    private async Task DeleteAsync()
    {
        busy = true; deleteError = null;
        var id = Conversation.Id;
        Nav.NavigateTo("/");
        try { await State.DeleteConversationAsync(id, deleteEveryone); }
        catch (Exception ex) { State.Report(ex); }
        finally { busy = false; }
    }
}
