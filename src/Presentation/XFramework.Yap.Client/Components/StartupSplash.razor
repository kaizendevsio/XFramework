<main class="startup-splash" role="status" aria-live="polite">
    <Brand />
    <p>@Text</p>
    <span class="spinner" aria-hidden="true"></span>
    @ChildContent
</main>
@code {
    [Parameter] public string Text { get; set; } = "Starting Yap…";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
