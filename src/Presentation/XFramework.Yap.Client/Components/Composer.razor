@inject ChatState State
@inject ChatApi Api
@inject IJSRuntime JS
@implements IAsyncDisposable
<form class="composer" data-update-busy="@((busy || State.SavingMessages || recording || uploading || attaching || file is not null).ToString().ToLowerInvariant())" @onsubmit="SendAsync" @onsubmit:preventDefault>
    @if (State.Selected?.Allows(ChatFeature.Typing) != false && State.TypingPeople is { Count: > 0 } people)
    { <div class="typing-indicator" role="status" aria-label="@State.TypingText">@foreach (var person in people) { <Avatar Initials="@ChatMessage.InitialsFor(person.Name)" ImageUrl="@person.AvatarUrl" Size="a28" /> }<span class="typing-dots" aria-hidden="true"><i></i><i></i><i></i></span></div> }
    @if (Reply is not null && ParentId is null) { <div class="replyto liquid-glass"><GlassLayer /><Icon Name="reply" Size="17" /><span class="mid"><span class="n">Replying to @Reply.Sender</span><span class="p">@Reply.Text</span></span><button type="button" class="iconbtn" aria-label="Cancel reply" @onclick="Cancel"><Icon Name="close" Size="16" /></button></div> }
    @if (file is { } staged)
    {
        var preview = ChatMedia.Preview(staged.ContentType, staged.Name);
        @* A photo, a video poster and a voice player already say what they are; only a plain
           file has nothing to show, so only it keeps the name-and-size row. A codec this
           browser cannot decode leaves nothing to show either, so it falls back to that row. *@
        if (preview is AttachmentPreview.File || previewFailed)
        {
            <div class="replyto liquid-glass attachment-preview"><GlassLayer />
                <Icon Name="@Glyph(staged.ContentType)" Size="17" />
                <span class="mid"><span class="n">@staged.Name</span><span class="p">@Describe(staged)</span>
                    @if (uploading) { <span class="upload-bar" role="progressbar" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100" aria-label="Upload progress"><i style="transform:scaleX(@Filled)"></i></span> }
                </span>
                <button type="button" class="iconbtn" aria-label="Remove attachment" @onclick="RemoveFileAsync"><Icon Name="close" Size="16" /></button>
            </div>
        }
        else
        {
            <div class="staged @(preview is AttachmentPreview.Voice ? "staged-voice" : "staged-media")">
                <MessageMedia @key="staged.Key" Message="@Local(staged)" PreviewFailed="() => previewFailed = true" />
                <button type="button" class="staged-remove" aria-label="Remove attachment" @onclick="RemoveFileAsync"><Icon Name="close" Size="18" /></button>
                @if (uploading)
                {
                    <span class="staged-upload"><span class="upload-bar" role="progressbar" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100" aria-label="Upload progress"><i style="transform:scaleX(@Filled)"></i></span><span>@(progress)%</span></span>
                }
            </div>
        }
    }
    @if (recording) { <VoiceRecorder Stop="FinishRecordingAsync" Cancel="CancelRecordingAsync" /> }
    <div class="inputrow liquid-glass @(CanSend ? "has-send" : "") @(emoji.Open ? "emoji-open" : "")"><GlassLayer />
        @if (State.Selected?.Allows(ChatFeature.Attachments) != false) { <button type="button" class="iconbtn attach-open" aria-label="Attach" @onpointerdown:preventDefault disabled="@(busy || recording || uploading)" @onclick="() => attaching = true"><Icon Name="plus" /></button> }
        @* @onpointerdown:preventDefault on the toggle keeps the native keyboard up until the
           picker has taken its place, so the two never both animate. *@
        <div class="inputbox"><textarea @ref="editor" rows="1" aria-label="@(ParentId.HasValue ? "Reply in thread" : "Message")" placeholder="@(ParentId.HasValue ? "Reply in thread" : "Message")" @bind="draft" @bind:event="oninput" @bind:after="SaveDraftAsync" @onfocus="CloseEmojiAsync" @onblur="StopTypingAsync" disabled="@recording" maxlength="4000" autocomplete="off"></textarea><button type="button" class="emoji-toggle" aria-label="@(emoji.Open ? "Show the keyboard" : "Emoji keyboard")" aria-expanded="@emoji.Open.ToString().ToLowerInvariant()" @onpointerdown:preventDefault @onclick="ToggleEmojiAsync">@(emoji.Open ? "⌨" : "☺")</button></div>
        <div class="composer-action">
            <button type="submit" class="sendbtn" aria-label="Send message" @onpointerdown:preventDefault tabindex="@(CanSend ? 0 : -1)" disabled="@(busy || !CanSend || recording)"><Icon Name="send" Size="20" /></button>
            @if (State.Selected?.Allows(ChatFeature.Voice) != false) { <button type="button" class="voicebtn iconbtn" aria-label="Record voice message" @onpointerdown:preventDefault tabindex="@(CanSend ? -1 : 0)" disabled="@(busy || recording || CanSend)" @onclick="StartRecordingAsync"><Icon Name="mic" Size="20" /></button> }
        </div>
    </div>
    @if (emoji.Open) { <EmojiKeyboard OnPick="InsertEmojiAsync" OnClose="() => ToggleEmojiAsync()" /> }
</form>
@if (attaching)
{
    <BottomSheet Title="Attach" OnClose="() => attaching = false">
        @* Each source is its own file input so the browser opens the right picker.
           No option filters or re-encodes the chosen file. *@
        <div class="attach-picker">
            <label class="sheetitem"><Icon Name="image" Size="20" /><span class="mid"><span class="n">Photo or video</span><span class="p">Sent at original quality</span></span><InputFile @ref="mediaInput" accept="image/*,video/*" OnChange="e => PickAsync(e, mediaInput)" aria-label="Choose a photo or video" /></label>
            <label class="sheetitem"><Icon Name="camera" Size="20" /><span class="mid"><span class="n">Camera</span><span class="p">Take a photo</span></span><InputFile @ref="cameraInput" accept="image/*" capture="environment" OnChange="e => PickAsync(e, cameraInput)" aria-label="Use the camera" /></label>
            <label class="sheetitem"><Icon Name="camera" Size="20" /><span class="mid"><span class="n">Record video</span><span class="p">Open the video camera</span></span><InputFile @ref="videoInput" accept="video/*" capture="environment" OnChange="e => PickAsync(e, videoInput)" aria-label="Record a video" /></label>
            <label class="sheetitem"><Icon Name="clip" Size="20" /><span class="mid"><span class="n">File</span><span class="p">Documents, PDFs, archives, anything</span></span><InputFile @ref="fileInput" OnChange="e => PickAsync(e, fileInput)" aria-label="Choose a file" /></label>
        </div>
        <p class="attach-note">Up to @(ChatLimits.MaxFileBytes / 1073741824) GB. Files over @(ChatLimits.StagedFileBytes / 1048576) MB upload as you compose and need a connection.</p>
    </BottomSheet>
}
@code {
    [Parameter] public Guid ThreadId { get; set; }
    [Parameter] public Guid? ParentId { get; set; }
    [Parameter] public ChatMessage? Reply { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    [Parameter] public EventCallback Sent { get; set; }
    [Parameter] public EventCallback<ChatMessage> RestoreReply { get; set; }
    private string Key => $"{ThreadId:N}:{ParentId?.ToString("N") ?? "main"}";
    private string draft = "", loaded = "";
    private long draftRevision;
    private bool busy, recording, attaching, uploading, previewFailed;
    private int progress;
    private ElementReference editor;
    private readonly EmojiKeyboardState emoji = new();
    private bool CanSend => !uploading && (!string.IsNullOrWhiteSpace(draft) || file is not null);
    private InputFile? mediaInput, cameraInput, videoInput, fileInput;
    private ChatState.PickedFile? file;
    private DotNetObjectReference<Composer>? reporter;
    protected override void OnInitialized() => State.Changed += Changed;
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    protected override async Task OnParametersSetAsync()
    {
        if (loaded == Key) return;
        var key = loaded = Key;
        var revision = ++draftRevision;
        draft = "";
        await RemoveFileAsync();
        var saved = await State.DraftAsync(key);
        if (loaded == key && draftRevision == revision) draft = saved;
    }
    private async Task SaveDraftAsync()
    {
        draftRevision++;
        _ = State.PublishTypingAsync(ThreadId, !string.IsNullOrWhiteSpace(draft));
        try { await State.SaveDraftAsync(Key, draft); } catch (Exception ex) { State.Report(ex); }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("yap.device.resizeComposer", editor);
    private Task StopTypingAsync() => State.PublishTypingAsync(ThreadId, false);
    public async ValueTask DisposeAsync()
    {
        State.Changed -= Changed;
        await StopTypingAsync();
        await CancelRecordingAsync();
        await RemoveFileAsync();
        // The picker owns a document-level flag while it is up; leaving the conversation
        // must not leave the shell laid out for a keyboard that is no longer there.
        if (emoji.Open) { emoji.Close(); await JS.InvokeVoidAsync("yap.emojiKeyboard.hide", editor, false); }
        reporter?.Dispose();
    }

    /// <summary>Hands the keyboard's place to the picker and back. Neither direction touches the draft.</summary>
    private async Task ToggleEmojiAsync()
    {
        if (emoji.Toggle())
        {
            await JS.InvokeVoidAsync("yap.emojiKeyboard.show", editor);
            await JS.InvokeVoidAsync("yap.haptics.buzz", "tap");
        }
        else await JS.InvokeVoidAsync("yap.emojiKeyboard.hide", editor, true);
    }

    // Tapping the draft asks for the real keyboard back, so the picker steps aside without
    // stealing the focus the tap just gave it.
    private async Task CloseEmojiAsync()
    {
        if (!emoji.Open) return;
        emoji.Close();
        await JS.InvokeVoidAsync("yap.emojiKeyboard.hide", editor, false);
    }

    private async Task InsertEmojiAsync(string glyph)
    {
        var range = await JS.InvokeAsync<int[]>("yap.emojiKeyboard.caret", editor);
        draft = emoji.Insert(draft, range.ElementAtOrDefault(0), range.ElementAtOrDefault(1), glyph);
        // Writing the new value drops the caret at the end, so the render has to happen before
        // the caret goes back - not on some later OnAfterRender, which would land on the old text.
        await InvokeAsync(StateHasChanged);
        if (emoji.TakeCaret() is { } caret) await JS.InvokeVoidAsync("yap.emojiKeyboard.place", editor, caret);
        await SaveDraftAsync();
    }
    private async Task StartRecordingAsync()
    {
        try { await JS.InvokeVoidAsync("yap.device.startRecording"); recording = true; }
        catch { State.Report(new InvalidOperationException("Allow microphone access to record a voice message.")); }
    }
    private async Task FinishRecordingAsync()
    {
        busy = true;
        try { var picked = await JS.InvokeAsync<ChatState.PickedFile?>("yap.device.stopRecording", Guid.NewGuid().ToString("N"), false, ChatLimits.StagedFileBytes); await RemoveFileAsync(); file = picked; }
        catch (Exception ex) { State.Report(ex); }
        finally { busy = recording = false; }
    }
    private async Task CancelRecordingAsync() { if (recording) await JS.InvokeVoidAsync("yap.device.stopRecording", "", true, ChatLimits.StagedFileBytes); recording = false; }

    private async Task PickAsync(InputFileChangeEventArgs e, InputFile? source)
    {
        attaching = false;
        busy = true;
        try
        {
            if (e.File.Size <= 0) throw new InvalidOperationException("Choose a file to attach.");
            if (e.File.Size > ChatLimits.MaxFileBytes)
                throw new InvalidOperationException($"Choose a file up to {ChatLimits.MaxFileBytes / 1073741824} GB.");
            if (e.File.Size > ChatLimits.StagedFileBytes && (!State.Online || State.NeedsLogin))
                throw new InvalidOperationException("Attachments this large need a connection. Reconnect and try again.");
            await RemoveFileAsync();
            var picked = await JS.InvokeAsync<ChatState.PickedFile>("yap.device.pickFile", source!.Element,
                Guid.NewGuid().ToString("N"), ChatLimits.StagedFileBytes, ChatLimits.MaxFileBytes);
            file = picked;
            if (!picked.Staged && !State.EncryptionEnabled) await StreamAsync(picked);
        }
        catch (Exception ex) { State.Report(ex); await RemoveFileAsync(); }
        finally { busy = false; }
    }

    /// <summary>
    /// Sends every part of an unstaged file now and keeps the session open. Completing it
    /// is left to the outbox, so removing the attachment aborts instead of orphaning bytes.
    /// </summary>
    private async Task StreamAsync(ChatState.PickedFile picked)
    {
        uploading = true;
        progress = 0;
        reporter ??= DotNetObjectReference.Create(this);
        Guid? session = null;
        try
        {
            var ticket = await Api.PostAsync<UploadTicket>($"api/chat/uploads/{ThreadId}/session",
                new BeginUpload(picked.Name, picked.ContentType, picked.Size)) ?? throw new ChatApiException(503);
            session = ticket.UploadId;
            var status = await JS.InvokeAsync<int>("yap.device.uploadParts", picked.Key, ticket.UploadId,
                ticket.ChunkSizeBytes, ticket.TotalParts, Api.Token, State.Scope, reporter);
            if (status is < 200 or >= 300) throw new ChatApiException(status);
            // The attachment may have been removed or replaced while the parts were in
            // flight. Never resurrect it; abandon the session instead.
            if (file?.Key != picked.Key) return;
            file = picked with { UploadId = ticket.UploadId };
            session = null;
        }
        catch
        {
            if (session is { } incomplete) await AbortAsync(incomplete);
            throw;
        }
        finally { uploading = false; }
    }

    [JSInvokable]
    public Task UploadProgress(int percent)
    {
        progress = percent;
        return InvokeAsync(StateHasChanged);
    }

    private async Task AbortAsync(Guid session)
    {
        try { await Api.PostAsync<object>($"api/chat/uploads/session/{session}/abort"); }
        catch (Exception ex) { Console.Error.WriteLine($"Yap could not abort upload {session}: {ex.Message}"); }
    }

    private async Task RemoveFileAsync()
    {
        previewFailed = false;
        if (file is not { } previous) return;
        file = null;
        if (previous.UploadId is { } session) await AbortAsync(session);
        await JS.InvokeVoidAsync("yap.device.removeFile", previous.Key);
    }

    private async Task SendAsync()
    {
        if (busy || recording || !CanSend) return;
        var text = draft;
        var attachment = file;
        var repliedTo = Reply;
        var key = Key;
        var account = State.Scope;
        draftRevision++;
        // Keep attachment ownership exclusive until it is durable, but let text
        // sends continue while previous messages are being saved.
        busy = attachment is not null;
        draft = ""; file = null; previewFailed = false;
        try
        {
            _ = StopTypingAsync();
            // The send commits here, not when the server answers: the tap confirms the gesture.
            _ = JS.InvokeVoidAsync("yap.haptics.buzz", "commit");
            var saving = State.SendAsync(ThreadId, text, ParentId ?? Reply?.Id, key, attachment, ParentId.HasValue);
            await Cancel.InvokeAsync(); await Sent.InvokeAsync();
            await saving;
        }
        catch (Exception ex)
        {
            State.Report(ex);
            if (State.Scope != account) return;
            if (Key == key)
            {
                draft = string.IsNullOrEmpty(draft) ? text : text + "\n" + draft;
                if (attachment is not null) file = attachment;
                if (repliedTo is not null) await RestoreReply.InvokeAsync(repliedTo);
                await SaveDraftAsync();
            }
            else
            {
                var previous = await State.DraftAsync(key);
                await State.SaveDraftAsync(key, string.IsNullOrEmpty(previous) ? text : text + "\n" + previous);
            }
        }
        finally { if (attachment is not null) busy = false; }
    }

    private string Filled => (progress / 100d).ToString(System.Globalization.CultureInfo.InvariantCulture);

    // The staged file is previewed through the same component the thread uses, from the local copy.
    private static ChatMessage Local(ChatState.PickedFile picked) => new()
    {
        Id = Guid.Parse(picked.Key), LocalFileKey = picked.Key, HasAttachments = true,
        Attachments = [new(Guid.Parse(picked.Key), picked.Name, picked.ContentType, picked.Size)]
    };

    private string Describe(ChatState.PickedFile picked) => uploading
        ? $"Uploading {progress}% · {Size(picked.Size)}"
        : picked.UploadId is not null ? $"Ready to send · {Size(picked.Size)}"
        : $"Saved on this device · {Size(picked.Size)}";

    private static string Size(long bytes) => bytes switch
    {
        >= 1073741824 => $"{bytes / 1073741824d:0.#} GB",
        >= 1048576 => $"{bytes / 1048576d:0.#} MB",
        >= 1024 => $"{bytes / 1024d:0} KB",
        _ => $"{bytes} B"
    };

    private static string Glyph(string contentType) => contentType.Split('/')[0] switch
    {
        "image" => "image", "video" => "video", "audio" => "mic", _ => "file"
    };
}
