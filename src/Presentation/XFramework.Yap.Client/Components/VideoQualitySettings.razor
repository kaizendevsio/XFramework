@inject VoiceState Voice
<div class="video-quality-settings">
    <label>Video resolution
        <select aria-label="Video resolution" value="@Voice.PreferredVideoHeight" disabled="@Voice.CameraBusy" @onchange="HeightAsync">
            <option value="360">360p</option><option value="540">540p</option><option value="720">720p</option>
            <option value="1080">1080p (default)</option><option value="1440">1440p</option><option value="2160">4K</option>
        </select>
    </label>
    <label>Frame rate
        <select aria-label="Video frame rate" value="@Voice.PreferredVideoFramerate" disabled="@Voice.CameraBusy" @onchange="RateAsync">
            <option value="30">30 fps (default)</option><option value="60">60 fps</option>
        </select>
    </label>
    <p>Maximum sending quality. Actual quality adapts to your camera, device and connection. Higher quality uses more data and battery.</p>
</div>
@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Voice.LoadVideoPreferenceAsync();
        StateHasChanged();
    }
    private Task HeightAsync(ChangeEventArgs args) => int.TryParse(args.Value?.ToString(), out var height)
        ? Voice.SetVideoPreferenceAsync(height, Voice.PreferredVideoFramerate) : Task.CompletedTask;
    private Task RateAsync(ChangeEventArgs args) => int.TryParse(args.Value?.ToString(), out var fps)
        ? Voice.SetVideoPreferenceAsync(Voice.PreferredVideoHeight, fps) : Task.CompletedTask;
}
