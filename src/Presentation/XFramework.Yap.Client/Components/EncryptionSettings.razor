@inject ChatState State
@inject IJSRuntime JS
@inject VoiceState Voice
@implements IDisposable
@if (State.User is not null && State.EncryptionEnabled)
{
    <h3 class="set-group">Privacy</h3>
    <section class="encryption-settings set-list">
        <div class="security-summary">
            <Icon Name="shield" Size="22" />
            <div><strong>Encrypted messages</strong><p>@(State.Encryption.Status.Approved ? "This device is ready" : "Unlock this device to send and read encrypted messages")</p></div>
        </div>
        @if (State.Encryption.Status.Approved && State.Encryption.Status.CanApproveDevices)
        {
            <details>
                <summary>Recovery and devices</summary>
                <p>@(passwordStatus?.Enabled == true ? "Signing in on a new device restores your messages automatically, using the password you type at sign-in. Keep a recovery key for the day you forget that password." : "Turn on password recovery below while this device still has your keys. Until then, a new device needs a recovery key or this device's approval.")</p>
                <button class="btn" disabled="@busy" @onclick="ShowRecoveryAsync">Show recovery key</button>
                @if (State.Encryption.RecoveryKey is { } key)
                {
                    <textarea class="secret-code" readonly aria-label="Recovery key" value="@key"></textarea>
                    <button class="btn" @onclick="() => CopyAsync(key)">Copy recovery key</button>
                    <button class="btn" @onclick="State.Encryption.HideRecovery">Hide recovery key</button>
                }
                <label>Approve another device<textarea @bind="deviceRequest" placeholder="Paste the request from your new device" autocomplete="off" spellcheck="false"></textarea></label>
                <button class="btn" disabled="@(busy || string.IsNullOrWhiteSpace(deviceRequest))" @onclick="ApproveAsync">Approve device</button>
                @if (approval is not null)
                {
                    <textarea readonly aria-label="Device approval" value="@approval"></textarea>
                    <button class="btn" @onclick="() => CopyAsync(approval)">Copy approval</button>
                }
                <p class="fingerprint">Your identity fingerprint: @State.Encryption.Status.RootFingerprint</p>
                <button class="btn" disabled="@busy" @onclick="LoadDevicesAsync">Manage devices</button>
                @if (devices is not null)
                {
                    <div class="device-list">
                    @foreach (var device in devices.OrderByDescending(d => d.IsLocal).ThenBy(d => d.Revoked))
                    {
                        <div class="device-row" @key="device.Id">
                            <div><strong>@(device.IsLocal ? "This device" : $"Device {device.Id.ToString("N")[..8]}")</strong><small>@(device.Revoked ? "Removed" : "Approved")</small></div>
                            @if (!device.IsLocal && !device.Revoked)
                            { <button class="btn device-remove" disabled="@busy" @onclick="() => revokeCandidate = device.Id">Remove</button> }
                        </div>
                        @if (revokeCandidate == device.Id)
                        {
                            <div class="device-confirm" role="alert">
                                <p>This device will stop receiving new encrypted messages. Previously downloaded messages remain on it.</p>
                                <button class="btn device-remove" disabled="@busy" @onclick="() => RevokeAsync(device.Id)">Remove device</button>
                                <button class="btn" disabled="@busy" @onclick="() => revokeCandidate = null">Keep device</button>
                            </div>
                        }
                    }
                    </div>
                }
            </details>
        }
        else if (State.Encryption.Status.Approved)
        {
            <p>Manage recovery and approve more devices from your original trusted device.</p>
            <p class="fingerprint">Your identity fingerprint: @State.Encryption.Status.RootFingerprint</p>
        }
        else
        {
            @* One way in, matching what sign-in already attempted. The recovery key is the fallback
               for a forgotten password, not a second route competing with it. *@
            @if (unlock is { Available: true })
            {
                <p>This sign-in still carries what this device needs. Nothing to retype.</p>
                <button class="btn" disabled="@busy" @onclick="UnlockAsync">Unlock encrypted messages</button>
            }
            else if (unlock is { SignedIn: true, Problem: { Length: > 0 } reason })
            {
                @* This sign-in proved the password and still could not open the backup. Retyping
                   the same password cannot change that, so say what did happen instead. *@
                <p role="alert">@reason</p>
            }
            else if (passwordStatus is { Enabled: true })
            {
                <p>Signing in restores your messages automatically. Confirm your account password to finish it here.</p>
                <label>Account password<input type="password" @bind="unlockPassword" autocomplete="current-password" /></label>
                <button class="btn" disabled="@(busy || string.IsNullOrEmpty(unlockPassword))" @onclick="UnlockWithPasswordAsync">Unlock with your password</button>
            }
            else if (passwordStatus is null)
            {
                <button class="btn" disabled="@busy" @onclick="LoadPasswordStatusAsync">Check unlock options</button>
            }
            else
            {
                @* An account whose password was reset looks exactly like one that never enrolled:
                   the reset deletes the wrapped backup key along with the old credential. *@
                <p>This account is not using password recovery right now, so your password cannot unlock older messages here. A password reset removes it; turn it back on from a device that still has your keys.</p>
            }
            <details><summary>Can't use your password?</summary>
                <label>Recovery key<textarea @bind="recoveryKey" autocomplete="off" spellcheck="false" placeholder="Paste your saved recovery key"></textarea></label>
                <button class="btn" disabled="@(busy || string.IsNullOrWhiteSpace(recoveryKey))" @onclick="RestoreAsync">Restore encrypted messages</button>
                <p>Or open Yap on a trusted device, then paste this device request in Settings → Privacy → Approve another device.</p>
                <button class="btn" disabled="@busy" @onclick="ProposeAsync">Create device request</button>
                @if (proposal is not null) { <textarea readonly aria-label="Device request" value="@proposal"></textarea><button class="btn" @onclick="() => CopyAsync(proposal)">Copy device request</button> }
                <label>Approval code<textarea @bind="approvalCode" autocomplete="off" spellcheck="false" placeholder="Paste the approval from your trusted device"></textarea></label>
                <button class="btn" disabled="@(busy || string.IsNullOrWhiteSpace(approvalCode))" @onclick="AcceptAsync">Unlock this device</button>
            </details>
        }
        @if (State.Encryption.Status.Approved)
        {
            <details>
                <summary>Verify a person</summary>
                <p>Compare fingerprints together or through another trusted app. Matching fingerprints confirm the encryption identity you are using.</p>
                <label>Person<select @bind="peerId" @bind:after="ClearPeer">
                    <option value="@Guid.Empty">Choose a person</option>
                    @foreach (var person in Peers) { <option value="@person.Id">@person.Name</option> }
                </select></label>
                <button class="btn" disabled="@(busy || peerId == Guid.Empty)" @onclick="LoadFingerprintAsync">Show fingerprint</button>
                @if (!Peers.Any()) { <p>Open a conversation first to find people to verify here.</p> }
                @if (fingerprint is not null && fingerprint.CredentialId == peerId)
                {
                    <p class="fingerprint">@fingerprint.Fingerprint</p>
                    @if (fingerprint.Changed) { <p role="alert">This person's encryption identity has changed. Compare this fingerprint with them before accepting their new identity.</p> }
                    @if (fingerprint.Verified) { <p class="verified-person">Identity verified</p> }
                    else
                    {
                        <label>The fingerprint they shared<input @bind="comparison" autocomplete="off" spellcheck="false" placeholder="Paste their fingerprint" /></label>
                        <button class="btn" disabled="@(busy || string.IsNullOrWhiteSpace(comparison))" @onclick="VerifyAsync">Verify match</button>
                    }
                }
            </details>
        }
        <details>
            <summary>Password and recovery</summary>
            @if (passwordStatus is null) { <button class="btn" disabled="@busy" @onclick="LoadPasswordStatusAsync">Check password recovery</button> }
            else
            {
                <p>@(passwordStatus.Enabled ? "Password recovery is on. Signing in on a new device restores your messages automatically, with the password you type at sign-in." : "Password recovery has not been enabled for this account yet.")</p>
                @* The build no longer promises that a known password cannot reach old messages: with
                   recovery on it can, by design, and saying otherwise is the more dangerous half. *@
                @if (passwordStatus.Enabled) { <p>Anyone who knows this password can read your message history on a new device. Change it here if you ever share it or suspect it.</p> }
                <p>Changing your password here keeps your old messages: it re-protects the same backup with your new password. A password reset you request from the sign-in screen does not, because it removes that protected backup along with the old password. After a reset, use a recovery key or a trusted device and turn password recovery back on.</p>
                <label>Current password<input type="password" @bind="currentPassword" autocomplete="current-password" /></label>
                @if (passwordStatus.Enabled)
                {
                    <label>New password<input type="password" @bind="newPassword" autocomplete="new-password" minlength="8" /></label>
                    <label>Confirm new password<input type="password" @bind="confirmPassword" autocomplete="new-password" /></label>
                    <button class="btn" disabled="@(busy || string.IsNullOrEmpty(currentPassword) || newPassword.Length < 8 || newPassword != confirmPassword)" @onclick="ChangePasswordAsync">Change password</button>
                }
                else
                {
                    <button class="btn" disabled="@(busy || !State.Encryption.Status.CanApproveDevices || string.IsNullOrEmpty(currentPassword))" @onclick="EnablePasswordAsync">Enable password recovery</button>
                    @if (!State.Encryption.Status.CanApproveDevices) { <p>Restore your recovery key or use your original device before enabling this.</p> }
                }
            }
        </details>
        <details class="reset-encryption">
            <summary>Lost your recovery key?</summary>
            <p>Try another trusted device first. If you cannot recover your keys, you can start fresh with a new encryption identity.</p>
            <p>Resetting removes saved messages, drafts and unsent messages from this device. Your new keys cannot unlock old encrypted messages. Other people keep their copies, and must verify your new identity. Your account stays signed in.</p>
            @if (Voice.IsCalling) { <p>Finish your call before resetting encryption.</p> }
            <label>Confirm your account password<input type="password" @bind="resetPassword" autocomplete="current-password" /></label>
            <label class="reset-consent"><input type="checkbox" @bind="resetConsent" />I understand that my old encrypted messages cannot be recovered with the new keys.</label>
            <button class="btn device-remove" disabled="@(busy || Voice.IsCalling || !State.Online || !resetConsent || string.IsNullOrEmpty(resetPassword))" @onclick="ResetAsync">Reset encryption and start fresh</button>
        </details>
        @if (notice is not null) { <p role="status">@notice</p> }
        @if (State.Encryption.BackupPending) { <p role="status">Your recovery backup is waiting to sync. Keep this device until it finishes.</p> }
    </section>
}
@code {
    private sealed record PasswordStatus(bool Enabled, string Username);
    private PasswordStatus? passwordStatus;
    private string currentPassword = "", newPassword = "", confirmPassword = "";
    private bool busy;
    private bool resetConsent;
    private string resetPassword = "";
    private string recoveryKey = "", deviceRequest = "", approvalCode = "";
    private string? proposal, approval, notice;
    private string? accountScope;
    private string unlockPassword = "";
    private ChatEncryption.PasswordUnlock? unlock;
    private List<ChatEncryption.DeviceInfo>? devices;
    private Guid? revokeCandidate;
    private Guid peerId;
    private string comparison = "";
    private ChatEncryption.FingerprintInfo? fingerprint;
    // The only string sort in the app, and the only place InvariantGlobalization changes an order rather
    // than a format: a default OrderBy would compare through a collation this build no longer ships.
    // Ordinal, ignoring case, is what the runtime would fall back to anyway - said out loud so it is a
    // decision and not a side effect. Accented names sort after unaccented ones; nobody sees a wrong time.
    private IEnumerable<Person> Peers => State.Conversations.SelectMany(c => c.People)
        .Concat(State.Selected?.People ?? []).Where(p => p.Id != State.User?.CredentialId).DistinctBy(p => p.Id)
        .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase);
    protected override void OnParametersSet()
    {
        var scope = State.User is null ? null : OfflineStore.Scope(State.User);
        if (scope == accountScope) { _ = LoadUnlockAsync(); return; }
        accountScope = scope; ClearPrivateUi(); _ = LoadUnlockAsync();
    }
    // What this browser session already holds decides whether unlocking needs the password typed
    // again at all, so a locked device asks before it offers anything rather than after.
    private bool loadingUnlock;
    private async Task LoadUnlockAsync()
    {
        var user = State.User;
        if (user is null || State.Encryption.Status.Approved || unlock is not null || loadingUnlock) return;
        var scope = OfflineStore.Scope(user);
        loadingUnlock = true;
        try
        {
            var state = await State.Encryption.PasswordUnlockStateAsync(user);
            if (State.User is null || OfflineStore.Scope(State.User) != scope) return;
            unlock = state;
            if (!state.SignedIn && passwordStatus is null)
                passwordStatus = await JS.InvokeAsync<PasswordStatus>("yap.encryption.passwordStatus", scope);
            if (State.User is not null && OfflineStore.Scope(State.User) == scope) StateHasChanged();
        }
        catch { /* An unavailable worker or a dropped connection is reported by the next action. */ }
        finally { loadingUnlock = false; }
    }
    private void ClearPrivateUi()
    { currentPassword = newPassword = confirmPassword = unlockPassword = ""; passwordStatus = null; unlock = null; recoveryKey = deviceRequest = approvalCode = comparison = resetPassword = ""; resetConsent = false; proposal = approval = notice = null; devices = null; revokeCandidate = null; fingerprint = null; peerId = Guid.Empty; }
    private void ClearPeer() { fingerprint = null; comparison = ""; }
    private async Task RunAsync(Func<UserSession, Task> action)
    {
        var user = State.User;
        if (user is null) return;
        var scope = OfflineStore.Scope(user);
        busy = true; notice = null;
        try { await action(user); }
        catch (Exception error)
        {
            // The old catch-all replaced every cause with one sentence about codes and connections,
            // so a failed unlock told the person - and the logs - nothing. Say what actually failed.
            if (State.User is not null && OfflineStore.Scope(State.User) == scope) notice = Explain(error);
            try { await JS.InvokeVoidAsync("yap.diagnostics.record", "encryption.failed", new { type = error.GetType().Name }); } catch { }
        }
        finally { busy = false; if (State.User is null || OfflineStore.Scope(State.User) != scope) ClearPrivateUi(); }
    }
    private static string Explain(Exception error) => error switch
    {
        OperationCanceledException => "The signed-in account changed. Open Settings again.",
        ChatApiException or JSException or InvalidOperationException when First(error.Message) is { Length: > 0 } message => message,
        _ => "Could not update encryption. Check the code, fingerprint and connection, then try again."
    };
    private static string First(string message) => message.Split('\n')[0].Trim();
    private Task LoadPasswordStatusAsync() => RunAsync(async user =>
        passwordStatus = await JS.InvokeAsync<PasswordStatus>("yap.encryption.passwordStatus", OfflineStore.Scope(user)));
    private Task EnablePasswordAsync() => RunAsync(async user =>
    {
        try
        {
            if (passwordStatus is null) return;
            if (!await State.Encryption.PasswordEnrollAsync(user, passwordStatus.Username, currentPassword))
                throw new InvalidOperationException();
            passwordStatus = passwordStatus with { Enabled = true }; notice = "Password recovery enabled.";
        }
        finally { currentPassword = ""; }
    });
    // The sign-in already produced the export key this needs; finish with it rather than asking again.
    private Task UnlockAsync() => RunAsync(async user =>
    {
        if (!await State.Encryption.PasswordRestoreAsync(user))
            throw new InvalidOperationException("Sign in again to unlock older messages with your password.");
        await State.SynchronizeAsync(); unlock = null; notice = "Encrypted messages unlocked.";
    });
    private Task UnlockWithPasswordAsync() => RunAsync(async user =>
    {
        try
        {
            if (passwordStatus is null) return;
            await JS.InvokeVoidAsync("yap.encryption.passwordSignIn", passwordStatus.Username, unlockPassword);
            await State.SynchronizeAsync();
            unlock = await State.Encryption.PasswordUnlockStateAsync(user);
            // A sign-in that leaves no material behind means this account still authenticates the
            // old way, so there is no password-wrapped backup to open.
            if (!await State.Encryption.PasswordRestoreAsync(user))
                throw new InvalidOperationException("Password recovery is not enabled for this account.");
            await State.SynchronizeAsync(); unlock = null; notice = "Encrypted messages unlocked.";
        }
        finally { unlockPassword = ""; }
    });
    private Task ChangePasswordAsync() => RunAsync(async user =>
    {
        try
        {
            if (passwordStatus is null || newPassword != confirmPassword || newPassword.Length < 8) return;
            await JS.InvokeVoidAsync("yap.encryption.passwordChange", OfflineStore.Scope(user), passwordStatus.Username, currentPassword, newPassword);
            await State.SynchronizeAsync(); notice = "Password changed. Other sessions have been signed out.";
        }
        finally { currentPassword = newPassword = confirmPassword = ""; }
    });
    private Task ShowRecoveryAsync() => RunAsync(State.Encryption.ShowRecoveryAsync);
    private Task ResetAsync() => RunAsync(async user =>
    {
        if (!resetConsent || Voice.IsCalling) return;
        try
        {
            await State.ResetEncryptionAsync(resetPassword);
            ClearPrivateUi();
            notice = "Encryption reset. Old messages remain locked. Check Password and recovery to confirm your recovery options.";
        }
        catch (ChatApiException ex) when (ex.Status is 403 or 429)
        {
            notice = ex.Status == 429 ? "Too many password attempts. Wait a little before trying again."
                : "Your password could not be confirmed. Check it and try again.";
        }
        finally { resetPassword = ""; resetConsent = false; }
    });
    private Task RestoreAsync() => RunAsync(async user => { await State.Encryption.RestoreAsync(user, recoveryKey.Trim()); recoveryKey = ""; unlock = null; await State.SynchronizeAsync(); notice = "This device is ready."; });
    private Task ProposeAsync() => RunAsync(async user => proposal = await State.Encryption.ProposeAsync(user));
    private Task ApproveAsync() => RunAsync(async user => { approval = await State.Encryption.ApproveAsync(user, deviceRequest); deviceRequest = ""; devices = null; });
    private Task AcceptAsync() => RunAsync(async user => { await State.Encryption.AcceptApprovalAsync(user, approvalCode); approvalCode = ""; unlock = null; await State.SynchronizeAsync(); });
    private Task LoadDevicesAsync() => RunAsync(async user => devices = await State.Encryption.DevicesAsync(user));
    private Task RevokeAsync(Guid id) => RunAsync(async user => { await State.Encryption.RevokeAsync(user, id); revokeCandidate = null; devices = await State.Encryption.DevicesAsync(user); notice = "Device removed."; });
    private Task LoadFingerprintAsync() => RunAsync(async user => fingerprint = await State.Encryption.FingerprintAsync(user, peerId));
    private Task VerifyAsync() => RunAsync(async user => { await State.Encryption.VerifyFingerprintAsync(user, peerId, comparison.Trim()); fingerprint = await State.Encryption.FingerprintAsync(user, peerId); comparison = ""; await State.RetryAsync(); notice = "Identity verified. Queued messages will resume sending."; });
    private async Task CopyAsync(string? value) { await JS.InvokeVoidAsync("navigator.clipboard.writeText", value); notice = "Copied."; }
    public void Dispose() { State.Encryption.HideRecovery(); ClearPrivateUi(); }
}
