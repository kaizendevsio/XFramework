@inject IJSRuntime JS
@inject VoiceState Voice
<h3 class="set-group">Video quality</h3>
<div class="set-list"><VideoQualitySettings /></div>
<h3 class="set-group">Microphone</h3>
<div class="set-list">
    <button type="button" class="set-row set-action" disabled="@(checkingMicrophone || Voice.IsCalling)" @onclick="EnableMicrophoneAsync">
        <span class="set-key"><Icon Name="mic" Size="19" /><span class="set-label">Enable microphone<small>@microphoneNotice</small></span></span>
    </button>
</div>
<p class="set-footnote">Your browser controls microphone permission. On iPhone, Safari's website settings may offer Microphone > Allow. An installed web app may still ask again; installing Yap cannot grant permanent access. This check releases the microphone immediately.</p>
<h3 class="set-group">Incoming call ringtone</h3>
<div class="set-list">
    <div class="set-row">
        <span class="set-key"><Icon Name="volume" Size="19" /><span class="set-label">Ring volume<small>How loudly this device rings for calls you receive</small></span></span>
        <input class="ring-volume" type="range" min="0" max="100" step="5" aria-label="Ring volume" value="@Percent" @onchange="VolumeAsync" />
    </div>
    @foreach (var tone in tones)
    {
        <button type="button" class="set-row set-action" aria-pressed="@((tone.Id == selected).ToString().ToLowerInvariant())" @onclick="() => ChooseAsync(tone.Id)">
            <span class="set-key"><Icon Name="@(tone.Id == selected ? "check" : "volume")" Size="19" /><span class="set-label">@tone.Label</span></span>
            <span class="set-value">@(tone.Id == selected ? "Selected" : "Preview")</span>
        </button>
    }
</div>
<p class="set-footnote" role="status">@notice</p>
<p class="set-footnote">This tone plays only for calls you receive. While you are placing a call you hear the standard ringing tone instead, at a fixed low level — turning the volume all the way down silences that too. Ringing is stored on this device only. Call volume during a call follows your device’s own volume buttons.</p>
@code {
    private bool checkingMicrophone;
    private string microphoneNotice = "Check access before your next call";
    private async Task EnableMicrophoneAsync()
    {
        if (checkingMicrophone || Voice.IsCalling) return;
        checkingMicrophone = true;
        try { DescribeMicrophone(await JS.InvokeAsync<string>("yap.microphone.request")); }
        catch { microphoneNotice = "Microphone access could not be checked."; }
        finally { checkingMicrophone = false; }
    }
    private void DescribeMicrophone(string state) => microphoneNotice = state switch
    {
        "ready" => "Microphone works. Your browser may ask again next time.",
        "granted" => "Access is currently allowed by your browser",
        "denied" => "Access is blocked. Check this site's microphone permission in your browser settings.",
        "missing" => "No microphone was found on this device",
        "unsupported" => "Microphone access is unavailable in this browser",
        "unavailable" => "Microphone is unavailable. Check whether another app is using it.",
        _ => "Tap to check access before your next call"
    };
    private RingTone[] tones = [];
    private string selected = "classic";
    private double volume = .7;
    private string notice = "Pick a ringtone to hear how an incoming call sounds on this device.";
    private int Percent => (int)Math.Round(volume * 100);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { DescribeMicrophone(await JS.InvokeAsync<string>("yap.microphone.state")); } catch { }
        try
        {
            tones = await JS.InvokeAsync<RingTone[]>("yap.ring.tones");
            var preference = await JS.InvokeAsync<RingPreference>("yap.ring.preference");
            selected = preference.Tone; volume = preference.Volume;
        }
        catch { notice = "Ring sounds are unavailable in this browser."; }
        StateHasChanged();
    }

    // Choosing plays the tone: the tap is also the gesture that proves this device can ring.
    private async Task ChooseAsync(string id)
    {
        selected = id;
        try { await JS.InvokeVoidAsync("yap.ring.setTone", id); Describe(await JS.InvokeAsync<RingStatus>("yap.ring.preview", id)); }
        catch { notice = "Ring sounds are unavailable in this browser."; }
    }

    private async Task VolumeAsync(ChangeEventArgs args)
    {
        if (!double.TryParse(args.Value?.ToString(), out var percent)) return;
        try
        {
            volume = await JS.InvokeAsync<double>("yap.ring.setVolume", percent / 100);
            Describe(await JS.InvokeAsync<RingStatus>("yap.ring.preview", selected));
        }
        catch { notice = "Ring sounds are unavailable in this browser."; }
    }

    private void Describe(RingStatus status) => notice = status.Audible ? "Incoming calls ring like this on this device."
        : status.Vibrating ? "This browser blocked the sound, so Yap vibrates instead."
        : volume == 0 ? "Ring volume is off. Incoming calls still show on screen."
        : selected == "silent" ? "Silent ringing. Incoming calls vibrate where the device supports it."
        : "This browser blocked the sound. Open Yap and tap once before a call arrives, or check your device’s mute switch.";
}
