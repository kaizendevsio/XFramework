@inject DatabaseStartup Startup
@inject NavigationManager Nav
@inject ChatState State
@inject ILogger<App> Logger
@inject IJSRuntime JS
@if (!State.Ready || failure is not null)
{
    <div class="toast-host"><UpdateNotice /></div>
    <div class="startup-recovery"><a href="/api/app-recovery" data-enhance-nav="false">Taking a while? Open recovery</a></div>
}
@if (failure is not null)
{
    <main class="loading"><Brand /><h1>Device storage unavailable</h1><p>@failure</p><button class="btn" @onclick="() => Nav.NavigateTo(Nav.Uri, true)">Try again</button><a href="diagnostics.html">Open diagnostic logs</a></main>
}
else if (!State.Ready)
{
    @if (waitingForDatabase)
    {
        <main class="loading" role="status"><Brand /><h1>Yap is open in another tab</h1><p>Close the other Yap tab or window. This page will continue automatically. Your saved conversations are safe.</p><progress aria-label="Waiting for the other tab"></progress><p><a href="diagnostics.html">Open diagnostic logs</a></p></main>
    }
    else
    {
        <main class="loading"><Brand /><p>Opening your conversations…</p><progress aria-label="Loading Yap"></progress></main>
    }
}
else
{
    <Router AppAssembly="typeof(App).Assembly"><Found Context="route"><RouteView RouteData="route" DefaultLayout="typeof(MainLayout)" /></Found>
    <NotFound><LayoutView Layout="typeof(MainLayout)"><div class="body"><h1>Page not found</h1><a class="btn" href="/">Back to chats</a></div></LayoutView></NotFound></Router>
}
@code {
    private string? failure;
    private bool waitingForDatabase;
    protected override Task OnInitializedAsync() => StartAsync();
    private async Task StartAsync()
    {
        failure = null;
        try
        {
            while (!await Startup.TryInitializeAsync())
            {
                waitingForDatabase = true;
                StateHasChanged();
            }
            waitingForDatabase = false;
            await State.InitializeAsync();
            await JS.InvokeVoidAsync("yap.diagnostics.record", "startup.complete");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Yap startup failed");
            try { await JS.InvokeVoidAsync("yap.diagnostics.record", "startup.failed", new { phase = Startup.Phase, type = ex.GetType().FullName }); }
            catch { /* Diagnostics must not prevent the recovery screen. */ }
            failure = "Use a current browser with device storage enabled. If Yap is open in another tab, close that tab and try again. Your saved data has not been cleared.";
        }
    }
}
