@page "/identity/sessions"
@implements IDisposable

<PageTitle>Sessions - Portal</PageTitle>

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <div>
            <BbTypographyH3>Sessions</BbTypographyH3>
            <p class="text-sm text-muted-foreground">Monitor and manage active user sessions</p>
        </div>
    </div>

    @if (_loading)
    {
        <CenteredSpinner />
    }
    else if (TenantFilter.SelectedTenantId is null || TenantFilter.SelectedTenantId == Guid.Empty)
    {
        <BbEmpty Title="Select a tenant" Description="Select a tenant to view sessions." />
    }
    else if (_loadFailed)
    {
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertTitle>Sessions could not be loaded.</BbAlertTitle>
            <BbAlertDescription>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@LoadData">Retry</BbButton>
            </BbAlertDescription>
        </BbAlert>
    }
    else
    {
    <BbDataGrid Items="@_sessions" ShowPagination="true" InitialPageSize="20" ShowSearch="true" SearchPlaceholder="Search sessions...">
        <Columns>
            <BbDataGridTemplateColumn Title="Credential" Filterable="true" FilterBy="@(item => GetCredentialLabel(item.CredentialId))">
                <ChildContent Context="item">
                    @GetCredentialLabel(item.CredentialId)
                </ChildContent>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn Title="Status" Filterable="true" FilterBy="@(item => GetStatusText(item.Status))">
                <ChildContent Context="item">
                    <StatusBadge Text="@GetStatusText(item.Status)"
                                 Status="@GetStatusKey(item.Status)" />
                </ChildContent>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn Title="Session Type" Filterable="true" FilterBy="@(item => GetSessionTypeLabel(item))">
                <ChildContent Context="item">
                    @GetSessionTypeLabel(item)
                </ChildContent>
            </BbDataGridTemplateColumn>
            <BbDataGridPropertyColumn Property="@(x => x.ExpiresAt)" Title="Expires At" Sortable="true" Filterable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
        </Columns>
        <EmptyTemplate>
            <BbEmpty Title="No sessions" Description="No sessions found for the selected tenant." />
        </EmptyTemplate>
    </BbDataGrid>
    }
</div>

@code {
    [Inject] private global::XFramework.Domain.Shared.DataContext.IDataContext DataContext { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private ILogger<Sessions> Logger { get; set; } = default!;

    private List<Session> _sessions = [];
    private List<IdentityCredential> _credentials = [];
    private bool _loading = true;
    private bool _loadFailed;
    private int _loadVersion;

    protected override async Task OnInitializedAsync()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        await LoadData();
    }

    private void OnTenantChanged() => _ = InvokeAsync(async () =>
    {
        var load = LoadData();
        StateHasChanged();
        await load;
        StateHasChanged();
    });

    private async Task LoadData()
    {
        var version = ++_loadVersion;
        var tenantId = TenantFilter.SelectedTenantId;
        _loading = true;
        _loadFailed = false;
        _sessions = [];
        _credentials = [];
        try
        {
            if (tenantId is null || tenantId == Guid.Empty)
                return;

            var sessions = await DataContext.Query<Session>()
                .NoCache()
                .Where(x => x.TenantId == tenantId.Value)
                .Include(x => x.SessionType)
                .OrderByDescending(x => x.CreatedAt)
                .Take(100)
                .ToListAsync();
            var credentialIds = sessions.Select(x => x.CredentialId).Distinct().ToArray();
            var credentials = credentialIds.Length == 0 ? [] : await DataContext.Query<IdentityCredential>()
                .NoCache()
                .Where(x => x.TenantId == tenantId.Value)
                .Where(x => credentialIds.Contains(x.Id))
                .Take(100)
                .ToListAsync();
            if (version == _loadVersion && tenantId == TenantFilter.SelectedTenantId)
            {
                _sessions = sessions;
                _credentials = credentials;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load sessions for tenant {TenantId}", tenantId);
            if (version == _loadVersion && tenantId == TenantFilter.SelectedTenantId)
                _loadFailed = true;
        }
        finally
        {
            if (version == _loadVersion)
                _loading = false;
        }
    }

    public void Dispose()
    {
        ++_loadVersion;
        TenantFilter.OnChanged -= OnTenantChanged;
    }

    private static string GetStatusText(CurrentSessionState status) => status switch
    {
        CurrentSessionState.Active => "Active",
        CurrentSessionState.Inactive => "Inactive",
        CurrentSessionState.Expired => "Expired",
        CurrentSessionState.Suspended => "Suspended",
        _ => "Unknown"
    };

    private static string GetStatusKey(CurrentSessionState status) => status switch
    {
        CurrentSessionState.Active => "active",
        CurrentSessionState.Inactive => "inactive",
        CurrentSessionState.Expired => "expired",
        CurrentSessionState.Suspended => "suspended",
        _ => "inactive"
    };

    private string GetCredentialLabel(Guid credentialId) =>
        _credentials.FirstOrDefault(x => x.Id == credentialId) is { } credential
            ? GetCredentialLabel(credential)
            : "Unknown credential";

    private static string GetCredentialLabel(IdentityCredential credential)
    {
        if (!string.IsNullOrWhiteSpace(credential.UserName))
            return credential.UserName;

        if (!string.IsNullOrWhiteSpace(credential.UserAlias))
            return credential.UserAlias;

        return "Unnamed credential";
    }

    private static string GetSessionTypeLabel(Session session) =>
        !string.IsNullOrWhiteSpace(session.SessionType?.Name)
            ? session.SessionType.Name
            : session.SessionTypeId.HasValue
                ? "Unknown session type"
                : "Default session";
}
