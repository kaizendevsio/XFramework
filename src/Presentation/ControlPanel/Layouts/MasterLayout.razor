@using XFramework.Blazor.Entity.Constants
@inherits XFramework.Blazor.Components.XLayoutBase
@layout BaseLayout

<SectionContent SectionName="@LayoutConstants.Sidebar">
    <MudNavMenu Class="mud-width-full">
        <MudDivider Class="my-2" />
        <MudNavLink Href="/tenants" Icon="@Icons.Material.Filled.Apartment">Tenants</MudNavLink>
    </MudNavMenu>
</SectionContent>

<SectionContent SectionName="@LayoutConstants.Content">
    <div class="d-flex flex-column gap-3 align-content-start p-3">
        <div>
            <SectionOutlet SectionName="@LayoutConstants.HeaderButton"/>
        </div>
        
        @Body
    </div>
</SectionContent>