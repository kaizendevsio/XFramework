@using XFramework.Blazor.Entity.Constants
@inherits XFramework.Blazor.Components.XLayoutBase
<MudThemeProvider IsDarkMode="@true"/>
<MudPopoverProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())"/>
        <MudSpacer/>
        <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End"/>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <MudDrawerHeader Class="d-flex flex-column px-0">
            <MudText Typo="Typo.h6" Class="px-4">Control Panel</MudText>
            <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">The ultimate business platform</MudText>
        </MudDrawerHeader>
        <SectionOutlet SectionName="@LayoutConstants.Sidebar"/>
    </MudDrawer>
    <MudMainContent>
        <SectionOutlet SectionName="@LayoutConstants.Content"/>
    </MudMainContent>
</MudLayout>

@Body

@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

}