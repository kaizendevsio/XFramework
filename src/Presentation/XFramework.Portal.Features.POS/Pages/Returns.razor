@page "/pos/returns"
@using XFramework.Domain.Shared.DataContext
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>POS Returns - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_hasTenant)
{
    <ModuleUnavailable ModuleName="POS" RequiresTenant="true" />
}
else if (!_moduleEnabled)
{
    <ModuleUnavailable ModuleName="POS Returns" />
}
else
{
    <FadeInContent>
        <div class="space-y-6">
            <div class="xf-page-header">
                <div>
                    <BbTypographyH3>Returns</BbTypographyH3>
                    <BbTypographyMuted>Post inventory returns through Inventario and refunds through Wallets.</BbTypographyMuted>
                </div>
                <div class="xf-page-actions">
                    <BbButton OnClick="@OpenReturnDialog">
                        <LucideIcon Name="undo-2" class="mr-2 h-4 w-4" />
                        Create Return
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@Reload">
                        <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                        Refresh
                    </BbButton>
                </div>
            </div>

            <section class="pos-list-surface" data-testid="pos-list-surface">
                <BbTypographyMuted data-testid="pos-list-result-count">@_returns.Count return(s) loaded</BbTypographyMuted>
                <div class="pos-list-content">
                    <div class="xf-filter-actions pos-list-toolbar" data-testid="pos-list-toolbar">
                        <div class="pos-list-search" data-testid="pos-list-search">
                            <BbFormFieldInput TValue="string" @bind-Value="_returnSearch" Label="Return or idempotency key" Placeholder="Search returns" />
                        </div>
                        <div class="pos-list-status" data-testid="pos-list-status">
                            <PosListStatusSelect @bind-Value="_returnStatusFilter" Options="@ReturnStatusOptions" />
                        </div>
                        <BbButton class="pos-list-search-action" OnClick="@ApplyReturnFilters" Disabled="@_loadingPage">
                            <LucideIcon Name="search" class="mr-2 h-4 w-4" />Search
                        </BbButton>
                    </div>
                    <BbDataGrid Items="@_returns" ShowPagination="false"
                                OnRowClick="@((PosReturnSummaryResponse item) => OpenReturn(item.Id))"
                                Class="cursor-pointer">
                        <Columns>
                            <BbDataGridPropertyColumn Property="@(x => x.ReturnNumber)" Title="Return" Sortable="true" Filterable="true" />
                            <BbDataGridTemplateColumn Title="Sale" Filterable="true" FilterBy="@(item => GetSaleNumber(item.SaleId))">
                                <ChildContent Context="item">@GetSaleNumber(item.SaleId)</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Register" Filterable="true" FilterBy="@(item => GetRegisterName(item.RegisterId))">
                                <ChildContent Context="item">@GetRegisterName(item.RegisterId)</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Refund" Sortable="true" Filterable="true" FilterBy="@(item => item.TotalRefundAmount)">
                                <ChildContent Context="item">@FormatMoney(item.TotalRefundAmount, item.CurrencyId)</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Status" Filterable="true" FilterBy="@(item => item.Status)">
                                <ChildContent Context="item">
                                    <StatusBadge Text="@item.Status.ToString()" Status="@GetReturnStatusBadge(item.Status)" />
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
                            <BbDataGridTemplateColumn Title="Actions">
                                <ChildContent Context="item">
                                    <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" OnClick="@(() => OpenReturn(item.Id))">View</BbButton>
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                        </Columns>
                        <EmptyTemplate>
                            <BbEmpty Title="No returns found" Description="Try adjusting the search or status filter." />
                        </EmptyTemplate>
                    </BbDataGrid>
                    <div class="pos-list-pager" data-testid="pos-list-pager">
                        <BbTypographyMuted>Page @_returnPage · up to @PageSize results per page</BbTypographyMuted>
                        <div class="pos-list-pager-actions">
                            <BbButton Variant="ButtonVariant.Outline" OnClick="@PreviousReturnPage" Disabled="@(_returnPage == 1 || _loadingPage)">Previous</BbButton>
                            <BbButton Variant="ButtonVariant.Outline" OnClick="@NextReturnPage" Disabled="@(!_hasNextReturnPage || _loadingPage)">Next</BbButton>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </FadeInContent>
}

<BbDialog Open="@_dialogOpen" OpenChanged="@(value => _dialogOpen = value)">
    <BbDialogContent TrapFocus="false" Class="xf-dialog-wide">
        <BbDialogHeader>
            <BbDialogTitle>Create POS Return</BbDialogTitle>
            <BbDialogDescription>Select a completed sale and the quantities to return.</BbDialogDescription>
        </BbDialogHeader>
        <div class="grid gap-4 py-4">
            <div class="flex items-end gap-2">
                <BbFormFieldInput TValue="string" @bind-Value="_saleSearch" Label="Find older receipt" />
                <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => SearchCompletedSales())" Disabled="@_searchingSales">
                    <LucideIcon Name="search" class="mr-2 h-4 w-4" />Find Receipt
                </BbButton>
            </div>
            <XfEntityPicker TItem="PosSaleSummaryResponse"
                            Value="@_selectedSaleId"
                            ValueChanged="@OnSaleChanged"
                            Items="@_completedSales"
                            Label="Original Sale"
                            Placeholder="Select sale"
                            SearchPlaceholder="Search receipts..."
                            EmptyMessage="No completed sales found."
                            ValueSelector="@GetSaleValue"
                            TextSelector="@GetSaleLabel"
                            SearchTextSelector="@GetSaleSearchText"
                            SearchRequested="@SearchCompletedSalesFromPicker"
                            AdvancedColumns="@SaleAdvancedColumns"
                            AdvancedSearchScope="Searches sale number, register, total, status, created date, completed date, and sale id."
                            AdvancedSearchTitle="Find Original Sale"
                            AdvancedSearchDescription="Select the completed sale for this return." />

            <div class="space-y-1">
                <BbTypographyMuted>Refund Method</BbTypographyMuted>
                <div class="font-medium" data-testid="pos-original-refund-method">@GetRefundMethodLabel(_refundMethod)</div>
                <BbTypographyMuted>Refunds are always sent through the original captured payment method and account.</BbTypographyMuted>
            </div>

            <BbDataGrid Items="@_returnLines" ShowPagination="false">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.ProductName)" Title="Item" Filterable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.PurchasedQuantity)" Title="Purchased" Sortable="true" Filterable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.PreviouslyReturnedQuantity)" Title="Returned" Sortable="true" Filterable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.RemainingQuantity)" Title="Remaining" Sortable="true" Filterable="true" />
                    <BbDataGridTemplateColumn Title="Return Qty" Sortable="true" Filterable="true" FilterBy="@(item => item.ReturnQuantity)">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => ChangeReturnQuantity(item, -1))">-</BbButton>
                                <span class="font-mono">@item.ReturnQuantity.ToString("N0")</span>
                                <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => ChangeReturnQuantity(item, 1))">+</BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                    <BbDataGridTemplateColumn Title="Unit" Filterable="true" FilterBy="@(item => item.UnitPrice)">
                        <ChildContent Context="item">@FormatSelectedMoney(item.UnitPrice)</ChildContent>
                    </BbDataGridTemplateColumn>
                    <BbDataGridTemplateColumn Title="Refund" Filterable="true" FilterBy="@(item => item.RefundAmount)">
                        <ChildContent Context="item">@FormatSelectedMoney(item.RefundAmount)</ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
                <EmptyTemplate>
                    <BbEmpty Title="No returnable lines" Description="Select a completed sale with line items." />
                </EmptyTemplate>
            </BbDataGrid>
            <BbFormFieldInput TValue="string" @bind-Value="_reason" Label="Reason" />
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _dialogOpen = false)">Cancel</BbButton>
            <BbButton OnClick="@CreateReturn" Disabled="@(_saving || !_returnLines.Any(line => line.ReturnQuantity > 0))">Create Return</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Parameter, SupplyParameterFromQuery] public Guid? SaleId { get; set; }

    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private IPOSServiceWrapper POS { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private IPortalModuleAvailability ModuleNavigation { get; set; } = default!;
    [Inject] private RequestMetadata RequestMetadata { get; set; } = default!;
    [Inject] private IPortalActorContext ActorContext { get; set; } = default!;

    private List<PosReturnSummaryResponse> _returns = [];
    private List<Wallets.Domain.Shared.Contracts.CurrencyType> _currencies = [];
    private List<PosSaleSummaryResponse> _completedSales = [];
    private List<PosRegister> _registers = [];
    private List<ReturnLineForm> _returnLines = [];
    private bool _loading = true;
    private bool _saving;
    private bool _hasTenant;
    private bool _moduleEnabled;
    private bool _dialogOpen;
    private bool _loadingPage;
    private bool _searchingSales;
    private bool _hasNextReturnPage;
    private int _returnPage = 1;
    private const int PageSize = 50;
    private string _returnSearch = "";
    private const string AllStatusesValue = "all";
    private string _returnStatusFilter = AllStatusesValue;
    private static readonly IReadOnlyList<SelectOption<string>> ReturnStatusOptions =
    [
        new(AllStatusesValue, "All statuses"),
        .. Enum.GetValues<PosReturnStatus>().Select(status => new SelectOption<string>(status.ToString(), status.ToString()))
    ];
    private string _saleSearch = "";
    private string? _selectedSaleId;
    private string _reason = "";
    private string _returnIdempotencyKey = NewReturnIdempotencyKey();
    private PosPaymentMethod _refundMethod = PosPaymentMethod.CashDrawer;
    private Guid? _selectedSaleCurrencyId;

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        ModuleNavigation.OnChanged += OnTenantChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        if (SaleId is Guid saleId)
        {
            _selectedSaleId = saleId.ToString();
            await LoadSaleLines(saleId);
            _dialogOpen = true;
        }
    }

    private void OnTenantChanged()
    {
        _returnPage = 1;
        _ = InvokeAsync(Reload);
    }

    private async Task Reload()
    {
        _loading = true;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _moduleEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Pos, "returns");
            _returns = [];
            _completedSales = [];
            _registers = [];
            _currencies = [];

            if (!_hasTenant || !_moduleEnabled || TenantFilter.SelectedTenantId is not Guid)
                return;

            await SearchCompletedSales();
            await LoadReturnPage();
        }
        catch
        {
            ToastService.Show("Could not load POS returns.");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadReturnPage()
    {
        _loadingPage = true;
        try
        {
            var response = await POS.SearchPosReturns(new SearchPosReturnsRequest
            {
                Metadata = BuildMetadata(),
                Search = string.IsNullOrWhiteSpace(_returnSearch) ? null : _returnSearch.Trim(),
                Status = Enum.TryParse<PosReturnStatus>(_returnStatusFilter, out var status) ? status : null,
                Page = _returnPage,
                PageSize = PageSize
            });
            _returns = response.Response ?? [];
            await LoadReferenceLabels();
            _hasNextReturnPage = response.IsSuccess && _returns.Count == PageSize;
            if (!response.IsSuccess)
                ToastService.Show(response.Message ?? "Could not load POS returns.");
        }
        finally
        {
            _loadingPage = false;
        }
    }

    private async Task SearchCompletedSales()
    {
        _searchingSales = true;
        try
        {
            var selected = _completedSales.FirstOrDefault(item => item.Id.ToString() == _selectedSaleId);
            var response = await POS.SearchPosSales(new SearchPosSalesRequest
            {
                Metadata = BuildMetadata(),
                Status = PosSaleStatus.Completed,
                Search = string.IsNullOrWhiteSpace(_saleSearch) ? null : _saleSearch.Trim(),
                Page = 1,
                PageSize = 100
            });
            _completedSales = response.Response ?? [];
            if (selected is not null && _completedSales.All(item => item.Id != selected.Id))
                _completedSales.Insert(0, selected);
            await LoadReferenceLabels();
            if (!response.IsSuccess)
                ToastService.Show(response.Message ?? "Could not load completed POS sales.");
        }
        finally
        {
            _searchingSales = false;
        }
    }

    private async Task SearchCompletedSalesFromPicker(string search)
    {
        _saleSearch = search;
        await SearchCompletedSales();
    }

    private async Task LoadReferenceLabels()
    {
        if (TenantFilter.SelectedTenantId is not Guid tenantId)
            return;

        var registerIds = _returns.Select(item => item.RegisterId)
            .Concat(_completedSales.Select(item => item.RegisterId))
            .Distinct()
            .ToList();
        _registers = await DataContext.Query<PosRegister>().IgnoreQueryFilters().NoCache()
            .Where(item => item.TenantId == tenantId && !item.IsDeleted && registerIds.Contains(item.Id))
            .ToListAsync();
        var currencyIds = _returns.Select(item => item.CurrencyId)
            .Concat(_completedSales.Select(item => item.CurrencyId))
            .Distinct()
            .ToList();
        _currencies = await DataContext.Query<Wallets.Domain.Shared.Contracts.CurrencyType>()
            .IgnoreQueryFilters().NoCache().Where(item => currencyIds.Contains(item.Id)).ToListAsync();
    }

    private async Task ApplyReturnFilters()
    {
        _returnPage = 1;
        await LoadReturnPage();
    }

    private async Task PreviousReturnPage()
    {
        if (_returnPage <= 1)
            return;
        _returnPage--;
        await LoadReturnPage();
    }

    private async Task NextReturnPage()
    {
        if (!_hasNextReturnPage)
            return;
        _returnPage++;
        await LoadReturnPage();
        if (_returns.Count == 0)
        {
            _returnPage--;
            await LoadReturnPage();
        }
    }

    private void OpenReturn(Guid returnId) => Navigation.NavigateTo($"/pos/returns/{returnId}");

    private async Task OpenReturnDialog()
    {
        _selectedSaleId = _completedSales.FirstOrDefault()?.Id.ToString();
        _reason = "";
        _returnIdempotencyKey = NewReturnIdempotencyKey();
        _returnLines = [];
        _selectedSaleCurrencyId = null;
        if (Guid.TryParse(_selectedSaleId, out var saleId))
            await LoadSaleLines(saleId);
        _dialogOpen = true;
    }

    private async Task OnSaleChanged(string? value)
    {
        _selectedSaleId = value;
        _returnIdempotencyKey = NewReturnIdempotencyKey();
        _returnLines = [];
        _selectedSaleCurrencyId = null;
        if (Guid.TryParse(value, out var saleId))
            await LoadSaleLines(saleId);
    }

    private async Task LoadSaleLines(Guid saleId)
    {
        if (TenantFilter.SelectedTenantId is not Guid tenantId)
            return;

        var response = await POS.GetPosSale(new GetPosSaleRequest
        {
            Metadata = BuildMetadata(),
            Id = saleId
        });

        if (!response.IsSuccess || response.Response is null)
        {
            ToastService.Show(response.Message ?? "Could not load sale lines.");
            return;
        }

        _refundMethod = response.Response.PaymentMethod;
        _selectedSaleCurrencyId = response.Response.CurrencyId;

        var saleReturns = new List<PosReturnSummaryResponse>();
        for (var page = 1; ; page++)
        {
            var priorReturnsResponse = await POS.SearchPosReturns(new SearchPosReturnsRequest
            {
                Metadata = BuildMetadata(),
                SaleId = saleId,
                Page = page,
                PageSize = 100
            });
            if (!priorReturnsResponse.IsSuccess)
            {
                ToastService.Show(priorReturnsResponse.Message ?? "Could not load prior returns.");
                return;
            }

            var pageItems = priorReturnsResponse.Response ?? [];
            saleReturns.AddRange(pageItems);
            if (pageItems.Count < 100)
                break;
        }

        var previousLines = new List<PosReturnLineResponse>();
        foreach (var existingReturn in saleReturns)
        {
            var returnResponse = await POS.GetPosReturn(new GetPosReturnRequest
            {
                Metadata = BuildMetadata(),
                Id = existingReturn.Id
            });

            if (!returnResponse.IsSuccess || returnResponse.Response is null)
            {
                ToastService.Show(returnResponse.Message ?? "Could not load prior return quantities.");
                return;
            }

            previousLines.AddRange(returnResponse.Response.Lines);
        }

        var previousBySaleLine = previousLines
            .GroupBy(line => line.SaleLineId)
            .ToDictionary(
                group => group.Key,
                group => new PreviousReturnAllocation(
                    group.Sum(line => line.Quantity),
                    group.Sum(line => line.RefundAmount)));
        var allocations = BuildSaleRefundAllocations(response.Response);

        _returnLines = response.Response.Lines.OrderBy(line => line.LineNumber).Select(line =>
        {
            previousBySaleLine.TryGetValue(line.Id, out var previous);
            return new ReturnLineForm
            {
                SaleLineId = line.Id,
                ProductName = string.IsNullOrWhiteSpace(line.VariantName) ? line.ProductName : $"{line.ProductName} - {line.VariantName}",
                PurchasedQuantity = line.Quantity,
                PreviouslyReturnedQuantity = previous.Quantity,
                PreviouslyReturnedRefundAmount = previous.RefundAmount,
                UnitPrice = line.UnitPrice,
                OriginalRefundAmount = allocations[line.Id].RefundAmount
            };
        }).ToList();
    }

    private void ChangeReturnQuantity(ReturnLineForm line, int delta)
    {
        line.ReturnQuantity = Math.Clamp(line.ReturnQuantity + delta, 0, line.RemainingQuantity);
    }

    private async Task CreateReturn()
    {
        if (!Guid.TryParse(_selectedSaleId, out var saleId))
        {
            ToastService.Show("Select an original sale.");
            return;
        }

        var cashierCredentialId = ActorContext.CredentialId ?? Guid.Empty;
        if (cashierCredentialId == Guid.Empty)
        {
            ToastService.Show("Cashier credential is missing from the current session.");
            return;
        }

        _saving = true;
        try
        {
            var response = await POS.CreatePosReturn(new CreatePosReturnRequest
            {
                Metadata = BuildMetadata(),
                SaleId = saleId,
                CashierCredentialId = cashierCredentialId,
                RefundMethod = _refundMethod,
                Reason = string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim(),
                IdempotencyKey = _returnIdempotencyKey,
                Lines = _returnLines
                    .Where(line => line.ReturnQuantity > 0)
                    .Select(line => new CreatePosReturnLineRequest
                    {
                        SaleLineId = line.SaleLineId,
                        Quantity = line.ReturnQuantity
                    })
                    .ToList()
            });

            if (response.IsSuccess)
            {
                ToastService.Show(response.Response?.Status == PosReturnStatus.Completed ? "Return completed." : "Return recorded with recovery status.");
                _dialogOpen = false;
                _returnIdempotencyKey = NewReturnIdempotencyKey();
                await Reload();
            }
            else
            {
                ToastService.Show(response.Message ?? "Could not create POS return.");
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private RequestMetadata BuildMetadata() => new()
    {
        RequestedTenantId = TenantFilter.SelectedTenantId,
        RequestId = Guid.NewGuid(),
        OperationName = "Portal"
    };

    private string GetSaleNumber(Guid saleId) => _completedSales.FirstOrDefault(item => item.Id == saleId)?.SaleNumber ?? saleId.ToString()[..8];
    private string GetRegisterName(Guid registerId) => _registers.FirstOrDefault(item => item.Id == registerId)?.Name ?? registerId.ToString()[..8];
    private static string GetSaleValue(PosSaleSummaryResponse item) => item.Id.ToString();
    private string GetSaleLabel(PosSaleSummaryResponse item) => $"{item.SaleNumber} - {FormatMoney(item.TotalAmount, item.CurrencyId)}";
    private string GetSaleSearchText(PosSaleSummaryResponse item) => $"{item.SaleNumber} {GetRegisterName(item.RegisterId)} {item.TotalAmount:N2} {item.CreatedAt:yyyy-MM-dd}";
    private string FormatMoney(decimal amount, Guid currencyId)
    {
        var code = _currencies.FirstOrDefault(item => item.Id == currencyId)?.CurrencyIsoCode3?.Trim().ToUpperInvariant();
        return code is { Length: 3 } && code.All(char.IsAsciiLetter) ? $"{code} {amount:N2}" : amount.ToString("N2");
    }
    private string FormatSelectedMoney(decimal amount) => _selectedSaleCurrencyId is { } currencyId
        ? FormatMoney(amount, currencyId)
        : amount.ToString("N2");
    private static string NewReturnIdempotencyKey() => $"Portal.POS.Return.{Guid.NewGuid():N}";
    private static string GetRefundMethodLabel(PosPaymentMethod method) => method switch
    {
        PosPaymentMethod.CashDrawer => "Cash Drawer",
        PosPaymentMethod.WalletTransfer => "Wallet Transfer",
        _ => method.ToString()
    };
    private static IReadOnlyDictionary<Guid, RefundAllocation> BuildSaleRefundAllocations(PosSaleReceiptResponse sale)
    {
        var orderedLines = sale.Lines.OrderBy(line => line.LineNumber).ToList();
        var grossSubtotal = orderedLines.Sum(line => line.Quantity * line.UnitPrice);
        var remainingHeaderDiscount = sale.DiscountAmount;
        var remainingHeaderTax = sale.TaxAmount;
        var allocations = new Dictionary<Guid, RefundAllocation>(orderedLines.Count);

        for (var index = 0; index < orderedLines.Count; index++)
        {
            var line = orderedLines[index];
            var isLast = index == orderedLines.Count - 1;
            var grossLineAmount = line.Quantity * line.UnitPrice;
            var headerDiscount = isLast
                ? remainingHeaderDiscount
                : AllocateProportion(sale.DiscountAmount, grossLineAmount, grossSubtotal);
            var headerTax = isLast
                ? remainingHeaderTax
                : AllocateProportion(sale.TaxAmount, grossLineAmount, grossSubtotal);

            remainingHeaderDiscount -= headerDiscount;
            remainingHeaderTax -= headerTax;
            allocations[line.Id] = new RefundAllocation(line.LineTotal - headerDiscount + headerTax);
        }

        return allocations;
    }

    private static decimal AllocateProportion(decimal amount, decimal lineAmount, decimal totalAmount) =>
        amount == 0 || totalAmount == 0
            ? 0
            : decimal.Round(amount * lineAmount / totalAmount, 2, MidpointRounding.AwayFromZero);

    private static string GetReturnStatusBadge(PosReturnStatus status) =>
        status switch
        {
            PosReturnStatus.Completed => "active",
            PosReturnStatus.Failed => "warning",
            _ => "pending"
        };

    private IReadOnlyList<XfEntityPickerColumn<PosSaleSummaryResponse>> SaleAdvancedColumns =>
    [
        new("Receipt", item => item.SaleNumber),
        new("Register", item => GetRegisterName(item.RegisterId)),
        new("Total", item => item.TotalAmount.ToString("N2")),
        new("Status", item => item.Status.ToString()),
        new("Created", item => item.CreatedAt.ToString("yyyy-MM-dd")),
        new("Completed", item => item.CompletedAt?.ToString("yyyy-MM-dd") ?? "-"),
        new("Sale", item => item.Id.ToString()[..8])
    ];

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantChanged;
        ModuleNavigation.OnChanged -= OnTenantChanged;
    }

    private sealed class ReturnLineForm
    {
        public Guid SaleLineId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal PurchasedQuantity { get; set; }
        public decimal PreviouslyReturnedQuantity { get; set; }
        public decimal PreviouslyReturnedRefundAmount { get; set; }
        public decimal ReturnQuantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal OriginalRefundAmount { get; set; }
        public decimal RemainingQuantity => PurchasedQuantity - PreviouslyReturnedQuantity;
        public decimal RefundAmount => ReturnQuantity == RemainingQuantity
            ? OriginalRefundAmount - PreviouslyReturnedRefundAmount
            : decimal.Round(OriginalRefundAmount * ReturnQuantity / PurchasedQuantity, 2, MidpointRounding.AwayFromZero);
    }

    private readonly record struct RefundAllocation(decimal RefundAmount);
    private readonly record struct PreviousReturnAllocation(decimal Quantity, decimal RefundAmount);
}
