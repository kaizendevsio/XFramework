@page "/pos/cashier"
@using XFramework.Domain.Shared.DataContext
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable

<PageTitle>POS Cashier - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_hasTenant)
{
    <ModuleUnavailable ModuleName="POS" RequiresTenant="true" />
}
else if (!_moduleEnabled)
{
    <ModuleUnavailable ModuleName="POS" />
}
else
{
    <FadeInContent Class="pos-cashier-content">
        <div class="pos-cashier-page" data-testid="pos-cashier" data-focus="@(_focusMode ? "true" : "false")">
            <div class="xf-page-header pos-cashier-header">
                <BbTypographyH3>Cashier</BbTypographyH3>
                <div class="pos-register-picker" data-testid="pos-register-picker">
                    <XfEntityPicker TItem="PosRegisterResponse"
                                    Value="@_selectedRegisterId"
                                    ValueChanged="RegisterChanged"
                                    Items="@_registers"
                                    Label="Register"
                                    Placeholder="Select register"
                                    SearchPlaceholder="Search registers..."
                                    EmptyMessage="No POS registers found."
                                    ValueSelector="@GetRegisterValue"
                                    TextSelector="@GetRegisterLabel"
                                    SearchTextSelector="@GetRegisterSearchText"
                                    SearchRequested="@SearchRegisterOptions"
                                    AdvancedColumns="@RegisterAdvancedColumns"
                                    AdvancedSearchScope="Searches register name, code, warehouse, location, and enabled state."
                                    AdvancedSearchTitle="Find register"
                                    AdvancedSearchDescription="Select the register for this sale."
                                    Disabled="@(_cart.Any() || IsInteractionLocked)" />
                </div>
                <div class="xf-page-actions pos-cashier-header-actions">
                    @if (_cartsEnabled)
                    {
                        <BbDialog Open="@_heldCartsOpen" OpenChanged="@(value => OnDialogOpenChanged(value, true))">
                            <BbDialogTrigger>
                                <BbButton Variant="ButtonVariant.Outline" Disabled="@IsInteractionLocked" data-pos-dialog-trigger="held-sales">
                                    <LucideIcon Name="clock" class="mr-2 h-4 w-4" />
                                    Held sales
                                    @if (_suspendedCarts.Count > 0)
                                    {
                                        <span class="pos-button-count">@_suspendedCarts.Count</span>
                                    }
                                </BbButton>
                            </BbDialogTrigger>
                            <BbDialogContent Class="xf-dialog-wide pos-held-carts-dialog"
                                             @onkeydown="@(args => HandleDialogKeyDown(args, true))">
                                <BbDialogHeader>
                                    <BbDialogTitle>Held sales</BbDialogTitle>
                                    <BbDialogDescription>@_suspendedCarts.Count held sales on page @_heldCartPage</BbDialogDescription>
                                </BbDialogHeader>
                                <div class="flex items-end gap-2">
                                    <BbFormFieldInput TValue="string" @bind-Value="_heldCartSearch" Label="Cart, customer, or note" />
                                    <BbButton OnClick="@SearchHeldCarts" Disabled="@_actingOnCart">
                                        <LucideIcon Name="search" class="mr-2 h-4 w-4" />Search
                                    </BbButton>
                                </div>
                                <BbDataView TItem="PosCartSummaryResponse" Data="@_suspendedCarts" Layout="DataViewLayout.List"
                                            ShowToolbar="false" ShowPagination="false"
                                            Class="pos-held-carts-view" ListClass="pos-held-carts-list">
                                    <Fields>
                                        <BbDataViewListTemplate TItem="PosCartSummaryResponse" Context="cart">
                                            <div class="pos-held-cart-row">
                                                <div class="pos-held-cart-main">
                                                    <strong>@cart.CartNumber</strong>
                                                    <span>@HeldCartCustomer(cart) | @FormatMoney(cart.TotalAmount)</span>
                                                    <small>Held @FormatDateTime(cart.SuspendedAt) | Expires @FormatDateTime(cart.ExpiresAt)</small>
                                                </div>
                                                <div class="pos-held-cart-actions">
                                                    <BbButton OnClick="@(() => ResumeCart(cart))" Disabled="@IsInteractionLocked">Resume sale</BbButton>
                                                    <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => CancelDraftCart(cart))" Disabled="@IsInteractionLocked">Cancel sale</BbButton>
                                                </div>
                                            </div>
                                        </BbDataViewListTemplate>
                                    </Fields>
                                    <EmptyTemplate>
                                        <BbEmpty Title="No held sales" Description="Sales you put on hold appear here." />
                                    </EmptyTemplate>
                                </BbDataView>
                                <div class="flex items-center justify-between">
                                    <BbTypographyMuted>Up to @HeldCartPageSize results per page</BbTypographyMuted>
                                    <div class="flex gap-2">
                                        <BbButton Variant="ButtonVariant.Outline" OnClick="@PreviousHeldCartPage" Disabled="@(_heldCartPage == 1 || _actingOnCart)">Previous</BbButton>
                                        <BbButton Variant="ButtonVariant.Outline" OnClick="@NextHeldCartPage" Disabled="@(!_hasNextHeldCartPage || _actingOnCart)">Next</BbButton>
                                    </div>
                                </div>
                            </BbDialogContent>
                        </BbDialog>
                    }
                    <BbDialog Open="@_saleDetailsOpen" OpenChanged="@(value => OnDialogOpenChanged(value, false))">
                        <BbDialogTrigger>
                            <BbButton Variant="ButtonVariant.Ghost" Disabled="@IsInteractionLocked" data-pos-dialog-trigger="sale-details">
                                <LucideIcon Name="clipboard-list" class="mr-2 h-4 w-4" />
                                Sale details
                            </BbButton>
                        </BbDialogTrigger>
                        <BbDialogContent Class="xf-dialog-wide"
                                         @onkeydown="@(args => HandleDialogKeyDown(args, false))">
                            <BbDialogHeader>
                                <BbDialogTitle>Sale details</BbDialogTitle>
                                <BbDialogDescription>Customer reference and notes for this sale.</BbDialogDescription>
                            </BbDialogHeader>
                            <div class="pos-dialog-fields">
                                <BbFormFieldInput @bind-Value="_customerLabel" Label="Customer reference" Placeholder="Name or queue number" Disabled="@IsInteractionLocked" />
                                <BbFormFieldTextarea @bind-Value="_cartNotes" Label="Sale notes" Placeholder="Optional note" Disabled="@IsInteractionLocked" />
                            </div>
                            <BbDialogFooter>
                                <BbDialogClose><BbButton>Done</BbButton></BbDialogClose>
                            </BbDialogFooter>
                        </BbDialogContent>
                    </BbDialog>
                    <BbButton Size="ButtonSize.IconLarge" Variant="ButtonVariant.Ghost" OnClick="@Reload"
                              Disabled="@(IsInteractionLocked || _searching)" aria-label="Refresh catalog" title="Refresh catalog">
                        <LucideIcon Name="refresh-cw" class="h-4 w-4" />
                    </BbButton>
                    <BbButton Size="ButtonSize.IconLarge" Variant="ButtonVariant.Ghost" OnClick="@(() => _focusMode = !_focusMode)"
                              aria-label="@(_focusMode ? "Exit cashier focus" : "Enter cashier focus")"
                              title="@(_focusMode ? "Exit cashier focus" : "Enter cashier focus")"
                              aria-pressed="@_focusMode">
                        <LucideIcon Name="@(_focusMode ? "minimize" : "maximize")" class="h-4 w-4" />
                    </BbButton>
                </div>
            </div>

            @if (_loadError is not null)
            {
                <BbAlert Variant="AlertVariant.Warning">
                    <BbAlertTitle>Cashier setup could not load</BbAlertTitle>
                    <BbAlertDescription>@_loadError</BbAlertDescription>
                </BbAlert>
            }

            <div class="pos-cashier-shell">
                <section class="pos-catalog-panel" aria-label="Product catalog" data-testid="pos-catalog" aria-busy="@_searching" data-search-query="@_lastCatalogSearch">
                    <div class="pos-catalog-toolbar">
                        <div class="pos-search-field">
                            <BbInput Id="pos-catalog-search"
                                     @bind-Value="_catalogSearch"
                                     UpdateTiming="UpdateTiming.Immediate"
                                     Placeholder="Search products or scan a SKU"
                                     aria-label="Search products"
                                     Class="pos-search-input"
                                     @onkeydown="@HandleCatalogKeyDown" />
                        </div>
                        <BbButton Size="ButtonSize.Large" OnClick="@(() => SearchCatalog())" Disabled="@IsInteractionLocked" Class="pos-search-button">
                            <LucideIcon Name="search" class="mr-2 h-5 w-5" />
                            Search
                        </BbButton>
                    </div>

                    <div class="pos-category-strip" aria-label="Catalog categories">
                        <BbButton Variant="@CategoryButtonVariant(null)" Class="pos-category-chip"
                                  aria-pressed="@(_selectedCategoryId is null)" OnClick="@(() => SelectCategory(null))">
                            All
                        </BbButton>
                        @foreach (var category in _categories)
                        {
                            <BbButton Variant="@CategoryButtonVariant(category.Id)" Class="pos-category-chip"
                                      aria-pressed="@(_selectedCategoryId == category.Id)" OnClick="@(() => SelectCategory(category.Id))">
                                @category.Name
                            </BbButton>
                        }
                    </div>

                    <div class="pos-catalog-scroll" data-testid="pos-catalog-scroll" tabindex="0" role="region" aria-label="Products">
                        @if (_catalogError is not null)
                        {
                            <BbAlert Variant="AlertVariant.Warning">
                                <BbAlertTitle>Catalog unavailable</BbAlertTitle>
                                <BbAlertDescription>@_catalogError</BbAlertDescription>
                                <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => SearchCatalog(false))">Retry search</BbButton>
                            </BbAlert>
                        }
                        else
                        {
                            <BbDataView TItem="PosCatalogItemResponse"
                                        Data="@_catalogItems"
                                        Layout="DataViewLayout.Grid"
                                        ShowToolbar="false"
                                        ShowPagination="@(_catalogItems.Count > 24)"
                                        InitialPageSize="24"
                                        GridColumnMinWidth="12rem"
                                        Class="pos-catalog-view"
                                        GridClass="pos-product-grid"
                                        IsLoading="@_searching">
                                <Fields>
                                    <BbDataViewGridTemplate TItem="PosCatalogItemResponse" Context="item">
                                        <BbButton Variant="ButtonVariant.Outline" Class="pos-product-tile"
                                                  data-testid="pos-product" aria-label="@($"Add {item.DisplayName}")"
                                                  OnClick="@(() => AddToCart(item))" Disabled="@(!item.IsAvailable || IsInteractionLocked)">
                                            <span class="pos-product-media">
                                                @if (!string.IsNullOrWhiteSpace(item.Image))
                                                {
                                                    <img src="@item.Image" alt="" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <LucideIcon Name="package" class="pos-product-icon" />
                                                }
                                            </span>
                                            <span class="pos-product-body">
                                                <span class="pos-product-name">@(string.IsNullOrWhiteSpace(item.ProductName) ? item.DisplayName : item.ProductName)</span>
                                                @if (!string.IsNullOrWhiteSpace(item.VariantName))
                                                {
                                                    <span class="pos-product-variant">@item.VariantName</span>
                                                }
                                                <span class="pos-product-meta">@item.SKU</span>
                                            </span>
                                            <span class="pos-product-footer">
                                                <span class="pos-product-price">@FormatMoney(item.Price)</span>
                                                <span class="@AvailabilityClass(item)">@AvailabilityText(item)</span>
                                            </span>
                                        </BbButton>
                                    </BbDataViewGridTemplate>
                                </Fields>
                                <LoadingTemplate>
                                    <div class="pos-catalog-empty"><BbSpinner /></div>
                                </LoadingTemplate>
                                <EmptyTemplate>
                                    <div data-testid="pos-catalog-empty">
                                    <BbEmpty Title="@(_lastCatalogSearch.Length > 0 ? "No matching products" : "No sellable products")"
                                             Description="@(_lastCatalogSearch.Length > 0 ? $"No products match \"{_lastCatalogSearch}\"." : "No products are available for this register and category.")" />
                                    </div>
                                </EmptyTemplate>
                            </BbDataView>
                        }
                    </div>
                </section>

                <aside class="pos-cart-panel" aria-label="Current sale">
                    <div class="pos-cart-title-row">
                        <div>
                            <h2>Cart</h2>
                            <span>@FormatQuantity(CartItemCount) items</span>
                        </div>
                        <div class="pos-cart-actions">
                            @if (_cartsEnabled)
                            {
                                <BbButton Variant="ButtonVariant.Outline" OnClick="@SuspendCart" Disabled="@(IsInteractionLocked || !_cart.Any())">
                                    <LucideIcon Name="pause" class="mr-2 h-4 w-4" />Hold sale
                                </BbButton>
                            }
                            <BbButton Size="ButtonSize.IconLarge" Variant="ButtonVariant.Ghost" OnClick="@ConfirmClearCurrentCart"
                                      Disabled="@(IsInteractionLocked || !_cart.Any())" aria-label="Clear cart" title="Clear cart">
                                <LucideIcon Name="trash-2" class="h-4 w-4" />
                            </BbButton>
                        </div>
                    </div>
                    <div class="pos-cart-scroll pos-cart-list" data-testid="pos-cart-scroll" tabindex="0" role="region" aria-label="Cart items">
                        @if (!string.IsNullOrWhiteSpace(_activeCartNumber))
                        {
                            <p class="pos-draft-label">Draft @_activeCartNumber</p>
                        }
                        @if (_lastReceipt is not null)
                        {
                            <div class="pos-receipt-panel" role="status" data-testid="pos-receipt">
                                <strong>Receipt @_lastReceipt.SaleNumber</strong>
                                <span>@_lastReceipt.Status | @FormatMoney(_lastReceipt.TotalAmount)</span>
                                @if (_lastReceipt.Payments.FirstOrDefault() is { CashTenderedAmount: { } tendered, ChangeAmount: { } change })
                                {
                                    <span data-testid="pos-receipt-cash">Cash received @FormatMoney(tendered) | Change @FormatMoney(change)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(_lastReceipt.FailureReason))
                                {
                                    <BbAlert Variant="AlertVariant.Warning">
                                        <BbAlertTitle>Recovery needed</BbAlertTitle>
                                        <BbAlertDescription>@_lastReceipt.FailureReason</BbAlertDescription>
                                    </BbAlert>
                                }
                                @if (HasPendingPayment)
                                {
                                    <BbButton Variant="ButtonVariant.Outline" OnClick="@ViewPendingSale">
                                        <LucideIcon Name="external-link" class="mr-2 h-4 w-4" />View pending sale
                                    </BbButton>
                                }
                                else
                                {
                                    <BbButton Variant="ButtonVariant.Outline" OnClick="@StartNewSale">
                                        <LucideIcon Name="plus" class="mr-2 h-4 w-4" />New sale
                                    </BbButton>
                                }
                            </div>
                        }
                        <BbDataView TItem="CartLine" Data="@_cart" Layout="DataViewLayout.List"
                                    ShowToolbar="false" ShowPagination="false" Class="pos-cart-view" ListClass="pos-cart-lines">
                            <Fields>
                                <BbDataViewListTemplate TItem="CartLine" Context="line">
                                    <div class="pos-cart-line" data-testid="pos-cart-line">
                                        <div class="pos-cart-line-main">
                                            <strong data-testid="pos-cart-item-name">@line.DisplayName</strong>
                                            <span>@FormatMoney(line.UnitPrice) each</span>
                                        </div>
                                        <BbButton Size="ButtonSize.IconLarge" Variant="ButtonVariant.Ghost"
                                                  Class="pos-cart-remove" OnClick="@(() => RemoveFromCart(line))"
                                                  Disabled="@IsInteractionLocked" aria-label="Remove item" title="@($"Remove {line.DisplayName}")">
                                            <LucideIcon Name="x" class="h-4 w-4" />
                                        </BbButton>
                                        <div class="pos-qty-stepper" aria-label="@($"Quantity for {line.DisplayName}")">
                                            <BbButton Size="ButtonSize.IconLarge" Variant="ButtonVariant.Outline"
                                                      OnClick="@(() => ChangeQuantity(line, -1))" Disabled="@(IsInteractionLocked || line.Quantity <= 1)"
                                                      aria-label="Decrease quantity" title="Decrease quantity">
                                                <LucideIcon Name="minus" class="h-4 w-4" />
                                            </BbButton>
                                            <span class="pos-qty-value">@FormatQuantity(line.Quantity)</span>
                                            <BbButton Size="ButtonSize.IconLarge" Variant="ButtonVariant.Outline"
                                                      OnClick="@(() => ChangeQuantity(line, 1))" Disabled="@IsInteractionLocked"
                                                      aria-label="Increase quantity" title="Increase quantity">
                                                <LucideIcon Name="plus" class="h-4 w-4" />
                                            </BbButton>
                                        </div>
                                        <div class="pos-cart-line-total">@FormatMoney(line.LineTotal)</div>
                                    </div>
                                </BbDataViewListTemplate>
                            </Fields>
                            <EmptyTemplate>
                                <BbEmpty Title="Cart is empty" Description="Add a product to start a sale." />
                            </EmptyTemplate>
                        </BbDataView>
                        @if (_removedLine is not null)
                        {
                            <div class="pos-undo-removal" role="status">
                                <span>Removed @_removedLine.DisplayName</span>
                                <BbButton Variant="ButtonVariant.Ghost" OnClick="@UndoRemoval" Disabled="@IsInteractionLocked">
                                    <LucideIcon Name="undo-2" class="mr-2 h-4 w-4" />Undo removal
                                </BbButton>
                            </div>
                        }
                    </div>

                    <div class="pos-checkout-panel">
                        <BbRadioGroup TValue="PosPaymentMethod" @bind-Value="_paymentMethod" Class="pos-payment-options">
                            <label class="pos-payment-option" for="pos-payment-cash">
                                <BbRadioGroupItem TValue="PosPaymentMethod" Value="@PosPaymentMethod.CashDrawer"
                                                  id="pos-payment-cash" Disabled="@IsInteractionLocked" />
                                <span>Cash</span>
                            </label>
                            <label class="pos-payment-option" for="pos-payment-wallet">
                                <BbRadioGroupItem TValue="PosPaymentMethod" Value="@PosPaymentMethod.WalletTransfer"
                                                  id="pos-payment-wallet" Disabled="@IsInteractionLocked" />
                                <span>Customer wallet</span>
                            </label>
                        </BbRadioGroup>

                        @if (IsWalletPayment)
                        {
                            <XfEntityPicker TItem="IdentityCredential" @bind-Value="_selectedCustomerCredentialId"
                                            Items="@_credentials" Label="Customer" Placeholder="Select customer"
                                            SearchPlaceholder="Search customers..." EmptyMessage="No customers found."
                                            ValueSelector="@GetCredentialValue" TextSelector="@GetCredentialLabel"
                                            SearchTextSelector="@GetCredentialSearchText" AdvancedColumns="@CredentialAdvancedColumns"
                                            SearchRequested="@SearchCredentialOptions"
                                            AdvancedSearchScope="Searches customer username, alias, and last seen date."
                                            AdvancedSearchTitle="Find customer" AdvancedSearchDescription="Select the customer paying for this sale."
                                            Disabled="@IsInteractionLocked" />
                        }

                        <BbCollapsible @bind-Open="_adjustmentsOpen" Class="pos-adjustments-section">
                            <BbCollapsibleTrigger>
                                <BbButton Variant="ButtonVariant.Ghost" Class="pos-adjustments-trigger" Disabled="@IsInteractionLocked">
                                    <span>Discount and tax</span><LucideIcon Name="@(_adjustmentsOpen ? "chevron-up" : "chevron-down")" class="h-4 w-4" />
                                </BbButton>
                            </BbCollapsibleTrigger>
                            <BbCollapsibleContent>
                                <div class="pos-adjustments">
                                    <BbField>
                                        <BbFieldLabel For="pos-discount-amount">Discount amount (@CurrencyCode)</BbFieldLabel>
                                        <BbCurrencyInput Id="pos-discount-amount" @bind-Value="_discountAmount" AriaLabel="@($"Discount amount ({CurrencyCode})")"
                                                         CurrencyCode="@CurrencyCode" ShowSymbol="false" Min="0" Disabled="@IsInteractionLocked" DisableDebounce="true" />
                                    </BbField>
                                    <BbField>
                                        <BbFieldLabel For="pos-tax-amount">Tax amount (@CurrencyCode)</BbFieldLabel>
                                        <BbCurrencyInput Id="pos-tax-amount" @bind-Value="_taxAmount" AriaLabel="@($"Tax amount ({CurrencyCode})")"
                                                         CurrencyCode="@CurrencyCode" ShowSymbol="false" Min="0" Disabled="@IsInteractionLocked" DisableDebounce="true" />
                                    </BbField>
                                </div>
                            </BbCollapsibleContent>
                        </BbCollapsible>

                        @if (IsCashPayment)
                        {
                            <div class="pos-cash-panel">
                                <div data-testid="pos-cash-received">
                                    <BbField>
                                        <BbFieldLabel For="pos-cash-amount">Cash received</BbFieldLabel>
                                        <BbCurrencyInput Id="pos-cash-amount" @bind-Value="_cashTenderedAmount" AriaLabel="Cash received"
                                                         CurrencyCode="@CurrencyCode" ShowSymbol="false" Min="0" Disabled="@IsInteractionLocked" DisableDebounce="true" />
                                    </BbField>
                                </div>
                                <div class="pos-change-due">
                                    <span>Change (@CurrencyCode)</span>
                                    <strong data-testid="pos-change">@ChangeDue.ToString("N2")</strong>
                                </div>
                            </div>
                            <div class="pos-cash-quick-actions" aria-label="Cash amounts">
                                <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _cashTenderedAmount = Total)"
                                          Disabled="@(IsInteractionLocked || !_cart.Any() || Total <= 0)">Exact amount</BbButton>
                                @foreach (var amount in SuggestedTenderAmounts)
                                {
                                    <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _cashTenderedAmount = amount)"
                                              data-testid="pos-cash-preset" Disabled="@(IsInteractionLocked || !_cart.Any() || Total <= 0)">@FormatMoney(amount)</BbButton>
                                }
                            </div>
                        }
                    </div>

                    <div class="pos-total-bar">
                        @if (_discountAmount != 0 || _taxAmount != 0)
                        {
                            <div class="pos-total-lines">
                                <div><span>Subtotal</span><strong data-testid="pos-subtotal">@FormatMoney(Subtotal)</strong></div>
                                <div><span>Discount</span><strong data-testid="pos-discount">-@FormatMoney(_discountAmount)</strong></div>
                                <div><span>Tax</span><strong data-testid="pos-tax">@FormatMoney(_taxAmount)</strong></div>
                            </div>
                        }
                        <div class="pos-grand-total">
                            <span>Total (@CurrencyCode)</span>
                            <strong data-testid="pos-total">@Total.ToString("N2")</strong>
                        </div>
                        <p id="pos-checkout-status" class="pos-checkout-status" role="status">@CheckoutStatus</p>
                        <BbButton Size="ButtonSize.Large" OnClick="@Checkout" Disabled="@(!CanCheckout)" Class="pos-checkout-action"
                                  data-testid="pos-checkout" aria-describedby="pos-checkout-status">
                            @if (_checkingOut)
                            {
                                <BbSpinner />
                            }
                            else
                            {
                                <LucideIcon Name="receipt" class="mr-2 h-5 w-5" />
                            }
                            @(_checkingOut ? "Processing payment" : HasPendingPayment ? "Retry payment" : $"Pay {FormatMoney(Total)}")
                        </BbButton>
                    </div>
                </aside>
            </div>
        </div>
    </FadeInContent>

}

@code {
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private IPOSServiceWrapper POS { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private IPortalModuleAvailability ModuleNavigation { get; set; } = default!;
    [Inject] private RequestMetadata RequestMetadata { get; set; } = default!;
    [Inject] private IPortalActorContext ActorContext { get; set; } = default!;
    [Inject] private DialogService DialogService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Inject] private ILogger<Cashier> Logger { get; set; } = default!;

    private List<CartLine> _cart = [];
    private List<PosRegisterResponse> _registers = [];
    private List<IdentityCredential> _credentials = [];
    private List<ProductCategory> _categories = [];
    private List<Wallets.Domain.Shared.Contracts.CurrencyType> _currencies = [];
    private List<PosCatalogItemResponse> _catalogItems = [];
    private List<PosCartSummaryResponse> _suspendedCarts = [];
    private bool _loading = true;
    private bool _hasTenant;
    private bool _moduleEnabled;
    private bool _cartsEnabled;
    private bool _searching;
    private bool _checkingOut;
    private bool _savingCart;
    private bool _actingOnCart;
    private bool _hasNextHeldCartPage;
    private bool _heldCartsOpen;
    private bool _saleDetailsOpen;
    private bool _focusMode;
    private bool _adjustmentsOpen;
    private bool _reloading;
    private bool _reloadRequested;
    private bool _disposed;
    private bool _focusPending;
    private string? _dialogFocusTarget;
    private int _searchVersion;
    private int _heldCartPage = 1;
    private Guid? _loadedTenantId;
    private string? _loadError;
    private string? _catalogError;
    private string _lastCatalogSearch = "";
    private Task<IJSObjectReference>? _scriptTask;
    private CartLine? _removedLine;
    private int _removedLineIndex;
    private string _catalogSearch = "";
    private string _heldCartSearch = "";
    private string? _selectedRegisterId;
    private string? _selectedCustomerCredentialId;
    private string _customerLabel = "";
    private string _cartNotes = "";
    private Guid? _selectedCategoryId;
    private Guid? _activeCartId;
    private Guid? _activeCartConcurrencyStamp;
    private string? _activeCartNumber;
    private string _activeSaleIdempotencyKey = NewSaleIdempotencyKey();
    private string _activeCartCreateIdempotencyKey = NewCartIdempotencyKey();
    private decimal _discountAmount;
    private decimal _taxAmount;
    private decimal _cashTenderedAmount;
    private PosPaymentMethod _paymentMethod = PosPaymentMethod.CashDrawer;
    private PosSaleReceiptResponse? _lastReceipt;
    private const int HeldCartPageSize = 25;

    private decimal Subtotal => _cart.Sum(line => line.LineTotal);
    private decimal Total => Subtotal - _discountAmount + _taxAmount;
    private decimal ChangeDue => _cart.Count == 0 ? 0 : Math.Max(0, _cashTenderedAmount - Total);
    private decimal CartItemCount => _cart.Sum(line => line.Quantity);
    private bool IsCashPayment => _paymentMethod == PosPaymentMethod.CashDrawer;
    private bool IsWalletPayment => _paymentMethod == PosPaymentMethod.WalletTransfer;
    private bool IsMerchantCustomer =>
        IsWalletPayment &&
        Guid.TryParse(_selectedCustomerCredentialId, out var customerCredentialId) &&
        customerCredentialId == SelectedRegister?.MerchantCredentialId;
    private bool IsBusy => _checkingOut || _savingCart || _actingOnCart;
    private bool HasPendingPayment => _lastReceipt?.Status == PosSaleStatus.PaymentPending;
    private bool IsInteractionLocked => IsBusy || HasPendingPayment;
    private PosRegisterResponse? SelectedRegister => _registers.FirstOrDefault(item => item.Id.ToString() == _selectedRegisterId);
    private string? RegisterCurrency
    {
        get
        {
            var code = _currencies.FirstOrDefault(item => item.Id == SelectedRegister?.CurrencyId)?.CurrencyIsoCode3?.Trim().ToUpperInvariant();
            return code is { Length: 3 } && code.All(char.IsAsciiLetter) ? code : null;
        }
    }
    private string CurrencyCode => RegisterCurrency ?? "XXX";
    private string FormatMoney(decimal value) => $"{CurrencyCode} {value:N2}";
    private IEnumerable<decimal> SuggestedTenderAmounts => new[] { 5m, 10m, 50m }
        .Select(step => Math.Ceiling(Math.Max(Total, 0.01m) / step) * step)
        .Where(amount => amount > Total).Distinct().Take(2);
    private string? CheckoutRequirement =>
        _loadError is not null ? "Refresh to finish loading the register." :
        SelectedRegister is null ? "Select a register to start a sale." :
        RegisterCurrency is null ? "The register currency could not be loaded. Refresh to retry." :
        ActorContext.CredentialId is null || ActorContext.CredentialId == Guid.Empty ? "Sign in again to identify the cashier." :
        !_cart.Any() ? "Add a product to start a sale." :
        Total <= 0 || _discountAmount < 0 || _taxAmount < 0 ? "Discount and tax must be valid amounts; the sale total must be greater than zero." :
        IsCashPayment && _cashTenderedAmount < Total ? $"Enter cash received. {FormatMoney(Total - _cashTenderedAmount)} remaining." :
        IsWalletPayment && !Guid.TryParse(_selectedCustomerCredentialId, out _) ? "Select a customer to pay from their wallet." :
        IsMerchantCustomer ? "Customer wallet must be different from the register merchant wallet." : null;
    private string CheckoutStatus => IsBusy
        ? "Please wait for the current sale action."
        : HasPendingPayment
            ? "Payment result is unknown. Retry to reuse the original payment reference."
            : CheckoutRequirement ?? "Ready for payment";
    private bool CanCheckout => !IsBusy && (HasPendingPayment || CheckoutRequirement is null);

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        ModuleNavigation.OnChanged += OnTenantChanged;
    }

    protected override async Task OnInitializedAsync() => await Reload();

    private void OnTenantChanged()
    {
        if (_disposed)
            return;
        if (_reloading)
        {
            _reloadRequested = true;
            return;
        }
        _ = InvokeAsync(Reload);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dialogFocusTarget is { } target)
        {
            _dialogFocusTarget = null;
            await RestoreDialogFocusAsync(target);
        }
        if (!_loading && _hasTenant && _moduleEnabled && _focusPending)
        {
            _focusPending = false;
            await FocusCatalogSearchAsync();
        }
    }

    private async Task Reload()
    {
        if (_disposed || _reloading || IsInteractionLocked)
            return;
        _reloading = true;
        _loading = true;
        _loadError = null;
        _searchVersion++;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            if (_loadedTenantId != TenantFilter.SelectedTenantId)
            {
                ClearCurrentCart();
                _lastReceipt = null;
                _selectedRegisterId = null;
                _selectedCategoryId = null;
                _catalogSearch = "";
                _catalogItems = [];
                _heldCartSearch = "";
                _heldCartPage = 1;
                _loadedTenantId = TenantFilter.SelectedTenantId;
            }
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _moduleEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Pos, "sales");
            _cartsEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Pos, "carts");
            _registers = [];
            _credentials = [];
            _categories = [];
            _currencies = [];
            _suspendedCarts = [];

            if (_hasTenant && _moduleEnabled && TenantFilter.SelectedTenantId is Guid tenantId)
            {
                await SearchRegisterOptions("");
                await SearchCredentialOptions("");

                _categories = await DataContext.Query<ProductCategory>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(item => item.TenantId == tenantId && !item.IsDeleted)
                    .OrderBy(item => item.Name)
                    .Take(80)
                    .ToListAsync();

                if (SelectedRegister is null)
                    _selectedRegisterId = _registers.FirstOrDefault()?.Id.ToString();
                if (_cartsEnabled)
                    await LoadSuspendedCarts();
                await SearchCatalog(false, false);
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load POS cashier data.");
            _loadError = "Refresh to retry loading this register and its products.";
        }
        finally
        {
            _loading = false;
            _reloading = false;
            _focusPending = true;
            if (!_disposed)
                StateHasChanged();
        }
        if (_reloadRequested && !_disposed)
        {
            _reloadRequested = false;
            await Reload();
        }
    }

    private async Task RegisterChanged(string? value)
    {
        if (IsInteractionLocked || _cart.Any())
            return;
        _selectedRegisterId = value;
        _lastReceipt = null;
        _removedLine = null;
        _cashTenderedAmount = 0;
        await SearchCatalog(false);
    }

    private async Task SearchRegisterOptions(string search)
    {
        if (TenantFilter.SelectedTenantId is not Guid tenantId)
            return;

        var selected = SelectedRegister;
        var response = await POS.SearchPosRegisters(new SearchPosRegistersRequest
        {
            Metadata = BuildMetadata(),
            Search = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
            IsEnabled = true,
            Page = 1,
            PageSize = 50
        });
        _registers = response.Response ?? [];
        if (selected is not null && _registers.All(item => item.Id != selected.Id))
            _registers.Insert(0, selected);
        var currencyIds = _registers.Select(item => item.CurrencyId).Distinct().ToList();
        _currencies = await DataContext.Query<Wallets.Domain.Shared.Contracts.CurrencyType>()
            .IgnoreQueryFilters().NoCache()
            .Where(item => !item.IsDeleted && currencyIds.Contains(item.Id) &&
                (item.TenantId == tenantId || item.TenantId == Guid.Empty))
            .OrderBy(item => item.CurrencyIsoCode3)
            .ToListAsync();
        if (!response.IsSuccess)
            ToastService.Show(response.Message ?? "Could not search POS registers.");
    }

    private async Task SearchCredentialOptions(string search)
    {
        if (TenantFilter.SelectedTenantId is not Guid tenantId)
            return;

        var selected = _credentials.FirstOrDefault(item => item.Id.ToString() == _selectedCustomerCredentialId);
        var query = DataContext.Query<IdentityCredential>().IgnoreQueryFilters().NoCache()
            .Where(item => item.TenantId == tenantId && !item.IsDeleted && item.IsEnabled);
        if (!string.IsNullOrWhiteSpace(search))
        {
            var term = search.Trim();
            query = query.Where(item => item.UserName.Contains(term) ||
                (item.UserAlias != null && item.UserAlias.Contains(term)));
        }

        _credentials = await query.OrderBy(item => item.UserName).Take(50).ToListAsync();
        if (selected is not null && _credentials.All(item => item.Id != selected.Id))
            _credentials.Insert(0, selected);
    }

    private async Task LoadSuspendedCarts()
    {
        if (!_cartsEnabled)
        {
            _suspendedCarts = [];
            return;
        }

        var response = await POS.SearchPosCarts(new SearchPosCartsRequest
        {
            Metadata = BuildMetadata(),
            Status = PosCartStatus.Suspended,
            Search = string.IsNullOrWhiteSpace(_heldCartSearch) ? null : _heldCartSearch.Trim(),
            Page = _heldCartPage,
            PageSize = HeldCartPageSize
        });

        _suspendedCarts = response.Response ?? [];
        _hasNextHeldCartPage = response.IsSuccess && _suspendedCarts.Count == HeldCartPageSize;
        if (!response.IsSuccess)
            ToastService.Show(response.Message ?? "Could not load held sales.");
    }

    private async Task SearchHeldCarts()
    {
        _heldCartPage = 1;
        await LoadSuspendedCarts();
    }

    private async Task PreviousHeldCartPage()
    {
        if (_heldCartPage <= 1)
            return;

        _heldCartPage--;
        await LoadSuspendedCarts();
    }

    private async Task NextHeldCartPage()
    {
        if (!_hasNextHeldCartPage)
            return;

        _heldCartPage++;
        await LoadSuspendedCarts();
        if (_suspendedCarts.Count == 0)
        {
            _heldCartPage--;
            await LoadSuspendedCarts();
        }
    }

    private async Task SearchCatalog(bool addExactSkuToCart = true, bool readCurrentInput = true)
    {
        if (_disposed || IsInteractionLocked || !_moduleEnabled || TenantFilter.SelectedTenantId is not Guid tenantId)
            return;

        var version = ++_searchVersion;
        _searching = true;
        _catalogError = null;
        try
        {
            // A scanner can send Enter before Blueprint's batched value callback reaches the server.
            if (readCurrentInput)
            {
                var script = await GetScriptAsync();
                _catalogSearch = await script.InvokeAsync<string>("readSearchValue");
            }
            var searchText = (_catalogSearch ?? "").Trim();
            var response = await POS.SearchPosCatalog(new SearchPosCatalogRequest
            {
                Metadata = BuildMetadata(),
                Search = searchText,
                CategoryId = _selectedCategoryId,
                RegisterId = TryResolveSelectedRegisterId(),
                Page = 1,
                PageSize = 50
            });

            if (_disposed || version != _searchVersion || tenantId != TenantFilter.SelectedTenantId)
                return;

            _lastCatalogSearch = searchText;
            if (!response.IsSuccess)
            {
                _catalogItems = [];
                _catalogError = "Products could not be loaded. Retry your search.";
                return;
            }
            _catalogItems = response.Response ?? [];

            if (addExactSkuToCart && !string.IsNullOrWhiteSpace(searchText))
                AddExactSkuMatchToCart(searchText);
        }
        catch (Exception exception)
        {
            if (!_disposed && version == _searchVersion)
            {
                Logger.LogError(exception, "POS catalog search failed.");
                _catalogItems = [];
                _catalogError = "Products could not be loaded. Retry your search.";
            }
        }
        finally
        {
            if (!_disposed && version == _searchVersion)
            {
                _searching = false;
                if (!_loading)
                    await FocusCatalogSearchAsync();
            }
        }
    }

    private async Task SelectCategory(Guid? categoryId)
    {
        if (_selectedCategoryId == categoryId)
            return;

        _selectedCategoryId = categoryId;
        await SearchCatalog(false);
    }

    private async Task HandleCatalogKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SearchCatalog();
    }

    private void AddExactSkuMatchToCart(string searchText)
    {
        var matches = _catalogItems
            .Where(item => item.IsAvailable && string.Equals(item.SKU, searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (matches.Count != 1)
            return;

        AddToCart(matches[0]);
        _catalogSearch = "";
        ToastService.Show("Item added to cart.");
    }

    private void AddToCart(PosCatalogItemResponse item)
    {
        if (IsInteractionLocked || !item.IsAvailable)
            return;
        _lastReceipt = null;
        var existing = _cart.FirstOrDefault(line =>
            line.ProductId == item.ProductId &&
            line.ProductVariationId == item.ProductVariationId);
        if (existing is not null)
        {
            SetQuantity(existing, existing.Quantity + 1);
            _cart = [.. _cart];
            _ = InvokeAsync(FocusCatalogSearchAsync);
            return;
        }

        _cart =
        [
            .. _cart,
            new CartLine
            {
                ProductId = item.ProductId,
                ProductVariationId = item.ProductVariationId,
                DisplayName = item.DisplayName,
                UnitPrice = item.Price,
                Quantity = 1
            }
        ];
        _ = InvokeAsync(FocusCatalogSearchAsync);
    }

    private void ChangeQuantity(CartLine line, decimal delta)
    {
        if (IsInteractionLocked)
            return;
        SetQuantity(line, line.Quantity + delta);
        _cart = [.. _cart];
    }

    private static void SetQuantity(CartLine line, decimal quantity)
    {
        line.Quantity = Math.Max(1, quantity);
    }

    private void RemoveFromCart(CartLine line)
    {
        if (IsInteractionLocked)
            return;
        _lastReceipt = null;
        _removedLine = line;
        _removedLineIndex = _cart.IndexOf(line);
        _cart = _cart.Where(item => !ReferenceEquals(item, line)).ToList();
    }

    private void UndoRemoval()
    {
        if (_removedLine is null || IsInteractionLocked)
            return;
        var existing = _cart.FirstOrDefault(line => line.ProductId == _removedLine.ProductId &&
            line.ProductVariationId == _removedLine.ProductVariationId);
        if (existing is not null)
            existing.Quantity += _removedLine.Quantity;
        else
            _cart.Insert(Math.Clamp(_removedLineIndex, 0, _cart.Count), _removedLine);
        _cart = [.. _cart];
        _removedLine = null;
    }

    private async Task SuspendCart()
    {
        if (IsInteractionLocked)
            return;
        if (!_cartsEnabled)
        {
            ToastService.Show("POS carts feature is not enabled.");
            return;
        }

        if (!TryResolveRegister(out var registerId) || !TryResolveCashier(out var cashierCredentialId))
            return;

        if (!_cart.Any())
        {
            ToastService.Show("Add at least one item before holding the sale.");
            return;
        }

        _savingCart = true;
        try
        {
            if (_activeCartId.HasValue)
            {
                var savedCart = await SaveActiveCart();
                if (savedCart is null)
                    return;

                var suspendResponse = await POS.SuspendPosCart(new SuspendPosCartRequest
                {
                    Metadata = BuildMetadata(),
                    CartId = savedCart.Id,
                    ExpectedConcurrencyStamp = savedCart.ConcurrencyStamp
                });

                if (!suspendResponse.IsSuccess)
                {
                    ToastService.Show(suspendResponse.Message ?? "Could not hold sale.");
                    return;
                }
            }
            else
            {
                var createResponse = await POS.CreatePosCart(new CreatePosCartRequest
                {
                    Metadata = BuildMetadata(),
                    RegisterId = registerId,
                    CashierCredentialId = cashierCredentialId,
                    CustomerCredentialId = TryResolveSelectedCustomer(),
                    CustomerLabel = _customerLabel,
                    Notes = _cartNotes,
                    DiscountAmount = _discountAmount,
                    TaxAmount = _taxAmount,
                    Suspend = true,
                    IdempotencyKey = _activeCartCreateIdempotencyKey,
                    Lines = BuildCartLineRequests()
                });

                if (!createResponse.IsSuccess)
                {
                    ToastService.Show(createResponse.Message ?? "Could not hold sale.");
                    return;
                }
            }

            ToastService.Show("Sale held.");
            ClearCurrentCart();
            await LoadSuspendedCarts();
            _heldCartsOpen = true;
        }
        finally
        {
            _savingCart = false;
        }
    }

    private async Task ResumeCart(PosCartSummaryResponse cart)
    {
        if (IsInteractionLocked)
            return;
        if (!_cartsEnabled)
        {
            ToastService.Show("POS carts feature is not enabled.");
            return;
        }

        if (_cart.Any() && _activeCartId != cart.Id)
        {
            ToastService.Show("Hold or clear the current sale before resuming another sale.");
            return;
        }

        _actingOnCart = true;
        try
        {
            var response = await POS.ResumePosCart(new ResumePosCartRequest
            {
                Metadata = BuildMetadata(),
                CartId = cart.Id,
                ExpectedConcurrencyStamp = cart.ConcurrencyStamp
            });

            if (!response.IsSuccess || response.Response is null)
            {
                ToastService.Show(response.Message ?? "Could not resume cart.");
                return;
            }

            ApplyCart(response.Response);
            _heldCartsOpen = false;
            if (response.Response.Warnings.Count > 0)
                ToastService.Show(response.Response.Warnings[0]);
            else
                ToastService.Show("Cart resumed.");

            await LoadSuspendedCarts();
        }
        finally
        {
            _actingOnCart = false;
        }
    }

    private async Task CancelDraftCart(PosCartSummaryResponse cart)
    {
        if (IsInteractionLocked)
            return;

        if (!_cartsEnabled)
        {
            ToastService.Show("POS carts feature is not enabled.");
            return;
        }

        if (!await DialogService.Confirm(
                "Cancel held sale",
                $"Cancel held sale {cart.CartNumber} and remove it from the queue?",
                new ConfirmDialogOptions { Destructive = true }))
        {
            return;
        }

        _actingOnCart = true;
        try
        {
            var response = await POS.CancelPosCart(new CancelPosCartRequest
            {
                Metadata = BuildMetadata(),
                CartId = cart.Id,
                ExpectedConcurrencyStamp = cart.ConcurrencyStamp,
                Reason = "Cancelled from Portal"
            });

            ToastService.Show(response.IsSuccess ? "Draft cart cancelled." : response.Message ?? "Could not cancel draft cart.");
            if (_activeCartId == cart.Id)
                ClearCurrentCart();

            await LoadSuspendedCarts();
        }
        finally
        {
            _actingOnCart = false;
        }
    }

    private async Task<PosCartResponse?> SaveActiveCart()
    {
        if (!_activeCartId.HasValue)
            return null;

        var response = await POS.UpdatePosCart(new UpdatePosCartRequest
        {
            Metadata = BuildMetadata(),
            Id = _activeCartId.Value,
            CustomerCredentialId = TryResolveSelectedCustomer(),
            CustomerLabel = _customerLabel,
            Notes = _cartNotes,
            DiscountAmount = _discountAmount,
            TaxAmount = _taxAmount,
            ExpectedConcurrencyStamp = _activeCartConcurrencyStamp,
            Lines = BuildCartLineRequests()
        });

        if (!response.IsSuccess || response.Response is null)
        {
            ToastService.Show(response.Message ?? "Could not save draft cart.");
            return null;
        }

        _activeCartConcurrencyStamp = response.Response.ConcurrencyStamp;
        _activeCartNumber = response.Response.CartNumber;
        return response.Response;
    }

    private async Task Checkout()
    {
        if (!CanCheckout)
            return;

        if (HasPendingPayment)
        {
            await RetryPendingPayment();
            return;
        }

        if (!TryResolveRegister(out var registerId) || !TryResolveCashier(out var cashierCredentialId))
            return;

        if (_activeCartId.HasValue && !_cartsEnabled)
        {
            ToastService.Show("POS carts feature is not enabled.");
            return;
        }

        if (Total <= 0)
        {
            ToastService.Show("POS sale total must be greater than zero.");
            return;
        }

        if (IsCashPayment && _cashTenderedAmount < Total)
        {
            ToastService.Show("Cash tendered must cover the sale total.");
            return;
        }

        Guid? customerCredentialId = null;
        if (IsWalletPayment)
        {
            if (!Guid.TryParse(_selectedCustomerCredentialId, out var parsedCustomer))
            {
                ToastService.Show("Select a customer.");
                return;
            }

            customerCredentialId = parsedCustomer;
        }

        _checkingOut = true;
        try
        {
            if (_activeCartId.HasValue)
            {
                var savedCart = await SaveActiveCart();
                if (savedCart is null)
                    return;

                var cartResponse = await POS.CheckoutPosCart(new CheckoutPosCartRequest
                {
                    Metadata = BuildMetadata(),
                    CartId = savedCart.Id,
                    ExpectedConcurrencyStamp = savedCart.ConcurrencyStamp,
                    IdempotencyKey = $"Portal.POS.CartCheckout.{savedCart.Id:N}",
                    Payment = new CheckoutPosPaymentRequest
                    {
                        Method = _paymentMethod,
                        Amount = Total,
                        CustomerCredentialId = customerCredentialId,
                        CashTenderedAmount = IsCashPayment ? _cashTenderedAmount : null
                    }
                });

                _lastReceipt = cartResponse.Response;
                if (cartResponse.IsSuccess)
                {
                    ToastService.Show(_lastReceipt?.Status == PosSaleStatus.Completed ? "Sale completed." : "Sale recorded with recovery status.");
                    if (_lastReceipt?.Status == PosSaleStatus.Completed)
                    {
                        ClearCurrentCart();
                        await LoadSuspendedCarts();
                    }
                }
                else
                {
                    ToastService.Show(cartResponse.Message ?? "Checkout failed.");
                }

                return;
            }

            var response = await POS.CheckoutPosSale(new CheckoutPosSaleRequest
            {
                Metadata = BuildMetadata(),
                RegisterId = registerId,
                CashierCredentialId = cashierCredentialId,
                CustomerCredentialId = customerCredentialId,
                DiscountAmount = _discountAmount,
                TaxAmount = _taxAmount,
                IdempotencyKey = _activeSaleIdempotencyKey,
                Lines = _cart.Select(line => new CheckoutPosSaleLineRequest
                {
                    ProductId = line.ProductId,
                    ProductVariationId = line.ProductVariationId,
                    Quantity = line.Quantity,
                    ExpectedUnitPrice = line.UnitPrice
                }).ToList(),
                Payment = new CheckoutPosPaymentRequest
                {
                    Method = _paymentMethod,
                    Amount = Total,
                    CustomerCredentialId = customerCredentialId,
                    CashTenderedAmount = IsCashPayment ? _cashTenderedAmount : null
                }
            });

            _lastReceipt = response.Response;
            if (response.IsSuccess)
            {
                ToastService.Show(_lastReceipt?.Status == PosSaleStatus.Completed ? "Sale completed." : "Sale recorded with recovery status.");
                if (_lastReceipt?.Status == PosSaleStatus.Completed)
                    ClearCurrentCart();
            }
            else
                ToastService.Show(response.Message ?? "Checkout failed.");
        }
        finally
        {
            _checkingOut = false;
        }
    }

    private async Task RetryPendingPayment()
    {
        if (_lastReceipt is not { Status: PosSaleStatus.PaymentPending } pendingSale)
            return;

        _checkingOut = true;
        try
        {
            var response = await POS.RetryPosSalePayment(new RetryPosSalePaymentRequest
            {
                Metadata = BuildMetadata(),
                SaleId = pendingSale.Id
            });

            if (response.Response is not null)
                _lastReceipt = response.Response;

            if (!response.IsSuccess)
            {
                ToastService.Show(response.Message ?? "Payment retry failed.");
                return;
            }

            ToastService.Show(_lastReceipt?.Status == PosSaleStatus.Completed
                ? "Sale completed."
                : "Payment remains pending; retry again after checking the payment provider.");

            if (_lastReceipt?.Status == PosSaleStatus.Completed)
            {
                ClearCurrentCart();
                if (_cartsEnabled)
                    await LoadSuspendedCarts();
            }
        }
        finally
        {
            _checkingOut = false;
        }
    }

    private List<PosCartLineRequest> BuildCartLineRequests() =>
        _cart.Select(line => new PosCartLineRequest
        {
            ProductId = line.ProductId,
            ProductVariationId = line.ProductVariationId,
            Quantity = line.Quantity,
            ExpectedUnitPrice = line.UnitPrice
        }).ToList();

    private void ApplyCart(PosCartResponse cart)
    {
        _lastReceipt = null;
        _removedLine = null;
        _activeCartId = cart.Id;
        _activeCartConcurrencyStamp = cart.ConcurrencyStamp;
        _activeCartNumber = cart.CartNumber;
        _selectedRegisterId = cart.RegisterId.ToString();
        _selectedCustomerCredentialId = cart.CustomerCredentialId?.ToString();
        _customerLabel = cart.CustomerLabel ?? "";
        _cartNotes = cart.Notes ?? "";
        _discountAmount = cart.DiscountAmount;
        _taxAmount = cart.TaxAmount;
        _adjustmentsOpen = _discountAmount != 0 || _taxAmount != 0;
        _cashTenderedAmount = 0;

        _cart = cart.Lines
            .OrderBy(item => item.LineNumber)
            .Select(line => new CartLine
            {
                ProductId = line.ProductId,
                ProductVariationId = line.ProductVariationId,
                DisplayName = string.IsNullOrWhiteSpace(line.VariantName)
                    ? line.ProductName
                    : $"{line.ProductName} - {line.VariantName}",
                UnitPrice = line.ExpectedUnitPrice,
                Quantity = line.Quantity
            })
            .ToList();
    }

    private void ClearCurrentCart()
    {
        _cart = [];
        _removedLine = null;
        _adjustmentsOpen = false;
        _activeCartId = null;
        _activeCartConcurrencyStamp = null;
        _activeCartNumber = null;
        _customerLabel = "";
        _cartNotes = "";
        _selectedCustomerCredentialId = null;
        _discountAmount = 0;
        _taxAmount = 0;
        _cashTenderedAmount = 0;
        _activeSaleIdempotencyKey = NewSaleIdempotencyKey();
        _activeCartCreateIdempotencyKey = NewCartIdempotencyKey();
    }

    private async Task ConfirmClearCurrentCart()
    {
        if (IsInteractionLocked || !_cart.Any())
            return;

        if (!await DialogService.Confirm(
                "Clear Cart",
                "Discard all items and customer details from the active cart?",
                new ConfirmDialogOptions { Destructive = true }))
        {
            return;
        }

        if (_activeCartId.HasValue)
        {
            _actingOnCart = true;
            try
            {
                var response = await POS.CancelPosCart(new CancelPosCartRequest
                {
                    Metadata = BuildMetadata(),
                    CartId = _activeCartId.Value,
                    ExpectedConcurrencyStamp = _activeCartConcurrencyStamp,
                    Reason = "Cleared from Portal"
                });

                if (!response.IsSuccess)
                {
                    ToastService.Show(response.Message ?? "Could not clear the persisted cart.");
                    return;
                }
            }
            finally
            {
                _actingOnCart = false;
            }
        }

        _lastReceipt = null;
        ClearCurrentCart();
        ToastService.Show("Cart cleared.");
    }

    private void StartNewSale()
    {
        if (HasPendingPayment)
            return;

        _lastReceipt = null;
        ClearCurrentCart();
        _ = InvokeAsync(FocusCatalogSearchAsync);
    }

    private void ViewPendingSale()
    {
        if (_lastReceipt is not null)
            Navigation.NavigateTo($"/pos/sales/{_lastReceipt.Id}");
    }

    private void HandleDialogKeyDown(KeyboardEventArgs args, bool heldSales)
    {
        // Blueprint registers its document Escape listener after asynchronous focus/scroll setup.
        if (args.Key == "Escape")
            OnDialogOpenChanged(false, heldSales);
    }

    private void OnDialogOpenChanged(bool open, bool heldSales)
    {
        if (heldSales)
            _heldCartsOpen = open;
        else
            _saleDetailsOpen = open;
        if (!open)
            _dialogFocusTarget = heldSales ? "held-sales" : "sale-details";
    }

    private async Task RestoreDialogFocusAsync(string target)
    {
        try
        {
            var script = await GetScriptAsync();
            await script.InvokeVoidAsync("restoreDialogFocus", target);
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // The user may leave the page while a portaled dialog is closing.
        }
    }

    private bool TryResolveRegister(out Guid registerId)
    {
        if (Guid.TryParse(_selectedRegisterId, out registerId))
            return true;

        ToastService.Show("Select a register.");
        return false;
    }

    private bool TryResolveCashier(out Guid cashierCredentialId)
    {
        cashierCredentialId = ActorContext.CredentialId ?? Guid.Empty;
        if (cashierCredentialId != Guid.Empty)
            return true;

        ToastService.Show("Sign in again to identify the cashier.");
        return false;
    }

    private Guid? TryResolveSelectedCustomer() =>
        Guid.TryParse(_selectedCustomerCredentialId, out var customerCredentialId)
            ? customerCredentialId
            : null;

    private Guid? TryResolveSelectedRegisterId() =>
        Guid.TryParse(_selectedRegisterId, out var registerId)
            ? registerId
            : null;

    private Task<IJSObjectReference> GetScriptAsync() => _scriptTask ??=
        JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/XFramework.Portal.Features.POS/cashier.js").AsTask();

    private async Task FocusCatalogSearchAsync()
    {
        if (_disposed)
            return;
        try
        {
            var script = await GetScriptAsync();
            await script.InvokeVoidAsync("focusSearch");
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // Focus is an ergonomic enhancement; checkout behavior must not depend on it.
        }
    }

    private ButtonVariant CategoryButtonVariant(Guid? categoryId) =>
        _selectedCategoryId == categoryId ? ButtonVariant.Default : ButtonVariant.Outline;

    private RequestMetadata BuildMetadata() => new()
    {
        RequestedTenantId = TenantFilter.SelectedTenantId,
        RequestId = Guid.NewGuid(),
        OperationName = "Portal"
    };

    private static string GetRegisterValue(PosRegisterResponse register) => register.Id.ToString();
    private static string GetRegisterLabel(PosRegisterResponse register) =>
        string.IsNullOrWhiteSpace(register.Code) ? register.Name : $"{register.Name} ({register.Code})";
    private static string GetRegisterSearchText(PosRegisterResponse register) =>
        $"{register.Name} {register.Code} {register.Description}";

    private static string GetCredentialValue(IdentityCredential credential) => credential.Id.ToString();
    private static string GetCredentialLabel(IdentityCredential credential) =>
        string.IsNullOrWhiteSpace(credential.UserName) ? credential.Id.ToString()[..8] : credential.UserName;
    private static string GetCredentialSearchText(IdentityCredential credential) =>
        $"{credential.UserName} {credential.UserAlias}";

    private static string NewSaleIdempotencyKey() => $"Portal.POS.Sale.{Guid.NewGuid():N}";
    private static string NewCartIdempotencyKey() => $"Portal.POS.Cart.{Guid.NewGuid():N}";

    private static string AvailabilityText(PosCatalogItemResponse item)
    {
        if (!item.IsAvailable)
            return "Unavailable";

        return item.AvailableQuantity.HasValue
            ? $"{FormatQuantity(item.AvailableQuantity.Value)} available"
            : "Available";
    }

    private static string AvailabilityClass(PosCatalogItemResponse item) =>
        item.IsAvailable ? "pos-product-status pos-product-status-ready" : "pos-product-status pos-product-status-offline";

    private static string FormatQuantity(decimal value) => value % 1 == 0 ? value.ToString("N0") : value.ToString("N2");
    private static string HeldCartCustomer(PosCartSummaryResponse cart) =>
        string.IsNullOrWhiteSpace(cart.CustomerLabel) ? "Walk-in customer" : cart.CustomerLabel;

    private static IReadOnlyList<XfEntityPickerColumn<PosRegisterResponse>> RegisterAdvancedColumns =>
    [
        new("Name", register => register.Name),
        new("Code", register => register.Code),
        new("Warehouse", register => ShortId(register.DefaultWarehouseId)),
        new("Location", register => ShortId(register.DefaultLocationId)),
        new("Enabled", register => FormatBoolean(register.IsEnabled)),
        new("Register", register => ShortId(register.Id))
    ];

    private static IReadOnlyList<XfEntityPickerColumn<IdentityCredential>> CredentialAdvancedColumns =>
    [
        new("Username", credential => credential.UserName ?? credential.UserAlias),
        new("Alias", credential => credential.UserAlias),
        new("Online", credential => FormatBoolean(credential.IsOnline)),
        new("Last Seen", credential => FormatDateTime(credential.LastSeen)),
        new("Device", credential => credential.Device),
        new("Location", credential => credential.Location),
        new("Credential", credential => ShortId(credential.Id))
    ];

    private static string ShortId(Guid id) => id.ToString()[..8];
    private static string FormatBoolean(bool value) => value ? "Yes" : "No";
    private static string FormatDateTime(DateTime? value) => value?.ToString("yyyy-MM-dd HH:mm") ?? "-";

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _searchVersion++;
        TenantFilter.OnChanged -= OnTenantChanged;
        ModuleNavigation.OnChanged -= OnTenantChanged;
        if (_scriptTask is not null)
        {
            try
            {
                await (await _scriptTask).DisposeAsync();
            }
            catch (Exception exception) when (exception is JSException or JSDisconnectedException or TaskCanceledException)
            {
                // The circuit may already be disconnected when the page is disposed.
            }
        }
    }

    private sealed class CartLine
    {
        public Guid ProductId { get; set; }
        public Guid? ProductVariationId { get; set; }
        public string DisplayName { get; set; } = "";
        public decimal UnitPrice { get; set; }
        public decimal Quantity { get; set; }
        public decimal LineTotal => UnitPrice * Quantity;
    }
}
