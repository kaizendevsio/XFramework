@page "/pos/settings"
@implements IDisposable
@using IdentityServer.Integration.Drivers
@using Microsoft.Extensions.Logging
@using XFramework.Portal.Features.POS.Tables
@inject IIdentityServerServiceWrapper Identity
@inject IPortalTenantContext Tenant
@inject IPortalModuleAvailability Modules
@inject ToastService Toast
@inject ILogger<Settings> Logger

<PageTitle>POS Settings - Portal</PageTitle>
<div class="pos-settings-page">
    <div class="xf-page-header">
        <div><BbTypographyH3>POS Settings</BbTypographyH3><BbTypographyMuted>@Tenant.SelectedTenantName</BbTypographyMuted></div>
        <div class="xf-page-actions">
            <BbButton Variant="ButtonVariant.Outline" OnClick="@Load" Disabled="@_busy"><LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />Refresh</BbButton>
        </div>
    </div>
    @if (Tenant.SelectedTenantId is null)
    {
        <ModuleUnavailable ModuleName="POS" RequiresTenant="true" />
    }
    else if (_loading)
    {
        <CenteredSpinner />
    }
    else if (!_enabled)
    {
        <ModuleUnavailable ModuleName="POS Sales" />
    }
    else
    {
        @if (_error is not null)
        {
            <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@_error</BbAlertDescription></BbAlert>
        }
        @if (_response is not null)
        {
            <BbTabs DefaultValue="tables">
            <BbTabsList aria-label="POS settings sections">
                <BbTabsTrigger Value="tables">Tables</BbTabsTrigger>
                <BbTabsTrigger Value="receipts">Receipts</BbTabsTrigger>
                <BbTabsTrigger Value="checkout">Checkout fields</BbTabsTrigger>
            </BbTabsList>
            <BbTabsContent Value="tables">
            <section class="pos-settings-section">
                <BbTypographyH4>Tables</BbTypographyH4>
                <label class="pos-settings-switch"><BbSwitch @bind-Checked="_settings.TableTrackingEnabled" Disabled="@ReadOnly" />Enable table selection</label>
                <label class="pos-settings-switch"><BbSwitch @bind-Checked="_settings.TableRequired" Disabled="@(ReadOnly || !_settings.TableTrackingEnabled)" />Require a table at payment</label>
                <PosTableLayoutEditor @key="_settings" Settings="_settings" Disabled="@ReadOnly" />
            </section>
            </BbTabsContent>
            <BbTabsContent Value="receipts">
            <ReceiptSettingsEditor Settings="_settings.Receipt" Disabled="@ReadOnly" />
            </BbTabsContent>
            <BbTabsContent Value="checkout">
            <section class="pos-settings-section">
                <div class="xf-page-header">
                    <BbTypographyH4>Checkout fields</BbTypographyH4>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@AddField" Disabled="@(ReadOnly || _settings.CheckoutFields.Count >= 20)">
                        <LucideIcon Name="plus" class="mr-2 h-4 w-4" />Add field
                    </BbButton>
                </div>
                <BbDataGrid TItem="PosCheckoutField" Items="@_settings.CheckoutFields" ShowPagination="false"
                            Class="pos-checkout-fields" TableContainerClass="pos-checkout-fields-scroll">
                    <Columns>
                        <BbDataGridTemplateColumn Title="Key" Width="28%" Filterable="true" FilterBy="@(x => x.Key)"><ChildContent Context="field">
                            <BbInput @bind-Value="field.Key" AriaLabel="Field key" Class="pos-settings-field-input" Disabled="@ReadOnly" />
                        </ChildContent></BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Label" Filterable="true" FilterBy="@(x => x.Label)"><ChildContent Context="field">
                            <BbInput @bind-Value="field.Label" AriaLabel="Field label" Class="pos-settings-field-input" Disabled="@ReadOnly" />
                        </ChildContent></BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Enabled" Width="7rem" Filterable="true" FilterBy="@(x => x.Enabled)"><ChildContent Context="field">
                            <BbSwitch @bind-Checked="field.Enabled" Disabled="@ReadOnly" AriaLabel="@($"Enable {field.Label}")" />
                        </ChildContent></BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Required" Width="7rem" Filterable="true" FilterBy="@(x => x.Required)"><ChildContent Context="field">
                            <BbSwitch @bind-Checked="field.Required" Disabled="@(ReadOnly || !field.Enabled)" AriaLabel="@($"Require {field.Label}")" />
                        </ChildContent></BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Actions" Width="5rem"><ChildContent Context="field">
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="@($"Remove {field.Label}")" Title="Remove field"
                                      Disabled="@ReadOnly" OnClick="@(() => RemoveField(field))"><LucideIcon Name="trash-2" class="h-4 w-4" /></BbButton>
                        </ChildContent></BbDataGridTemplateColumn>
                    </Columns>
                    <EmptyTemplate><BbEmpty Title="No checkout fields" /></EmptyTemplate>
                </BbDataGrid>
                @if (!_settings.IsValid())
                {
                    <p role="alert">Check table layouts and checkout fields. Fields need unique keys (letters, numbers, underscore or hyphen, up to 64 characters) and labels of up to 100 characters.</p>
                }
            </section>
            </BbTabsContent>
            </BbTabs>
            <div class="xf-page-actions">
                <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => Apply(_response))" Disabled="@ReadOnly">Discard changes</BbButton>
                <BbButton OnClick="@Save" Disabled="@ReadOnly"><LucideIcon Name="save" class="mr-2 h-4 w-4" />Save</BbButton>
            </div>
        }
    }
</div>

@code {
    private TenantPosSettingsResponse? _response;
    private PosCheckoutSettings _settings = new();
    private string? _error;
    private bool _loading = true, _busy, _disposed, _enabled;
    private long _version;
    private bool ReadOnly => _busy || _response?.CanManage != true || _response.TenantId != Tenant.SelectedTenantId;

    protected override async Task OnInitializedAsync()
    {
        Tenant.OnChanged += TenantChanged;
        await Load();
    }

    private void TenantChanged()
    {
        _version++;
        _response = null;
        _ = InvokeAsync(Load);
    }

    private async Task Load()
    {
        var version = ++_version;
        _loading = true;
        _error = null;
        _response = null;
        try
        {
            if (Tenant.SelectedTenantId is not Guid tenantId) return;
            await Modules.EnsureLoadedAsync();
            if (_disposed || version != _version) return;
            _enabled = Modules.IsFeatureEnabled(TenantModuleFeatureKeys.Pos, "sales");
            if (!_enabled) return;
            var result = await Identity.GetTenantPosSettings(new() { Metadata = new() { RequestedTenantId = tenantId } });
            if (_disposed || version != _version) return;
            if (!result.IsSuccess || result.Response?.TenantId != tenantId)
            { _error = result.Message ?? "POS settings could not be loaded."; return; }
            Apply(result.Response);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load POS checkout settings");
            if (version == _version) _error = "POS settings could not be loaded. Refresh to retry.";
        }
        finally { if (version == _version) _loading = false; }
    }

    private void Apply(TenantPosSettingsResponse response)
    {
        _response = response;
        _settings = response.Settings.DeepClone();
        _error = response.ConfigurationError;
    }

    private void AddField()
    {
        if (ReadOnly || _settings.CheckoutFields.Count >= 20) return;
        var suffix = 1;
        while (_settings.CheckoutFields.Any(field => field.Key == $"field_{suffix}")) suffix++;
        _settings.CheckoutFields = [.. _settings.CheckoutFields, new() { Key = $"field_{suffix}", Label = $"Field {suffix}", Enabled = true }];
    }

    private void RemoveField(PosCheckoutField field) =>
        _settings.CheckoutFields = _settings.CheckoutFields.Where(item => !ReferenceEquals(item, field)).ToList();

    private async Task Save()
    {
        if (ReadOnly || Tenant.SelectedTenantId is not Guid tenantId || _response is null) return;
        if (!_settings.IsValid())
        {
            _error = "Check the table layouts, receipt settings and checkout fields before saving.";
            return;
        }
        _busy = true;
        var version = _version;
        _error = null;
        try
        {
            var result = await Identity.UpdateTenantPosSettings(new()
            {
                Metadata = new() { RequestedTenantId = tenantId },
                ExpectedConcurrencyStamp = _response.ConcurrencyStamp, Settings = _settings
            });
            if (_disposed || version != _version) return;
            if (!result.IsSuccess || result.Response?.TenantId != tenantId)
            { _error = result.Message ?? "POS settings could not be saved."; return; }
            Apply(result.Response);
            Toast.Success("POS settings saved.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not save POS checkout settings");
            if (version == _version) _error = "POS settings could not be saved. Refresh before trying again.";
        }
        finally { _busy = false; }
    }

    public void Dispose() { _disposed = true; _version++; Tenant.OnChanged -= TenantChanged; }
}
