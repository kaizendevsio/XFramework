@page "/pos/sales"
@using XFramework.Domain.Shared.DataContext
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>POS Sales - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_hasTenant)
{
    <ModuleUnavailable ModuleName="POS" RequiresTenant="true" />
}
else if (!_moduleEnabled)
{
    <ModuleUnavailable ModuleName="POS Sales" />
}
else
{
    <FadeInContent>
        <div class="space-y-6">
            <div class="xf-page-header">
                <div>
                    <BbTypographyH3>Sales</BbTypographyH3>
                    <BbTypographyMuted>Lookup receipts, monitor recovery states, and start returns.</BbTypographyMuted>
                </div>
                <div class="xf-page-actions">
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@Reload">
                        <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                        Refresh
                    </BbButton>
                </div>
            </div>

            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Sale List</BbCardTitle>
                    <BbCardDescription>@_sales.Count sale(s) loaded</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <div class="mb-4 flex flex-wrap items-end gap-3">
                        <BbFormFieldInput TValue="string" @bind-Value="_search" Label="Receipt or idempotency key" />
                        <BbFormFieldSelect TValue="string" @bind-Value="_statusFilter" Label="Status">
                            <BbSelectItem Value="@AllStatusesValue">All statuses</BbSelectItem>
                            @foreach (var status in Enum.GetValues<PosSaleStatus>())
                            {
                                <BbSelectItem Value="@status.ToString()">@status</BbSelectItem>
                            }
                        </BbFormFieldSelect>
                        <BbButton OnClick="@ApplyFilters" Disabled="@_loadingPage">
                            <LucideIcon Name="search" class="mr-2 h-4 w-4" />Search
                        </BbButton>
                    </div>
                    <BbDataGrid Items="@_sales" ShowPagination="false"
                                OnRowClick="@((PosSaleSummaryResponse item) => OpenSale(item.Id))"
                                Class="cursor-pointer">
                        <Columns>
                            <BbDataGridPropertyColumn Property="@(x => x.SaleNumber)" Title="Receipt" Sortable="true" Filterable="true" />
                            <BbDataGridTemplateColumn Title="Register" Filterable="true" FilterBy="@(item => GetRegisterName(item.RegisterId))">
                                <ChildContent Context="item">@GetRegisterName(item.RegisterId)</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Total" Sortable="true" Filterable="true" FilterBy="@(item => item.TotalAmount)">
                                <ChildContent Context="item">@FormatMoney(item.TotalAmount, item.CurrencyId)</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Status" Filterable="true" FilterBy="@(item => item.Status)">
                                <ChildContent Context="item">
                                    <StatusBadge Text="@item.Status.ToString()" Status="@GetSaleStatusBadge(item.Status)" />
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.CompletedAt)" Title="Completed" Sortable="true" Filterable="true" />
                            <BbDataGridTemplateColumn Title="Actions">
                                <ChildContent Context="item">
                                    <div class="flex flex-wrap gap-1">
                                        <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" OnClick="@(() => OpenSale(item.Id))">
                                            View
                                        </BbButton>
                                        @if (item.Status == PosSaleStatus.InventoryFulfillmentFailed)
                                        {
                                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => RetryFulfillment(item.Id))" Disabled="@_acting">
                                                Retry
                                            </BbButton>
                                        }
                                        @if (item.Status is PosSaleStatus.Draft or PosSaleStatus.InventoryReserved or PosSaleStatus.PaymentFailed or PosSaleStatus.InventoryReservationFailed)
                                        {
                                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Destructive" OnClick="@(() => CancelSale(item.Id))" Disabled="@_acting">
                                                Cancel
                                            </BbButton>
                                        }
                                        @if (item.Status == PosSaleStatus.Completed)
                                        {
                                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => Navigation.NavigateTo($"/pos/returns?saleId={item.Id}"))">
                                                Return
                                            </BbButton>
                                        }
                                    </div>
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                        </Columns>
                        <EmptyTemplate>
                            <BbEmpty Title="No POS sales" Description="Completed and recoverable checkout records will appear here." />
                        </EmptyTemplate>
                    </BbDataGrid>
                    <div class="mt-4 flex items-center justify-between">
                        <BbTypographyMuted>Page @_page · up to @PageSize results per page</BbTypographyMuted>
                        <div class="flex gap-2">
                            <BbButton Variant="ButtonVariant.Outline" OnClick="@PreviousPage" Disabled="@(_page == 1 || _loadingPage)">Previous</BbButton>
                            <BbButton Variant="ButtonVariant.Outline" OnClick="@NextPage" Disabled="@(!_hasNextPage || _loadingPage)">Next</BbButton>
                        </div>
                    </div>
                </BbCardContent>
            </BbCard>
        </div>
    </FadeInContent>
}

@code {
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private IPOSServiceWrapper POS { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private IPortalModuleAvailability ModuleNavigation { get; set; } = default!;
    [Inject] private RequestMetadata RequestMetadata { get; set; } = default!;
    [Inject] private DialogService DialogService { get; set; } = default!;

    private List<PosSaleSummaryResponse> _sales = [];
    private List<PosRegister> _registers = [];
    private List<Wallets.Domain.Shared.Contracts.CurrencyType> _currencies = [];
    private bool _loading = true;
    private bool _acting;
    private bool _hasTenant;
    private bool _moduleEnabled;
    private bool _loadingPage;
    private bool _hasNextPage;
    private int _page = 1;
    private const int PageSize = 50;
    private string _search = "";
    private const string AllStatusesValue = "all";
    private string _statusFilter = AllStatusesValue;

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        ModuleNavigation.OnChanged += OnTenantChanged;
    }

    protected override async Task OnInitializedAsync() => await Reload();

    private void OnTenantChanged()
    {
        _page = 1;
        _ = InvokeAsync(Reload);
    }

    private async Task Reload()
    {
        _loading = true;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _moduleEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Pos, "sales");
            _sales = [];
            _registers = [];
            _currencies = [];

            if (!_hasTenant || !_moduleEnabled || TenantFilter.SelectedTenantId is not Guid)
                return;

            await LoadSalesPage();
        }
        catch
        {
            ToastService.Show("Could not load POS sales.");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadSalesPage()
    {
        _loadingPage = true;
        try
        {
            var salesResponse = await POS.SearchPosSales(new SearchPosSalesRequest
            {
                Metadata = BuildMetadata(),
                Search = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
                Status = Enum.TryParse<PosSaleStatus>(_statusFilter, out var status) ? status : null,
                Page = _page,
                PageSize = PageSize
            });
            _sales = salesResponse.Response ?? [];
            await LoadReferenceLabels();
            _hasNextPage = salesResponse.IsSuccess && _sales.Count == PageSize;
            if (!salesResponse.IsSuccess)
                ToastService.Show(salesResponse.Message ?? "Could not load POS sales.");
        }
        finally
        {
            _loadingPage = false;
        }
    }

    private async Task LoadReferenceLabels()
    {
        if (TenantFilter.SelectedTenantId is not Guid tenantId)
            return;

        var registerIds = _sales.Select(item => item.RegisterId).Distinct().ToList();
        _registers = await DataContext.Query<PosRegister>().IgnoreQueryFilters().NoCache()
            .Where(item => item.TenantId == tenantId && !item.IsDeleted && registerIds.Contains(item.Id))
            .ToListAsync();
        var currencyIds = _sales.Select(item => item.CurrencyId).Distinct().ToList();
        _currencies = await DataContext.Query<Wallets.Domain.Shared.Contracts.CurrencyType>()
            .IgnoreQueryFilters().NoCache().Where(item => currencyIds.Contains(item.Id)).ToListAsync();
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadSalesPage();
    }

    private async Task PreviousPage()
    {
        if (_page <= 1)
            return;
        _page--;
        await LoadSalesPage();
    }

    private async Task NextPage()
    {
        if (!_hasNextPage)
            return;
        _page++;
        await LoadSalesPage();
        if (_sales.Count == 0)
        {
            _page--;
            await LoadSalesPage();
        }
    }

    private void OpenSale(Guid saleId) => Navigation.NavigateTo($"/pos/sales/{saleId}");
    private string FormatMoney(decimal amount, Guid currencyId)
    {
        var code = _currencies.FirstOrDefault(item => item.Id == currencyId)?.CurrencyIsoCode3?.Trim().ToUpperInvariant();
        return code is { Length: 3 } && code.All(char.IsAsciiLetter) ? $"{code} {amount:N2}" : amount.ToString("N2");
    }

    private async Task CancelSale(Guid saleId)
    {
        if (!await DialogService.Confirm(
                "Cancel POS Sale",
                "Cancel this sale and stop its recovery workflow?",
                new ConfirmDialogOptions { Destructive = true }))
        {
            return;
        }

        _acting = true;
        try
        {
            var response = await POS.CancelPosSale(new CancelPosSaleRequest
            {
                Metadata = BuildMetadata(),
                SaleId = saleId,
                Reason = "Cancelled from Portal"
            });
            ToastService.Show(response.IsSuccess ? "Sale cancelled." : response.Message ?? "Could not cancel sale.");
            await Reload();
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task RetryFulfillment(Guid saleId)
    {
        _acting = true;
        try
        {
            var response = await POS.RetryPosSaleFulfillment(new RetryPosSaleFulfillmentRequest
            {
                Metadata = BuildMetadata(),
                SaleId = saleId
            });
            ToastService.Show(response.IsSuccess ? "Fulfillment retry submitted." : response.Message ?? "Could not retry fulfillment.");
            await Reload();
        }
        finally
        {
            _acting = false;
        }
    }

    private RequestMetadata BuildMetadata() => new()
    {
        RequestedTenantId = TenantFilter.SelectedTenantId,
        RequestId = Guid.NewGuid(),
        OperationName = "Portal"
    };

    private string GetRegisterName(Guid registerId) =>
        _registers.FirstOrDefault(item => item.Id == registerId)?.Name ?? registerId.ToString()[..8];

    private static string GetSaleStatusBadge(PosSaleStatus status) =>
        status switch
        {
            PosSaleStatus.Completed => "active",
            PosSaleStatus.PaymentFailed or PosSaleStatus.InventoryFulfillmentFailed or PosSaleStatus.InventoryReservationFailed => "warning",
            PosSaleStatus.Cancelled => "inactive",
            _ => "pending"
        };

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantChanged;
        ModuleNavigation.OnChanged -= OnTenantChanged;
    }
}
