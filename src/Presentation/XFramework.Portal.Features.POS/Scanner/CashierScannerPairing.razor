@implements IAsyncDisposable
@inject IPOSServiceWrapper POS
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IPortalTenantContext Tenant
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject BlazorBlueprint.Primitives.Services.IFocusManager Focus

<link rel="stylesheet" href="/_content/XFramework.Portal.Features.POS/XFramework.Portal.Features.POS.bundle.scp.css" />

<div class="cashier-scanner" data-testid="cashier-scanner-pairing">
    <BbButton OnClick="OpenPairing" Disabled="@(Disabled || _busy || RegisterId == Guid.Empty)" Variant="ButtonVariant.Outline">
        <LucideIcon Name="scan-barcode" Size="18" />@(_paired ? "Phone connected" : "Scan with phone")
    </BbButton>
    <span class="scanner-live" role="status" aria-live="polite">@_status</span>
</div>

<BbDialog Open="@_dialogOpen" OpenChanged="DialogOpenChanged">
    <BbDialogContent TrapFocus="true" CloseOnEscape="false" @onkeydown="PairingKeyDown">
        <BbDialogHeader>
            <BbDialogTitle>@(_paired ? "Phone connected" : "Scan with phone")</BbDialogTitle>
            <BbDialogDescription>@_status</BbDialogDescription>
        </BbDialogHeader>
        <div class="scanner-pairing-content">
            @if (_error is not null) { <BbAlert><BbAlertDescription>@_error</BbAlertDescription></BbAlert> }
            @if (_busy) { <BbSpinner /> }
            @if (PairingExpired)
            {
                <p role="status" data-testid="pairing-expired">Pairing code expired</p>
            }
            else if (_pairing is not null && !_paired)
            {
                @if (_qrSource is not null) { <img src="@_qrSource" width="240" height="240" alt="One-time phone pairing QR" /> }
                <output class="scanner-short-code" aria-label="Six-digit pairing code" data-testid="pairing-short-code">@_pairing.PairingCode</output>
                <p role="timer" aria-live="off" data-testid="pairing-countdown">Expires in @Countdown</p>
            }
            @if (_scannerUrl.Length > 0)
            {
                <BbPopover Open="@_phoneLinkOpen" OpenChanged="PhoneLinkOpenChanged" RestoreFocusOnClose="true">
                    <BbPopoverTrigger AsChild="false" class="scanner-phone-link" aria-label="Phone scanner">
                        <LucideIcon Name="smartphone" Size="18" />Phone scanner
                    </BbPopoverTrigger>
                    <BbPopoverContent Class="scanner-phone-popover" aria-label="Phone scanner" CloseOnClickOutside="false" CloseOnEscape="true" ZIndex="90"
                                      OnContentReady="PhoneContentReady"
                                      style="width: min(280px, calc(100vw - 32px));">
                        <div @ref="_phoneLinkContent">
                            @if (_phoneLinkQrSource is not null)
                            {
                                <img src="@_phoneLinkQrSource" width="240" height="240" alt="Phone scanner HTTPS landing QR"
                                     style="max-width: 100%; height: auto; background: white;" />
                            }
                            <BbButton OnClick="@(() => PhoneLinkOpenChanged(false))" Variant="ButtonVariant.Outline" aria-label="Close phone scanner QR" title="Close phone scanner QR">
                                <LucideIcon Name="x" Size="18" />
                            </BbButton>
                        </div>
                    </BbPopoverContent>
                    @if (_phoneLinkOpen) { <XfPopoverClickOutside /> }
                </BbPopover>
            }
        </div>
        <BbDialogFooter>
            @if (_pairing is null || PairingExpired)
            {
                <BbButton OnClick="NewPairing" Disabled="@(_busy || Disabled)"><LucideIcon Name="qr-code" Size="18" />@(PairingExpired ? "New pairing code" : "Pair phone")</BbButton>
            }
            else
            {
                <BbButton OnClick="Disconnect" Variant="ButtonVariant.Outline"><LucideIcon Name="unplug" Size="18" />Disconnect</BbButton>
            }
            <BbButton OnClick="@(() => DialogOpenChanged(false))" Variant="ButtonVariant.Outline">Done</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Parameter] public Guid RegisterId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public long SaleGeneration { get; set; }
    // Must complete only after the existing cashier barcode-add path has accepted/rejected the code.
    [Parameter, EditorRequired] public EventCallback<string> ScanReceived { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _polling;
    private Task? _countdown;
    private PosScannerPairingResponse? _pairing;
    private IJSObjectReference? _script;
    private string? _qrSource;
    private string? _phoneLinkQrSource;
    private bool _phoneLinkOpen;
    private ElementReference _phoneLinkContent;
    private IAsyncDisposable? _phoneFocusTrap;
    private long _phoneFocusVersion;
    private bool _expired;
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private Guid _registerId;
    private Guid? _tenantId;
    private long _acknowledged;
    private bool _paired;
    private long _saleGeneration;
    private bool _discardPending;
    private bool _dialogOpen;
    private bool _busy;
    private bool _disposed;
    private string _status = "Not paired";
    private string? _error;
    private string _scannerUrl = "";

    private int RemainingSeconds => _pairing is null ? 0 : Math.Max(0, (int)Math.Ceiling((_pairing.ChallengeExpiresAt - _now).TotalSeconds));
    private string Countdown => TimeSpan.FromSeconds(RemainingSeconds).ToString(@"mm\:ss", System.Globalization.CultureInfo.InvariantCulture);
    private bool PairingExpired => _expired || (_pairing is not null && !_paired && RemainingSeconds == 0);

    protected override void OnInitialized()
    {
        Tenant.OnChanged += TenantChanged;
        _countdown = TickCountdown();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_pairing is not null && SaleGeneration != _saleGeneration) _discardPending = true;
        _saleGeneration = SaleGeneration;
        if (Disabled) await DialogOpenChanged(false);
        if (_pairing is not null && (RegisterId != _registerId || Tenant.SelectedTenantId != _tenantId))
            await Disconnect();
    }

    private void TenantChanged() => _ = InvokeAsync(async () => { await Disconnect(); StateHasChanged(); });

    private async Task OpenPairing()
    {
        _dialogOpen = true;
        if (_pairing is null && !_expired) await Create();
    }

    private async Task DialogOpenChanged(bool open)
    {
        _dialogOpen = open;
        if (!open) await PhoneLinkOpenChanged(false);
    }

    private async Task PhoneLinkOpenChanged(bool open)
    {
        _phoneLinkOpen = open;
        if (open) return;
        _phoneFocusVersion++;
        var trap = _phoneFocusTrap;
        _phoneFocusTrap = null;
        if (trap is not null) await DisposePhoneFocus(trap);
    }

    private async Task PhoneContentReady()
    {
        // The popover lives outside the dialog DOM, so it needs its own native focus scope.
        var version = ++_phoneFocusVersion;
        var trap = await Focus.TrapFocus(_phoneLinkContent);
        if (_disposed || !_phoneLinkOpen || version != _phoneFocusVersion)
        { await DisposePhoneFocus(trap); return; }
        var previous = _phoneFocusTrap;
        _phoneFocusTrap = trap;
        if (previous is not null) await DisposePhoneFocus(previous);
    }

    private static async Task DisposePhoneFocus(IAsyncDisposable trap)
    {
        try { await trap.DisposeAsync(); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }

    // Scope Escape to this DOM subtree; the portaled popover handles its own Escape.
    private async Task PairingKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && !_phoneLinkOpen) await DialogOpenChanged(false);
    }

    private async Task NewPairing()
    {
        if (_busy || _disposed || Disabled) return;
        await Disconnect();
        await Create();
    }

    private async Task TickCountdown()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
                await InvokeAsync(() =>
                {
                    if (_disposed) return;
                    _now = DateTimeOffset.UtcNow;
                    if (_dialogOpen && !_paired) StateHasChanged();
                });
        }
        catch (OperationCanceledException) { }
    }

    private async Task Create()
    {
        if (_busy || _disposed || Disabled || RegisterId == Guid.Empty || !ScanReceived.HasDelegate) return;
        if (!ScannerPublicOrigin.TryResolve(Configuration["Portal:ScannerPublicBaseUrl"], Navigation.BaseUri, out var origin))
        { _error = "Phone pairing requires a valid HTTPS Portal scanner origin. Configure Portal:ScannerPublicBaseUrl."; return; }
        _scannerUrl = new Uri(origin!, "/pos/mobile-scanner").AbsoluteUri;
        _busy = true;
        _error = null;
        _expired = false;
        _phoneLinkOpen = false;
        _now = DateTimeOffset.UtcNow;
        _registerId = RegisterId;
        _tenantId = Tenant.SelectedTenantId;
        if (_tenantId.HasValue) _scannerUrl += "?tenant=" + _tenantId.Value;
        try
        {
            var result = await POS.CreatePosScannerPairing(new()
            {
                RegisterId = RegisterId, Metadata = Metadata()
            }, _lifetime.Token);
            if (!result.IsSuccess || result.Response is null) { _error = result.Message ?? "Pairing unavailable."; return; }
            _pairing = result.Response;
            _now = DateTimeOffset.UtcNow;
            if (_disposed || RegisterId != _registerId || Tenant.SelectedTenantId != _tenantId)
            { await Disconnect(); return; }
            _acknowledged = 0;
            _discardPending = false;
            _saleGeneration = SaleGeneration;
            _paired = false;
            _status = "Waiting for phone";
            _polling ??= Poll();
            try
            {
                var current = _pairing;
                if (current is null) return;
                _script ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/XFramework.Portal.Features.POS/scanner/scanner.js");
                if (current != _pairing || _disposed) return;
                var source = await _script.InvokeAsync<string>("qrData", _scannerUrl + "#" + current.Challenge);
                if (current == _pairing && !_disposed) _qrSource = source;
                if (current != _pairing || _disposed) return;
                var landing = await _script.InvokeAsync<string>("qrData", _scannerUrl);
                if (current == _pairing && !_disposed) _phoneLinkQrSource = landing;
            }
            catch (JSException) { _error = "Pairing QR could not load. Use the pairing code."; }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        { _error = "Scanner connection unavailable."; }
        finally { _busy = false; }
    }

    private RequestMetadata Metadata() => new() { RequestedTenantId = _tenantId, OperationName = "Portal.POS.Scanner" };

    private async Task Poll()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
            {
                await InvokeAsync(async () =>
                {
                    var current = _pairing;
                    if (current is null || _disposed) return;
                    var generation = SaleGeneration;
                    var discardPending = _discardPending;
                    QueryResponse<PosScannerPollResponse> result;
                    try
                    {
                        result = await POS.PollPosScannerCodes(new()
                        {
                            PairingId = current.PairingId, DesktopKey = current.DesktopKey,
                            AcknowledgedSequence = _acknowledged, PauseDelivery = Disabled,
                            DiscardPendingCodes = discardPending, Metadata = Metadata()
                        }, _lifetime.Token);
                    }
                    catch (Exception)
                    {
                        if (current != _pairing || _disposed || _lifetime.IsCancellationRequested) return;
                        _error = "Scanner connection interrupted. Pair again.";
                        await Disconnect();
                        StateHasChanged();
                        return;
                    }
                    if (current != _pairing || _disposed) return;
                    if (!result.IsSuccess || result.Response is null)
                    {
                        var expired = !_paired && current.ChallengeExpiresAt <= DateTimeOffset.UtcNow;
                        _error = expired ? null : result.Message ?? "Scanner pairing ended.";
                        await Disconnect();
                        if (expired) { _expired = true; _status = "Pairing code expired"; }
                        StateHasChanged();
                        return;
                    }
                    _paired = result.Response.IsPaired;
                    _status = _paired ? (Disabled ? "Phone connected; cashier busy" : "Phone connected") : "Waiting for phone";
                    if (discardPending)
                    {
                        _acknowledged = result.Response.AcknowledgedSequence;
                        if (generation == SaleGeneration) _discardPending = false;
                    }
                    foreach (var code in result.Response.Codes)
                    {
                        if (current != _pairing || _disposed || Disabled || generation != SaleGeneration) break;
                        if (code.Sequence <= _acknowledged) continue;
                        try
                        {
                            await ScanReceived.InvokeAsync(code.Code);
                            if (current != _pairing || _disposed || generation != SaleGeneration) break;
                            _acknowledged = code.Sequence;
                        }
                        catch (Exception)
                        {
                            if (current != _pairing || _disposed) break;
                            if (generation != SaleGeneration) { _discardPending = true; break; }
                            _error = "Cashier could not accept the scan. Scanner disconnected; check the cart before pairing again.";
                            await Disconnect();
                            break;
                        }
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            if (!_disposed) await InvokeAsync(async () =>
            { _error = "Scanner connection interrupted. Pair again."; await Disconnect(); StateHasChanged(); });
        }
        finally { _polling = null; }
    }

    private async Task Disconnect()
    {
        var current = _pairing;
        _pairing = null;
        _qrSource = null;
        _phoneLinkQrSource = null;
        await PhoneLinkOpenChanged(false);
        _expired = false;
        _paired = false;
        _discardPending = false;
        _status = "Not paired";
        if (current is null) return;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(2));
            await POS.RevokePosScannerPairing(new()
            { PairingId = current.PairingId, DesktopKey = current.DesktopKey, Metadata = Metadata() }, timeout.Token);
        }
        catch (Exception) { /* A disconnected desktop lease expires within 30 seconds. */ }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Tenant.OnChanged -= TenantChanged;
        await _lifetime.CancelAsync();
        if (_countdown is not null) await _countdown;
        await Disconnect();
        if (_script is not null)
        {
            try { await _script.DisposeAsync(); }
            catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
        }
        _lifetime.Dispose();
    }
}
