@implements IDisposable

<PageTitle>@CurrentSection.Title - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (_guard is { IsEnabled: false })
{
    <div class="space-y-4">
        <BbAlert Variant="@(_guard.HasSelectedTenant ? AlertVariant.Warning : AlertVariant.Info)">
            <BbAlertTitle>@_guard.Title</BbAlertTitle>
            <BbAlertDescription>@_guard.Description</BbAlertDescription>
        </BbAlert>
        @if (_guard.TenantId is Guid tenantId)
        {
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => Navigation.NavigateTo($"/identity/tenants/{tenantId}/modules"))">
                <LucideIcon Name="blocks" class="mr-2 h-4 w-4" />
                Tenant Modules
            </BbButton>
        }
    </div>
}
else
{
    <FadeInContent>
        <div class="space-y-6">
            <div class="xf-page-header">
                <div>
                    <BbTypographyH3>Communications Settings</BbTypographyH3>
                    <BbTypographyMuted>Communication controls for @(_guard?.TenantName ?? "selected tenant")</BbTypographyMuted>
                </div>
                <div class="xf-page-actions">
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@RefreshSettingsShell" Disabled="@_refreshing">
                        @if (_refreshing)
                        {
                            <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                        }
                        else
                        {
                            <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                        }
                        Refresh
                    </BbButton>
                </div>
            </div>

            <div class="communications-settings-layout">
                <aside class="communications-settings-section-nav" aria-label="Communications settings sections">
                    <div class="communications-settings-section-links">
                        @foreach (var settingSection in Sections)
                        {
                            <NavLink href="@(settingSection.Href)"
                                     Match="NavLinkMatch.All"
                                     class="sidebar-nav-item"
                                     ActiveClass="sidebar-nav-item-active"
                                     title="@(settingSection.Title)"
                                     aria-label="@(settingSection.Title)">
                                <LucideIcon Name="@(settingSection.Icon)" class="sidebar-nav-icon h-4 w-4" />
                                <span class="sidebar-label">@settingSection.Title</span>
                            </NavLink>
                        }
                    </div>
                </aside>

                <section class="communications-settings-content">
                    @if (CurrentSection.SectionKey == CommunicationsSettingsCatalog.TemplatesSectionKey)
                    {
                        <CommunicationsTemplateLibrary />
                    }
                    else
                    {
                        <CommunicationsSettingsEditor Title="@CurrentSection.Title"
                                                 Description="@CurrentSection.Description"
                                                 SectionKey="@CurrentSection.SectionKey" />
                    }
                </section>
            </div>
        </div>
    </FadeInContent>
}

@code {
    [Parameter] public string? SectionKey { get; set; }

    [Inject] private CommunicationsPortalGuard Guard { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    private static readonly IReadOnlyList<SettingsSection> Sections =
    [
        new(CommunicationsSettingsCatalog.ChatSectionKey, "Chat Controls", "Thread, direct-message, read-state, typing, and presence defaults.", "message-circle", "/communications/settings/chat"),
        new(CommunicationsSettingsCatalog.PolicySectionKey, "Policy", "Retention, attachment, rate-limit, and moderation policy values.", "shield-check", "/communications/settings/policy"),
        new(CommunicationsSettingsCatalog.TemplatesSectionKey, "Templates", "System, tenant, and user message templates.", "file-text", "/communications/settings/templates")
    ];

    private CommunicationsPortalGuardResult? _guard;
    private bool _loading = true;
    private bool _refreshing;

    private SettingsSection CurrentSection =>
        Sections.FirstOrDefault(section => string.Equals(section.SectionKey, SectionKey, StringComparison.OrdinalIgnoreCase))
        ?? Sections[0];

    protected override async Task OnInitializedAsync()
    {
        TenantFilter.OnChanged += OnTenantFilterChanged;
        await LoadData();
    }

    private void OnTenantFilterChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    private async Task RefreshSettingsShell()
    {
        _refreshing = true;

        try
        {
            await LoadData(showFeedback: true);
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task LoadData(bool showFeedback = false)
    {
        _loading = !showFeedback;

        try
        {
            _guard = await Guard.GetCurrentTenantStateAsync();
        }
        catch
        {
            if (showFeedback)
            {
                ToastService.Error("Communications settings overview could not be refreshed.");
            }
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantFilterChanged;
    }

    private sealed record SettingsSection(
        string SectionKey,
        string Title,
        string Description,
        string Icon,
        string Href);
}
