    private async Task SaveWalletType()
    {
        var code = (_formCode ?? string.Empty).Trim();
        var name = (_formName ?? string.Empty).Trim();
        var description = (_formDescription ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(code))
        {
            ToastService.Show("Code and Name are required.");
            return;
        }

        if (code.Length > 9)
        {
            ToastService.Show("Wallet type code must be 9 characters or fewer.");
            return;
        }

        if (name.Length > 20)
        {
            ToastService.Show("Wallet type name must be 20 characters or fewer.");
            return;
        }

        if (description.Length > 500)
        {
            ToastService.Show("Wallet type description must be 500 characters or fewer.");
            return;
        }

        await PersistAndClose<global::Wallets.Domain.Shared.Contracts.WalletType>(entity =>
        {
            entity.Code = code;
            entity.Name = name;
            entity.Desc = string.IsNullOrWhiteSpace(description) ? null : description;
            entity.MinTransferRule = decimal.TryParse(_formMinTransfer, out var minT) ? minT : null;
            entity.MaxTransferRule = decimal.TryParse(_formMaxTransfer, out var maxT) ? maxT : null;
        });
    }

