        @* -- Exchange Rates -- *@
        <BbTabsContent Value="exchange-rates" Class="xf-fade-in">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Exchange Rates</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Exchange Rate
                </BbButton>
            </div>
            <BbDataGrid Items="@_exchangeRates" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.SourceCurrencyTypeId)" Title="Source Currency" />
                    <BbDataGridPropertyColumn Property="@(x => x.TargetCurrencyTypeId)" Title="Target Currency" />
                    <BbDataGridPropertyColumn Property="@(x => x.Value)" Title="Rate" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.Fee)" Title="Fee" />
                    <BbDataGridPropertyColumn Property="@(x => x.EffectivityDate)" Title="Effective" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.ExpiryDate)" Title="Expires" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditExchangeRate(item))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, $"Rate {item.Value}"))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>
        }
        </div>
    </BbTabs>
    </FadeInContent>
    }
</div>

@* -- Create / Edit Dialog -- *@
<BbDialog Open="@_dialogOpen" OpenChanged="@(v => _dialogOpen = v)">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>@(_isEditing ? "Edit" : "Add") @TabDisplayName</BbDialogTitle>
            <BbDialogDescription>@(_isEditing ? "Update the record below." : "Fill in the details to create a new record.")</BbDialogDescription>
        </BbDialogHeader>
        <div class="space-y-4 py-4">
            @switch (_activeTab)
            {
                case "role-types":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formName"
                                      Label="Name"
                                      Placeholder="Role type name"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formLevel"
                                      Label="Level"
                                      Placeholder="Numeric role level (e.g. 1)" />
                    @if (_roleTypeGroups.Count == 0)
                    {
                        <div>
                            <BbLabel>Group</BbLabel>
                            <p class="text-sm text-muted-foreground">Create a role group before adding role types.</p>
                        </div>
                    }
                    else
                    {
                        <BbFormFieldSelect TValue="string"
                                           @bind-Value="_formGroupId"
                                           Label="Group"
                                           Placeholder="Select role group"
                                           Required="true">
                            @foreach (var group in _roleTypeGroups)
                            {
                                <BbSelectItem Value="@group.Id.ToString()">@group.Name</BbSelectItem>
                            }
                        </BbFormFieldSelect>
                    }
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formSystemRef"
                                      Label="System Reference ID"
                                      Placeholder="GUID (leave empty for auto-generated)" />
                    break;

                case "role-type-groups":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formName"
                                      Label="Name"
                                      Placeholder="Group name"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formDescription"
                                      Label="Description"
                                      Placeholder="Group description" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formSystemRef"
                                      Label="System Reference ID"
                                      Placeholder="GUID (leave empty for auto-generated)" />
                    break;

                case "contact-types":
                case "contact-groups":
                case "address-types":
                case "session-types":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formName"
                                      Label="Name"
                                      Placeholder="Type name"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formSystemRef"
                                      Label="System Reference ID"
                                      Placeholder="GUID (leave empty for auto-generated)" />
                    break;

                case "verification-types":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formName"
                                      Label="Name"
                                      Placeholder="Verification type name"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formDefaultExpiry"
                                      Label="Default Expiry (seconds)"
                                      Placeholder="e.g. 3600" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formPriority"
                                      Label="Priority"
                                      Placeholder="e.g. 1" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formSystemRef"
                                      Label="System Reference ID"
                                      Placeholder="GUID (leave empty for auto-generated)" />
                    break;

                case "wallet-types":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formCode"
                                      Label="Code"
                                      Placeholder="Short code (e.g. PHP)"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formName"
                                      Label="Name"
                                      Placeholder="Wallet type name"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formDescription"
                                      Label="Description"
                                      Placeholder="Description" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formMinTransfer"
                                      Label="Min Transfer"
                                      Placeholder="e.g. 0.01" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formMaxTransfer"
                                      Label="Max Transfer"
                                      Placeholder="e.g. 100000" />
                    break;

                case "currency-types":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formName"
                                      Label="Name"
                                      Placeholder="Currency name (e.g. Philippine Peso)"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formCurrencyCode"
                                      Label="Currency ISO Code"
                                      Placeholder="3-letter ISO code (e.g. PHP)" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formDescription"
                                      Label="Description"
                                      Placeholder="Description" />
                    break;

                case "exchange-rates":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formSourceCurrency"
                                      Label="Source Currency Type ID"
                                      Placeholder="GUID of source currency"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formTargetCurrency"
                                      Label="Target Currency Type ID"
                                      Placeholder="GUID of target currency"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formValue"
                                      Label="Rate"
                                      Placeholder="Exchange rate value"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formFee"
                                      Label="Fee"
                                      Placeholder="Transaction fee" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formEffectivity"
                                      Label="Effectivity Date (UTC)"
                                      Placeholder="YYYY-MM-DD HH:mm" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formExpiry"
                                      Label="Expiry Date (UTC)"
                                      Placeholder="YYYY-MM-DD HH:mm" />
                    break;
            }
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _dialogOpen = false)">Cancel</BbButton>
            <BbButton OnClick="@SaveRecord" Disabled="@_saving">@(_isEditing ? "Update" : "Create")</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@* -- Delete Confirmation Dialog -- *@
<ConfirmDeleteDialog Open="@_deleteDialogOpen"
                     OpenChanged="@(v => _deleteDialogOpen = v)"
                     Message="@($"Delete \"{_deleteName}\"?")"
                     OnConfirm="@ConfirmDelete" />

@code {
    [Inject] private IServiceProvider Services { get; set; } = default!;
    [Inject] private RequestMetadata RequestMetadata { get; set; } = default!;
    [Inject] private ILogger<ReferenceData> Logger { get; set; } = default!;
    private BaseModel? _editingRecord;
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    private bool _loading = true;
    private bool _dialogOpen;
    private bool _deleteDialogOpen;
    private bool _isEditing;
    private bool _saving;
    private string _activeTab = "role-types";
    private bool _activeTabLoading;
    private string _categorySearch = "";
    private readonly HashSet<string> _loadedTabs = [];

    private static readonly List<ReferenceCategory> _referenceCategories =
    [
        new("role-types", "Role Types", "Identity"),
        new("role-type-groups", "Role Groups", "Identity"),
        new("contact-types", "Contact Types", "Profile Data"),
        new("contact-groups", "Contact Groups", "Profile Data"),
        new("address-types", "Address Types", "Profile Data"),
        new("verification-types", "Verification Types", "Security"),
        new("session-types", "Session Types", "Security"),
        new("wallet-types", "Wallet Types", "Finance"),
        new("currency-types", "Currency Types", "Finance"),
        new("exchange-rates", "Exchange Rates", "Finance")
    ];

