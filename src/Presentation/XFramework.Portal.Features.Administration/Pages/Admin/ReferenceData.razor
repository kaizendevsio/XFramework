    protected override async Task OnInitializedAsync()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        _loading = true;
        try
        {
            await ReloadActiveTab();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnTenantChanged() => _ = InvokeAsync(async () =>
    {
        _dialogOpen = false;
        _deleteDialogOpen = false;
        _loadedTabs.Clear();
        _roleTypes = [];
        _roleTypeGroups = [];
        _contactTypes = [];
        _contactGroups = [];
        _addressTypes = [];
        _verificationTypes = [];
        _sessionTypes = [];
        _walletTypes = [];
        _currencyTypes = [];
        _exchangeRates = [];
        await ReloadActiveTab();
        StateHasChanged();
    });

    public void Dispose() => TenantFilter.OnChanged -= OnTenantChanged;

    private async Task OnReferenceCategoryChanged(string? value)
    {
        var nextTab = string.IsNullOrWhiteSpace(value) ? "role-types" : value;
        if (_activeTab == nextTab)
        {
            return;
        }

        _activeTab = nextTab;
        if (_loadedTabs.Contains(_activeTab))
        {
            return;
        }

        _activeTabLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await ReloadActiveTab();
        }
        finally
        {
            _activeTabLoading = false;
        }
    }

    private async Task LoadAllData()
    {
        _roleTypes = await LoadList<IdentityRoleType>();
        _roleTypeGroups = await LoadList<IdentityRoleTypeGroup>();
        _contactTypes = await LoadList<IdentityContactType>();
        _contactGroups = await LoadList<IdentityContactGroup>();
        _addressTypes = await LoadList<IdentityAddressType>();
        _verificationTypes = await LoadList<IdentityVerificationType>();
        _sessionTypes = await LoadList<SessionType>();
        _walletTypes = await LoadList<global::Wallets.Domain.Shared.Contracts.WalletType>();
        _currencyTypes = await LoadList<global::Wallets.Domain.Shared.Contracts.CurrencyType>();
        _exchangeRates = await LoadList<ExchangeRate>();
    }

    private async Task ReloadActiveTab()
    {
        try
        {
            switch (_activeTab)
            {
                case "role-types":
                    _roleTypes = await LoadList<IdentityRoleType>();
                    _roleTypeGroups = await LoadList<IdentityRoleTypeGroup>();
                    break;
                case "role-type-groups":
                    _roleTypeGroups = await LoadList<IdentityRoleTypeGroup>();
                    break;
                case "contact-types":
                    _contactTypes = await LoadList<IdentityContactType>();
                    break;
                case "contact-groups":
                    _contactGroups = await LoadList<IdentityContactGroup>();
                    break;
                case "address-types":
                    _addressTypes = await LoadList<IdentityAddressType>();
                    break;
                case "verification-types":
                    _verificationTypes = await LoadList<IdentityVerificationType>();
                    break;
                case "session-types":
                    _sessionTypes = await LoadList<SessionType>();
                    break;
                case "wallet-types":
                    _walletTypes = await LoadList<global::Wallets.Domain.Shared.Contracts.WalletType>();
                    break;
                case "currency-types":
                    _currencyTypes = await LoadList<global::Wallets.Domain.Shared.Contracts.CurrencyType>();
                    break;
                case "exchange-rates":
                    _exchangeRates = await LoadList<ExchangeRate>();
                    break;
            }

            _loadedTabs.Add(_activeTab);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load reference data category {Category}", _activeTab);
            ToastService.Show("Could not load reference data. Check your tenant and permissions, then try again.");
        }
    }

    private async Task<List<T>> LoadList<T>(int take = 100) where T : BaseModel =>
        await DataContext.Query<T>()
            .NoCache()
            .Where(x => !x.IsDeleted)
            .OrderByDescending(x => x.CreatedAt)
            .Take(take)
            .ToListAsync();

