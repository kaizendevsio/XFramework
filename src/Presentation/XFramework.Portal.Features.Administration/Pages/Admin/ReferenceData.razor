    private Guid ParseSystemRef() =>
        Guid.TryParse(_formSystemRef, out var id) ? id : Guid.NewGuid();

    private async Task SaveRoleType()
    {
        var name = (_formName ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(name)) { ToastService.Show("Name is required."); return; }

        if (!Guid.TryParse(_formGroupId, out var groupId) || groupId == Guid.Empty)
        {
            ToastService.Show("Role group is required.");
            return;
        }

        await PersistAndClose<IdentityRoleType>(entity =>
        {
            entity.Name = name;
            entity.RoleLevel = short.TryParse(_formLevel, out var lv) ? lv : null;
            entity.GroupId = groupId;
            entity.SystemReferenceId = ParseSystemRef();
        });
    }

