            entity.CurrencyIsoCode3 = string.IsNullOrWhiteSpace(_formCurrencyCode) ? null : _formCurrencyCode;
            entity.Description = string.IsNullOrWhiteSpace(_formDescription) ? null : _formDescription;
        });
    }

    private async Task SaveExchangeRate()
    {
        if (!Guid.TryParse(_formSourceCurrency, out var sourceId) || !Guid.TryParse(_formTargetCurrency, out var targetId))
        {
            ToastService.Show("Source and Target Currency IDs must be valid GUIDs.");
            return;
        }

        if (!decimal.TryParse(_formValue, out var rate))
        {
            ToastService.Show("Rate must be a valid number.");
            return;
        }

        await PersistAndClose<ExchangeRate>(entity =>
        {
            entity.SourceCurrencyTypeId = sourceId;
            entity.TargetCurrencyTypeId = targetId;
            entity.Value = rate;
            entity.Fee = decimal.TryParse(_formFee, out var fee) ? fee : null;
            entity.EffectivityDate = DateTime.TryParse(_formEffectivity, out var eff) ? DateTime.SpecifyKind(eff, DateTimeKind.Utc) : null;
            entity.ExpiryDate = DateTime.TryParse(_formExpiry, out var exp) ? DateTime.SpecifyKind(exp, DateTimeKind.Utc) : null;
        });
    }

    // Keep each save isolated: failed remote batches remain queued in their context.
    // Reuse this circuit's service provider so the actor token is preserved.
    // Match Portal's uncached registration; client-cache services are not registered by the host.
    private IDataContext CreateMutationContext(Guid tenantId) =>
        new RemoteDataContext(Services, new RequestMetadata { RequestedTenantId = tenantId });

    private async Task PersistAndClose<T>(Action<T> applyChanges) where T : BaseModel, new()
    {
        var tenantId = _isEditing ? _editingRecord?.TenantId : RequestMetadata.RequestedTenantId;
        if (tenantId is null || tenantId == Guid.Empty)
        {
            ToastService.Show("Select a tenant before adding reference data. Global reference data cannot be changed here.");
            return;
        }

        var context = CreateMutationContext(tenantId.Value);
        T entity;
        if (_isEditing)
        {
            // Query in the mutation context so Update sends a field patch, not a full replacement.
            var current = await context.Query<T>().NoCache().Where(x => x.Id == _editingId).FirstOrDefaultAsync();
            if (current is null || current.ConcurrencyStamp != _editingRecord?.ConcurrencyStamp)
            {
                ToastService.Show("This record changed or was removed. Reload it before editing.");
                return;
            }
            entity = current;
        }
        else
        {
            entity = new T
            {
                Id = Guid.NewGuid(),
                TenantId = tenantId.Value,
                CreatedAt = DateTime.UtcNow,
                IsEnabled = true,
                ConcurrencyStamp = Guid.NewGuid()
            };
        }

        applyChanges(entity);
        if (entity is IHasSystemReferenceId systemReference && systemReference.SystemReferenceId == Guid.Empty)
            systemReference.SystemReferenceId = Guid.NewGuid();

        if (_isEditing)
            context.Update(entity);
        else
            context.Add(entity);

        var result = await context.SaveChangesAsync();
        if (!result.IsSuccess)
        {
            ToastService.Show($"Error: {result.Message}");
            return;
        }

        ToastService.Show(_isEditing ? $"{TabDisplayName} updated." : $"{TabDisplayName} created.");
        _dialogOpen = false;
        await ReloadActiveTab();
    }
