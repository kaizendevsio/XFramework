        @* -- Currency Types -- *@
        <BbTabsContent Value="currency-types" Class="xf-fade-in">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Currency Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
