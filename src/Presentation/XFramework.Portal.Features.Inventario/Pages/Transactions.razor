@page "/inventario/transactions"
@using Microsoft.Extensions.Logging
@using global::POS.Integration.Drivers
@using global::POS.Domain.Shared.Contracts.Requests
@using global::POS.Domain.Shared.Contracts.Responses
@using DataGridRequest = BlazorBlueprint.Primitives.DataGrid.DataGridRequest
@implements IDisposable
@inject IPOSServiceWrapper POS
@inject IInventarioServiceWrapper Inventario
@inject IPortalTenantContext Tenant
@inject IPortalModuleAvailability Modules
@inject ILogger<Transactions> Logger

<PageTitle>Inventario Sales Transactions - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (_tenantId is null)
{
    <ModuleUnavailable ModuleName="Inventario" RequiresTenant="true" />
}
else if (!_enabled)
{
    <ModuleUnavailable ModuleName="Sales Transactions" />
}
else
{
    <div class="space-y-6 inv-page" data-testid="inventory-transactions-surface">
        <div class="xf-page-header">
            <div>
                <BbTypographyH3>Sales Transactions</BbTypographyH3>
                <BbTypographyMuted>@(_source == "pos" ? "Completed POS sales. After line discounts; before receipt discounts, tax and refunds." : "Direct inventory sales. Recorded totals have no currency metadata.")</BbTypographyMuted>
            </div>
            <div class="xf-page-actions">
                <BbButton Variant="ButtonVariant.Outline" OnClick="Reload"><LucideIcon Name="refresh-cw" Size="16" />Refresh</BbButton>
            </div>
        </div>
        <BbTabs Value="@_source" ValueChanged="ChangeSource">
        <BbTabsList aria-label="Sales source">
            @if (_inventoryEnabled) { <BbTabsTrigger Value="inventory">Inventory sales</BbTabsTrigger> }
            @if (_posEnabled) { <BbTabsTrigger Value="pos">POS product sales</BbTabsTrigger> }
        </BbTabsList>
        <BbTabsContent Value="@_source" Class="space-y-4">
        <div class="sales-dates" data-testid="transaction-date-filter">
            <BbLabel>@(_source == "pos" ? "Completion dates (UTC)" : "Transaction dates (UTC)")</BbLabel>
            <BbDateRangePicker Value="_dates" ValueChanged="ChangeDates" MaxDays="366" ShowPresets="true" AriaLabel="Sales date range UTC" />
        </div>
        @if (_error is not null)
        {
            <BbAlert role="alert"><BbAlertDescription>@_error</BbAlertDescription></BbAlert>
        }
        <BbDataGrid @key="_revision" TData="SalesSummaryRow" ItemsProvider="LoadSales" ShowPagination="true" InitialPageSize="20" PageSizes="@(new[] { 20, 50, 100 })">
            <Columns>
                <BbDataGridPropertyColumn Property="@(x => x.ProductName)" Title="Product" Filterable="true" Sortable="false" />
                <BbDataGridPropertyColumn Property="@(x => x.VariantName)" Title="Variant" Sortable="false" />
                <BbDataGridPropertyColumn Property="@(x => x.SKU)" Title="SKU" Sortable="false" />
                <BbDataGridPropertyColumn Property="@(x => x.Quantity)" Title="Quantity sold" Format="0.####" Sortable="false" />
                @if (_source == "pos")
                {
                <BbDataGridTemplateColumn Title="Currency">
                    <ChildContent Context="row"><span title="@row.CurrencyId">@CurrencyLabel(row.CurrencyId)</span></ChildContent>
                </BbDataGridTemplateColumn>
                }
                <BbDataGridPropertyColumn Property="@(x => x.SalesAmount)" Title="@(_source == "pos" ? "Product revenue" : "Recorded revenue")" Format="N2" Sortable="false" />
            </Columns>
            <EmptyTemplate>
                <BbEmpty Title="@(_error is null ? "No sold products in this date range" : "Sales summary unavailable")" />
            </EmptyTemplate>
        </BbDataGrid>
        </BbTabsContent>
        </BbTabs>
    </div>
}

@code {
    private DateRange _dates = DateRange.Create(DateTime.UtcNow.Date.AddDays(-29), DateTime.UtcNow.Date);
    private DateTime _fromUtc, _toUtc;
    private Guid? _tenantId;
    private bool _loading = true, _enabled, _inventoryEnabled, _posEnabled, _disposed;
    private string _source = "pos";
    private int _revision;
    private string? _error;
    private Dictionary<Guid, string> _currencies = [];
    private CancellationTokenSource _load = new();

    protected override async Task OnInitializedAsync()
    {
        Tenant.OnChanged += OnScopeChanged;
        Modules.OnChanged += OnScopeChanged;
        await Reload();
    }

    private void OnScopeChanged() => _ = InvokeAsync(Reload);
    private async Task ChangeDates(DateRange dates) { _dates = dates; await Reload(); }
    private async Task ChangeSource(string source) { _source = source; await Reload(); }

    private async Task Reload()
    {
        if (_disposed) return;
        _load.Cancel(); _load.Dispose(); _load = new();
        var revision = ++_revision;
        _loading = true; _error = null; _currencies = [];
        _tenantId = Tenant.SelectedTenantId;
        try
        {
            await Modules.EnsureLoadedAsync(_load.Token);
            if (revision != _revision || _disposed) return;
            _inventoryEnabled = Modules.IsFeatureEnabled(TenantModuleFeatureKeys.InventarioTransactions);
            _posEnabled = Modules.IsFeatureEnabled(TenantModuleFeatureKeys.Pos, TenantModuleFeatureKeys.PosReportingSubFeature);
            _enabled = _inventoryEnabled || _posEnabled;
            if (_source == "inventory" && !_inventoryEnabled) _source = "pos";
            else if (_source == "pos" && !_posEnabled) _source = "inventory";
            _fromUtc = DateTime.SpecifyKind(_dates.Start.Date, DateTimeKind.Utc);
            _toUtc = DateTime.SpecifyKind(_dates.End.Date, DateTimeKind.Utc).AddDays(1);
            if (_toUtc <= _fromUtc || _toUtc - _fromUtc > TimeSpan.FromDays(366))
                _error = "Choose a date range of 1-366 days.";
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load sold-product report scope");
            if (revision == _revision) _error = "Could not load sales summary. Refresh to retry.";
        }
        finally
        {
            if (!_disposed && revision == _revision) { _loading = false; StateHasChanged(); }
        }
    }

    private async ValueTask<BlazorBlueprint.Primitives.DataGrid.DataGridResult<SalesSummaryRow>> LoadSales(DataGridRequest request)
    {
        var revision = _revision;
        var tenantId = _tenantId;
        if (_disposed || _loading || !_enabled || tenantId is null || _error is not null)
            return new() { Items = [], TotalItemCount = 0 };
        using var linked = CancellationTokenSource.CreateLinkedTokenSource(_load.Token, request.CancellationToken);
        try
        {
            var filter = request.Filters?.GetValueOrDefault(nameof(SalesSummaryRow.ProductName));
            if (_source == "inventory")
            {
                var inventory = await Inventario.GetInventoryProductSales(new()
                {
                    Metadata = new() { RequestedTenantId = tenantId }, FromUtc = _fromUtc, ToUtcExclusive = _toUtc,
                    Skip = Math.Max(0, request.StartIndex), Take = Math.Clamp(request.Count ?? 20, 1, 100),
                    ProductFilter = Convert.ToString(filter?.Value), ProductFilterOperator = filter?.Operator.ToString()
                }, linked.Token);
                if (!IsCurrent(revision, tenantId) || linked.IsCancellationRequested) return new() { Items = [], TotalItemCount = 0 };
                if (!inventory.IsSuccess || inventory.Response is null) throw new InvalidOperationException("Inventory product-sales report was unavailable.");
                return new() { Items = inventory.Response.Rows.Select(x => new SalesSummaryRow(x.ProductName, x.VariantName, x.SKU,
                    Guid.Empty, x.Quantity, x.RecordedRevenue)).ToList(), TotalItemCount = inventory.Response.TotalCount };
            }
            var response = await POS.GetPosProductSalesReport(new()
            {
                Metadata = new() { RequestedTenantId = tenantId }, FromUtc = _fromUtc, ToUtcExclusive = _toUtc,
                Skip = Math.Max(0, request.StartIndex), Take = Math.Clamp(request.Count ?? 20, 1, 100),
                ProductFilter = Convert.ToString(filter?.Value), ProductFilterOperator = filter?.Operator.ToString()
            }, linked.Token);
            if (!IsCurrent(revision, tenantId) || linked.IsCancellationRequested) return new() { Items = [], TotalItemCount = 0 };
            if (!response.IsSuccess || response.Response is null) throw new InvalidOperationException("POS product-sales report was unavailable.");
            _currencies = response.Response.CurrencyLabels.ToDictionary(x => x.CurrencyId, x => x.Label);
            await InvokeAsync(StateHasChanged);
            return new() { Items = response.Response.Rows.Select(x => new SalesSummaryRow(x.ProductName, x.VariantName, x.SKU,
                x.CurrencyId, x.Quantity, x.SalesAmount)).ToList(), TotalItemCount = response.Response.TotalCount };
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load sold-product report for tenant {TenantId}", tenantId);
            if (IsCurrent(revision, tenantId))
            {
                _error = "Could not load sales summary. Refresh to retry.";
                await InvokeAsync(StateHasChanged);
            }
        }
        return new() { Items = [], TotalItemCount = 0 };
    }

    private bool IsCurrent(int revision, Guid? tenantId) => !_disposed && revision == _revision && tenantId == Tenant.SelectedTenantId;
    private string CurrencyLabel(Guid id) => _currencies.GetValueOrDefault(id, $"Unknown ({id.ToString()[..8]})");
    private sealed record SalesSummaryRow(string ProductName, string? VariantName, string? SKU,
        Guid CurrencyId, decimal Quantity, decimal SalesAmount);
    public void Dispose()
    {
        _disposed = true; _load.Cancel(); _load.Dispose();
        Tenant.OnChanged -= OnScopeChanged;
        Modules.OnChanged -= OnScopeChanged;
    }
}
