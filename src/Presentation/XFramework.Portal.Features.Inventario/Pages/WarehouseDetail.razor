@page "/inventario/warehouses/{Id:guid}"
@using XFramework.Domain.Shared.DataContext
@using XFramework.Inventario.Domain.Shared.Contracts.Requests.Locations
@using XFramework.Inventario.Domain.Shared.Enums
@implements IDisposable

<PageTitle>Inventario Warehouse - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_hasTenant)
{
    <ModuleUnavailable ModuleName="Inventario" RequiresTenant="true" />
}
else if (!_warehousingEnabled)
{
    <ModuleUnavailable ModuleName="Inventario Warehousing" />
}
else if (_outsideTenantContext)
{
    <div class="space-y-4">
        <BbButton Variant="ButtonVariant.Ghost" OnClick="@(() => Navigation.NavigateTo("/inventario/warehouses"))">
            <LucideIcon Name="arrow-left" class="mr-2 h-4 w-4" />
            Back to Warehouses
        </BbButton>
        <BbAlert>
            <BbAlertTitle>Warehouse Outside Active Tenant</BbAlertTitle>
            <BbAlertDescription>Switch to this warehouse's tenant to view its details.</BbAlertDescription>
        </BbAlert>
    </div>
}
else if (_warehouse is null)
{
    <BbTypographyMuted>Warehouse not found.</BbTypographyMuted>
}
else
{
    <FadeInContent>
        <div class="space-y-6 inv-page">
            <div class="flex items-center gap-4">
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Back to warehouses"
                          OnClick="@(() => Navigation.NavigateTo("/inventario/warehouses"))">
                    <LucideIcon Name="arrow-left" class="h-4 w-4" />
                </BbButton>
                <div class="flex-1">
                    <div class="flex items-center gap-2">
                        <BbTypographyH3>@_warehouse.Name</BbTypographyH3>
                        <StatusBadge Text="@(_warehouse.IsDefault ? "Default" : "Standard")"
                                     Status="@(_warehouse.IsDefault ? "active" : "inactive")" />
                    </div>
                    <BbTypographyMuted>@_warehouse.Code - ID: @_warehouse.Id</BbTypographyMuted>
                </div>
                <div class="xf-page-actions">
                    <BbButton OnClick="@OpenLocationDialog">
                        <LucideIcon Name="map-pin-plus" class="mr-2 h-4 w-4" />
                        Create Location
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@Reload">
                        <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                        Refresh
                    </BbButton>
                </div>
            </div>

            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Warehouse Summary</BbCardTitle>
                    <BbCardDescription>Storage facility details for the selected tenant.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>@if (_maintenanceEditing)
                    {
                        @if (_maintenanceError is not null) { <BbAlert><BbAlertDescription>@_maintenanceError</BbAlertDescription></BbAlert> }
                        <div class="xf-detail-field-grid"><BbFormFieldInput TValue="string" @bind-Value="_editName" Label="Name" />
<BbFormFieldInput TValue="string" @bind-Value="_editDescription" Label="Description" />
<BbFormFieldInput TValue="string" @bind-Value="_editAddressLine" Label="Address Line" />
<BbFormFieldInput TValue="string" @bind-Value="_editCity" Label="City" />
<BbFormFieldInput TValue="string" @bind-Value="_editRegion" Label="Region" />
<BbFormFieldInput TValue="string" @bind-Value="_editPostalCode" Label="Postal Code" />
<BbFormFieldInput TValue="string" @bind-Value="_editCountryCode" Label="Country code (SG, PHL)" />
</div>
                        <p class="text-sm text-muted-foreground">Identity and existing stock quantities remain unchanged. </p>
                        <div class="xf-page-actions"><BbButton OnClick="@SaveMaintenance" Disabled="@_maintenanceSaving">Save changes</BbButton><BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _maintenanceEditing = false)" Disabled="@_maintenanceSaving">Discard</BbButton></div>
                    }
                    else
                    {
                        <BbButton Variant="ButtonVariant.Outline" OnClick="@BeginMaintenance">Edit details</BbButton>

                    <div class="grid gap-4 md:grid-cols-2">
                        <div>
                            <BbTypographyMuted>Code</BbTypographyMuted>
                            <div class="font-mono">@_warehouse.Code</div>
                        </div>
                        <div>
                            <BbTypographyMuted>Name</BbTypographyMuted>
                            <div>@_warehouse.Name</div>
                        </div>
                        <div>
                            <BbTypographyMuted>Address</BbTypographyMuted>
                            <div>@FormatAddress(_warehouse)</div>
                        </div>
                        <div>
                            <BbTypographyMuted>Created</BbTypographyMuted>
                            <div>@_warehouse.CreatedAt.ToLocalTime().ToString("g")</div>
                        </div>
                        <div class="md:col-span-2">
                            <BbTypographyMuted>Description</BbTypographyMuted>
                            <div>@(_warehouse.Description ?? "No description")</div>
                        </div>
                    </div>

                    }
</BbCardContent>
            </BbCard>

            <div class="xf-summary-grid xf-summary-grid-3">
                <BbCard>
                    <BbCardContent>
                        <div class="space-y-1 pt-4">
                            <BbTypographyMuted>Locations</BbTypographyMuted>
                            <BbTypographyH3>@_locations.Count</BbTypographyH3>
                        </div>
                    </BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardContent>
                        <div class="space-y-1 pt-4">
                            <BbTypographyMuted>Stock Balances</BbTypographyMuted>
                            <BbTypographyH3>@_balances.Count</BbTypographyH3>
                        </div>
                    </BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardContent>
                        <div class="space-y-1 pt-4">
                            <BbTypographyMuted>Recent Movements</BbTypographyMuted>
                            <BbTypographyH3>@_movements.Count</BbTypographyH3>
                        </div>
                    </BbCardContent>
                </BbCard>
            </div>

            <BbTabs DefaultValue="view0" Class="inv-workspace-tabs"><BbTabsList><BbTabsTrigger Value="view0">Locations</BbTabsTrigger><BbTabsTrigger Value="view1">Balances</BbTabsTrigger><BbTabsTrigger Value="view2">Movements</BbTabsTrigger></BbTabsList><BbTabsContent Value="view0" ForceMount="true"><BbCard>
                <BbCardHeader>
                    <BbCardTitle>Locations</BbCardTitle>
                    <BbCardDescription>Internal positions inside this warehouse.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataGrid Items="@_locations" ShowPagination="true" InitialPageSize="10"
                                OnRowClick="@((InventoryLocation item) => Navigation.NavigateTo($"/inventario/locations/{item.Id}"))"
                                Class="cursor-pointer">
                        <Columns>
                            <BbDataGridPropertyColumn Property="@(x => x.Code)" Title="Code" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.LocationType)" Title="Type" Sortable="true" Filterable="true" />
                            <InventoryTemplateColumn Title="Pickable" Filterable="true" SortBy="@(item => item.IsPickable ? "Pickable" : "Storage")" FilterBy="@(item => item.IsPickable ? "Pickable" : "Storage")">
                                <ChildContent Context="item">
                                    <StatusBadge Text="@(item.IsPickable ? "Pickable" : "Storage")" Status="@(item.IsPickable ? "active" : "inactive")" />
                                </ChildContent>
                            </InventoryTemplateColumn>
                        </Columns>
                    </BbDataGrid>
                </BbCardContent>
            </BbCard></BbTabsContent>

            <BbTabsContent Value="view1" ForceMount="true"><BbCard>
                <BbCardHeader>
                    <BbCardTitle>Stock Balances</BbCardTitle>
                    <BbCardDescription>Current balances held in this warehouse.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataGrid Items="@_balances" ShowPagination="true" InitialPageSize="10"
                                OnRowClick="@((StockBalance item) => Navigation.NavigateTo($"/inventario/stock/balances/{item.Id}"))"
                                Class="cursor-pointer">
                        <Columns><InventoryTemplateColumn Title="Variant" Filterable="true" SortBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))" FilterBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))"><ChildContent Context="item">@InventoryDisplay.Variant(_variants, item.ProductVariationId)</ChildContent></InventoryTemplateColumn><InventoryTemplateColumn Title="Lot" Filterable="true" SortBy="@(item => IdentityLotLabel(item.LotId))" FilterBy="@(item => IdentityLotLabel(item.LotId))"><ChildContent Context="item">@(_identityLots.FirstOrDefault(x => x.Id == item.LotId)?.LotNumber ?? "Untracked")</ChildContent></InventoryTemplateColumn>
                            <InventoryTemplateColumn Title="Product" Filterable="true" SortBy="@(item => GetProductName(item.ProductId))" FilterBy="@(item => GetProductName(item.ProductId))">
                                <ChildContent Context="item">@GetProductName(item.ProductId)</ChildContent>
                            </InventoryTemplateColumn>
                            <InventoryTemplateColumn Title="Location" Filterable="true" SortBy="@(item => GetLocationName(item.LocationId))" FilterBy="@(item => GetLocationName(item.LocationId))">
                                <ChildContent Context="item">@GetLocationName(item.LocationId)</ChildContent>
                            </InventoryTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.OnHandQuantity)" Title="On Hand" Format="0.####" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.ReservedQuantity)" Title="Reserved" Format="0.####" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.AvailableQuantity)" Title="Available" Format="0.####" Sortable="true" Filterable="true" />
                        </Columns>
                    </BbDataGrid>
                </BbCardContent>
            </BbCard></BbTabsContent>

            <BbTabsContent Value="view2" ForceMount="true"><BbCard>
                <BbCardHeader>
                    <BbCardTitle>Recent Movements</BbCardTitle>
                    <BbCardDescription>Latest movement ledger entries for this warehouse.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataGrid Items="@_movements" ShowPagination="true" InitialPageSize="10"
                                OnRowClick="@((InventoryMovement item) => Navigation.NavigateTo($"/inventario/stock/movements/{item.Id}"))"
                                Class="cursor-pointer">
                        <Columns><InventoryTemplateColumn Title="Variant" Filterable="true" SortBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))" FilterBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))"><ChildContent Context="item">@InventoryDisplay.Variant(_variants, item.ProductVariationId)</ChildContent></InventoryTemplateColumn><InventoryTemplateColumn Title="Lot" Filterable="true" SortBy="@(item => IdentityLotLabel(item.LotId))" FilterBy="@(item => IdentityLotLabel(item.LotId))"><ChildContent Context="item">@(_identityLots.FirstOrDefault(x => x.Id == item.LotId)?.LotNumber ?? "Untracked")</ChildContent></InventoryTemplateColumn>
                            <InventoryTemplateColumn Title="Product" Filterable="true" SortBy="@(item => GetProductName(item.ProductId))" FilterBy="@(item => GetProductName(item.ProductId))">
                                <ChildContent Context="item">@GetProductName(item.ProductId)</ChildContent>
                            </InventoryTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.MovementType)" Title="Type" Sortable="true" Filterable="true" />
                            <InventoryTemplateColumn Title="Affects" Filterable="true" SortBy="@(item => InventoryDisplay.Effect(item.MovementType))" FilterBy="@(item => InventoryDisplay.Effect(item.MovementType))"><ChildContent Context="item">@InventoryDisplay.Effect(item.MovementType)</ChildContent></InventoryTemplateColumn>
<BbDataGridPropertyColumn Property="@(x => x.QuantityDelta)" Title="Delta" Format="0.####" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.QuantityAfter)" Title="On hand after" Format="0.####" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.MovementDate)" Title="Movement Date" Sortable="true" Filterable="true" />
                        </Columns>
                    </BbDataGrid>
                </BbCardContent>
            </BbCard></BbTabsContent></BbTabs>
        </div>
    </FadeInContent>
}

<BbDialog Open="@_locationDialogOpen" OpenChanged="@(value => _locationDialogOpen = value)">
    <BbDialogContent Class="xf-dialog-wide inv-dialog">
        <BbDialogHeader>
            <BbDialogTitle>Create Location</BbDialogTitle>
            <BbDialogDescription>Add a bin, shelf, or zone inside @_warehouse?.Name.</BbDialogDescription>
        </BbDialogHeader>
        <div class="grid gap-4 py-4 inv-dialog-body">
            <div class="grid gap-3 md:grid-cols-2">
                <BbFormFieldInput TValue="string" @bind-Value="_locationForm.Code" Label="Code" Required="true" />
                <BbFormFieldInput TValue="string" @bind-Value="_locationForm.Name" Label="Name" Required="true" />
            </div>
            <InventorySelect TValue="string" @bind-Value="_locationForm.LocationType" Label="Location Type">
                @foreach (var type in Enum.GetValues<InventoryLocationType>())
                {
                    <BbSelectItem Value="@type.ToString()">@type</BbSelectItem>
                }
            </InventorySelect>
            <BbFormFieldInput TValue="string" @bind-Value="_locationForm.Description" Label="Description" />
            <BbFormFieldSwitch Checked="@_locationForm.IsPickable"
                               CheckedChanged="@((bool value) => _locationForm.IsPickable = value)"
                               Label="Pickable location" />
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _locationDialogOpen = false)">Cancel</BbButton>
            <BbButton OnClick="@CreateLocation" Disabled="@_savingLocation">Create</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private string IdentityLotLabel(Guid? id) => _identityLots.FirstOrDefault(x => x.Id == id)?.LotNumber ?? "Untracked";
    private List<ProductVariation> _variants = [];
    private List<InventoryLot> _identityLots = [];
    [Parameter] public Guid Id { get; set; }

    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private IInventarioServiceWrapper Inventario { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private IPortalModuleAvailability ModuleNavigation { get; set; } = default!;

    private Warehouse? _warehouse;
    private List<InventoryLocation> _locations = [];
    private List<StockBalance> _balances = [];
    private List<InventoryMovement> _movements = [];
    private Dictionary<Guid, string> _productNames = [];
    private readonly LocationForm _locationForm = new();
    private bool _loading = true;
    private bool _hasTenant;
    private bool _warehousingEnabled;
    private bool _outsideTenantContext;
    private bool _locationDialogOpen;
    private bool _savingLocation;
    private bool _reloading;
    private Guid? _loadedId;

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        ModuleNavigation.OnChanged += OnTenantChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id) return;
        _loadedId = Id;
        await Reload();
    }

    private void OnTenantChanged()
    {
        if (_reloading) return;
        _ = InvokeAsync(Reload);
    }

    private async Task Reload()
    {
        if (_reloading) return;

        _reloading = true;
        _loading = true;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _warehousingEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "warehousing");
            _outsideTenantContext = false;
            _warehouse = null;
            _locations = [];
            _balances = [];
            _movements = [];
            _productNames = [];

            if (!_hasTenant || !_warehousingEnabled) return;

            _warehouse = await DataContext.Query<Warehouse>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id && !x.IsDeleted)
                .FirstOrDefaultAsync();

            _outsideTenantContext = _warehouse is not null && _warehouse.TenantId != TenantFilter.SelectedTenantId;
            if (_warehouse is null || _outsideTenantContext) return;

            var tenantId = _warehouse.TenantId;
            _variants = await DataContext.Query<ProductVariation>().NoCache().Where(x => x.TenantId == tenantId && !x.IsDeleted).Take(1000).ToListAsync();
            _identityLots = await DataContext.Query<InventoryLot>().NoCache().Where(x => x.TenantId == tenantId && !x.IsDeleted).Take(1000).ToListAsync();
            _locations = await DataContext.Query<InventoryLocation>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && x.WarehouseId == Id && !x.IsDeleted)
                .OrderBy(x => x.Code)
                .Take(200)
                .ToListAsync();

            _balances = await DataContext.Query<StockBalance>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && x.WarehouseId == Id && !x.IsDeleted)
                .OrderBy(x => x.ProductId)
                .Take(200)
                .ToListAsync();

            _movements = await DataContext.Query<InventoryMovement>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && x.WarehouseId == Id && !x.IsDeleted)
                .OrderByDescending(x => x.MovementDate)
                .Take(100)
                .ToListAsync();

            var productIds = _balances.Select(x => x.ProductId).Concat(_movements.Select(x => x.ProductId)).Distinct().ToList();
            if (productIds.Count > 0)
            {
                var products = await DataContext.Query<Product>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                    .Take(500)
                    .ToListAsync();
                _productNames = products
                    .Where(x => productIds.Contains(x.Id))
                    .ToDictionary(x => x.Id, x => x.Name ?? x.Id.ToString()[..8]);
            }
        }
        catch
        {
            ToastService.Show("Could not load warehouse.");
        }
        finally
        {
            _reloading = false;
            _loading = false;
            StateHasChanged();
        }
    }

    private void OpenLocationDialog()
    {
        _locationForm.Reset();
        _locationDialogOpen = true;
    }

    private async Task CreateLocation()
    {
        if (string.IsNullOrWhiteSpace(_locationForm.Code) || string.IsNullOrWhiteSpace(_locationForm.Name))
        {
            ToastService.Show("Location code and name are required.");
            return;
        }

        _savingLocation = true;
        try
        {
            var result = await Inventario.CreateInventoryLocation(new CreateInventoryLocationRequest
            {
                Metadata = BuildMetadata(),
                WarehouseId = Id,
                Code = _locationForm.Code,
                Name = _locationForm.Name,
                Description = NullIfEmpty(_locationForm.Description),
                LocationType = Enum.TryParse<InventoryLocationType>(_locationForm.LocationType, out var type)
                    ? type
                    : InventoryLocationType.Bin,
                IsPickable = _locationForm.IsPickable
            });
            ToastService.Show(result.IsSuccess ? "Location created." : "Could not create location.");
            if (result.IsSuccess)
            {
                _locationDialogOpen = false;
                await Reload();
            }
        }
        finally
        {
            _savingLocation = false;
        }
    }

    private RequestMetadata BuildMetadata() => new()
    {
        RequestedTenantId = TenantFilter.SelectedTenantId,
        RequestId = Guid.NewGuid(),
        OperationName = "Portal"
    };

    private string GetProductName(Guid productId) =>
        _productNames.TryGetValue(productId, out var name) ? name : productId.ToString()[..8];

    private string GetLocationName(Guid locationId) =>
        _locations.FirstOrDefault(x => x.Id == locationId)?.Name ?? locationId.ToString()[..8];

    private static string FormatAddress(Warehouse warehouse)
    {
        var parts = new[] { warehouse.AddressLine, warehouse.City, warehouse.Region, warehouse.PostalCode, warehouse.CountryCode }
            .Where(x => !string.IsNullOrWhiteSpace(x));
        var address = string.Join(", ", parts);
        return string.IsNullOrWhiteSpace(address) ? "N/A" : address;
    }

    private static string? NullIfEmpty(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantChanged;
        ModuleNavigation.OnChanged -= OnTenantChanged;
    }

    private sealed class LocationForm
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string LocationType { get; set; } = InventoryLocationType.Bin.ToString();
        public bool IsPickable { get; set; } = true;

        public void Reset()
        {
            Code = "";
            Name = "";
            Description = "";
            LocationType = InventoryLocationType.Bin.ToString();
            IsPickable = true;
        }
    }

    private string? _maintenanceError;
    private bool _maintenanceEditing;
    private bool _maintenanceSaving;
    private Guid _editStamp;
    private string _editName = "";
    private string _editDescription = "";
    private string _editAddressLine = "";
    private string _editCity = "";
    private string _editRegion = "";
    private string _editPostalCode = "";
    private string _editCountryCode = "";

    private void BeginMaintenance()
    {
        if (_warehouse is null) return;
        _editStamp = _warehouse.ConcurrencyStamp;
        _editName = _warehouse.Name ?? "";
        _editDescription = _warehouse.Description ?? "";
        _editAddressLine = _warehouse.AddressLine ?? "";
        _editCity = _warehouse.City ?? "";
        _editRegion = _warehouse.Region ?? "";
        _editPostalCode = _warehouse.PostalCode ?? "";
        _editCountryCode = _warehouse.CountryCode ?? "";
        _maintenanceError = null;
        _maintenanceEditing = true;
    }
    private async Task SaveMaintenance()
    {
        if (_warehouse is null || _maintenanceSaving) return;
        _maintenanceError = null;
        if (_editName.Length > 200) { _maintenanceError = "Name must be at most 200 characters."; return; }
        if (_editDescription.Length > 1000) { _maintenanceError = "Description must be at most 1000 characters."; return; }
        if (_editAddressLine.Length > 500) { _maintenanceError = "AddressLine must be at most 500 characters."; return; }
        if (_editCity.Length > 100) { _maintenanceError = "City must be at most 100 characters."; return; }
        if (_editRegion.Length > 100) { _maintenanceError = "Region must be at most 100 characters."; return; }
        if (_editPostalCode.Length > 25) { _maintenanceError = "PostalCode must be at most 25 characters."; return; }
        if (_editCountryCode.Length > 3) { _maintenanceError = "CountryCode must be at most 3 characters."; return; }
        if (string.IsNullOrWhiteSpace(_editName)) { _maintenanceError = "Name is required."; return; }
        _maintenanceSaving = true;
        try
        {
            var result = await Inventario.UpdateWarehouse(new UpdateWarehouseRequest
            {
                Metadata = new() { RequestedTenantId = TenantFilter.SelectedTenantId },
                Id = _warehouse.Id,
                ConcurrencyStamp = _editStamp,
                Name = _editName,
                Description = _editDescription,
                AddressLine = _editAddressLine,
                City = _editCity,
                Region = _editRegion,
                PostalCode = _editPostalCode,
                CountryCode = _editCountryCode,
            });
            if (result.IsSuccess)
            {
                _maintenanceEditing = false;
                ToastService.Success("Changes saved.");
                await Reload();
            }
            else ToastService.Error("Could not save. Check fields, release active reservations if changing eligibility, or refresh if another user edited this record.");
        }
        catch { ToastService.Error("Could not save changes. Refresh and try again."); }
        finally { _maintenanceSaving = false; }
    }
}
