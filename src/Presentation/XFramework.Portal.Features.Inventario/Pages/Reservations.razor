@page "/inventario/reservations"
@using XFramework.Domain.Shared.BusinessObjects
@using XFramework.Domain.Shared.DataContext
@using XFramework.Inventario.Domain.Shared.Contracts.Requests.Locations
@using XFramework.Inventario.Domain.Shared.Contracts.Requests.Reservations
@using XFramework.Inventario.Domain.Shared.Contracts.Requests.Warehouses
@using XFramework.Inventario.Domain.Shared.Enums
@implements IDisposable

<PageTitle>Inventario Reservations - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_hasTenant)
{
    <ModuleUnavailable ModuleName="Inventario" RequiresTenant="true" />
}
else if (!_reservationsEnabled)
{
    <ModuleUnavailable ModuleName="Inventario Reservations" />
}
else if (_loadError is not null)
{
    <BbAlert><BbAlertTitle>Reservations could not be loaded</BbAlertTitle><BbAlertDescription>@_loadError</BbAlertDescription></BbAlert>
    <BbButton Variant="ButtonVariant.Outline" OnClick="@Reload">Retry loading reservations</BbButton>
}
else
{
    <FadeInContent>
        <div class="space-y-6 inv-page">
            <div class="xf-page-header">
                <div>
                    <BbTypographyH3>Reservations</BbTypographyH3>
                    <BbTypographyMuted>Reserve, release, fulfill, and expire allocated inventory.</BbTypographyMuted>
                </div>
                <div class="xf-page-actions">
                    <BbButton OnClick="@OpenReservationDialog" Disabled="@(_products.Count == 0 || _warehouses.Count == 0 || _locations.Count == 0)">
                        <LucideIcon Name="clipboard-plus" class="mr-2 h-4 w-4" />
                        Reserve Inventory
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@ExpireDueReservations" Disabled="@_expiring">
                        <LucideIcon Name="timer" class="mr-2 h-4 w-4" />
                        Expire Due
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@Reload">
                        <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                        Refresh
                    </BbButton>
                </div>
            </div>

            <div class="xf-filter-actions">
                <BbFormFieldInput TValue="string" @bind-Value="_search" Label="Search reservations" />
                <InventorySelect TValue="string" @bind-Value="_view" Label="Status" DisplayTextSelector="@(value => value switch { "active" => "Active", "expiring" => "Due within 24 hours", "all" => "All history", _ => value })">
                    <BbSelectItem Value="@("active")">Active</BbSelectItem><BbSelectItem Value="@("expiring")">Due within 24 hours</BbSelectItem><BbSelectItem Value="@("all")">All history</BbSelectItem>
                    @foreach (var status in Enum.GetValues<ReservationStatus>()) { <BbSelectItem Value="@status.ToString()">@status</BbSelectItem> }
                </InventorySelect>
            </div><BbCard>
                <BbCardHeader>
                    <BbCardTitle>Reservation List</BbCardTitle>
                    <BbCardDescription>@_reservations.Count reservation(s) loaded</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataGrid Items="@_reservations.Where(MatchesReservation).ToList()" ShowPagination="true" InitialPageSize="20"
                                OnRowClick="@((Reservation item) => Navigation.NavigateTo($"/inventario/reservations/{item.Id}"))"
                                Class="cursor-pointer">
                        <Columns>
                            <InventoryTemplateColumn Title="Variant" Filterable="true" SortBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))" FilterBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))"><ChildContent Context="item">@InventoryDisplay.Variant(_variants, item.ProductVariationId)</ChildContent></InventoryTemplateColumn>
                            <InventoryTemplateColumn Title="Warehouse" Filterable="true" SortBy="@(item => GetWarehouseName(item.WarehouseId))" FilterBy="@(item => GetWarehouseName(item.WarehouseId))"><ChildContent Context="item">@GetWarehouseName(item.WarehouseId)</ChildContent></InventoryTemplateColumn>
                            <InventoryTemplateColumn Title="Allocated lots" Filterable="true" SortBy="@(item => AllocationLabel(item))" FilterBy="@(item => AllocationLabel(item))"><ChildContent Context="item">@AllocationLabel(item)</ChildContent></InventoryTemplateColumn>
                            <InventoryTemplateColumn Title="Product" Filterable="true" SortBy="@(item => GetProductName(item.ProductId))" FilterBy="@(item => GetProductName(item.ProductId))">
                                <ChildContent Context="item">@GetProductName(item.ProductId)</ChildContent>
                            </InventoryTemplateColumn>
                            <InventoryTemplateColumn Title="Location" Filterable="true" SortBy="@(item => GetLocationName(item.LocationId))" FilterBy="@(item => GetLocationName(item.LocationId))">
                                <ChildContent Context="item">@GetLocationName(item.LocationId)</ChildContent>
                            </InventoryTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.Quantity)" Title="Qty" Format="0.####" Sortable="true" Filterable="true" />
                            <InventoryTemplateColumn Title="Status" Filterable="true" SortBy="@(item => item.Status)" FilterBy="@(item => item.Status)">
                                <ChildContent Context="item">
                                    <StatusBadge Text="@item.Status.ToString()" Status="@GetStatusBadge(item.Status)" />
                                </ChildContent>
                            </InventoryTemplateColumn>
                            <InventoryTemplateColumn Title="Reference" Filterable="true" SortBy="@(item => InventoryDisplay.Reference(item.ReferenceType))" FilterBy="@(item => InventoryDisplay.Reference(item.ReferenceType))"><ChildContent Context="item">@InventoryDisplay.Reference(item.ReferenceType)</ChildContent></InventoryTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.ReservedAt)" Title="Reserved" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.ExpiresAt)" Title="Expires" Sortable="true" Filterable="true" />
                            <BbDataGridTemplateColumn Title="Actions">
                                <ChildContent Context="item">
                                    <div class="flex flex-wrap gap-1" @onclick:stopPropagation="true">
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="View reservation"
                                                  OnClick="@(() => Navigation.NavigateTo($"/inventario/reservations/{item.Id}"))">
                                            <LucideIcon Name="eye" class="h-4 w-4" />
                                        </BbButton>
                                        @if (item.Status == ReservationStatus.Active)
                                        {
                                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => ReleaseReservation(item.Id))">Release</BbButton>
                                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => FulfillReservation(item.Id))">Fulfill</BbButton>
                                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Destructive" OnClick="@(() => CancelReservation(item.Id))">Cancel</BbButton>
                                        }
                                    </div>
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                        </Columns>
                    </BbDataGrid>
                </BbCardContent>
            </BbCard>
        </div>
    </FadeInContent>
}

<BbDialog Open="@_reservationDialogOpen" OpenChanged="@(v => _reservationDialogOpen = v)">
    <BbDialogContent TrapFocus="false" Class="xf-dialog-wide inv-dialog">
        <BbDialogHeader>
            <BbDialogTitle>Reserve Inventory</BbDialogTitle>
            <BbDialogDescription>Reservations reduce available quantity without changing on-hand stock.</BbDialogDescription>
        </BbDialogHeader>
        <div class="grid gap-4 py-4 inv-dialog-body">
            <div class="grid gap-3 xl:grid-cols-3">
                <XfEntityPicker TItem="Product"
                                Value="@_form.ProductId"
                                ValueChanged="@OnReservationProductChanged"
                                Items="@_products"
                                Label="Product"
                                Placeholder="Select product"
                                SearchPlaceholder="Search products..."
                                EmptyMessage="No products found."
                                ValueSelector="@GetProductPickerValue"
                                TextSelector="@GetProductLabel"
                                SearchTextSelector="@GetProductSearchText"
                                AdvancedSearchTitle="Find Product"
                                AdvancedSearchDescription="Search products in the active tenant." />
                <XfEntityPicker TItem="Warehouse"
                                Value="@_form.WarehouseId"
                                ValueChanged="@OnReservationWarehouseChanged"
                                Items="@_warehouses"
                                Label="Warehouse"
                                Placeholder="Select warehouse"
                                SearchPlaceholder="Search warehouses..."
                                EmptyMessage="No warehouses found."
                                ValueSelector="@GetWarehousePickerValue"
                                TextSelector="@GetWarehouseLabel"
                                SearchTextSelector="@GetWarehouseSearchText"
                                AdvancedSearchTitle="Find Warehouse"
                                AdvancedSearchDescription="Search warehouses in the active tenant." />
                <XfEntityPicker TItem="InventoryLocation"
                                @bind-Value="_form.LocationId"
                                Items="@LocationsForSelectedWarehouse().ToList()"
                                Label="Location"
                                Placeholder="Select location"
                                SearchPlaceholder="Search locations..."
                                EmptyMessage="No locations found."
                                ValueSelector="@GetLocationPickerValue"
                                TextSelector="@GetLocationLabel"
                                SearchTextSelector="@GetLocationSearchText"
                                AdvancedSearchTitle="Find Location"
                                AdvancedSearchDescription="Search locations for the selected warehouse." />
            </div>
            <InventorySelect TValue="string" Value="@_form.ProductVariationId" ValueChanged="@((string value) => { _form.ProductVariationId = value; _form.LotId = ""; })" Label="Variant" DisplayTextSelector="@(value => InventoryDisplay.Variant(_variants, Guid.TryParse(value, out var id) ? id : null))">
                <BbSelectItem Value="@("base")">Base product</BbSelectItem>
                @foreach (var variant in _variants.Where(x => x.ProductId.ToString() == _form.ProductId))
                { <BbSelectItem Value="@variant.Id.ToString()">@InventoryDisplay.Variant(_variants, variant.Id)</BbSelectItem> }
            </InventorySelect>
            <p>Available stock: @AvailableStock.ToString("0.####"). Leaving the lot empty allocates eligible stock with the earliest expiry first.</p>
            @if (_traceabilityEnabled)
            {
                <div class="grid gap-3 md:grid-cols-2">
                    <XfEntityPicker TItem="InventoryLot"
                                    @bind-Value="_form.LotId"
                                    Items="@LotsForSelectedProduct().ToList()"
                                    Label="Lot / Batch"
                                    Placeholder="Earliest expiry first"
                                    SearchPlaceholder="Search lots..."
                                    EmptyMessage="No lots found."
                                    ValueSelector="@GetLotPickerValue"
                                    TextSelector="@GetLotLabel"
                                    SearchTextSelector="@GetLotSearchText"
                                    AllowClear="true"
                                    ClearText="Earliest expiry first"
                                    AdvancedSearchTitle="Find Lot / Batch"
                                    AdvancedSearchDescription="Search lots for the selected product." />
                    <BbFormFieldSwitch Checked="@_form.AllowExpiredLotOverride"
                                       CheckedChanged="@((bool value) => _form.AllowExpiredLotOverride = value)"
                                       Label="Allow expired lot override" />
                </div>
                @if (_form.AllowExpiredLotOverride)
                {
                    <BbFormFieldInput TValue="string" @bind-Value="_form.ExpiredLotOverrideReason" Label="Override Reason" />
                }
            }
            <div class="grid gap-3 md:grid-cols-3">
                <div>
                <BbFormFieldNumericInput TValue="decimal"
                                         @bind-Value="_form.Quantity"
                                         Label="Quantity"
                                         Min="0"
                                         DecimalPlaces="4"
                                         Step="1" />
                    @if (QuantityValidationMessage is { } quantityMessage)
                    {
                        <p role="alert" class="text-sm text-destructive">@quantityMessage</p>
                    }
                </div>
                <BbFormFieldDatePicker @bind-Value="_form.ExpiresAt" Label="Expires At" />
                <BbFormFieldInput TValue="string" @bind-Value="_form.ReferenceType" Label="Reference Type" />
            </div>
            @if (_reserveError is not null)
            {
                <BbAlert><BbAlertTitle>Reservation not created</BbAlertTitle><BbAlertDescription>@_reserveError</BbAlertDescription></BbAlert>
            }
            <div class="grid gap-3 md:grid-cols-2">
                <BbFormFieldInput TValue="string" @bind-Value="_form.ReferenceId" Label="Reference ID" />
                <BbFormFieldInput TValue="string" @bind-Value="_form.Reason" Label="Reason" />
            </div>
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _reservationDialogOpen = false)">Cancel</BbButton>
            <BbButton OnClick="@ReserveInventory" Disabled="@IsReserveDisabled">
                Reserve
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private IInventarioServiceWrapper Inventario { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private IPortalModuleAvailability ModuleNavigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private ILogger<Reservations> Logger { get; set; } = default!;
    private string? _loadError;
    private string? _reserveError;

    private ReservationForm _form = new();
    private List<Product> _products = [];
    private List<ProductVariation> _variants = [];
    private List<StockBalance> _balances = [];
    private List<ReservationAllocation> _allocations = [];
    private string _search = "";
    private string _view = "active";
    private static Guid? OptionalId(string value) => Guid.TryParse(value, out var id) ? id : null;
    private string AllocationLabel(Reservation reservation) => string.Join(", ", _allocations.Where(x => x.ReservationId == reservation.Id).Select(x => x.LotId is { } id ? _lots.FirstOrDefault(l => l.Id == id)?.LotNumber ?? id.ToString()[..8] : "Untracked").Distinct());
    private decimal AvailableStock => _balances.Where(x => x.ProductId.ToString() == _form.ProductId && x.ProductVariationId == OptionalId(_form.ProductVariationId) && x.WarehouseId.ToString() == _form.WarehouseId && x.LocationId.ToString() == _form.LocationId && (string.IsNullOrEmpty(_form.LotId) || x.LotId.ToString() == _form.LotId) && (x.LotId == null || _lots.Any(l => l.Id == x.LotId && l.Status == InventoryLotStatus.Available && (l.ExpiresAt == null || l.ExpiresAt > DateTime.UtcNow || _form.AllowExpiredLotOverride)))).Sum(x => x.AvailableQuantity);
    private bool MatchesReservation(Reservation item) =>
        (_view == "all" || (_view == "active" && item.Status == ReservationStatus.Active) || (_view == "expiring" && item.Status == ReservationStatus.Active && item.ExpiresAt <= DateTime.UtcNow.AddDays(1)) || item.Status.ToString() == _view) &&
        $"{GetProductName(item.ProductId)} {InventoryDisplay.Variant(_variants, item.ProductVariationId)} {item.ReferenceType} {AllocationLabel(item)}".Contains(_search, StringComparison.OrdinalIgnoreCase);

    private List<Warehouse> _warehouses = [];
    private List<InventoryLocation> _locations = [];
    private List<InventoryLot> _lots = [];
    private List<Reservation> _reservations = [];
    private bool _loading = true;
    private bool _hasTenant;
    private bool _reservationsEnabled;
    private bool _traceabilityEnabled;
    private bool _reserving;
    private bool _expiring;
    private bool _reservationDialogOpen;
    private string? QuantityValidationMessage => _form.Quantity <= 0
        ? "Enter a quantity greater than zero."
        : !string.IsNullOrEmpty(_form.ProductId) && !string.IsNullOrEmpty(_form.WarehouseId) && !string.IsNullOrEmpty(_form.LocationId) && _form.Quantity > AvailableStock
            ? $"Requested quantity {_form.Quantity:0.####} exceeds the {AvailableStock:0.####} currently available. Reduce the quantity or select another stock position."
            : null;
    private bool IsReserveDisabled => _reserving || string.IsNullOrEmpty(_form.ProductId) || string.IsNullOrEmpty(_form.WarehouseId) || string.IsNullOrEmpty(_form.LocationId) || QuantityValidationMessage is not null || _products.Count == 0 || _warehouses.Count == 0 || _locations.Count == 0;

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        ModuleNavigation.OnChanged += OnTenantChanged;
    }

    protected override async Task OnInitializedAsync() => await Reload();

    private void OnTenantChanged() => _ = InvokeAsync(Reload);

    private async Task Reload()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _reservationsEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "reservations");
            _traceabilityEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "traceability");
            _products = [];
            _warehouses = [];
            _locations = [];
            _lots = [];
            _reservations = [];
            _variants = [];
            _balances = [];
            _allocations = [];

            if (!_hasTenant || !_reservationsEnabled) return;

            var tenantId = TenantFilter.SelectedTenantId!.Value;
            _variants = await DataContext.Query<ProductVariation>().NoCache().Where(x => x.TenantId == tenantId && !x.IsDeleted).Take(1000).ToListAsync();
            _balances = await DataContext.Query<StockBalance>().NoCache().Where(x => x.TenantId == tenantId && !x.IsDeleted).Take(1000).ToListAsync();
            var allocations = await Inventario.GetReservationAllocations(new GetReservationAllocationsRequest { Metadata = BuildMetadata() });
            if (!allocations.IsSuccess) throw new InvalidOperationException("Reservation allocations could not be loaded through Inventario.");
            _allocations = allocations.Response ?? [];
            _products = await DataContext.Query<Product>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                .OrderBy(x => x.Name)
                .Take(250)
                .ToListAsync();

            _warehouses = await DataContext.Query<Warehouse>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                .OrderBy(x => x.Code)
                .Take(200)
                .ToListAsync();

            _locations = await DataContext.Query<InventoryLocation>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                .OrderBy(x => x.Code)
                .Take(500)
                .ToListAsync();

            if (_traceabilityEnabled)
            {
                _lots = await DataContext.Query<InventoryLot>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                    .OrderBy(x => x.ExpiresAt)
                    .ThenBy(x => x.LotNumber)
                    .Take(500)
                    .ToListAsync();
            }

            _reservations = await DataContext.Query<Reservation>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                .OrderByDescending(x => x.CreatedAt)
                .Take(500)
                .ToListAsync();

            ApplyDefaultSelections();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not load Inventario reservations for the selected tenant.");
            _loadError = "Reservation and stock data are unavailable. Retry loading before creating a reservation.";
            _reservationDialogOpen = false;
            _form = new();
            _products = [];
            _variants = [];
            _warehouses = [];
            _locations = [];
            _lots = [];
            _balances = [];
            _allocations = [];
            _reservations = [];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ReserveInventory()
    {
        if (!Guid.TryParse(_form.ProductId, out var productId) ||
            !Guid.TryParse(_form.WarehouseId, out var warehouseId) ||
            !Guid.TryParse(_form.LocationId, out var locationId))
        {
            ToastService.Show("Select product, warehouse, and location.");
            return;
        }

        if (QuantityValidationMessage is { } quantityMessage)
        {
            ToastService.Show(quantityMessage);
            return;
        }

        _reserving = true;
        _reserveError = null;
        try
        {
            var result = await Inventario.ReserveInventory(new ReserveInventoryRequest
            {
                Metadata = BuildMetadata(),
                ProductId = productId,
                ProductVariationId = OptionalId(_form.ProductVariationId),
                WarehouseId = warehouseId,
                LocationId = locationId,
                Quantity = _form.Quantity,
                LotId = Guid.TryParse(_form.LotId, out var lotId) ? lotId : null,
                ExpiresAt = InventoryDisplay.CalendarDateUtc(_form.ExpiresAt),
                ReferenceType = NullIfEmpty(_form.ReferenceType),
                ReferenceId = Guid.TryParse(_form.ReferenceId, out var referenceId) ? referenceId : (Guid?)null,
                Reason = NullIfEmpty(_form.Reason),
                AllowExpiredLotOverride = _form.AllowExpiredLotOverride,
                ExpiredLotOverrideReason = NullIfEmpty(_form.ExpiredLotOverrideReason)
            });

            if (!result.IsSuccess)
            {
                _reserveError = ReservationFailureMessage(result);
                return;
            }
            ToastService.Show("Inventory reserved.");
            if (result.IsSuccess)
            {
                _form.Quantity = 0m;
                _form.ExpiresAt = null;
                _form.LotId = "";
                _form.AllowExpiredLotOverride = false;
                _form.ExpiredLotOverrideReason = "";
                _form.Reason = "";
                _reservationDialogOpen = false;
                await Reload();
            }
        }
        finally
        {
            _reserving = false;
        }
    }

    private static string ReservationFailureMessage(CmdResponse result) => result.Message switch
    {
        "Insufficient allocatable stock for the requested reservation quantity." =>
            "Not enough eligible stock is available. Reduce the quantity or refresh stock availability before trying again.",
        "Expired lot override requires a reason." => "Enter a reason for the expired lot override.",
        _ => result.HttpStatusCode switch
        {
            System.Net.HttpStatusCode.Conflict => "Stock changed while reserving. Refresh stock availability and review the quantity before trying again.",
            System.Net.HttpStatusCode.BadRequest => "Review the quantity, selected lot, and expiry or override details before trying again.",
            System.Net.HttpStatusCode.Unauthorized => "Your session expired. Sign in again before reserving stock.",
            System.Net.HttpStatusCode.Forbidden => "You do not have access to reserve stock in the selected tenant.",
            _ => "The reservation service is unavailable. Your draft is retained; try again when the service is available."
        }
    };

    private void OpenReservationDialog()
    {
        _reserveError = null;
        _form = new();
        ApplyDefaultSelections();
        _reservationDialogOpen = true;
    }

    private async Task ReleaseReservation(Guid reservationId) =>
        await RunReservationAction(
            () => Inventario.ReleaseReservation(new ReleaseReservationRequest
            {
                Metadata = BuildMetadata(),
                ReservationId = reservationId
            }),
            "Reservation released.");

    private async Task FulfillReservation(Guid reservationId) =>
        await RunReservationAction(
            () => Inventario.FulfillReservation(new FulfillReservationRequest
            {
                Metadata = BuildMetadata(),
                ReservationId = reservationId
            }),
            "Reservation fulfilled.");

    private async Task CancelReservation(Guid reservationId) =>
        await RunReservationAction(
            () => Inventario.CancelReservation(new CancelReservationRequest
            {
                Metadata = BuildMetadata(),
                ReservationId = reservationId
            }),
            "Reservation cancelled.");

    private async Task ExpireDueReservations()
    {
        _expiring = true;
        try
        {
            await RunReservationAction(
                () => Inventario.ExpireReservations(new ExpireReservationsRequest
                {
                    Metadata = BuildMetadata(),
                    ExpiresBefore = DateTime.UtcNow
                }),
                "Due reservations expired.");
        }
        finally
        {
            _expiring = false;
        }
    }

    private async Task RunReservationAction(Func<Task<CmdResponse>> action, string successMessage)
    {
        var result = await action();
        ToastService.Show(result.IsSuccess ? successMessage : "Could not update reservation.");
        if (result.IsSuccess)
            await Reload();
    }

    private IEnumerable<InventoryLocation> LocationsForSelectedWarehouse()
    {
        if (!Guid.TryParse(_form.WarehouseId, out var warehouseId))
            return _locations;

        return _locations.Where(x => x.WarehouseId == warehouseId);
    }

    private IEnumerable<InventoryLot> LotsForSelectedProduct()
    {
        if (!Guid.TryParse(_form.ProductId, out var productId))
            return [];

        return _lots.Where(x => x.ProductId == productId && x.ProductVariationId == OptionalId(_form.ProductVariationId));
    }

    private void OnReservationProductChanged(string? value)
    {
        _form.ProductId = value ?? "";
        _form.ProductVariationId = "base";
        _form.LotId = "";
    }

    private void OnReservationWarehouseChanged(string? value)
    {
        _form.WarehouseId = value ?? "";
        var location = LocationsForSelectedWarehouse().FirstOrDefault();
        _form.LocationId = location?.Id.ToString() ?? "";
    }

    private void ApplyDefaultSelections()
    {

        _form.WarehouseId = _form.WarehouseId.Length > 0 ? _form.WarehouseId : _warehouses.FirstOrDefault()?.Id.ToString() ?? "";
        var location = LocationsForSelectedWarehouse().FirstOrDefault() ?? _locations.FirstOrDefault();
        _form.LocationId = _form.LocationId.Length > 0 ? _form.LocationId : location?.Id.ToString() ?? "";
    }

    private RequestMetadata BuildMetadata() => new()
    {
        RequestedTenantId = TenantFilter.SelectedTenantId,
        RequestId = Guid.NewGuid(),
        OperationName = "Portal"
    };

    private string GetProductLabel(Product product) =>
        string.IsNullOrWhiteSpace(product.SKU) ? product.Name ?? product.Id.ToString()[..8] : $"{product.Name} ({product.SKU})";

    private static string GetProductPickerValue(Product product) => product.Id.ToString();

    private static string GetProductSearchText(Product product) =>
        $"{product.Name} {product.SKU} {product.Brand} {product.Description}";

    private string GetProductName(Guid productId) =>
        _products.FirstOrDefault(x => x.Id == productId)?.Name ?? productId.ToString()[..8];

    private string GetLocationName(Guid? locationId)
    {
        if (locationId is not { } id)
            return "N/A";

        return _locations.FirstOrDefault(x => x.Id == id)?.Name ?? id.ToString()[..8];
    }

    private static string GetWarehouseLabel(Warehouse warehouse) => $"{warehouse.Code} - {warehouse.Name}";
    private static string GetWarehousePickerValue(Warehouse warehouse) => warehouse.Id.ToString();
    private static string GetWarehouseSearchText(Warehouse warehouse) => $"{warehouse.Code} {warehouse.Name} {warehouse.City} {warehouse.Region} {warehouse.CountryCode}";
    private string GetWarehouseName(Guid? warehouseId) => _warehouses.FirstOrDefault(x => x.Id == warehouseId) is { } warehouse ? GetWarehouseLabel(warehouse) : warehouseId?.ToString()[..8] ?? "Any warehouse";

    private static string GetLocationLabel(InventoryLocation location) => $"{location.Code} - {location.Name}";
    private static string GetLocationPickerValue(InventoryLocation location) => location.Id.ToString();
    private string GetLocationSearchText(InventoryLocation location) => $"{location.Code} {location.Name} {GetWarehouseName(location.WarehouseId)} {location.LocationType} {location.Description}";

    private static string GetLotLabel(InventoryLot lot)
    {
        var expiry = lot.ExpiresAt is null ? "No expiry" : lot.ExpiresAt.Value.ToLocalTime().ToString("d");
        return $"{lot.LotNumber} - {expiry}";
    }

    private static string GetLotPickerValue(InventoryLot lot) => lot.Id.ToString();

    private string GetLotSearchText(InventoryLot lot) =>
        $"{lot.LotNumber} {lot.Status} {GetProductName(lot.ProductId)} {lot.SupplierReference}";

    private static string GetStatusBadge(ReservationStatus status) =>
        status == ReservationStatus.Active ? "active" : "inactive";

    private static string? NullIfEmpty(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantChanged;
        ModuleNavigation.OnChanged -= OnTenantChanged;
    }

    private sealed class ReservationForm
    {
        public string ProductId { get; set; } = "";
        public string ProductVariationId { get; set; } = "base";
        public string WarehouseId { get; set; } = "";
        public string LocationId { get; set; } = "";
        public string LotId { get; set; } = "";
        public decimal Quantity { get; set; } = 1m;
        public DateTime? ExpiresAt { get; set; }
        public string ReferenceType { get; set; } = "";
        public string ReferenceId { get; set; } = "";
        public string Reason { get; set; } = "";
        public bool AllowExpiredLotOverride { get; set; }
        public string ExpiredLotOverrideReason { get; set; } = "";
    }
}
