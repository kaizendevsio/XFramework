@page "/inventario/planning"
@using XFramework.Domain.Shared.DataContext
@using XFramework.Inventario.Domain.Shared.Contracts.Requests.Planning
@using XFramework.Inventario.Domain.Shared.Contracts.Responses.Reports
@using DataGridRequest = BlazorBlueprint.Primitives.DataGrid.DataGridRequest
@implements IDisposable

<PageTitle>Inventario Planning - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_hasTenant)
{
    <ModuleUnavailable ModuleName="Inventario" RequiresTenant="true" />
}
else if (!_planningEnabled)
{
    <ModuleUnavailable ModuleName="Inventario Planning" />
}
else if (_loadError is not null)
{
    <BbAlert role="alert">@_loadError</BbAlert>
    <BbButton Variant="ButtonVariant.Outline" OnClick="@Reload">Retry planning</BbButton>
}
else
{
    <FadeInContent>
        <div class="space-y-6 inv-page">
            <div class="xf-page-header">
                <div>
                    <BbTypographyH3>Replenishment Planning</BbTypographyH3>
                    <BbTypographyMuted>@(_warehouseId is null ? "All warehouses" : GetWarehouseName(_warehouseId))</BbTypographyMuted>
                </div>
                <div class="xf-page-actions">
                    <BbButton OnClick="@OpenRuleDialog">
                        <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                        Add Rule
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@Reload">
                        <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                        Refresh
                    </BbButton>
                </div>
            </div>

            <div class="xf-summary-grid xf-summary-grid-3">
                <BbCard>
                    <BbCardContent>
                        <div class="space-y-1 pt-4">
                            <BbTypographyMuted>Active Rules</BbTypographyMuted>
                            <BbTypographyH3>@_activeRuleCount</BbTypographyH3>
                        </div>
                    </BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardContent>
                        <div class="space-y-1 pt-4">
                            <BbTypographyMuted>Low Stock</BbTypographyMuted>
                            <BbTypographyH3 title="Low-stock positions matching active reorder rules">@(_lowStockCount?.ToString("N0") ?? "Unavailable")</BbTypographyH3>
                        </div>
                    </BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardContent>
                        <div class="space-y-1 pt-4">
                            <BbTypographyMuted>Suggested Quantity</BbTypographyMuted>
                            <BbTypographyH3>@(_suggestedQuantity?.ToString("N2") ?? "Unavailable")</BbTypographyH3>
                        </div>
                    </BbCardContent>
                </BbCard>
            </div>

            <BbTabs DefaultValue="view0" Class="inv-workspace-tabs"><BbTabsList><BbTabsTrigger Value="view0">Suggestions</BbTabsTrigger><BbTabsTrigger Value="view1">Rules</BbTabsTrigger></BbTabsList><BbTabsContent Value="view0" ForceMount="true"><BbCard>
                <BbCardHeader>
                    <BbCardTitle>Reorder Suggestions</BbCardTitle>
                    <BbCardDescription>@(_lowStockCount?.ToString("N0") ?? "Unavailable") low-stock positions matching active reorder rules</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    @if (_suggestionsError is not null) { <BbAlert role="alert">@_suggestionsError</BbAlert> }
                    <BbDataGrid @key="_revision" TData="ReorderSuggestionRow" ItemsProvider="LoadSuggestions" ShowPagination="true" InitialPageSize="20" PageSizes="@(new[] { 20, 50, 100 })">
                        <Columns>
                            <BbDataGridPropertyColumn Property="@(x => x.ProductName)" Title="Product" />
                            <BbDataGridPropertyColumn Property="@(x => x.ProductVariationName)" Title="Variant" />
                            <BbDataGridPropertyColumn Property="@(x => x.WarehouseName)" Title="Warehouse" />
                            <BbDataGridPropertyColumn Property="@(x => x.LocationName)" Title="Location" />
                            <BbDataGridPropertyColumn Property="@(x => x.AvailableQuantity)" Title="Available" Format="0.####" />
                            <BbDataGridPropertyColumn Property="@(x => x.ReorderPoint)" Title="Reorder Point" />
                            <BbDataGridPropertyColumn Property="@(x => x.SuggestedQuantity)" Title="Suggested Qty" />
                            <BbDataGridPropertyColumn Property="@(x => x.PreferredSupplier)" Title="Preferred Supplier" Filterable="true" /><BbDataGridTemplateColumn Title="Next step"><ChildContent Context="item"><BbButton Variant="ButtonVariant.Outline" OnClick="@(() => Navigation.NavigateTo($"/inventario/purchase-orders?productId={item.ProductId}&variantId={item.ProductVariationId}&preferredSupplier={Uri.EscapeDataString(item.PreferredSupplier ?? "")}&quantity={item.SuggestedQuantity.ToString(CultureInfo.InvariantCulture)}&scope={Uri.EscapeDataString($"Replenish {item.WarehouseName} / {item.LocationName}. Preferred supplier: {item.PreferredSupplier}")}"))">Prepare draft PO</BbButton></ChildContent></BbDataGridTemplateColumn>
                        </Columns>
                        <EmptyTemplate>@if (_suggestionsError is null) { <span>No low-stock positions in this scope.</span> }</EmptyTemplate>
                    </BbDataGrid>
                </BbCardContent>
            </BbCard></BbTabsContent>

            <BbTabsContent Value="view1" ForceMount="true"><BbCard>
                <BbCardHeader>
                    <BbCardTitle>Reorder Rules</BbCardTitle>
                    <BbCardDescription>@_rules.Count rule(s) configured</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataGrid Items="@_rules" OnRowClick="@((InventoryReorderRule item) => Navigation.NavigateTo($"/inventario/planning/rules/{item.Id}"))" ShowPagination="true" InitialPageSize="20">
                        <Columns>
                            <InventoryTemplateColumn Title="Product" Filterable="true" SortBy="@(item => GetProductName(item.ProductId))" FilterBy="@(item => GetProductName(item.ProductId))">
                                <ChildContent Context="item">@GetProductName(item.ProductId)</ChildContent>
                            </InventoryTemplateColumn>
                            <InventoryTemplateColumn Title="Scope" Filterable="true" SortBy="@(item => GetScopeLabel(item))" FilterBy="@(item => GetScopeLabel(item))">
                                <ChildContent Context="item">@GetScopeLabel(item)</ChildContent>
                            </InventoryTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.MinimumQuantity)" Title="Min" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.MaximumQuantity)" Title="Max" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.ReorderPoint)" Title="Point" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.ReorderQuantity)" Title="Qty" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.PreferredSupplier)" Title="Supplier" Filterable="true" />
                            <InventoryTemplateColumn Title="Status" Filterable="true" SortBy="@(item => item.IsActive)" FilterBy="@(item => item.IsActive)">
                                <ChildContent Context="item">
                                    <StatusBadge Text="@(item.IsActive ? "Active" : "Inactive")" Status="@(item.IsActive ? "active" : "inactive")" />
                                </ChildContent>
                            </InventoryTemplateColumn>
                        <BbDataGridTemplateColumn Title="Actions"><ChildContent Context="item"><BbButton Variant="ButtonVariant.Ghost" OnClick="@(() => Navigation.NavigateTo($"/inventario/planning/rules/{item.Id}"))">View / edit</BbButton></ChildContent></BbDataGridTemplateColumn></Columns>
                    </BbDataGrid>
                </BbCardContent>
            </BbCard></BbTabsContent></BbTabs>
        </div>
    </FadeInContent>
}

<BbDialog Open="@_ruleDialogOpen" OpenChanged="@(v => _ruleDialogOpen = v)">
    <BbDialogContent TrapFocus="false" Class="xf-dialog-wide inv-dialog">
        <BbDialogHeader>
            <BbDialogTitle>Add Reorder Rule</BbDialogTitle>
            <BbDialogDescription>Rules can apply tenant-wide for a product or be scoped to a warehouse/location.</BbDialogDescription>
        </BbDialogHeader>
        <div class="grid gap-4 py-4 inv-dialog-body">
            <div class="grid gap-3 md:grid-cols-2">
                <XfEntityPicker TItem="Product"
                                @bind-Value="_form.ProductId"
                                Items="@_products"
                                Label="Product"
                                Placeholder="Select product"
                                SearchPlaceholder="Search products..."
                                EmptyMessage="No products found."
                                ValueSelector="@GetProductPickerValue"
                                TextSelector="@GetProductLabel"
                                SearchTextSelector="@GetProductSearchText"
                                AdvancedSearchTitle="Find Product"
                                AdvancedSearchDescription="Search products in the active tenant." />
                <XfEntityPicker TItem="Warehouse"
                                Value="@_form.WarehouseId"
                                ValueChanged="@OnWarehouseChanged"
                                Items="@_warehouses"
                                Label="Warehouse"
                                Placeholder="Any warehouse"
                                SearchPlaceholder="Search warehouses..."
                                EmptyMessage="No warehouses found."
                                ValueSelector="@GetWarehousePickerValue"
                                TextSelector="@GetWarehouseLabel"
                                SearchTextSelector="@GetWarehouseSearchText"
                                AllowClear="true"
                                ClearText="Any warehouse"
                                AdvancedSearchTitle="Find Warehouse"
                                AdvancedSearchDescription="Search warehouses in the active tenant." />
                <XfEntityPicker TItem="InventoryLocation"
                                @bind-Value="_form.LocationId"
                                Items="@LocationsForSelectedWarehouse().ToList()"
                                Label="Location"
                                Placeholder="Any location"
                                SearchPlaceholder="Search locations..."
                                EmptyMessage="No locations found."
                                ValueSelector="@GetLocationPickerValue"
                                TextSelector="@GetLocationLabel"
                                SearchTextSelector="@GetLocationSearchText"
                                AllowClear="true"
                                ClearText="Any location"
                                AdvancedSearchTitle="Find Location"
                                AdvancedSearchDescription="Search locations for the selected warehouse." />
                <BbFormFieldInput TValue="string" @bind-Value="_form.PreferredSupplier" Label="Preferred Supplier" />
            </div>
            <div class="grid gap-3 md:grid-cols-4">
                <BbFormFieldNumericInput TValue="decimal"
                                         @bind-Value="_form.MinimumQuantity"
                                         Label="Minimum"
                                         Min="0"
                                         DecimalPlaces="4"
                                         Step="1" />
                <BbFormFieldNumericInput TValue="decimal"
                                         @bind-Value="_form.MaximumQuantity"
                                         Label="Maximum"
                                         Min="0"
                                         DecimalPlaces="4"
                                         Step="1" />
                <BbFormFieldNumericInput TValue="decimal"
                                         @bind-Value="_form.ReorderPoint"
                                         Label="Reorder Point"
                                         Min="0"
                                         DecimalPlaces="4"
                                         Step="1" />
                <BbFormFieldNumericInput TValue="decimal"
                                         @bind-Value="_form.ReorderQuantity"
                                         Label="Reorder Qty"
                                         Min="0"
                                         DecimalPlaces="4"
                                         Step="1" />
            </div>
            <BbFormFieldSwitch Checked="@_form.IsActive"
                               CheckedChanged="@((bool value) => _form.IsActive = value)"
                               Label="Rule active" />
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _ruleDialogOpen = false)">Cancel</BbButton>
            <BbButton OnClick="@CreateRule" Disabled="@_savingRule">Create Rule</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [SupplyParameterFromQuery(Name = "warehouseId")] public string? WarehouseId { get; set; }
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private IInventarioServiceWrapper Inventario { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private IPortalModuleAvailability ModuleNavigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    private readonly RuleForm _form = new();
    private List<Product> _products = [];
    private List<ProductVariation> _variants = [];
    private List<Warehouse> _warehouses = [];
    private List<InventoryLocation> _locations = [];
    private List<InventoryReorderRule> _rules = [];
    private Guid? _tenantId, _warehouseId;
    private int _activeRuleCount, _revision;
    private int? _lowStockCount;
    private decimal? _suggestedQuantity;
    private string? _loadError, _suggestionsError, _loadedWarehouseParameter;
    private bool _parametersLoaded, _disposed;
    private CancellationTokenSource _load = new();
    private bool _loading = true;
    private bool _hasTenant;
    private bool _planningEnabled;
    private bool _ruleDialogOpen;
    private bool _savingRule;

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        ModuleNavigation.OnChanged += OnTenantChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_parametersLoaded && _loadedWarehouseParameter == WarehouseId) return;
        _parametersLoaded = true;
        _loadedWarehouseParameter = WarehouseId;
        await Reload();
    }

    private void OnTenantChanged() => _ = InvokeAsync(Reload);

    private async Task Reload()
    {
        if (_disposed) return;
        _load.Cancel();
        _load.Dispose();
        _load = new();
        var ct = _load.Token;
        var revision = ++_revision;
        var tenantId = TenantFilter.SelectedTenantId;
        _tenantId = tenantId;
        _warehouseId = null;
        _loadError = _suggestionsError = null;
        _lowStockCount = null;
        _suggestedQuantity = null;
        _activeRuleCount = 0;
        _ruleDialogOpen = false;
        ResetForm();
        _loading = true;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _planningEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "planning");
            _products = [];
            _variants = [];
            _warehouses = [];
            _locations = [];
            _rules = [];

            if (!_hasTenant || !_planningEnabled) return;

            Warehouse? selectedWarehouse = null;
            if (WarehouseId is not null)
            {
                if (!Guid.TryParse(WarehouseId, out var warehouseId) || warehouseId == Guid.Empty)
                    throw new InvalidOperationException("Invalid warehouse scope.");
                selectedWarehouse = await DataContext.Query<Warehouse>().NoCache()
                    .Where(x => x.Id == warehouseId && x.TenantId == tenantId && !x.IsDeleted).FirstOrDefaultAsync(ct);
                if (selectedWarehouse is null) throw new InvalidOperationException("Warehouse is unavailable in the selected tenant.");
            }
            var scope = selectedWarehouse?.Id;
            var variants = await DataContext.Query<ProductVariation>().NoCache().Where(x => x.TenantId == tenantId && !x.IsDeleted).Take(1000).ToListAsync(ct);
            var products = await DataContext.Query<Product>().NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted).OrderBy(x => x.Name).Take(500).ToListAsync(ct);
            var warehouses = await DataContext.Query<Warehouse>().NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted).OrderBy(x => x.Code).Take(500).ToListAsync(ct);
            if (selectedWarehouse is not null && warehouses.All(x => x.Id != selectedWarehouse.Id)) warehouses.Add(selectedWarehouse);
            var locations = await DataContext.Query<InventoryLocation>().NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted && (scope == null || x.WarehouseId == scope)).OrderBy(x => x.Code).Take(500).ToListAsync(ct);
            var rulesQuery = DataContext.Query<InventoryReorderRule>().NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted && (scope == null || x.WarehouseId == null || x.WarehouseId == scope));
            var activeRules = await rulesQuery.Where(x => x.IsActive).CountAsync(ct);
            var rules = await rulesQuery.OrderBy(x => x.CreatedAt).Take(500).ToListAsync(ct);
            if (!IsCurrent(revision, tenantId) || ct.IsCancellationRequested) return;
            _warehouseId = scope;
            _variants = variants; _products = products; _warehouses = warehouses; _locations = locations; _rules = rules;
            _activeRuleCount = activeRules;
            ApplyDefaults();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (IsCurrent(revision, tenantId)) _loadError = ex is InvalidOperationException ? ex.Message : "Could not load planning. Try again.";
        }
        finally
        {
            if (IsCurrent(revision, tenantId)) { _loading = false; StateHasChanged(); }
        }
    }

    private bool IsCurrent(int revision, Guid? tenant) => !_disposed && revision == _revision && tenant == TenantFilter.SelectedTenantId;

    private async ValueTask<BlazorBlueprint.Primitives.DataGrid.DataGridResult<ReorderSuggestionRow>> LoadSuggestions(DataGridRequest request)
    {
        var revision = _revision;
        var tenant = _tenantId;
        if (_disposed || _loading || !_planningEnabled || tenant is null || _loadError is not null)
            return new() { Items = [], TotalItemCount = 0 };
        using var linked = CancellationTokenSource.CreateLinkedTokenSource(request.CancellationToken, _load.Token);
        try
        {
            var filter = request.Filters?.GetValueOrDefault(nameof(ReorderSuggestionRow.PreferredSupplier));
            var result = await Inventario.GetReorderSuggestionPage(new GetReorderSuggestionPageRequest
            {
                Metadata = new() { RequestedTenantId = tenant }, WarehouseId = _warehouseId,
                Skip = Math.Max(0, request.StartIndex), Take = Math.Clamp(request.Count ?? 20, 1, 100),
                SupplierFilter = Convert.ToString(filter?.Value), SupplierFilterOperator = filter?.Operator.ToString()
            }, linked.Token);
            if (!IsCurrent(revision, tenant) || linked.IsCancellationRequested) return new() { Items = [], TotalItemCount = 0 };
            if (!result.IsSuccess || result.Response is null) throw new InvalidOperationException();
            _suggestionsError = null;
            _lowStockCount = result.Response.TotalCount;
            _suggestedQuantity = result.Response.TotalSuggestedQuantity;
            await InvokeAsync(StateHasChanged);
            return new() { Items = result.Response.Items, TotalItemCount = result.Response.TotalCount };
        }
        catch (OperationCanceledException) { }
        catch
        {
            if (IsCurrent(revision, tenant))
            {
                _lowStockCount = null; _suggestedQuantity = null;
                _suggestionsError = "Could not load suggestions. Refresh planning to retry.";
                await InvokeAsync(StateHasChanged);
            }
        }
        return new() { Items = [], TotalItemCount = 0 };
    }

    private async Task CreateRule()
    {
        if (!_hasTenant || !Guid.TryParse(_form.ProductId, out var productId))
        {
            ToastService.Show("Select a product.");
            return;
        }

        if (_form.MinimumQuantity < 0 || _form.ReorderPoint < 0 || _form.ReorderQuantity <= 0)
        {
            ToastService.Show("Quantities must be valid.");
            return;
        }

        if (_form.MaximumQuantity > 0 && _form.MaximumQuantity < _form.MinimumQuantity)
        {
            ToastService.Show("Maximum must be greater than or equal to minimum.");
            return;
        }

        _savingRule = true;
        try
        {
            var result = await Inventario.CreateInventoryReorderRule(new CreateInventoryReorderRuleRequest
            {
                Metadata = BuildMetadata(),
                ProductId = productId,
                WarehouseId = Guid.TryParse(_form.WarehouseId, out var warehouseId) ? warehouseId : null,
                LocationId = Guid.TryParse(_form.LocationId, out var locationId) ? locationId : null,
                MinimumQuantity = _form.MinimumQuantity,
                MaximumQuantity = _form.MaximumQuantity > 0 ? _form.MaximumQuantity : null,
                ReorderPoint = _form.ReorderPoint,
                ReorderQuantity = _form.ReorderQuantity,
                PreferredSupplier = NullIfEmpty(_form.PreferredSupplier),
                IsActive = _form.IsActive
            });
            ToastService.Show(result.IsSuccess ? "Reorder rule created." : "Could not create reorder rule.");
            if (result.IsSuccess)
            {
                _ruleDialogOpen = false;
                ResetForm();
                await Reload();
            }
        }
        finally
        {
            _savingRule = false;
        }
    }

    private void OpenRuleDialog()
    {
        ApplyDefaults();
        _ruleDialogOpen = true;
    }

    private void OnWarehouseChanged(string? value)
    {
        _form.WarehouseId = value ?? "";
        _form.LocationId = "";
    }

    private IEnumerable<InventoryLocation> LocationsForSelectedWarehouse()
    {
        if (!Guid.TryParse(_form.WarehouseId, out var warehouseId))
            return _locations;
        return _locations.Where(x => x.WarehouseId == warehouseId);
    }

    private void ApplyDefaults()
    {
        _form.ProductId = _form.ProductId.Length > 0 ? _form.ProductId : _products.FirstOrDefault()?.Id.ToString() ?? "";
        _form.WarehouseId = _warehouseId?.ToString() ?? "";
    }

    private void ResetForm()
    {
        _form.ProductId = "";
        _form.WarehouseId = "";
        _form.LocationId = "";
        _form.MinimumQuantity = 0m;
        _form.MaximumQuantity = 0m;
        _form.ReorderPoint = 0m;
        _form.ReorderQuantity = 1m;
        _form.PreferredSupplier = "";
        _form.IsActive = true;
    }

    private string GetProductName(Guid productId) =>
        _products.FirstOrDefault(x => x.Id == productId)?.Name ?? productId.ToString()[..8];

    private string GetProductLabel(Product product) =>
        string.IsNullOrWhiteSpace(product.SKU) ? product.Name ?? product.Id.ToString()[..8] : $"{product.Name} ({product.SKU})";

    private static string GetProductPickerValue(Product product) => product.Id.ToString();

    private static string GetProductSearchText(Product product) =>
        $"{product.Name} {product.SKU} {product.Brand} {product.Description}";

    private string GetWarehouseName(Guid? warehouseId) =>
        warehouseId is { } id ? _warehouses.FirstOrDefault(x => x.Id == id) is { } warehouse ? GetWarehouseLabel(warehouse) : id.ToString()[..8] : "Any warehouse";

    private string GetLocationName(Guid? locationId) =>
        locationId is { } id ? _locations.FirstOrDefault(x => x.Id == id) is { } location ? GetLocationLabel(location) : id.ToString()[..8] : "Any location";

    private string GetScopeLabel(InventoryReorderRule rule) =>
        $"{GetWarehouseName(rule.WarehouseId)} / {GetLocationName(rule.LocationId)}";

    private RequestMetadata BuildMetadata() => new()
    {
        RequestedTenantId = TenantFilter.SelectedTenantId,
        RequestId = Guid.NewGuid(),
        OperationName = "Portal"
    };

    private static string GetWarehouseLabel(Warehouse warehouse) => $"{warehouse.Code} - {warehouse.Name}";
    private static string GetLocationLabel(InventoryLocation location) => $"{location.Code} - {location.Name}";
    private static string GetWarehousePickerValue(Warehouse warehouse) => warehouse.Id.ToString();
    private static string GetWarehouseSearchText(Warehouse warehouse) => $"{warehouse.Code} {warehouse.Name} {warehouse.City} {warehouse.Region} {warehouse.CountryCode}";
    private static string GetLocationPickerValue(InventoryLocation location) => location.Id.ToString();
    private string GetLocationSearchText(InventoryLocation location) => $"{location.Code} {location.Name} {GetWarehouseName(location.WarehouseId)} {location.LocationType} {location.Description}";
    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public void Dispose()
    {
        _disposed = true;
        _load.Cancel();
        _load.Dispose();
        TenantFilter.OnChanged -= OnTenantChanged;
        ModuleNavigation.OnChanged -= OnTenantChanged;
    }

    private sealed class RuleForm
    {
        public string ProductId { get; set; } = "";
        public string WarehouseId { get; set; } = "";
        public string LocationId { get; set; } = "";
        public decimal MinimumQuantity { get; set; }
        public decimal MaximumQuantity { get; set; }
        public decimal ReorderPoint { get; set; }
        public decimal ReorderQuantity { get; set; } = 1m;
        public string PreferredSupplier { get; set; } = "";
        public bool IsActive { get; set; } = true;
    }
}
