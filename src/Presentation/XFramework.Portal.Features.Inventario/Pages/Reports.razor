@page "/inventario/reports"
@using XFramework.Inventario.Domain.Shared.Contracts.Responses.Reports
@implements IDisposable

<PageTitle>Inventario Reports - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_hasTenant)
{
    <ModuleUnavailable ModuleName="Inventario" RequiresTenant="true" />
}
else if (!_reportingEnabled)
{
    <ModuleUnavailable ModuleName="Inventario Reporting" />
}
else
{
    <FadeInContent>
        <div class="space-y-6 inv-page">
            <div class="xf-page-header">
                <div>
                    <BbTypographyH3>Inventory Risk Reports</BbTypographyH3>
                    <BbTypographyMuted>Review near-expiry and expired stock without repeating operational inventory pages.</BbTypographyMuted>
                </div>
                <BbButton Variant="ButtonVariant.Outline" OnClick="@Reload">
                    <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                    Refresh
                </BbButton>
            </div>


            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Report Filters</BbCardTitle>
                    <BbCardDescription>Choose product and storage scope, then apply. Column filters refine the loaded results.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <div class="inv-report-filters">
                        <XfEntityPicker TItem="Product"
                                        @bind-Value="_filterProductId"
                                        Items="@_products"
                                        Label="Product"
                                        Placeholder="All products"
                                        SearchPlaceholder="Search products..."
                                        EmptyMessage="No products found."
                                        ValueSelector="@GetProductPickerValue"
                                        TextSelector="@GetProductLabel"
                                        SearchTextSelector="@GetProductSearchText"
                                        AllowClear="true"
                                        ClearText="All products"
                                        AdvancedSearchTitle="Find Product"
                                        AdvancedSearchDescription="Search products in the active tenant." />
                        <XfEntityPicker TItem="Warehouse"
                                        Value="@_filterWarehouseId"
                                        ValueChanged="@OnFilterWarehouseChanged"
                                        Items="@_warehouses"
                                        Label="Warehouse"
                                        Placeholder="All warehouses"
                                        SearchPlaceholder="Search warehouses..."
                                        EmptyMessage="No warehouses found."
                                        ValueSelector="@GetWarehousePickerValue"
                                        TextSelector="@GetWarehouseLabel"
                                        SearchTextSelector="@GetWarehouseSearchText"
                                        AllowClear="true"
                                        ClearText="All warehouses"
                                        AdvancedSearchTitle="Find Warehouse"
                                        AdvancedSearchDescription="Search warehouses in the active tenant." />
                        <XfEntityPicker TItem="InventoryLocation"
                                        @bind-Value="_filterLocationId"
                                        Items="@LocationsForSelectedWarehouse().ToList()"
                                        Label="Location"
                                        Placeholder="All locations"
                                        SearchPlaceholder="Search locations..."
                                        EmptyMessage="No locations found."
                                        ValueSelector="@GetLocationPickerValue"
                                        TextSelector="@GetLocationLabel"
                                        SearchTextSelector="@GetLocationSearchText"
                                        AllowClear="true"
                                        ClearText="All locations"
                                        AdvancedSearchTitle="Find Location"
                                        AdvancedSearchDescription="Search locations in the selected warehouse." />
                        <BbFormFieldNumericInput TValue="int"
                                                 @bind-Value="_nearExpiryWindowDays"
                                                 Label="Expiry window (days)"
                                                 Min="1"
                                                 Max="365"
                                                 Step="1" />
                    <div class="flex flex-wrap justify-end gap-2">
                        <BbButton Variant="ButtonVariant.Outline" OnClick="@ResetReportFilters">
                            <LucideIcon Name="rotate-ccw" class="mr-2 h-4 w-4" />
                            Reset
                        </BbButton>
                        <BbButton OnClick="@ApplyReportFilters">
                            Apply Filters
                        </BbButton>
                    </div>
                    </div>
                </BbCardContent>
            </BbCard>

            <p class="text-sm text-muted-foreground">Applied scope: @_appliedScope</p>
            <BbTabs DefaultValue="view0" Class="inv-workspace-tabs"><BbTabsList><BbTabsTrigger Value="view0">Near expiry (@_nearExpiry.Count)</BbTabsTrigger><BbTabsTrigger Value="view1">Expired (@_expired.Count)</BbTabsTrigger></BbTabsList><BbTabsContent Value="view0" ForceMount="true"><BbCard>
                <BbCardHeader>
                    <BbCardTitle>Near Expiry</BbCardTitle>
                    <BbCardDescription>Lots expiring in the next @_appliedWindowDays day(s) with on-hand stock</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    @if (_nearExpiry.Count == 0)
                    {
                        <BbEmpty Title="No near-expiry stock" Description="Adjust filters or expand the expiry window." />
                    }
                    else
                    {
                        <BbDataGrid Items="@_nearExpiry" ShowPagination="true" InitialPageSize="10">
                            <Columns>
                                <BbDataGridPropertyColumn Property="@(x => x.ProductName)" Title="Product" Filterable="true" />
                                <InventoryTemplateColumn Title="Lot" Filterable="true" SortBy="@(item => item.LotNumber)" FilterBy="@(item => item.LotNumber)"><ChildContent Context="item"><a href="@($"/inventario/lots/{item.LotId}")">@item.LotNumber</a></ChildContent></InventoryTemplateColumn>
                                <BbDataGridPropertyColumn Property="@(x => x.Scope)" Title="Location" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.AvailableQuantity)" Title="Available" Format="0.####" Sortable="true" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.ExpiresAt)" Title="Expires" Sortable="true" Filterable="true" />
                            </Columns>
                        </BbDataGrid>
                    }
                </BbCardContent>
            </BbCard></BbTabsContent>

            <BbTabsContent Value="view1" ForceMount="true"><BbCard>
                <BbCardHeader>
                    <BbCardTitle>Expired Stock</BbCardTitle>
                    <BbCardDescription>Expired or expired-status lots that still have on-hand stock</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    @if (_expired.Count == 0)
                    {
                        <BbEmpty Title="No expired stock" Description="No expired lots match the current filters." />
                    }
                    else
                    {
                        <BbDataGrid Items="@_expired" ShowPagination="true" InitialPageSize="10">
                            <Columns>
                                <BbDataGridPropertyColumn Property="@(x => x.ProductName)" Title="Product" Filterable="true" />
                                <InventoryTemplateColumn Title="Lot" Filterable="true" SortBy="@(item => item.LotNumber)" FilterBy="@(item => item.LotNumber)"><ChildContent Context="item"><a href="@($"/inventario/lots/{item.LotId}")">@item.LotNumber</a></ChildContent></InventoryTemplateColumn>
                                <BbDataGridPropertyColumn Property="@(x => x.Scope)" Title="Location" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.AvailableQuantity)" Title="Available" Format="0.####" Sortable="true" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.ExpiresAt)" Title="Expired" Sortable="true" Filterable="true" />
                            </Columns>
                        </BbDataGrid>
                    }
                </BbCardContent>
            </BbCard></BbTabsContent></BbTabs>

        </div>
    </FadeInContent>
}

@code {
    [Inject] private IInventarioServiceWrapper Inventario { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private IPortalModuleAvailability ModuleNavigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private ILogger<Reports> Logger { get; set; } = default!;

    private List<Product> _products = [];
    private List<Warehouse> _warehouses = [];
    private List<InventoryLocation> _locations = [];
    private List<ExpiryRow> _nearExpiry = [];
    private List<ExpiryRow> _expired = [];
    private string? _filterProductId;
    private string? _filterWarehouseId;
    private string? _filterLocationId;
    private int _nearExpiryWindowDays = 30;
    private int _appliedWindowDays = 30;
    private string _appliedScope = "All products / all warehouses / all locations";
    private bool _loading = true;
    private bool _hasTenant;
    private bool _reportingEnabled;

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        ModuleNavigation.OnChanged += OnTenantChanged;
    }

    protected override async Task OnInitializedAsync() => await Reload();

    private void OnTenantChanged() => _ = InvokeAsync(Reload);

    private async Task Reload()
    {
        _loading = true;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _reportingEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "reporting");
            ClearRows();
            if (!_hasTenant || !_reportingEnabled) return;

            await LoadReports(refreshFilterOptions: true);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load inventory reports for tenant {TenantId}", TenantFilter.SelectedTenantId);
            ToastService.Show("Could not load inventory reports.");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ClearRows()
    {
        _products = [];
        _warehouses = [];
        _locations = [];
        _nearExpiry = [];
        _expired = [];
    }

    private async Task LoadReports(bool refreshFilterOptions)
    {
        var productId = ParseFilterGuid(_filterProductId);
        var warehouseId = ParseFilterGuid(_filterWarehouseId);
        var locationId = ParseFilterGuid(_filterLocationId);

        var nearExpiryResponse = await Inventario.GetNearExpiryStockReport(new GetNearExpiryStockReportRequest
        {
            Metadata = BuildMetadata(),
            ProductId = productId,
            DaysAhead = Math.Clamp(_nearExpiryWindowDays, 1, 365)
        });
        var expiredResponse = await Inventario.GetExpiredStockReport(new GetExpiredStockReportRequest
        {
            Metadata = BuildMetadata(),
            ProductId = productId
        });
        var nearExpiryRows = (nearExpiryResponse.Response ?? [])
            .Where(row => MatchesWarehouse(warehouseId, row.WarehouseId))
            .Where(row => MatchesLocation(locationId, row.LocationId))
            .ToList();
        var expiredRows = (expiredResponse.Response ?? [])
            .Where(row => MatchesWarehouse(warehouseId, row.WarehouseId))
            .Where(row => MatchesLocation(locationId, row.LocationId))
            .ToList();
        _nearExpiry = nearExpiryRows.Select(row => new ExpiryRow(
            row.LotId, row.ProductName,
            row.LotNumber,
            GetReportScope(row.WarehouseName, row.LocationName),
            row.AvailableQuantity,
            row.ExpiresAt)).ToList();
        _expired = expiredRows.Select(row => new ExpiryRow(
            row.LotId, row.ProductName,
            row.LotNumber,
            GetReportScope(row.WarehouseName, row.LocationName),
            row.AvailableQuantity,
            row.ExpiresAt)).ToList();
        if (refreshFilterOptions)
            BuildFilterOptions(nearExpiryRows, expiredRows);

        _appliedWindowDays = Math.Clamp(_nearExpiryWindowDays, 1, 365);
        _appliedScope = $"{_products.FirstOrDefault(x => x.Id == productId)?.Name ?? "All products"} / {_warehouses.FirstOrDefault(x => x.Id == warehouseId)?.Name ?? "All warehouses"} / {_locations.FirstOrDefault(x => x.Id == locationId)?.Name ?? "All locations"}";
        var failures = new[]
        {
            (nearExpiryResponse.IsSuccess, nearExpiryResponse.Message),
            (expiredResponse.IsSuccess, expiredResponse.Message)
        }.Where(result => !result.IsSuccess).Select(result => result.Message ?? "Unknown report failure").ToArray();

        if (failures.Length > 0)
        {
            Logger.LogWarning("Inventory report sections failed: {Failures}", string.Join(" | ", failures));
            ToastService.Show("Could not load all inventory report sections.");
        }
    }

    private void BuildFilterOptions(
        IReadOnlyCollection<NearExpiryStockReportRow> nearExpiryRows,
        IReadOnlyCollection<NearExpiryStockReportRow> expiredRows)
    {
        _products = nearExpiryRows.Select(row => (row.ProductId, row.ProductName))
            .Concat(expiredRows.Select(row => (row.ProductId, row.ProductName)))
            .DistinctBy(row => row.ProductId)
            .Select(row => new Product { Id = row.ProductId, Name = row.ProductName, IsEnabled = true })
            .OrderBy(product => product.Name)
            .ToList();
        var expiryRows = nearExpiryRows.Concat(expiredRows).ToList();
        _warehouses = expiryRows
            .Where(row => row.WarehouseId.HasValue)
            .DistinctBy(row => row.WarehouseId)
            .Select(row => new Warehouse
            {
                Id = row.WarehouseId!.Value,
                Code = row.WarehouseName ?? row.WarehouseId.Value.ToString()[..8],
                Name = row.WarehouseName ?? row.WarehouseId.Value.ToString()[..8],
                IsEnabled = true
            })
            .OrderBy(warehouse => warehouse.Name)
            .ToList();
        _locations = expiryRows
            .Where(row => row.WarehouseId.HasValue && row.LocationId.HasValue)
            .DistinctBy(row => row.LocationId)
            .Select(row => new InventoryLocation
            {
                Id = row.LocationId!.Value,
                WarehouseId = row.WarehouseId!.Value,
                Code = row.LocationName ?? row.LocationId.Value.ToString()[..8],
                Name = row.LocationName ?? row.LocationId.Value.ToString()[..8],
                IsEnabled = true
            })
            .OrderBy(location => location.Name)
            .ToList();
    }

    private async Task ApplyReportFilters()
    {
        _nearExpiryWindowDays = Math.Clamp(_nearExpiryWindowDays, 1, 365);
        await LoadReports(refreshFilterOptions: false);
    }

    private async Task ResetReportFilters()
    {
        _filterProductId = null;
        _filterWarehouseId = null;
        _filterLocationId = null;
        _nearExpiryWindowDays = 30;
        await LoadReports(refreshFilterOptions: true);
    }

    private Task OnFilterWarehouseChanged(string? value)
    {
        _filterWarehouseId = value;
        _filterLocationId = null;
        return Task.CompletedTask;
    }

    private IEnumerable<InventoryLocation> LocationsForSelectedWarehouse()
    {
        var warehouseId = ParseFilterGuid(_filterWarehouseId);
        return warehouseId is null
            ? _locations
            : _locations.Where(x => x.WarehouseId == warehouseId.Value);
    }

    private static Guid? ParseFilterGuid(string? value) =>
        Guid.TryParse(value, out var parsed) ? parsed : null;

    private static bool MatchesWarehouse(Guid? filterWarehouseId, Guid? warehouseId) =>
        filterWarehouseId is null || warehouseId == filterWarehouseId.Value;

    private static bool MatchesLocation(Guid? filterLocationId, Guid? locationId) =>
        filterLocationId is null || locationId == filterLocationId.Value;

    private string GetWarehouseName(Guid? id) =>
        id is { } value ? _warehouses.FirstOrDefault(x => x.Id == value)?.Name ?? value.ToString()[..8] : "Any warehouse";

    private static string GetReportScope(string? warehouseName, string? locationName) =>
        $"{warehouseName ?? "Any warehouse"} / {locationName ?? "Any location"}";

    private RequestMetadata BuildMetadata() => new()
    {
        RequestedTenantId = TenantFilter.SelectedTenantId,
        RequestId = Guid.NewGuid(),
        OperationName = "Portal"
    };

    private static string GetProductPickerValue(Product product) => product.Id.ToString();

    private static string GetWarehousePickerValue(Warehouse warehouse) => warehouse.Id.ToString();

    private static string GetLocationPickerValue(InventoryLocation location) => location.Id.ToString();

    private static string GetProductLabel(Product product) =>
        string.IsNullOrWhiteSpace(product.SKU)
            ? product.Name ?? product.Id.ToString()[..8]
            : $"{product.SKU} - {product.Name ?? product.Id.ToString()[..8]}";

    private static string GetWarehouseLabel(Warehouse warehouse) =>
        string.Equals(warehouse.Code, warehouse.Name, StringComparison.Ordinal)
            ? warehouse.Name
            : $"{warehouse.Code} - {warehouse.Name}";

    private string GetLocationLabel(InventoryLocation location) =>
        $"{(string.Equals(location.Code, location.Name, StringComparison.Ordinal) ? location.Name : $"{location.Code} - {location.Name}")} ({GetWarehouseName(location.WarehouseId)})";

    private static string GetProductSearchText(Product product) =>
        $"{product.SKU} {product.Name} {product.Description}";

    private static string GetWarehouseSearchText(Warehouse warehouse) =>
        $"{warehouse.Code} {warehouse.Name} {warehouse.City} {warehouse.Region} {warehouse.CountryCode}";

    private string GetLocationSearchText(InventoryLocation location) =>
        $"{location.Code} {location.Name} {GetWarehouseName(location.WarehouseId)}";

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantChanged;
        ModuleNavigation.OnChanged -= OnTenantChanged;
    }

    private sealed record ExpiryRow(Guid LotId, string ProductName, string LotNumber, string Scope, decimal AvailableQuantity, DateTime? ExpiresAt);
}
