@page "/inventario/reports"
@using XFramework.Portal.Features.Inventario.Reports
@using XFramework.Inventario.Domain.Shared.Contracts.Responses.Reports
@implements IAsyncDisposable

<PageTitle>Inventory Reports - Portal</PageTitle>

<div class="inventory-reports inv-page">
    <div class="xf-page-header">
        <div><BbTypographyH3>Inventory Reports</BbTypographyH3><BbTypographyMuted>@TenantLabel</BbTypographyMuted></div>
        <div class="xf-page-actions">
            <BbFormFieldSwitch Checked="@_live" CheckedChanged="@SetLive" Label="Live (30 seconds)" Disabled="@(_scope is null)" />
            <BbButton Variant="ButtonVariant.Outline" OnClick="@Refresh" Disabled="@(_busy || _scope is null)">
                <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />Refresh
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@Share" Disabled="@(_snapshot is null || _busy)">
                <LucideIcon Name="link" class="mr-2 h-4 w-4" />Share link
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@Export" Disabled="@(_snapshot is null || _busy || _exporting)">
                <LucideIcon Name="download" class="mr-2 h-4 w-4" />PDF snapshot
            </BbButton>
        </div>
    </div>
    @if (_error is not null)
    {
        <BbAlert role="alert"><BbAlertDescription>@_error</BbAlertDescription></BbAlert>
    }
    @if (_scope is null && !_busy)
    {
        <ModuleUnavailable ModuleName="Inventario" RequiresTenant="true" />
    }
    else
    {
        @if (!_denied)
        {
        <div class="report-filters">
            <XfEntityPicker TItem="ReportChoice" @bind-Value="_product" Items="@_products" Label="Product"
                Placeholder="All products" AllowClear="true" ShowAdvancedSearch="false" ValueSelector="@(x => x.Id.ToString())" TextSelector="@(x => x.Label)" />
            <XfEntityPicker TItem="ReportChoice" Value="@_warehouse" ValueChanged="@WarehouseChanged" Items="@_warehouses" Label="Warehouse"
                Placeholder="All warehouses" AllowClear="true" ShowAdvancedSearch="false" ValueSelector="@(x => x.Id.ToString())" TextSelector="@(x => x.Label)" />
            <XfEntityPicker TItem="ReportChoice" @bind-Value="_location" Items="@LocationChoices" Label="Location"
                Placeholder="All locations" AllowClear="true" ShowAdvancedSearch="false" ValueSelector="@(x => x.Id.ToString())" TextSelector="@(x => x.Label)" />
            <BbFormFieldDatePicker @bind-Value="_from" Label="Movements from (UTC)" />
            <BbFormFieldDatePicker @bind-Value="_to" Label="Movements through (UTC)" />
            <BbFormFieldNumericInput TValue="int" @bind-Value="_days" Label="Expiry window (days)" Min="1" Max="365" Step="1" />
            <div class="xf-filter-actions">
                <BbButton Variant="ButtonVariant.Outline" OnClick="@Reset" Disabled="@_busy">
                    <LucideIcon Name="rotate-ccw" class="mr-2 h-4 w-4" />Reset
                </BbButton>
                <BbButton OnClick="@Apply" Disabled="@_busy"><LucideIcon Name="filter" class="mr-2 h-4 w-4" />Apply</BbButton>
            </div>
        </div>
        }
        @if (_shareUri is not null)
        {
            <div class="protected-share"><BbLabel>Protected report link</BbLabel><BbInput Value="@_shareUri" ReadOnly="true" aria-label="Protected report link" /></div>
        }
        @if (_busy && _snapshot is null)
        {
            <CenteredSpinner />
        }
        @if (_snapshot is { } snapshot)
        {
            <p class="snapshot-scope">As of @snapshot.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") | @_snapshotScope</p>
            @if (snapshot.PositionCount > snapshot.Positions.Count || snapshot.MovementCount > snapshot.Movements.Count)
            {
                <BbAlert><BbAlertDescription>Detail rows are capped at 1,000 per report. Summary quantities include all matching records.</BbAlertDescription></BbAlert>
            }
            <InventoryReportView Snapshot="@snapshot" />
            @if (snapshot.Products.Count == 500 || snapshot.Warehouses.Count == 500 || snapshot.Locations.Count == 500)
            {
                <p class="snapshot-scope">Filter choices are limited to the first 500 names in each catalog. Saved links retain their exact scope.</p>
            }
        }
    }
</div>

@code {
    [Inject] private IInventarioServiceWrapper Inventario { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private IPortalModuleAvailability ModuleNavigation { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private ILogger<Reports> Logger { get; set; } = default!;
    // Query binding makes parameter-only navigation reload and reauthorize a saved report.
    [SupplyParameterFromQuery(Name = "tenant")] public string? QueryTenant { get; set; }
    [SupplyParameterFromQuery(Name = "product")] public string? QueryProduct { get; set; }
    [SupplyParameterFromQuery(Name = "warehouse")] public string? QueryWarehouse { get; set; }
    [SupplyParameterFromQuery(Name = "location")] public string? QueryLocation { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? QueryFrom { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? QueryTo { get; set; }
    [SupplyParameterFromQuery(Name = "expiry")] public string? QueryExpiry { get; set; }

    private readonly SemaphoreSlim _requestGate = new(1, 1);
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _request;
    private CancellationTokenSource? _liveCancellation;
    private Task? _liveTask;
    private InventoryReportScope? _scope;
    private InventoryReportSnapshot? _snapshot;
    private string? _product, _warehouse, _location, _error, _shareUri;
    private string _snapshotScope = "";
    private string _snapshotTenant = "";
    private DateTime? _from, _to;
    private int _days = 30, _revision, _liveRevision;
    private bool _busy, _live, _exporting, _disposed, _initializing, _denied;
    private List<ReportChoice> _products = [], _warehouses = [], _locations = [];
    private string TenantLabel => _snapshot is not null ? _snapshotTenant :
        _scope?.TenantId == TenantFilter.SelectedTenantId ? TenantFilter.SelectedTenantName ?? "Selected tenant" :
        _scope is not null ? $"Shared tenant {_scope.TenantId.ToString()[..8]}" : "Select a tenant";
    private List<ReportChoice> LocationChoices => _locations.Where(x => string.IsNullOrWhiteSpace(_warehouse) || x.ParentId?.ToString() == _warehouse).ToList();
    public sealed record ReportChoice(Guid Id, string Label, Guid? ParentId = null);

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += ContextChanged;
        ModuleNavigation.OnChanged += ContextChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        Invalidate();
        _initializing = true;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync(_lifetime.Token);
            _scope = InventoryReportScope.Parse(Navigation.Uri, TenantFilter.SelectedTenantId);
            _products = []; _warehouses = []; _locations = [];
            if (_scope is not null)
            {
                _product = _scope.ProductId?.ToString(); _warehouse = _scope.WarehouseId?.ToString();
                _location = _scope.LocationId?.ToString(); _from = _scope.FromUtc.Date;
                _to = _scope.ToUtc.Date; _days = _scope.DaysAhead;
            }
        }
        catch (FormatException ex) { _scope = null; _error = ex.Message; }
        finally { _initializing = false; }
        if (_scope is not null) await Refresh();
    }

    private void Invalidate()
    {
        _revision++;
        _request?.Cancel();
        _snapshot = null;
        _busy = false;
        _products = []; _warehouses = []; _locations = [];
        _denied = false;
        _shareUri = null;
        _error = null;
    }

    private void ContextChanged()
    {
        if (_disposed || _initializing) return;
        // Invalidate immediately, before the renderer can process a late response.
        Invalidate();
        _ = InvokeAsync(async () => { StateHasChanged(); await OnParametersSetAsync(); StateHasChanged(); });
    }

    private async Task Refresh()
    {
        if (_disposed || _scope is null) return;
        var scope = _scope;
        var selectedTenant = TenantFilter.SelectedTenantId;
        var revision = ++_revision;
        _request?.Cancel();
        using var request = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _request = request;
        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            await _requestGate.WaitAsync(request.Token);
            try
            {
                request.Token.ThrowIfCancellationRequested();
                // A saved cross-tenant report is checked by the backend, not the selected tenant's flags.
                if (scope.TenantId == selectedTenant &&
                    !ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "reporting"))
                {
                    _snapshot = null;
                    _denied = true;
                    _error = "Inventory Reporting is not enabled for this tenant.";
                    return;
                }
                var response = await Inventario.GetInventoryReportSnapshot(scope.Request(), request.Token);
                if (_disposed || request.IsCancellationRequested || revision != _revision ||
                    scope != _scope || selectedTenant != TenantFilter.SelectedTenantId) return;
                if (!response.IsSuccess || response.Response is null)
                {
                    // Denial clears the snapshot; transient errors retain its original as-of time.
                    if ((int)response.HttpStatusCode is 401 or 403 or 404)
                    {
                        _snapshot = null;
                        _denied = true;
                        _products = []; _warehouses = []; _locations = [];
                    }
                    _error = _snapshot is null ? "Could not open this report. Check your sign-in, report permission and tenant access." :
                        "Refresh failed. Showing the last successful snapshot.";
                    return;
                }
                if (response.Response.TenantId != scope.TenantId)
                {
                    _snapshot = null;
                    _denied = true;
                    _products = []; _warehouses = []; _locations = [];
                    _error = "The returned report tenant does not match this link.";
                    return;
                }
                _snapshot = response.Response;
                _denied = false;
                BuildChoices(_snapshot);
                _snapshotTenant = scope.TenantId == selectedTenant ? TenantFilter.SelectedTenantName ?? "Selected tenant" :
                    $"Shared tenant {scope.TenantId.ToString()[..8]}";
                _snapshotScope = ScopeLabel(scope);
            }
            finally { _requestGate.Release(); }
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Inventory report refresh failed for tenant {TenantId}", scope.TenantId);
            if (revision == _revision && !_disposed)
                _error = _snapshot is null ? "Could not load inventory reports." : "Refresh failed. Showing the last successful snapshot.";
        }
        finally
        {
            if (ReferenceEquals(_request, request)) _request = null;
            if (revision == _revision && !_disposed) { _busy = false; StateHasChanged(); }
        }
    }

    private void BuildChoices(InventoryReportSnapshot snapshot)
    {
        _products = snapshot.Products.Select(x => new ReportChoice(x.Id, x.Label))
            .Concat(snapshot.Positions.Select(x => new ReportChoice(x.ProductId, x.ProductName)))
            .Concat(snapshot.Movements.Select(x => new ReportChoice(x.ProductId, x.ProductName)))
            .Concat(snapshot.NearExpiry.Concat(snapshot.Expired).Select(x => new ReportChoice(x.ProductId, x.ProductName)))
            .DistinctBy(x => x.Id).OrderBy(x => x.Label).ToList();
        _warehouses = snapshot.Warehouses.Select(x => new ReportChoice(x.Id, x.Label))
            .Concat(snapshot.Positions.Select(x => new ReportChoice(x.WarehouseId, x.WarehouseName)))
            .Concat(snapshot.Movements.Where(x => x.WarehouseId.HasValue).Select(x => new ReportChoice(x.WarehouseId!.Value, x.WarehouseName)))
            .DistinctBy(x => x.Id).OrderBy(x => x.Label).ToList();
        _locations = snapshot.Locations.Select(x => new ReportChoice(x.Id, x.Label, x.ParentId))
            .Concat(snapshot.Positions.Select(x => new ReportChoice(x.LocationId, x.LocationName, x.WarehouseId)))
            .Concat(snapshot.Movements.Where(x => x.LocationId.HasValue).Select(x => new ReportChoice(x.LocationId!.Value, x.LocationName, x.WarehouseId)))
            .DistinctBy(x => x.Id).OrderBy(x => x.Label).ToList();
    }

    private string ScopeLabel(InventoryReportScope scope)
    {
        string Label(List<ReportChoice> choices, Guid? id, string all, string selected) =>
            id is null ? all : choices.FirstOrDefault(x => x.Id == id)?.Label ?? selected;
        return $"{Label(_products, scope.ProductId, "All products", "Selected product")} / " +
            $"{Label(_warehouses, scope.WarehouseId, "All warehouses", "Selected warehouse")} / " +
            $"{Label(_locations, scope.LocationId, "All locations", "Selected location")} | " +
            $"Movements {scope.FromUtc:yyyy-MM-dd} to {scope.ToUtc:yyyy-MM-dd} UTC | Expiry {scope.DaysAhead} days";
    }

    private Task WarehouseChanged(string? value) { _warehouse = string.IsNullOrWhiteSpace(value) ? null : value; _location = null; return Task.CompletedTask; }
    private Task Apply()
    {
        if (_scope is null) return Task.CompletedTask;
        try
        {
            Guid? Id(string? value) => string.IsNullOrWhiteSpace(value) ? null : Guid.Parse(value);
            if (_from is null || _to is null || _to.Value.Date >= DateTime.MaxValue.Date) throw new FormatException();
            var scope = _scope with { ProductId = Id(_product), WarehouseId = Id(_warehouse), LocationId = Id(_location),
                FromUtc = DateTime.SpecifyKind(_from.Value.Date, DateTimeKind.Utc),
                ToUtc = DateTime.SpecifyKind(_to.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc), DaysAhead = _days };
            var uri = scope.ShareUri(Navigation);
            InventoryReportScope.Parse(uri, null);
            Navigation.NavigateTo(uri);
        }
        catch (FormatException) { _error = "Choose valid filters, a date range of at most 366 days and an expiry window of 1-365 days."; }
        return Task.CompletedTask;
    }
    private void Reset()
    {
        if (_scope is not null) Navigation.NavigateTo(InventoryReportScope.Default(_scope.TenantId).ShareUri(Navigation));
    }
    private void Share()
    {
        if (_scope is not null && _snapshot is not null) _shareUri = _scope.ShareUri(Navigation);
    }
    private async Task Export()
    {
        if (_snapshot is null || _scope is null || _busy || _exporting) return;
        var snapshot = _snapshot;
        var revision = _revision;
        var model = InventoryReportExport.Create(snapshot, _snapshotTenant, _snapshotScope);
        _exporting = true;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/XFramework.Portal.Shared/reports/report-export.js");
            if (_disposed || revision != _revision || !ReferenceEquals(snapshot, _snapshot)) return;
            await module.InvokeVoidAsync("exportPdf", model);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Inventory report PDF export failed");
            if (!_disposed && revision == _revision) _error = "Could not export this snapshot. Please try again.";
        }
        finally { _exporting = false; }
    }
    private async Task SetLive(bool value)
    {
        var revision = ++_liveRevision;
        _live = value;
        var cancellation = _liveCancellation;
        var task = _liveTask;
        _liveCancellation = null;
        _liveTask = null;
        cancellation?.Cancel();
        if (!value) _request?.Cancel();
        try { if (task is not null) await task; }
        finally { cancellation?.Dispose(); }
        if (value && !_disposed && revision == _liveRevision)
        {
            _liveCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
            _liveTask = LiveLoop(_liveCancellation.Token);
        }
    }
    private async Task LiveLoop(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(30), ct);
                await InvokeAsync(async () => { if (!_busy && !_exporting && _scope is not null) await Refresh(); });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        TenantFilter.OnChanged -= ContextChanged;
        ModuleNavigation.OnChanged -= ContextChanged;
        Invalidate();
        _lifetime.Cancel();
        await SetLive(false);
        _lifetime.Dispose();
    }
}
