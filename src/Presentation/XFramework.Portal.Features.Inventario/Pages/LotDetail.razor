@page "/inventario/lots/{Id:guid}"
@using XFramework.Domain.Shared.DataContext
@using XFramework.Inventario.Domain.Shared.Enums
@implements IDisposable

<PageTitle>Inventario Lot - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_hasTenant)
{
    <ModuleUnavailable ModuleName="Inventario" RequiresTenant="true" />
}
else if (!_traceabilityEnabled)
{
    <ModuleUnavailable ModuleName="Inventario Traceability" />
}
else if (_outsideTenantContext)
{
    <div class="space-y-4">
        <BbButton Variant="ButtonVariant.Ghost" OnClick="@(() => Navigation.NavigateTo("/inventario/lots"))">
            <LucideIcon Name="arrow-left" class="mr-2 h-4 w-4" />
            Back to Lots
        </BbButton>
        <BbAlert>
            <BbAlertTitle>Lot Outside Active Tenant</BbAlertTitle>
            <BbAlertDescription>Switch to this lot's tenant to view its details.</BbAlertDescription>
        </BbAlert>
    </div>
}
else if (_lot is null)
{
    <BbTypographyMuted>Lot not found.</BbTypographyMuted>
}
else
{
    <FadeInContent>
        <div class="space-y-6 inv-page">
            <div class="flex items-center gap-4">
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Back to lots"
                          OnClick="@(() => Navigation.NavigateTo("/inventario/lots"))">
                    <LucideIcon Name="arrow-left" class="h-4 w-4" />
                </BbButton>
                <div class="flex-1">
                    <div class="flex items-center gap-2">
                        <BbTypographyH3>@_lot.LotNumber</BbTypographyH3>
                        <StatusBadge Text="@(_lot.Status == InventoryLotStatus.Available ? "Eligible" : _lot.Status.ToString())" Status="@GetStatusBadge(_lot.Status)" />
                    </div>
                    <BbTypographyMuted>@GetProductLabel() / @InventoryDisplay.Variant(_variants, _lot.ProductVariationId). @(_balances.Sum(x => x.OnHandQuantity) == 0 ? "Depleted" : "Stock on hand")</BbTypographyMuted>
                </div>
                <BbButton Variant="ButtonVariant.Outline" OnClick="@Reload">
                    <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                    Refresh
                </BbButton>
            </div>

            <div class="xf-summary-grid xf-summary-grid-3">
                <BbCard>
                    <BbCardContent>
                        <div class="space-y-1 pt-4">
                            <BbTypographyMuted>On Hand</BbTypographyMuted>
                            <BbTypographyH3>@TotalOnHand.ToString("N2")</BbTypographyH3>
                        </div>
                    </BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardContent>
                        <div class="space-y-1 pt-4">
                            <BbTypographyMuted>Reserved</BbTypographyMuted>
                            <BbTypographyH3>@TotalReserved.ToString("N2")</BbTypographyH3>
                        </div>
                    </BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardContent>
                        <div class="space-y-1 pt-4">
                            <BbTypographyMuted>Available</BbTypographyMuted>
                            <BbTypographyH3>@TotalAvailable.ToString("N2")</BbTypographyH3>
                        </div>
                    </BbCardContent>
                </BbCard>
            </div>

            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Lot Summary</BbCardTitle>
                    <BbCardDescription>Traceability metadata and source details.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>@if (_maintenanceEditing)
                    {
                        @if (_maintenanceError is not null) { <BbAlert><BbAlertDescription>@_maintenanceError</BbAlertDescription></BbAlert> }
                        <div class="xf-detail-field-grid"><BbFormFieldInput TValue="string" @bind-Value="_editSupplierReference" Label="Supplier Reference" />
<BbFormFieldDatePicker @bind-Value="_editManufacturedAt" Label="Manufactured At" />
<BbFormFieldDatePicker @bind-Value="_editExpiresAt" Label="Expires At" />
<InventorySelect TValue="InventoryLotStatus" @bind-Value="_editStatus" Label="Status">@foreach (var value in Enum.GetValues<InventoryLotStatus>()) { <BbSelectItem Value="@value">@value</BbSelectItem> }</InventorySelect>
</div>
                        <p class="text-sm text-muted-foreground">Identity and existing stock quantities remain unchanged. Eligibility and pickability changes require active reservations to be released first.</p>
                        <div class="xf-page-actions"><BbButton OnClick="@SaveMaintenance" Disabled="@_maintenanceSaving">Save changes</BbButton><BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _maintenanceEditing = false)" Disabled="@_maintenanceSaving">Discard</BbButton></div>
                    }
                    else
                    {
                        <BbButton Variant="ButtonVariant.Outline" OnClick="@BeginMaintenance">Edit details</BbButton>

                    <div class="grid gap-4 md:grid-cols-2">
                        <div>
                            <BbTypographyMuted>Product</BbTypographyMuted>
                            <div>@GetProductLabel()</div>
                        </div>
                        <div>
                            <BbTypographyMuted>Supplier / Source Ref</BbTypographyMuted>
                            <div>@(_lot.SupplierReference ?? "N/A")</div>
                        </div>
                        <div>
                            <BbTypographyMuted>Received</BbTypographyMuted>
                            <div>@FormatDate(_lot.ReceivedAt)</div>
                        </div>
                        <div>
                            <BbTypographyMuted>Manufactured</BbTypographyMuted>
                            <div>@FormatDate(_lot.ManufacturedAt)</div>
                        </div>
                        <div>
                            <BbTypographyMuted>Expiration</BbTypographyMuted>
                            <div>@(_lot.ExpiresAt?.ToString("dd MMM yyyy") ?? "No expiry")</div>
                        </div>
                        <div>
                            <BbTypographyMuted>Unit Cost</BbTypographyMuted>
                            <div>@(_lot.UnitCost?.ToString("N4") ?? "N/A")</div>
                        </div>
                        <div>
                            <BbTypographyMuted>Source</BbTypographyMuted>
                            <div>@if (_lot.SourceReferenceType == "receiving" && _lot.SourceReferenceId is { } receiptId)
                            { <a href="@($"/inventario/receiving/{receiptId}")">Stock receipt</a> }
                            else { @FormatSource() }</div>
                        </div>
                        <div>
                            <BbTypographyMuted>Created</BbTypographyMuted>
                            <div>@_lot.CreatedAt.ToLocalTime().ToString("g")</div>
                        </div>
                    </div>

                    }
</BbCardContent>
            </BbCard>

            <BbTabs DefaultValue="view0" Class="inv-workspace-tabs"><BbTabsList><BbTabsTrigger Value="view0">Balances</BbTabsTrigger><BbTabsTrigger Value="view1">Movements</BbTabsTrigger></BbTabsList><BbTabsContent Value="view0" ForceMount="true"><BbCard>
                <BbCardHeader>
                    <BbCardTitle>Stock Balances</BbCardTitle>
                    <BbCardDescription>Warehouse and location balances for this lot.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataGrid Items="@_balances" ShowPagination="true" InitialPageSize="10"
                                OnRowClick="@((StockBalance item) => Navigation.NavigateTo($"/inventario/stock/balances/{item.Id}"))"
                                Class="cursor-pointer">
                        <Columns><InventoryTemplateColumn Title="Variant" Filterable="true" SortBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))" FilterBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))"><ChildContent Context="item">@InventoryDisplay.Variant(_variants, item.ProductVariationId)</ChildContent></InventoryTemplateColumn>
                            <InventoryTemplateColumn Title="Warehouse" Filterable="true" SortBy="@(item => GetWarehouseName(item.WarehouseId))" FilterBy="@(item => GetWarehouseName(item.WarehouseId))">
                                <ChildContent Context="item">@GetWarehouseName(item.WarehouseId)</ChildContent>
                            </InventoryTemplateColumn>
                            <InventoryTemplateColumn Title="Location" Filterable="true" SortBy="@(item => GetLocationName(item.LocationId))" FilterBy="@(item => GetLocationName(item.LocationId))">
                                <ChildContent Context="item">@GetLocationName(item.LocationId)</ChildContent>
                            </InventoryTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.OnHandQuantity)" Title="On Hand" Format="0.####" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.ReservedQuantity)" Title="Reserved" Format="0.####" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.AvailableQuantity)" Title="Available" Format="0.####" Sortable="true" Filterable="true" />
                        </Columns>
                    </BbDataGrid>
                </BbCardContent>
            </BbCard></BbTabsContent>

            <BbTabsContent Value="view1" ForceMount="true"><BbCard>
                <BbCardHeader>
                    <BbCardTitle>Movement Ledger</BbCardTitle>
                    <BbCardDescription>Append-only movement rows associated with this lot.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataGrid Items="@_movements" ShowPagination="true" InitialPageSize="10"
                                OnRowClick="@((InventoryMovement item) => Navigation.NavigateTo($"/inventario/stock/movements/{item.Id}"))"
                                Class="cursor-pointer">
                        <Columns><InventoryTemplateColumn Title="Variant" Filterable="true" SortBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))" FilterBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))"><ChildContent Context="item">@InventoryDisplay.Variant(_variants, item.ProductVariationId)</ChildContent></InventoryTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.MovementType)" Title="Type" Sortable="true" Filterable="true" />
                            <InventoryTemplateColumn Title="Affects" Filterable="true" SortBy="@(item => InventoryDisplay.Effect(item.MovementType))" FilterBy="@(item => InventoryDisplay.Effect(item.MovementType))"><ChildContent Context="item">@InventoryDisplay.Effect(item.MovementType)</ChildContent></InventoryTemplateColumn>
<BbDataGridPropertyColumn Property="@(x => x.QuantityDelta)" Title="Delta" Format="0.####" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.QuantityAfter)" Title="On hand after" Format="0.####" Sortable="true" Filterable="true" />
                            <InventoryTemplateColumn Title="Reference" Filterable="true" SortBy="@(item => InventoryDisplay.Reference(item.ReferenceType))" FilterBy="@(item => InventoryDisplay.Reference(item.ReferenceType))"><ChildContent Context="item">@InventoryDisplay.Reference(item.ReferenceType)</ChildContent></InventoryTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.MovementDate)" Title="Movement Date" Sortable="true" Filterable="true" />
                        </Columns>
                    </BbDataGrid>
                </BbCardContent>
            </BbCard></BbTabsContent></BbTabs>
        </div>
    </FadeInContent>
}

@code {
    private List<ProductVariation> _variants = [];
    private List<InventoryLot> _identityLots = [];
    [Parameter] public Guid Id { get; set; }

    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private IPortalModuleAvailability ModuleNavigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    private InventoryLot? _lot;
    private Product? _product;
    private List<Warehouse> _warehouses = [];
    private List<InventoryLocation> _locations = [];
    private List<StockBalance> _balances = [];
    private List<InventoryMovement> _movements = [];
    private bool _loading = true;
    private bool _hasTenant;
    private bool _traceabilityEnabled;
    private bool _outsideTenantContext;
    private Guid? _loadedId;

    private decimal TotalOnHand => _balances.Sum(x => x.OnHandQuantity);
    private decimal TotalReserved => _balances.Sum(x => x.ReservedQuantity);
    private decimal TotalAvailable => _balances.Sum(x => x.AvailableQuantity);

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        ModuleNavigation.OnChanged += OnTenantChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id) return;
        _loadedId = Id;
        await Reload();
    }

    private void OnTenantChanged() => _ = InvokeAsync(Reload);

    private async Task Reload()
    {
        _loading = true;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _traceabilityEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "traceability");
            _outsideTenantContext = false;
            _lot = null;
            _product = null;
            _warehouses = [];
            _locations = [];
            _balances = [];
            _movements = [];

            if (!_hasTenant || !_traceabilityEnabled) return;

            _lot = await DataContext.Query<InventoryLot>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id && !x.IsDeleted)
                .FirstOrDefaultAsync();

            _outsideTenantContext = _lot is not null && _lot.TenantId != TenantFilter.SelectedTenantId;
            if (_lot is null || _outsideTenantContext) return;

            var tenantId = _lot.TenantId;
            _variants = await DataContext.Query<ProductVariation>().NoCache().Where(x => x.TenantId == tenantId && !x.IsDeleted).Take(1000).ToListAsync();
            _identityLots = await DataContext.Query<InventoryLot>().NoCache().Where(x => x.TenantId == tenantId && !x.IsDeleted).Take(1000).ToListAsync();
            _product = await DataContext.Query<Product>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && x.Id == _lot.ProductId && !x.IsDeleted)
                .FirstOrDefaultAsync();

            _warehouses = await DataContext.Query<Warehouse>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                .Take(200)
                .ToListAsync();

            _locations = await DataContext.Query<InventoryLocation>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                .Take(500)
                .ToListAsync();

            _balances = await DataContext.Query<StockBalance>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && x.LotId == Id && !x.IsDeleted)
                .OrderBy(x => x.WarehouseId)
                .Take(500)
                .ToListAsync();

            _movements = await DataContext.Query<InventoryMovement>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && x.LotId == Id && !x.IsDeleted)
                .OrderByDescending(x => x.MovementDate)
                .Take(500)
                .ToListAsync();
        }
        catch
        {
            ToastService.Show("Could not load lot.");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private string GetProductLabel() =>
        _product is null
            ? _lot?.ProductId.ToString()[..8] ?? "N/A"
            : string.IsNullOrWhiteSpace(_product.SKU) ? _product.Name ?? _product.Id.ToString()[..8] : $"{_product.Name} ({_product.SKU})";

    private string GetWarehouseName(Guid warehouseId) =>
        _warehouses.FirstOrDefault(x => x.Id == warehouseId)?.Name ?? warehouseId.ToString()[..8];

    private string GetLocationName(Guid locationId) =>
        _locations.FirstOrDefault(x => x.Id == locationId)?.Name ?? locationId.ToString()[..8];

    private string FormatSource()
    {
        if (_lot is null) return "N/A";
        if (string.IsNullOrWhiteSpace(_lot.SourceReferenceType) && _lot.SourceReferenceId is null) return "N/A";
        return InventoryDisplay.Reference(_lot.SourceReferenceType);
    }

    private static string FormatDate(DateTime? value) =>
        value.HasValue ? value.Value.ToLocalTime().ToString("g") : "N/A";

    private static string GetStatusBadge(InventoryLotStatus status) =>
        status is InventoryLotStatus.Available ? "active" : "inactive";

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantChanged;
        ModuleNavigation.OnChanged -= OnTenantChanged;
    }

    private string? _maintenanceError;
    private bool _maintenanceEditing;
    private bool _maintenanceSaving;
    private Guid _editStamp;
    private string _editSupplierReference = "";
    private DateTime? _editManufacturedAt;
    private DateTime? _editExpiresAt;
    private InventoryLotStatus _editStatus;

    private void BeginMaintenance()
    {
        if (_lot is null) return;
        _editStamp = _lot.ConcurrencyStamp;
        _editSupplierReference = _lot.SupplierReference ?? "";
        _editManufacturedAt = _lot.ManufacturedAt;
        _editExpiresAt = _lot.ExpiresAt;
        _editStatus = _lot.Status;
        _maintenanceError = null;
        _maintenanceEditing = true;
    }
    private async Task SaveMaintenance()
    {
        if (_lot is null || _maintenanceSaving) return;
        _maintenanceError = null;
        if (_editSupplierReference.Length > 200) { _maintenanceError = "Supplier reference must be at most 200 characters."; return; }
        _maintenanceSaving = true;
        try
        {
            var result = await Inventario.UpdateInventoryLot(new UpdateInventoryLotRequest
            {
                Metadata = new() { RequestedTenantId = TenantFilter.SelectedTenantId },
                Id = _lot.Id,
                ConcurrencyStamp = _editStamp,
                SupplierReference = _editSupplierReference,
                ManufacturedAt = InventoryDisplay.CalendarDateUtc(_editManufacturedAt),
                ExpiresAt = InventoryDisplay.CalendarDateUtc(_editExpiresAt),
                Status = _editStatus,
            });
            if (result.IsSuccess)
            {
                _maintenanceEditing = false;
                ToastService.Success("Changes saved.");
                await Reload();
            }
            else ToastService.Error("Could not save. Check fields, release active reservations if changing eligibility, or refresh if another user edited this record.");
        }
        catch { ToastService.Error("Could not save changes. Refresh and try again."); }
        finally { _maintenanceSaving = false; }
    }
    [Inject] private IInventarioServiceWrapper Inventario { get; set; } = default!;
}
