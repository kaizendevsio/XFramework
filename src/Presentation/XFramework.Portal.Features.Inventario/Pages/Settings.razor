@page "/inventario/settings"
@using XFramework.Inventario.Domain.Shared.Contracts.Requests.Setup
@using XFramework.Inventario.Domain.Shared.Contracts.Responses
@using XFramework.Portal.Features.Inventario.Components
@implements IDisposable

<PageTitle>Inventario Settings - Portal</PageTitle>
@if (_loading) { <CenteredSpinner /> }
else if (TenantContext.SelectedTenantId is null) { <ModuleUnavailable ModuleName="Inventario" RequiresTenant="true" /> }
else if (!_moduleEnabled) { <ModuleUnavailable ModuleName="Inventario" /> }
else
{
    <div class="inv-page settings-page space-y-6" data-testid="inventario-settings">
        <div class="xf-page-header">
            <div><BbTypographyH3>Inventario Settings</BbTypographyH3><BbTypographyMuted>@TenantContext.SelectedTenantName</BbTypographyMuted></div>
            <div class="xf-page-actions">
                <BbButton Variant="ButtonVariant.Outline" OnClick="Reload" Disabled="@_saving"><LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />Reload</BbButton>
                @if (_state?.CanManage == true && _state.CompletedAt is null)
                { <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => Navigation.NavigateTo("/inventario/setup"))" Disabled="@_saving"><LucideIcon Name="settings" class="mr-2 h-4 w-4" />Setup</BbButton> }
            </div>
        </div>
        @if (_error is not null) { <BbAlert Variant="AlertVariant.Danger" role="alert"><BbAlertDescription>@_error</BbAlertDescription></BbAlert> }
        @if (_state is not null)
        {
            @if (_state.ShouldPrompt)
            { <BbAlert><BbAlertTitle>Inventario is not set up</BbAlertTitle><BbAlertDescription>No configuration has been confirmed for this tenant.</BbAlertDescription></BbAlert> }
            <fieldset disabled="@(_saving || !_state.CanManage)">
            <section class="settings-section">
                <BbTypographyH4>Stock organization</BbTypographyH4>
                <div class="settings-fields">
                    <InventorySelect TValue="string" @bind-Value="_mode" Label="Setup mode" DisplayTextSelector="@(value => value == "advanced" ? "Advanced" : "Basic")">
                        <BbSelectItem Value="@("basic")">Basic</BbSelectItem>
                        <BbSelectItem Value="@("advanced")">Advanced</BbSelectItem>
                    </InventorySelect>
                </div>
                <BbTypographyMuted>Changing mode keeps existing stock, warehouses and locations.</BbTypographyMuted>
            </section>
            <section class="settings-section">
                <BbTypographyH4>Catalog defaults</BbTypographyH4>
                <InventarioPreferencesFields SupportedCurrencies="_state.SupportedCurrencies" @bind-Currency="_currency" @bind-Threshold="_threshold" @bind-DefaultProductAvailable="_defaultProductAvailable" />
            </section>
            <section class="settings-section">
                <BbTypographyH4>Default stock area</BbTypographyH4>
                @if (_state.WarehousingEnabled)
                {
                <div class="settings-fields">
                    <div><BbLabel for="settings-warehouse">@WarehouseLabel</BbLabel><BbCombobox Id="settings-warehouse" AriaLabel="@WarehouseLabel" Class="w-full inventory-default-picker" TValue="string" Value="@_warehouseId" ValueChanged="SelectWarehouse" Options="WarehouseOptions" Placeholder="Select stock area" /></div>
                    <div><BbLabel for="settings-location">@LocationLabel</BbLabel><BbCombobox Id="settings-location" AriaLabel="@LocationLabel" Class="w-full inventory-default-picker" TValue="string" @bind-Value="_locationId" Options="LocationOptions" Placeholder="Select stock location" Disabled="@string.IsNullOrEmpty(_warehouseId)" /></div>
                </div>
                }
                else
                { <BbTypographyMuted>Catalog only. Warehousing is disabled; existing stock defaults are preserved.</BbTypographyMuted> }
            </section>
            </fieldset>
            <div class="settings-actions">
                <BbButton Variant="ButtonVariant.Outline" OnClick="RestoreDraft" Disabled="@(_saving || !IsDirty)">Discard changes</BbButton>
                <BbButton OnClick="Save" Disabled="@(_saving || !_state.CanManage || !IsDirty || !_state.SupportedCurrencies.Contains(_currency) || !StockSelectionValid)"><LucideIcon Name="save" class="mr-2 h-4 w-4" />@(_saving ? "Saving..." : "Save Settings")</BbButton>
            </div>
            <InventarioConfigurationLinks />
        }
    </div>
}

@code {
    [Inject] private IInventarioServiceWrapper Inventario { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantContext { get; set; } = default!;
    [Inject] private IPortalModuleAvailability Availability { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ToastService Toasts { get; set; } = default!;
    private InventarioSetupResponse? _state;
    private int _threshold, _revision;
    private string _currency = "PHP";
    private string _mode = "basic", _warehouseId = "", _locationId = "";
    private bool _defaultProductAvailable = true;
    private string WarehouseLabel => _mode == "basic" ? "Stock area" : "Default warehouse";
    private string LocationLabel => _mode == "basic" ? "Stock location" : "Default location";
    private bool StockSelectionValid => _state?.WarehousingEnabled != true ||
        (string.IsNullOrEmpty(_warehouseId) && string.IsNullOrEmpty(_locationId)) ||
        (_state.Warehouses.Any(x => x.IsEnabled && x.Id.ToString() == _warehouseId) &&
         _state.Locations.Any(x => x.IsEnabled && x.IsPickable && x.WarehouseId.ToString() == _warehouseId && x.Id.ToString() == _locationId));
    private List<SelectOption<string>> WarehouseOptions => _state?.Warehouses.Where(x => x.IsEnabled).Select(x => new SelectOption<string>(x.Id.ToString(), $"{x.Code} - {x.Name}")).ToList() ?? [];
    private List<SelectOption<string>> LocationOptions => _state?.Locations.Where(x => x.IsEnabled && x.IsPickable && x.WarehouseId.ToString() == _warehouseId).Select(x => new SelectOption<string>(x.Id.ToString(), $"{x.Code} - {x.Name}")).ToList() ?? [];
    private string? _error;
    private bool _loading = true, _saving, _moduleEnabled, _disposed;
    private bool IsDirty => _state is not null && (_threshold != _state.LowStockThreshold || _currency != _state.DefaultCurrency || _defaultProductAvailable != _state.DefaultProductAvailable || _mode != (_state.Mode == InventarioSetupMode.Advanced ? "advanced" : "basic") || _warehouseId != (_state.WarehouseId?.ToString() ?? "") || _locationId != (_state.LocationId?.ToString() ?? ""));
    private void SelectWarehouse(string value) { _warehouseId = value; _locationId = ""; }
    private void RestoreDraft()
    {
        if (_state is null) return;
        _threshold = _state.LowStockThreshold; _currency = _state.DefaultCurrency;
        _mode = _state.Mode == InventarioSetupMode.Advanced ? "advanced" : "basic";
        _defaultProductAvailable = _state.DefaultProductAvailable;
        _warehouseId = _state.WarehouseId?.ToString() ?? ""; _locationId = _state.LocationId?.ToString() ?? "";
        _error = null;
    }
    protected override void OnInitialized() { TenantContext.OnChanged += Changed; Availability.OnChanged += Changed; }
    protected override Task OnInitializedAsync() => Reload();
    private void Changed()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () => { var pending = Reload(); StateHasChanged(); await pending; if (!_disposed) StateHasChanged(); });
    }
    private bool Current(int revision, Guid? id) => !_disposed && revision == _revision && TenantContext.SelectedTenantId == id;
    private async Task Reload()
    {
        var revision = ++_revision;
        var id = TenantContext.SelectedTenantId;
        _loading = true; _saving = false; _error = null; _state = null;
        try
        {
            await Availability.EnsureLoadedAsync();
            if (!Current(revision, id)) return;
            _moduleEnabled = Availability.ActiveTenantId == id && Availability.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario);
            if (id is not Guid tenantId || !_moduleEnabled) return;
            var result = await Inventario.GetInventarioSetup(new GetInventarioSetupRequest { Metadata = new() { RequestedTenantId = tenantId } });
            if (!Current(revision, id)) return;
            if (result.IsSuccess && result.Response?.TenantId == tenantId)
            { _state = result.Response; RestoreDraft(); }
            else _error = "Inventario settings could not be loaded.";
        }
        catch { if (Current(revision, id)) _error = "Inventario settings could not be loaded."; }
        finally { if (Current(revision, id)) _loading = false; }
    }
    private async Task Save()
    {
        if (_saving || _state?.CanManage != true || TenantContext.SelectedTenantId != _state.TenantId) return;
        if (_threshold < 0 || !_state.SupportedCurrencies.Contains(_currency))
        { _error = "Enter a non-negative threshold and select a supported currency."; return; }
        if (!StockSelectionValid)
        { _error = "Select an active stock area and pickable location."; return; }
        var revision = _revision;
        var id = _state.TenantId;
        var request = new UpdateInventarioPreferencesRequest
        {
            Metadata = new() { RequestedTenantId = id }, ExpectedConcurrencyStamp = _state.ConcurrencyStamp,
            LowStockThreshold = _threshold, DefaultCurrency = _currency,
            Mode = _mode == "advanced" ? InventarioSetupMode.Advanced : InventarioSetupMode.Basic,
            DefaultProductAvailable = _defaultProductAvailable,
            WarehouseId = _state.WarehousingEnabled && Guid.TryParse(_warehouseId, out var w) ? w : null,
            LocationId = _state.WarehousingEnabled && Guid.TryParse(_locationId, out var l) ? l : null
        };
        _saving = true; _error = null;
        try
        {
            var result = await Inventario.UpdateInventarioPreferences(request);
            if (!Current(revision, id)) return;
            if (result.IsSuccess && result.Response?.TenantId == id)
            { _state = result.Response; RestoreDraft(); Toasts.Success("Inventario settings saved."); }
            else _error = result.HttpStatusCode == System.Net.HttpStatusCode.Conflict ? "Settings changed. Reload before saving." : "Settings could not be saved.";
        }
        catch { if (Current(revision, id)) _error = "Settings could not be saved."; }
        finally { if (Current(revision, id)) _saving = false; }
    }
    public void Dispose() { _disposed = true; ++_revision; TenantContext.OnChanged -= Changed; Availability.OnChanged -= Changed; }
}
