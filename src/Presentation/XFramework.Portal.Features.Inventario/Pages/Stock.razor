@page "/inventario/stock"
@using XFramework.Domain.Shared.DataContext
@using XFramework.Inventario.Domain.Shared.Contracts.Requests.Lots
@using XFramework.Inventario.Domain.Shared.Contracts.Requests.Locations
@using XFramework.Inventario.Domain.Shared.Contracts.Requests.Stock
@using XFramework.Inventario.Domain.Shared.Contracts.Requests.Warehouses
@using XFramework.Inventario.Domain.Shared.Enums
@implements IDisposable

<PageTitle>Inventario Stock - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_hasTenant)
{
    <ModuleUnavailable ModuleName="Inventario" RequiresTenant="true" />
}
else if (!_stockEnabled && !_movementsEnabled)
{
    <ModuleUnavailable ModuleName="Inventario Stock" />
}
else
{
    <FadeInContent>
        <div class="space-y-6 inv-page">
            <div class="xf-page-header">
                <div>
                    <BbTypographyH3>Stock Control</BbTypographyH3>
                    <BbTypographyMuted>Post stock movements and inspect balances for the selected tenant.</BbTypographyMuted>
                </div>
                <div class="xf-page-actions">
                    @if (_movementsEnabled)
                    {
                        <BbButton OnClick="@OpenMovementDialog">
                            <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                            Post Movement
                        </BbButton>
                    }
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@Reload">
                        <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                        Refresh
                    </BbButton>
                </div>
            </div>

            @if (ProductId is { } productId)
            {
                <div class="flex flex-wrap items-center gap-3">
                    <span>Product: @GetProductName(productId)</span>
                    <a href="@($"/inventario/products/{productId}/stock")">Back to product stock</a>
                    <a href="/inventario/stock">Clear product scope</a>
                </div>
            }
            <div class="xf-filter-actions">
                <BbFormFieldInput TValue="string" @bind-Value="_search" Label="Search stock" Placeholder="Product, SKU, variant or lot" />
                <InventorySelect TValue="string" @bind-Value="_warehouseFilter" Label="Warehouse" DisplayTextSelector="@(value => value == "all" ? "All warehouses" : _warehouses.FirstOrDefault(x => x.Id.ToString() == value)?.Name ?? "Select warehouse")">
                    <BbSelectItem Value="@("all")">All warehouses</BbSelectItem>
                    @foreach (var warehouse in _warehouses) { <BbSelectItem Value="@warehouse.Id.ToString()">@warehouse.Name</BbSelectItem> }
                </InventorySelect>
                <BbButton Variant="ButtonVariant.Outline" OnClick="@ClearFilters">Clear filters</BbButton>
            </div>
            <BbTabs Value="@_stockView" ValueChanged="@(v => _stockView = v)" Class="inv-workspace-tabs">
                <BbTabsList>
                    @if (_stockEnabled) { <BbTabsTrigger Value="balances">Balances (@FilteredBalanceCount)</BbTabsTrigger> }
                    @if (_movementsEnabled) { <BbTabsTrigger Value="movements">Movements (@FilteredMovementCount)</BbTabsTrigger> }
                </BbTabsList>
            @if (_stockEnabled)
            {
                <BbTabsContent Value="balances" ForceMount="true"><BbCard>
                    <BbCardHeader>
                        <BbCardTitle>Stock Balances</BbCardTitle>
                        <BbCardDescription>@FilteredBalanceCount balance row(s) in scope before column filters</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent>
                        <BbDataGrid Items="@_balances.Where(x => Matches(x.ProductId, x.ProductVariationId, x.LotId, x.WarehouseId)).ToList()" ShowPagination="true" InitialPageSize="20"
                                    OnRowClick="@((StockBalance item) => Navigation.NavigateTo($"/inventario/stock/balances/{item.Id}{ProductQuery}"))"
                                    Class="cursor-pointer">
                            <Columns><InventoryTemplateColumn Title="Variant" Filterable="true" SortBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))" FilterBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))"><ChildContent Context="item">@InventoryDisplay.Variant(_variants, item.ProductVariationId)</ChildContent></InventoryTemplateColumn>
                                <InventoryTemplateColumn Title="Product" Filterable="true" SortBy="@(item => GetProductName(item.ProductId))" FilterBy="@(item => GetProductName(item.ProductId))">
                                    <ChildContent Context="item">@GetProductName(item.ProductId)</ChildContent>
                                </InventoryTemplateColumn>
                                <InventoryTemplateColumn Title="Warehouse" Filterable="true" SortBy="@(item => GetWarehouseName(item.WarehouseId))" FilterBy="@(item => GetWarehouseName(item.WarehouseId))">
                                    <ChildContent Context="item">@GetWarehouseName(item.WarehouseId)</ChildContent>
                                </InventoryTemplateColumn>
                                <InventoryTemplateColumn Title="Location" Filterable="true" SortBy="@(item => GetLocationName(item.LocationId))" FilterBy="@(item => GetLocationName(item.LocationId))">
                                    <ChildContent Context="item">@GetLocationName(item.LocationId)</ChildContent>
                                </InventoryTemplateColumn>
                                @if (_traceabilityEnabled)
                                {
                                    <InventoryTemplateColumn Title="Lot" Filterable="true" SortBy="@(item => GetLotLabel(item.LotId))" FilterBy="@(item => GetLotLabel(item.LotId))">
                                        <ChildContent Context="item">@GetLotLabel(item.LotId)</ChildContent>
                                    </InventoryTemplateColumn>
                                }
                                <BbDataGridPropertyColumn Property="@(x => x.OnHandQuantity)" Title="On Hand" Format="0.####" Sortable="true" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.ReservedQuantity)" Title="Reserved" Format="0.####" Sortable="true" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.AvailableQuantity)" Title="Available" Format="0.####" Sortable="true" Filterable="true" />

                                <BbDataGridPropertyColumn Property="@(x => x.LastMovementAt)" Title="Last movement" Sortable="true" Filterable="true" />
                                <BbDataGridTemplateColumn Title="Actions">
                                    <ChildContent Context="item">
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="View stock balance"
                                                  OnClick="@(() => Navigation.NavigateTo($"/inventario/stock/balances/{item.Id}{ProductQuery}"))">
                                            <LucideIcon Name="eye" class="h-4 w-4" />
                                        </BbButton>
                                        <div @onclick:stopPropagation="true"><BbButton Variant="ButtonVariant.Ghost" OnClick="@(() => OpenForBalance(item))">Adjust</BbButton></div>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                            </Columns>
                        </BbDataGrid>
                    </BbCardContent>
                </BbCard></BbTabsContent>
            }

            @if (_movementsEnabled)
            {
                <BbTabsContent Value="movements" ForceMount="true"><BbCard>
                    <BbCardHeader>
                        <BbCardTitle>Movement Ledger</BbCardTitle>
                        <BbCardDescription>@FilteredMovementCount movement(s) in scope before column filters</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent>
                        <BbDataGrid Items="@_movements.Where(x => Matches(x.ProductId, x.ProductVariationId, x.LotId, x.WarehouseId)).ToList()" ShowPagination="true" InitialPageSize="20"
                                    OnRowClick="@((InventoryMovement item) => Navigation.NavigateTo($"/inventario/stock/movements/{item.Id}{ProductQuery}"))"
                                    Class="cursor-pointer">
                            <Columns><InventoryTemplateColumn Title="Variant" Filterable="true" SortBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))" FilterBy="@(item => InventoryDisplay.Variant(_variants, item.ProductVariationId))"><ChildContent Context="item">@InventoryDisplay.Variant(_variants, item.ProductVariationId)</ChildContent></InventoryTemplateColumn>
                                <InventoryTemplateColumn Title="Product" Filterable="true" SortBy="@(item => GetProductName(item.ProductId))" FilterBy="@(item => GetProductName(item.ProductId))">
                                    <ChildContent Context="item">@GetProductName(item.ProductId)</ChildContent>
                                </InventoryTemplateColumn>
                                @if (_traceabilityEnabled)
                                {
                                    <InventoryTemplateColumn Title="Lot" Filterable="true" SortBy="@(item => GetLotLabel(item.LotId))" FilterBy="@(item => GetLotLabel(item.LotId))">
                                        <ChildContent Context="item">@GetLotLabel(item.LotId)</ChildContent>
                                    </InventoryTemplateColumn>
                                }
                                <BbDataGridPropertyColumn Property="@(x => x.MovementType)" Title="Type" Sortable="true" Filterable="true" />
                                <InventoryTemplateColumn Title="Affects" Filterable="true" SortBy="@(item => InventoryDisplay.Effect(item.MovementType))" FilterBy="@(item => InventoryDisplay.Effect(item.MovementType))"><ChildContent Context="item">@InventoryDisplay.Effect(item.MovementType)</ChildContent></InventoryTemplateColumn>
<BbDataGridPropertyColumn Property="@(x => x.QuantityDelta)" Title="Delta" Format="0.####" Sortable="true" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.QuantityBefore)" Title="On hand before" Format="0.####" Sortable="true" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.QuantityAfter)" Title="On hand after" Format="0.####" Sortable="true" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.Reason)" Title="Reason" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.MovementDate)" Title="Movement Date" Sortable="true" Filterable="true" />
                                <BbDataGridTemplateColumn Title="Actions">
                                    <ChildContent Context="item">
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="View movement"
                                                  OnClick="@(() => Navigation.NavigateTo($"/inventario/stock/movements/{item.Id}{ProductQuery}"))">
                                            <LucideIcon Name="eye" class="h-4 w-4" />
                                        </BbButton>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                            </Columns>
                        </BbDataGrid>
                    </BbCardContent>
                </BbCard></BbTabsContent>
            }
</BbTabs>
        </div>
    </FadeInContent>
}

<BbDialog Open="@_movementDialogOpen" OpenChanged="@(v => _movementDialogOpen = v)">
    <BbDialogContent TrapFocus="false" Class="xf-dialog-wide inv-dialog">
        <BbDialogHeader>
            <BbDialogTitle>Post Movement</BbDialogTitle>
            <BbDialogDescription>Choose the stock position and record the quantity change. Adjustments use a signed change: +5 adds five; -5 removes five. This does not set an absolute balance.</BbDialogDescription>
        </BbDialogHeader>
        <div class="grid gap-4 py-4 inv-dialog-body">
            <div class="grid gap-3 xl:grid-cols-2">
                <XfEntityPicker TItem="Product"
                                Value="@_movementForm.ProductId"
                                ValueChanged="@OnMovementProductChanged"
                                Items="@_products"
                                Label="Product"
                                Placeholder="Select product"
                                SearchPlaceholder="Search products..."
                                EmptyMessage="No products found."
                                ValueSelector="@GetProductPickerValue"
                                TextSelector="@GetProductLabel"
                                SearchTextSelector="@GetProductSearchText"
                                AdvancedSearchTitle="Find Product"
                                AdvancedSearchDescription="Search products in the active tenant." />
                <InventorySelect TValue="string" Value="@_movementForm.ProductVariationId" ValueChanged="@((string value) => { _movementForm.ProductVariationId = value; _movementForm.LotId = ""; })" Label="Variant" DisplayTextSelector="@(value => InventoryDisplay.Variant(_variants, Guid.TryParse(value, out var id) ? id : null))">
                    <BbSelectItem Value="@("base")">Base product</BbSelectItem>
                    @foreach (var variant in _variants.Where(x => x.ProductId.ToString() == _movementForm.ProductId))
                    { <BbSelectItem Value="@variant.Id.ToString()">@InventoryDisplay.Variant(_variants, variant.Id)</BbSelectItem> }
                </InventorySelect>
                @if (_traceabilityEnabled)
                {
                    <XfEntityPicker TItem="InventoryLot"
                                    @bind-Value="_movementForm.LotId"
                                    Items="@LotsForSelectedProduct().ToList()"
                                    Label="Lot / Batch"
                                    Placeholder="No lot"
                                    SearchPlaceholder="Search lots..."
                                    EmptyMessage="No lots found."
                                    ValueSelector="@GetLotPickerValue"
                                    TextSelector="@GetLotLabel"
                                    SearchTextSelector="@GetLotSearchText"
                                    AllowClear="true"
                                    ClearText="No lot / untracked"
                                    AdvancedSearchTitle="Find Lot / Batch"
                                    AdvancedSearchDescription="Search lots for the selected product." />
                }
                <XfEntityPicker TItem="Warehouse"
                                Value="@_movementForm.WarehouseId"
                                ValueChanged="@OnMovementWarehouseChanged"
                                Items="@_warehouses"
                                Label="Warehouse"
                                Placeholder="Select warehouse"
                                SearchPlaceholder="Search warehouses..."
                                EmptyMessage="No warehouses found."
                                ValueSelector="@GetWarehousePickerValue"
                                TextSelector="@GetWarehouseLabel"
                                SearchTextSelector="@GetWarehouseSearchText"
                                AdvancedSearchTitle="Find Warehouse"
                                AdvancedSearchDescription="Search warehouses in the active tenant." />
                <XfEntityPicker TItem="InventoryLocation"
                                @bind-Value="_movementForm.LocationId"
                                Items="@LocationsForSelectedWarehouse().ToList()"
                                Label="Location"
                                Placeholder="Select location"
                                SearchPlaceholder="Search locations..."
                                EmptyMessage="No locations found."
                                ValueSelector="@GetLocationPickerValue"
                                TextSelector="@GetLocationLabel"
                                SearchTextSelector="@GetLocationSearchText"
                                AdvancedSearchTitle="Find Location"
                                AdvancedSearchDescription="Search locations for the selected warehouse." />
                <InventorySelect TValue="string" @bind-Value="_movementForm.MovementType" Label="Movement Type">
                    @foreach (var type in Enum.GetValues<InventoryMovementType>())
                    {
                        <BbSelectItem Value="@type.ToString()">@type</BbSelectItem>
                    }
                </InventorySelect>
            </div>
            <div class="grid gap-3 md:grid-cols-3">
                <BbFormFieldNumericInput TValue="decimal"
                                         @bind-Value="_movementForm.Quantity"
                                         Label="Quantity"
                                         DecimalPlaces="4"
                                         Step="1" />
                <BbFormFieldInput TValue="string" @bind-Value="_movementForm.UnitOfMeasure" Label="Unit" />
                <BbFormFieldInput TValue="string" @bind-Value="_movementForm.ReferenceType" Label="Reference Type" />
            </div>
            <p class="text-sm text-muted-foreground">Available in selected position: @SelectedAvailable.ToString("0.####"). Reservation/release changes reserved stock; other types change on-hand. A negative-stock override permits an available balance below zero for this posting only.</p>
            <BbFormFieldInput TValue="string" @bind-Value="_movementForm.Reason" Label="Reason" />
            @if (_negativeStockEnabled)
            {
                <BbFormFieldSwitch Checked="@_movementForm.AllowNegativeStock"
                                   CheckedChanged="@((bool value) => _movementForm.AllowNegativeStock = value)"
                                   Label="Allow negative stock for this posting" />
            }
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _movementDialogOpen = false)">Cancel</BbButton>
            <BbButton OnClick="@PostMovement" Disabled="@IsPostMovementDisabled">
                Post Movement
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Inject] private Microsoft.JSInterop.IJSRuntime FocusJs { get; set; } = default!;
    private bool _wasDialogOpen;
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private IInventarioServiceWrapper Inventario { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private IPortalModuleAvailability ModuleNavigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    private MovementForm _movementForm = new();
    private List<Product> _products = [];
    private List<ProductVariation> _variants = [];
    private string _search = "";
    private string _warehouseFilter = "all";
    private string _stockView = "balances";
    [SupplyParameterFromQuery] public Guid? ProductId { get; set; }
    private string ProductQuery => ProductId is { } productId ? $"?productId={productId}" : "";
    private int FilteredBalanceCount => _balances.Count(x => Matches(x.ProductId, x.ProductVariationId, x.LotId, x.WarehouseId));
    private int FilteredMovementCount => _movements.Count(x => Matches(x.ProductId, x.ProductVariationId, x.LotId, x.WarehouseId));
    private void ClearFilters()
    {
        _search = "";
        _warehouseFilter = "all";
        if (ProductId is not null) Navigation.NavigateTo("/inventario/stock");
    }
    private bool Matches(Guid product, Guid? variant, Guid? lot, Guid? warehouse) =>
        (ProductId is null || product == ProductId) && (_warehouseFilter == "all" || warehouse.ToString() == _warehouseFilter) &&
        $"{GetProductName(product)} {_products.FirstOrDefault(x => x.Id == product)?.SKU} {InventoryDisplay.Variant(_variants, variant)} {GetLotLabel(lot)}".Contains(_search, StringComparison.OrdinalIgnoreCase);
    private decimal SelectedAvailable => _balances.Where(x => x.ProductId.ToString() == _movementForm.ProductId && x.ProductVariationId == ParseVariant(_movementForm.ProductVariationId) && x.WarehouseId.ToString() == _movementForm.WarehouseId && x.LocationId.ToString() == _movementForm.LocationId && x.LotId == ParseVariant(_movementForm.LotId)).Sum(x => x.AvailableQuantity);
    private static Guid? ParseVariant(string value) => Guid.TryParse(value, out var id) ? id : null;
    private async Task OpenForBalance(StockBalance balance)
    {
        await FocusJs.InvokeVoidAsync("inventarioFocus.capture", "stock-movement");
        _movementForm = new();
        _movementForm.ProductId = balance.ProductId.ToString();
        _movementForm.ProductVariationId = balance.ProductVariationId?.ToString() ?? "base";
        _movementForm.WarehouseId = balance.WarehouseId.ToString();
        _movementForm.LocationId = balance.LocationId.ToString();
        _movementForm.LotId = balance.LotId?.ToString() ?? "";
        _movementForm.Quantity = 0;
        _movementForm.MovementType = InventoryMovementType.Adjustment.ToString();
        _movementForm.AllowNegativeStock = false;
        _movementForm.ReferenceType = "";
        _movementForm.Reason = "";
        _movementDialogOpen = true;
    }
    private List<Warehouse> _warehouses = [];
    private List<InventoryLocation> _locations = [];
    private List<InventoryLot> _lots = [];
    private List<StockBalance> _balances = [];
    private List<InventoryMovement> _movements = [];
    private bool _loading = true;
    private bool _hasTenant;
    private bool _stockEnabled;
    private bool _movementsEnabled;
    private bool _traceabilityEnabled;
    private bool _negativeStockEnabled;
    private bool _postingMovement;
    private bool _movementDialogOpen;
    private bool IsPostMovementDisabled => _postingMovement || string.IsNullOrEmpty(_movementForm.ProductId) || _movementForm.Quantity == 0 || _products.Count == 0 || _warehouses.Count == 0 || _locations.Count == 0;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_wasDialogOpen && !_movementDialogOpen) await FocusJs.InvokeVoidAsync("inventarioFocus.restore", "stock-movement");
        _wasDialogOpen = _movementDialogOpen;
    }

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        ModuleNavigation.OnChanged += OnTenantChanged;
    }

    protected override async Task OnInitializedAsync() => await Reload();

    private void OnTenantChanged() => _ = InvokeAsync(Reload);

    private async Task Reload()
    {
        _loading = true;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _stockEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "stock_balances");
            _movementsEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "movements");
            _traceabilityEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "traceability");
            _negativeStockEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "negative_stock");
            if (!_negativeStockEnabled)
                _movementForm.AllowNegativeStock = false;
            _products = [];
            _warehouses = [];
            _locations = [];
            _lots = [];
            _balances = [];
            _movements = [];

            if (!_hasTenant || (!_stockEnabled && !_movementsEnabled)) return;

            var tenantId = TenantFilter.SelectedTenantId!.Value;
            _variants = await DataContext.Query<ProductVariation>().NoCache().Where(x => x.TenantId == tenantId && !x.IsDeleted).Take(1000).ToListAsync();
            if (!_stockEnabled) _stockView = "movements";
            _products = await DataContext.Query<Product>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                .OrderBy(x => x.Name)
                .Take(250)
                .ToListAsync();

            _warehouses = await DataContext.Query<Warehouse>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                .OrderBy(x => x.Code)
                .Take(200)
                .ToListAsync();

            _locations = await DataContext.Query<InventoryLocation>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                .OrderBy(x => x.Code)
                .Take(500)
                .ToListAsync();

            if (_traceabilityEnabled)
                _lots = await DataContext.Query<InventoryLot>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                    .OrderBy(x => x.LotNumber)
                    .Take(500)
                    .ToListAsync();

            if (_stockEnabled)
                _balances = await DataContext.Query<StockBalance>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                    .OrderBy(x => x.ProductId)
                    .Take(500)
                    .ToListAsync();

            if (_movementsEnabled)
                _movements = await DataContext.Query<InventoryMovement>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                    .OrderByDescending(x => x.CreatedAt)
                    .Take(500)
                    .ToListAsync();

            ApplyDefaultMovementSelections();
        }
        catch
        {
            ToastService.Show("Could not load stock control.");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task PostMovement()
    {
        if (!Guid.TryParse(_movementForm.ProductId, out var productId) ||
            !Guid.TryParse(_movementForm.WarehouseId, out var warehouseId) ||
            !Guid.TryParse(_movementForm.LocationId, out var locationId))
        {
            ToastService.Show("Select product, warehouse, and location.");
            return;
        }

        if (_movementForm.Quantity == 0)
        {
            ToastService.Show("Quantity must not be zero.");
            return;
        }

        _postingMovement = true;
        try
        {
            var result = await Inventario.PostStockMovement(new PostStockMovementRequest
            {
                Metadata = BuildMetadata(),
                ProductId = productId,
                ProductVariationId = ParseVariant(_movementForm.ProductVariationId),
                WarehouseId = warehouseId,
                LocationId = locationId,
                LotId = Guid.TryParse(_movementForm.LotId, out var lotId) ? lotId : null,
                MovementType = Enum.TryParse<InventoryMovementType>(_movementForm.MovementType, out var type) ? type : InventoryMovementType.Adjustment,
                Quantity = _movementForm.Quantity,
                UnitOfMeasure = NullIfEmpty(_movementForm.UnitOfMeasure),
                ReferenceType = NullIfEmpty(_movementForm.ReferenceType),
                Reason = NullIfEmpty(_movementForm.Reason),
                AllowNegativeStock = _negativeStockEnabled && _movementForm.AllowNegativeStock
            });

            ToastService.Show(result.IsSuccess ? "Stock movement posted." : "Could not post stock movement.");
            if (result.IsSuccess)
            {
                _movementForm.Quantity = 0m;
                _movementForm.Reason = "";
                _movementDialogOpen = false;
                await Reload();
            }
        }
        finally
        {
            _postingMovement = false;
        }
    }

    private async Task OpenMovementDialog()
    {
        await FocusJs.InvokeVoidAsync("inventarioFocus.capture", "stock-movement");
        _movementForm = new();
        ApplyDefaultMovementSelections();
        _movementDialogOpen = true;
    }

    private IEnumerable<InventoryLocation> LocationsForSelectedWarehouse()
    {
        if (!Guid.TryParse(_movementForm.WarehouseId, out var warehouseId))
            return _locations;

        return _locations.Where(x => x.WarehouseId == warehouseId);
    }

    private void OnMovementWarehouseChanged(string? value)
    {
        _movementForm.WarehouseId = value ?? "";
        var location = LocationsForSelectedWarehouse().FirstOrDefault();
        _movementForm.LocationId = location?.Id.ToString() ?? "";
    }

    private void OnMovementProductChanged(string? value)
    {
        _movementForm.ProductId = value ?? "";
        _movementForm.ProductVariationId = "base";
        _movementForm.LotId = "";
    }

    private void ApplyDefaultMovementSelections()
    {

        _movementForm.WarehouseId = _movementForm.WarehouseId.Length > 0 ? _movementForm.WarehouseId : _warehouses.FirstOrDefault()?.Id.ToString() ?? "";
        var location = LocationsForSelectedWarehouse().FirstOrDefault() ?? _locations.FirstOrDefault();
        _movementForm.LocationId = _movementForm.LocationId.Length > 0 ? _movementForm.LocationId : location?.Id.ToString() ?? "";
    }

    private IEnumerable<InventoryLot> LotsForSelectedProduct()
    {
        if (!Guid.TryParse(_movementForm.ProductId, out var productId))
            return [];

        return _lots.Where(x => x.ProductId == productId && x.ProductVariationId == ParseVariant(_movementForm.ProductVariationId));
    }

    private RequestMetadata BuildMetadata() => new()
    {
        RequestedTenantId = TenantFilter.SelectedTenantId,
        RequestId = Guid.NewGuid(),
        OperationName = "Portal"
    };

    private string GetProductLabel(Product product) =>
        string.IsNullOrWhiteSpace(product.SKU) ? product.Name ?? product.Id.ToString()[..8] : $"{product.Name} ({product.SKU})";

    private static string GetProductPickerValue(Product product) => product.Id.ToString();

    private static string GetProductSearchText(Product product) =>
        $"{product.Name} {product.SKU} {product.Brand} {product.Description}";

    private string GetProductName(Guid productId) =>
        _products.FirstOrDefault(x => x.Id == productId)?.Name ?? productId.ToString()[..8];

    private static string GetWarehouseLabel(Warehouse warehouse) => $"{warehouse.Code} - {warehouse.Name}";

    private static string GetWarehousePickerValue(Warehouse warehouse) => warehouse.Id.ToString();

    private static string GetWarehouseSearchText(Warehouse warehouse) =>
        $"{warehouse.Code} {warehouse.Name} {warehouse.City} {warehouse.Region} {warehouse.CountryCode}";

    private string GetWarehouseName(Guid warehouseId) =>
        _warehouses.FirstOrDefault(x => x.Id == warehouseId)?.Name ?? warehouseId.ToString()[..8];

    private string GetLocationName(Guid locationId) =>
        _locations.FirstOrDefault(x => x.Id == locationId)?.Name ?? locationId.ToString()[..8];

    private static string GetLocationLabel(InventoryLocation location) => $"{location.Code} - {location.Name}";

    private static string GetLocationPickerValue(InventoryLocation location) => location.Id.ToString();

    private string GetLocationSearchText(InventoryLocation location) =>
        $"{location.Code} {location.Name} {GetWarehouseName(location.WarehouseId)} {location.LocationType} {location.Description}";

    private string GetLotLabel(Guid? lotId) =>
        lotId is { } id
            ? _lots.FirstOrDefault(x => x.Id == id)?.LotNumber ?? id.ToString()[..8]
            : "No lot";

    private string GetLotLabel(InventoryLot lot) =>
        string.IsNullOrWhiteSpace(lot.LotNumber) ? lot.Id.ToString()[..8] : lot.LotNumber;

    private static string GetLotPickerValue(InventoryLot lot) => lot.Id.ToString();

    private string GetLotSearchText(InventoryLot lot) =>
        $"{lot.LotNumber} {lot.Status} {GetProductName(lot.ProductId)} {lot.SupplierReference} {lot.SourceReferenceType}";

    private static string? NullIfEmpty(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantChanged;
        ModuleNavigation.OnChanged -= OnTenantChanged;
    }

    private sealed class MovementForm
    {
        public string ProductId { get; set; } = "";
        public string ProductVariationId { get; set; } = "base";
        public string WarehouseId { get; set; } = "";
        public string LocationId { get; set; } = "";
        public string LotId { get; set; } = "";
        public string MovementType { get; set; } = InventoryMovementType.Adjustment.ToString();
        public decimal Quantity { get; set; }
        public string UnitOfMeasure { get; set; } = "each";
        public string ReferenceType { get; set; } = "";
        public string Reason { get; set; } = "";
        public bool AllowNegativeStock { get; set; }
    }
}
