@page "/inventario/stock"
@inject NavigationManager Navigation

<CenteredSpinner />

@code {
    [SupplyParameterFromQuery] public Guid? ProductId { get; set; }

    protected override void OnParametersSet() => Navigation.NavigateTo(
        ProductId is { } id ? $"/inventario/products/{id}/stock" : "/inventario/products", replace: true);
}
