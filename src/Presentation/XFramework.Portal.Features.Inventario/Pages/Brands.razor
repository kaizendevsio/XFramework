@page "/inventario/brands"
@using XFramework.Inventario.Domain.Shared.Contracts.Requests.Brands
@using XFramework.Inventario.Domain.Shared.Contracts.Requests.Setup
@using XFramework.Inventario.Domain.Shared.Contracts.Responses
@using XFramework.Inventario.Domain.Shared.Contracts.Responses.Brands
@using XFramework.Portal.Features.Inventario.Components
@implements IDisposable

<PageTitle>Inventario Brands - Portal</PageTitle>
@if (_loading)
{
    <CenteredSpinner />
}
else if (TenantContext.SelectedTenantId is null)
{
    <ModuleUnavailable ModuleName="Inventario" RequiresTenant="true" />
}
else if (!_catalogEnabled)
{
    <ModuleUnavailable ModuleName="Inventario Catalog" />
}
else
{
    <div class="inv-page brands-page space-y-6">
        <div class="xf-page-header">
            <div><BbTypographyH3>Brands</BbTypographyH3><BbTypographyMuted>@TenantContext.SelectedTenantName</BbTypographyMuted></div>
            <div class="xf-page-actions">
                <BbButton Variant="ButtonVariant.Outline" OnClick="Reload"><LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />Reload</BbButton>
                @if (CanManage)
                {
                    <BbButton Variant="ButtonVariant.Outline" Disabled="@(SelectedCategory is null || _brandsLoading)" OnClick="@(() => OpenMerge())">
                        <LucideIcon Name="merge" class="mr-2 h-4 w-4" />Merge brands
                    </BbButton>
                }
            </div>
        </div>
        @if (_error is not null)
        {
            <BbAlert Variant="AlertVariant.Danger" role="alert"><BbAlertDescription>@_error</BbAlertDescription></BbAlert>
        }
        else if (_preferences is not null)
        {
            <div class="brands-fields">
                <XfEntityPicker TItem="ProductCategory" Label="Category" Value="@_categoryId" ValueChanged="SelectCategory"
                                Items="@_categories" ValueSelector="@(x => x.Id.ToString())" TextSelector="@(x => x.Name ?? "Unnamed category")"
                                SearchTextSelector="@(x => $"{x.Name} {x.Description}")" AdvancedColumns="@CategoryColumns"
                                AdvancedSearchTitle="Find category" AdvancedSearchScope="Categories in the selected tenant"
                                Placeholder="Select category" SearchPlaceholder="Search categories..." ShowCreate="false" />
                <BbFormFieldInput TValue="string" Label="Search brands" Value="@_search" ValueChanged="SearchBrands"
                                  UpdateTiming="UpdateTiming.Debounced" DebounceInterval="300"
                                  Placeholder="Search all brands in category..." MaxLength="100" Disabled="@(SelectedCategory is null)" />
            </div>
            @if (_brandsError is not null)
            {
                <BbAlert Variant="AlertVariant.Danger" role="alert">
                    <BbAlertDescription>@_brandsError</BbAlertDescription>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="LoadBrands"><LucideIcon Name="refresh-cw" />Retry brands</BbButton>
                </BbAlert>
            }
            else
            {
                @if (_brands.Count == BrandLimit)
                {
                    <BbAlert><BbAlertDescription>Showing the first 50 matching brands. Refine the search to find other brands.</BbAlertDescription></BbAlert>
                }
                <BbDataGrid @key="(_categoryId, _brandVersion)" TItem="BrandRow" Items="@_brands" IsLoading="@_brandsLoading"
                            ShowPagination="true" InitialPageSize="10" aria-label="Brands">
                    <Columns>
                        <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Brand" Sortable="true" Filterable="true" />
                        @if (CanManage)
                        {
                            <BbDataGridTemplateColumn Title="Actions" Width="140px">
                                <ChildContent Context="brand">
                                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => OpenMerge(brand.Name))"
                                              AriaLabel="@($"Merge {brand.Name}")"><LucideIcon Name="merge" />Merge</BbButton>
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                        }
                    </Columns>
                    <EmptyTemplate>
                        <BbEmpty><BbEmptyTitle>@(SelectedCategory is null ? "No categories available" : "No matching brands")</BbEmptyTitle></BbEmpty>
                    </EmptyTemplate>
                </BbDataGrid>
            }
            @if (!CanManage)
            {
                <BbAlert><BbAlertDescription>Tenant management permission is required to merge brands.</BbAlertDescription></BbAlert>
            }
        }
    </div>
}

<BbDialog @bind-Open="_mergeOpen">
    <BbDialogContent TrapFocus="false">
        <BbDialogHeader>
            <BbDialogTitle>Merge brands</BbDialogTitle>
            <BbDialogDescription>@_mergeCategoryName</BbDialogDescription>
        </BbDialogHeader>
        @if (_mergeOpen && CanManage && _mergeCategoryId is not null)
        {
            <ProductBrandMerge @key="(_revision, _mergeCategoryId, _mergeSource)" CategoryId="@_mergeCategoryId" SourceBrand="@_mergeSource" CanManage="@CanManage" Merged="OnMerged" />
        }
    </BbDialogContent>
</BbDialog>

@code {
    [Inject] private IInventarioServiceWrapper Inventario { get; set; } = default!;
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantContext { get; set; } = default!;
    [Inject] private IPortalModuleAvailability Availability { get; set; } = default!;
    [Inject] private ILogger<Brands> Logger { get; set; } = default!;
    private InventarioSetupResponse? _preferences;
    private List<ProductCategory> _categories = [];
    private string? _categoryId, _error, _mergeCategoryName, _mergeSource, _brandsError;
    private string _search = "";
    private const int BrandLimit = 50;
    private List<BrandRow> _brands = [];
    private Guid? _mergeCategoryId;
    private bool _loading = true, _catalogEnabled, _mergeOpen, _disposed, _brandsLoading;
    private int _revision, _brandVersion, _brandRevision;
    private sealed record BrandRow(string Name);
    private bool CanManage => _preferences?.CanManage == true && _preferences.TenantId == TenantContext.SelectedTenantId;
    private ProductCategory? SelectedCategory => _categories.FirstOrDefault(x => x.Id.ToString() == _categoryId);
    private static readonly IReadOnlyList<XfEntityPickerColumn<ProductCategory>> CategoryColumns =
        [new("Name", x => x.Name), new("Description", x => x.Description)];

    protected override void OnInitialized()
    {
        TenantContext.OnChanged += Changed;
        Availability.OnChanged += Changed;
    }
    protected override Task OnInitializedAsync() => Reload();

    private void Changed()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            var pending = Reload();
            StateHasChanged();
            await pending;
            if (!_disposed) StateHasChanged();
        });
    }

    private async Task Reload()
    {
        var revision = ++_revision;
        var tenant = TenantContext.SelectedTenantId;
        var categoryId = _categoryId;
        ++_brandRevision;
        _loading = true;
        _mergeOpen = false;
        _mergeCategoryId = null;
        _preferences = null;
        _categories = [];
        _categoryId = _error = _brandsError = null;
        _brands = [];
        _search = "";
        ++_brandVersion;
        try
        {
            await Availability.EnsureLoadedAsync();
            if (!Current(revision, tenant)) return;
            _catalogEnabled = Availability.ActiveTenantId == tenant &&
                Availability.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, TenantModuleFeatureKeys.CatalogSubFeature);
            if (tenant is not Guid tenantId || !_catalogEnabled) return;
            var result = await Inventario.GetInventarioSetup(new GetInventarioSetupRequest { Metadata = new() { RequestedTenantId = tenantId } });
            if (!Current(revision, tenant)) return;
            if (!result.IsSuccess || result.Response?.TenantId != tenantId)
            {
                _error = "Brand permissions could not be loaded.";
                return;
            }
            var categories = await DataContext.Query<ProductCategory>()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted).NoCache()
                .OrderBy(x => x.Name).Take(1000).ToListAsync();
            if (!Current(revision, tenant)) return;
            _preferences = result.Response;
            _categories = categories;
            _categoryId = (_categories.FirstOrDefault(x => x.Id.ToString() == categoryId) ?? _categories.FirstOrDefault())?.Id.ToString();
            await LoadBrands();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Brand management prerequisites could not be loaded.");
            if (Current(revision, tenant)) _error = "Brands could not be loaded. Reload to try again.";
        }
        finally { if (Current(revision, tenant)) _loading = false; }
    }

    private async Task SelectCategory(string? value)
    {
        _categoryId = value;
        _search = "";
        _mergeOpen = false;
        ++_brandVersion;
        await LoadBrands();
    }
    private async Task SearchBrands(string value)
    {
        _search = value;
        ++_brandVersion;
        await LoadBrands();
    }
    private async Task LoadBrands()
    {
        var revision = ++_brandRevision;
        var tenant = TenantContext.SelectedTenantId;
        var category = SelectedCategory?.Id;
        _brands = [];
        _brandsError = null;
        _brandsLoading = true;
        try
        {
            if (tenant is null || category is null || !_catalogEnabled || _preferences?.TenantId != tenant) return;
            var result = await Inventario.SearchProductBrands(new SearchProductBrandsRequest
            {
                Metadata = new() { RequestedTenantId = tenant }, CategoryId = category.Value, Search = _search, Limit = BrandLimit
            });
            if (!BrandsCurrent(revision, tenant, category)) return;
            if (!result.IsSuccess || result.Response is null)
            {
                _brandsError = "Brands could not be loaded. Try again.";
                return;
            }
            _brands = result.Response.Select(name => new BrandRow(name)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Category brands could not be loaded.");
            if (BrandsCurrent(revision, tenant, category)) _brandsError = "Brands could not be loaded. Try again.";
        }
        finally { if (BrandsCurrent(revision, tenant, category)) _brandsLoading = false; }
    }
    private bool BrandsCurrent(int revision, Guid? tenant, Guid? category) =>
        !_disposed && revision == _brandRevision && tenant == TenantContext.SelectedTenantId && category == SelectedCategory?.Id;

    private void OpenMerge(string? source = null)
    {
        if (!CanManage || SelectedCategory is not { } category) return;
        _mergeCategoryId = category.Id;
        _mergeCategoryName = category.Name;
        _mergeSource = source;
        _mergeOpen = true;
    }
    private async Task OnMerged(ProductBrandMergePreview result)
    {
        if (!CanManage || result.CategoryId != SelectedCategory?.Id) return;
        _mergeOpen = false;
        _search = "";
        ++_brandVersion;
        await LoadBrands();
    }
    private bool Current(int revision, Guid? tenant) =>
        !_disposed && revision == _revision && TenantContext.SelectedTenantId == tenant;
    public void Dispose()
    {
        _disposed = true;
        ++_revision;
        TenantContext.OnChanged -= Changed;
        Availability.OnChanged -= Changed;
    }
}

