@implements IDisposable

<div class="setup-wizard" data-testid="inventario-setup-wizard">
    @if (_error is not null)
    { <BbAlert Variant="AlertVariant.Danger" role="alert"><BbAlertDescription>@_error</BbAlertDescription></BbAlert> }
    <fieldset disabled="@_saving">
        <BbFormWizard @key="ExplicitStorage" @bind-CurrentStep="_currentStep" OnComplete="ConfirmAsync" CompleteLabel="Confirm setup">
            <ChildContent>
                <BbWizardStep Title="Organization" Validator="ValidateMode">
                    <div class="setup-intro"><LucideIcon Name="boxes" /><BbTypographyH4>Stock organization</BbTypographyH4></div>
                    <InventorySelect TValue="string" Value="@_mode" ValueChanged="SelectMode" Label="Stock organization" DisplayTextSelector="@(value => value == "advanced" ? "Multiple locations (Advanced)" : "One stock area (Basic)")">
                        <BbSelectItem Value="@("basic")">One stock area (Basic)</BbSelectItem>
                        <BbSelectItem Value="@("advanced")">Multiple locations (Advanced)</BbSelectItem>
                    </InventorySelect>
                    @if (!State.WarehousingEnabled)
                    { <BbAlert><BbAlertTitle>Catalog only</BbAlertTitle><BbAlertDescription>Warehousing is disabled. No stock areas will be created or features enabled.</BbAlertDescription></BbAlert> }
                    else if (!Advanced)
                    { <BbFormFieldInput TValue="string" @bind-Value="_stockAreaName" UpdateTiming="UpdateTiming.Immediate" Label="Stock area name (optional)" Placeholder="My stock, home or store" /> }
                    @if (State.HasExistingConfiguration)
                    { <BbTypographyMuted>Existing stock areas and stock will be kept.</BbTypographyMuted> }
                </BbWizardStep>
                @if (ExplicitStorage)
                {
                <BbWizardStep Title="Warehouse" Validator="ValidateWarehouse">
                    @if (!State.WarehousingEnabled)
                    { <BbAlert><BbAlertDescription>Warehousing is disabled. No warehouse or location will be created.</BbAlertDescription></BbAlert> }
                    else
                    {
                        @if (Advanced)
                        {
                            <label class="setup-label" for="setup-warehouse">Warehouse</label>
                            <BbCombobox Id="setup-warehouse" AriaLabel="Warehouse" TValue="string" Value="@_warehouseId" ValueChanged="SelectWarehouse" Options="@WarehouseOptions" Placeholder="New warehouse" />
                        }
                        @if (_warehouseId == "")
                        {
                            <div class="setup-fields">
                                <BbFormFieldInput TValue="string" @bind-Value="_warehouseCode" UpdateTiming="UpdateTiming.Immediate" Label="Warehouse code" Required="true" />
                                <BbFormFieldInput TValue="string" @bind-Value="_warehouseName" UpdateTiming="UpdateTiming.Immediate" Label="Warehouse name" Required="true" />
                                @if (Advanced)
                                {
                                    <BbFormFieldInput TValue="string" @bind-Value="_warehouseDescription" UpdateTiming="UpdateTiming.Immediate" Label="Warehouse description" />
                                    <BbFormFieldInput TValue="string" @bind-Value="_address" UpdateTiming="UpdateTiming.Immediate" Label="Address" />
                                    <BbFormFieldInput TValue="string" @bind-Value="_city" UpdateTiming="UpdateTiming.Immediate" Label="City" />
                                    <BbFormFieldInput TValue="string" @bind-Value="_region" UpdateTiming="UpdateTiming.Immediate" Label="Region" />
                                    <BbFormFieldInput TValue="string" @bind-Value="_postalCode" UpdateTiming="UpdateTiming.Immediate" Label="Postal code" />
                                    <BbFormFieldInput TValue="string" @bind-Value="_countryCode" UpdateTiming="UpdateTiming.Immediate" Label="Country code" />
                                    <BbFormFieldSwitch @bind-Checked="_isDefault" Label="Default warehouse (only when none exists)" />
                                }
                            </div>
                        }
                    }
                </BbWizardStep>
                <BbWizardStep Title="Location" Validator="ValidateLocation">
                    @if (!State.WarehousingEnabled)
                    { <p>No storage locations will be changed.</p> }
                    else
                    {
                        @if (Advanced && _warehouseId != "")
                        {
                            <label class="setup-label" for="setup-location">Location</label>
                            <BbCombobox Id="setup-location" AriaLabel="Location" TValue="string" @bind-Value="_locationId" Options="@LocationOptions" Placeholder="New location" />
                        }
                        @if (_locationId == "")
                        {
                            <div class="setup-fields">
                                <BbFormFieldInput TValue="string" @bind-Value="_locationCode" UpdateTiming="UpdateTiming.Immediate" Label="Location code" Required="true" />
                                <BbFormFieldInput TValue="string" @bind-Value="_locationName" UpdateTiming="UpdateTiming.Immediate" Label="Location name" Required="true" />
                                @if (Advanced)
                                {
                                    <BbFormFieldInput TValue="string" @bind-Value="_locationDescription" UpdateTiming="UpdateTiming.Immediate" Label="Location description" />
                                    <InventorySelect TValue="string" @bind-Value="_locationType" Label="Location type">
                                        @foreach (var type in Enum.GetValues<InventoryLocationType>())
                                        { <BbSelectItem Value="@type.ToString()">@type</BbSelectItem> }
                                    </InventorySelect>
                                    @if (_warehouseId != "")
                                    {
                                        <label class="setup-label" for="setup-parent-location">Parent location</label>
                                        <BbCombobox Id="setup-parent-location" AriaLabel="Parent location" TValue="string" @bind-Value="_parentLocationId" Options="@ParentOptions" Placeholder="No parent location" />
                                    }
                                    <BbFormFieldSwitch @bind-Checked="_pickable" Label="Pickable location" />
                                }
                            </div>
                        }
                    }
                </BbWizardStep>
                }
                <BbWizardStep Title="Defaults" Validator="ValidateDefaults">
                    <InventarioPreferencesFields SupportedCurrencies="State.SupportedCurrencies" @bind-Currency="_currency" @bind-Threshold="_threshold" @bind-DefaultProductAvailable="_defaultProductAvailable" />
                </BbWizardStep>
                <BbWizardStep Title="Review" Validator="ValidateAll">
                    <dl class="setup-review" data-testid="inventario-setup-review">
                        <dt>Tenant</dt><dd>@TenantName</dd>
                        <dt>Mode</dt><dd>@(Advanced ? "Advanced" : "Basic")</dd>
                        @if (ExplicitStorage)
                        { <dt>Warehouse</dt><dd>@WarehouseSummary</dd><dt>Location</dt><dd>@LocationSummary</dd> }
                        else
                        { <dt>Stock area</dt><dd>@(State.WarehousingEnabled ? StockAreaName : "Catalog only")</dd> }
                        <dt>Low stock threshold</dt><dd>@_threshold</dd>
                        <dt>Default currency</dt><dd>@_currency.Trim().ToUpperInvariant()</dd>
                        <dt>New products</dt><dd>@(_defaultProductAvailable ? "Catalog enabled" : "Catalog disabled")</dd>
                    </dl>
                    @if (Advanced) { <InventarioConfigurationLinks /> }
                </BbWizardStep>
            </ChildContent>
            <NavigationTemplate>
                <div class="setup-actions" data-testid="inventario-setup-footer">
                    <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync" Disabled="@_saving">Cancel</BbButton>
                    <div class="setup-navigation">
                        <BbButton Variant="ButtonVariant.Outline" OnClick="Back" Disabled="@(_saving || _currentStep == 0)"><LucideIcon Name="arrow-left" class="h-4 w-4" />Back</BbButton>
                        @if (_currentStep == ReviewStep)
                        { <BbButton OnClick="ConfirmAsync" Disabled="@(_saving || !State.SupportedCurrencies.Contains(_currency))"><LucideIcon Name="check" class="h-4 w-4" />Confirm setup</BbButton> }
                        else
                        { <BbButton OnClick="Next" Disabled="@_saving">Next<LucideIcon Name="arrow-right" class="h-4 w-4" /></BbButton> }
                    </div>
                </div>
            </NavigationTemplate>
        </BbFormWizard>
    </fieldset>
    @if (_saving) { <BbTypographyMuted>Saving setup...</BbTypographyMuted> }
</div>
