@inherits LayoutComponentBase

<BbSidebarProvider>
    <BbSidebar>
        <BbSidebarHeader>
            <div class="flex items-center gap-2 px-2 h-10">
                <div class="flex h-7 w-7 items-center justify-center rounded-md bg-primary text-primary-foreground">
                    <LucideIcon Name="shield" class="h-4 w-4" />
                </div>
                <span class="text-sm font-semibold">Control Panel</span>
            </div>
        </BbSidebarHeader>
        <BbSidebarContent>
            <NavMenu />
        </BbSidebarContent>
        <BbSidebarFooter>
            <div class="flex items-center gap-2 px-2 py-2">
                <span class="text-xs text-muted-foreground">XFramework Admin</span>
            </div>
        </BbSidebarFooter>
    </BbSidebar>
    <BbSidebarInset>
        <header class="flex items-center gap-2 px-4 py-3 border-b">
            <BbSidebarTrigger />
            <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="h-4" />
            <BbBreadcrumb>
                <BbBreadcrumbList>
                    <BbBreadcrumbItem>
                        <BbBreadcrumbLink Href="/">Dashboard</BbBreadcrumbLink>
                    </BbBreadcrumbItem>
                </BbBreadcrumbList>
            </BbBreadcrumb>
        </header>
        <div class="flex-1 p-4">
            @Body
        </div>
    </BbSidebarInset>
</BbSidebarProvider>

<BbToastProvider Position="ToastPosition.BottomRight" />
<BbDialogProvider />
<BbPortalHost />
