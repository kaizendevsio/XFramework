@* Storage *@
<div class="mt-4">
    <p class="px-3 mb-1 text-xs font-medium text-muted-foreground uppercase tracking-wider">Storage</p>
    <div class="space-y-0.5">
        <NavLink href="/storage/files" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="file" class="h-4 w-4" /> Files
        </NavLink>
    </div>
</div>
