@* Dashboard *@
<div class="space-y-1">
    <NavLink href="/" Match="NavLinkMatch.All"
             class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"
             ActiveClass="bg-sidebar-accent text-sidebar-accent-foreground">
        <LucideIcon Name="layout-dashboard" class="h-4 w-4" />
        Dashboard
    </NavLink>
</div>

@* Identity *@
<div class="mt-4">
    <p class="px-3 mb-1 text-[10px] font-medium text-muted-foreground uppercase tracking-wider">Identity</p>
    <div class="space-y-0.5">
        <NavLink href="/identity/users" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-sidebar-accent" ActiveClass="bg-sidebar-accent text-sidebar-accent-foreground">
            <LucideIcon Name="users" class="h-4 w-4" /> Users
        </NavLink>
        <NavLink href="/identity/sessions" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-sidebar-accent" ActiveClass="bg-sidebar-accent text-sidebar-accent-foreground">
            <LucideIcon Name="monitor" class="h-4 w-4" /> Sessions
        </NavLink>
        <NavLink href="/identity/auth-logs" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-sidebar-accent" ActiveClass="bg-sidebar-accent text-sidebar-accent-foreground">
            <LucideIcon Name="scroll-text" class="h-4 w-4" /> Auth Logs
        </NavLink>
    </div>
</div>

@* Finance *@
<div class="mt-4">
    <p class="px-3 mb-1 text-[10px] font-medium text-muted-foreground uppercase tracking-wider">Finance</p>
    <div class="space-y-0.5">
        <NavLink href="/finance/wallets" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-sidebar-accent" ActiveClass="bg-sidebar-accent text-sidebar-accent-foreground">
            <LucideIcon Name="wallet" class="h-4 w-4" /> Wallets
        </NavLink>
    </div>
</div>

@* System *@
<div class="mt-4">
    <p class="px-3 mb-1 text-[10px] font-medium text-muted-foreground uppercase tracking-wider">System</p>
    <div class="space-y-0.5">
        <NavLink href="/admin/reference-data" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-sidebar-accent" ActiveClass="bg-sidebar-accent text-sidebar-accent-foreground">
            <LucideIcon Name="database" class="h-4 w-4" /> Reference Data
        </NavLink>
    </div>
</div>
