        <NavLink href="/lookups/exchange-rates" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="arrow-right-left" class="h-4 w-4" /> Exchange Rates
        </NavLink>
        <NavLink href="/lookups/configurations" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="settings" class="h-4 w-4" /> Configurations
        </NavLink>
        <NavLink href="/lookups/configuration-groups" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
