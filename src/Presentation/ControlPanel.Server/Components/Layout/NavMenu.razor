        </NavLink>
        <NavLink href="/lookups/wallet-types" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="tag" class="h-4 w-4" /> Wallet Types
        </NavLink>
        <NavLink href="/lookups/currency-types" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
