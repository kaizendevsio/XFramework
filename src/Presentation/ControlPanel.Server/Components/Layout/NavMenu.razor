@* Dashboard *@
<div class="space-y-1">
    <NavLink href="/" Match="NavLinkMatch.All"
             class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
             ActiveClass="bg-accent text-accent-foreground">
        <LucideIcon Name="layout-dashboard" class="h-4 w-4" />
        Dashboard
    </NavLink>
</div>

@* Identity *@
<div class="mt-4">
    <p class="px-3 mb-1 text-xs font-medium text-muted-foreground uppercase tracking-wider">Identity</p>
    <div class="space-y-0.5">
        <NavLink href="/identity/users" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="users" class="h-4 w-4" /> Users
        </NavLink>
        <NavLink href="/identity/credentials" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="key-round" class="h-4 w-4" /> Credentials
        </NavLink>
        <NavLink href="/identity/roles" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="shield" class="h-4 w-4" /> Roles
        </NavLink>
        <NavLink href="/identity/sessions" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="monitor" class="h-4 w-4" /> Sessions
        </NavLink>
        <NavLink href="/identity/auth-logs" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="scroll-text" class="h-4 w-4" /> Auth Logs
        </NavLink>
        <NavLink href="/identity/verifications" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="shield-check" class="h-4 w-4" /> Verifications
        </NavLink>
        <NavLink href="/identity/contacts" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="contact" class="h-4 w-4" /> Contacts
        </NavLink>
        <NavLink href="/identity/addresses" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="map-pin" class="h-4 w-4" /> Addresses
        </NavLink>
        <NavLink href="/identity/tenants" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="building-2" class="h-4 w-4" /> Tenants
        </NavLink>
    </div>
</div>

@* Finance *@
<div class="mt-4">
    <p class="px-3 mb-1 text-xs font-medium text-muted-foreground uppercase tracking-wider">Finance</p>
    <div class="space-y-0.5">
        <NavLink href="/finance/wallets" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="wallet" class="h-4 w-4" /> Wallets
        </NavLink>
        <NavLink href="/finance/transactions" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="arrow-left-right" class="h-4 w-4" /> Transactions
        </NavLink>
        <NavLink href="/finance/transfers" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="send" class="h-4 w-4" /> Transfers
        </NavLink>
        <NavLink href="/finance/batch-operations" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="layers" class="h-4 w-4" /> Batch Operations
        </NavLink>
        <NavLink href="/finance/deposit-requests" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="arrow-down-to-line" class="h-4 w-4" /> Deposits
        </NavLink>
        <NavLink href="/finance/withdrawal-requests" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-accent" ActiveClass="bg-accent text-accent-foreground">
            <LucideIcon Name="arrow-up-from-line" class="h-4 w-4" /> Withdrawals
        </NavLink>
    </div>
</div>

