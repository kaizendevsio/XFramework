@implements IDisposable
@inject TenantModuleNavigationService ModuleNavigation

<SidebarNavItem Href="/" Label="Dashboard" Icon="layout-dashboard" Match="NavLinkMatch.All" Strong="true" />

<SidebarSection GroupId="identity" Title="Identity" Icon="users">
    <SidebarNavItem Href="/identity/users" Label="Users" Icon="users" />
    <SidebarNavItem Href="/identity/sessions" Label="Sessions" Icon="monitor" />
    <SidebarNavItem Href="/identity/auth-logs" Label="Auth Logs" Icon="scroll-text" />
</SidebarSection>

@if (ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario))
{
    <SidebarSection GroupId="inventario" Title="Inventario" Icon="package">
        <SidebarNavItem Href="/inventario/products" Label="Products" Icon="package" />
        <SidebarNavItem Href="/inventario/categories" Label="Categories" Icon="folders" />
        @if (ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "warehousing"))
        {
            <SidebarNavItem Href="/inventario/warehouses" Label="Warehouses" Icon="warehouse" />
        }
        @if (ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "traceability"))
        {
            <SidebarNavItem Href="/inventario/lots" Label="Lots" Icon="scan-barcode" />
        }
        @if (ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "stock_balances")
             || ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "movements"))
        {
            <SidebarNavItem Href="/inventario/stock" Label="Stock" Icon="boxes" />
        }
        @if (ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "reservations"))
        {
            <SidebarNavItem Href="/inventario/reservations" Label="Reservations" Icon="clipboard-check" />
        }
        @if (ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "planning"))
        {
            <SidebarNavItem Href="/inventario/planning" Label="Planning" Icon="chart-no-axes-combined" />
        }
        @if (ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "purchasing"))
        {
            <SidebarNavItem Href="/inventario/suppliers" Label="Suppliers" Icon="truck" />
            <SidebarNavItem Href="/inventario/purchase-orders" Label="Purchase Orders" Icon="clipboard-list" />
            <SidebarNavItem Href="/inventario/receiving" Label="Receiving" Icon="package-check" />
        }
        @if (ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "reporting"))
        {
            <SidebarNavItem Href="/inventario/reports" Label="Reports" Icon="file-chart-column" />
        }
        @if (ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Inventario, "transactions"))
        {
            <SidebarNavItem Href="/inventario/transactions" Label="Transactions" Icon="arrow-left-right" />
        }
        <SidebarNavItem Href="/inventario/settings" Label="Settings" Icon="settings" />
    </SidebarSection>
}

@if (ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Communications))
{
    <SidebarSection GroupId="communications" Title="Communications" Icon="messages-square">
        <SidebarNavItem Href="/communications/users" Label="Users" Icon="users" />
        <SidebarNavItem Href="/communications/threads" Label="Threads" Icon="messages-square" />
        <SidebarNavItem Href="/communications/operations" Label="Operations" Icon="radio-tower" />
        <SidebarNavItem Href="/communications/moderation" Label="Moderation" Icon="shield-alert" />
        <SidebarNavItem Href="/communications/settings" Label="Settings" Icon="settings" />
    </SidebarSection>
}

@if (ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Community))
{
    <SidebarSection GroupId="community" Title="Community" Icon="user-round">
        <SidebarNavItem Href="/community/identities" Label="Identities" Icon="user-round" />
        <SidebarNavItem Href="/community/content" Label="Content" Icon="newspaper" />
        <SidebarNavItem Href="/community/connections" Label="Connections" Icon="network" />
        <SidebarNavItem Href="/community/notifications" Label="Notifications" Icon="bell" />
        <SidebarNavItem Href="/community/settings" Label="Settings" Icon="settings" />
    </SidebarSection>
}

@if (ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Attendance))
{
    <SidebarSection GroupId="attendance" Title="Attendance" Icon="calendar-check">
        <SidebarNavItem Href="/attendance/contexts" Label="Contexts" Icon="layout-list" />
        <SidebarNavItem Href="/attendance/sessions" Label="Sessions" Icon="calendar-clock" />
        <SidebarNavItem Href="/attendance/reports" Label="Reports" Icon="file-chart-column" />
    </SidebarSection>
}

@if (ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Storage))
{
    <SidebarSection GroupId="storage" Title="Storage" Icon="hard-drive">
        <SidebarNavItem Href="/storage/files" Label="Files" Icon="hard-drive" />
    </SidebarSection>
}

@if (AnyWalletFinanceFeatureEnabled())
{
    <SidebarSection GroupId="finance" Title="Finance" Icon="wallet">
        @if (WalletFeatureEnabled(TenantModuleFeatureKeys.Wallets))
        {
            <SidebarNavItem Href="/finance/wallets" Label="Wallets" Icon="wallet" />
        }
        @if (WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsDeposits))
        {
            <SidebarNavItem Href="/finance/deposit-requests" Label="Deposits" Icon="arrow-down-to-line" />
        }
        @if (WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsWithdrawals))
        {
            <SidebarNavItem Href="/finance/withdrawal-requests" Label="Withdrawals" Icon="arrow-up-from-line" />
        }
        @if (WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsTransfers))
        {
            <SidebarNavItem Href="/finance/transfers" Label="Transfers" Icon="arrow-left-right" />
        }
        @if (WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsBatch))
        {
            <SidebarNavItem Href="/finance/batch" Label="Batch" Icon="layers" />
        }
        @if (WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsReporting))
        {
            <SidebarNavItem Href="/finance/wallet-operations" Label="Operations" Icon="receipt-text" />
            <SidebarNavItem Href="/finance/statements" Label="Statements" Icon="file-text" />
            <SidebarNavItem Href="/finance/wallet-audit" Label="Audit" Icon="list-checks" />
        }
        @if (WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsReconciliation))
        {
            <SidebarNavItem Href="/finance/reconciliation" Label="Reconciliation" Icon="scale" />
        }
        @if (WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsWebhooks))
        {
            <SidebarNavItem Href="/finance/outbox-webhooks" Label="Outbox" Icon="send" />
        }
        @if (WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsPolicy))
        {
            <SidebarNavItem Href="/finance/wallet-approvals" Label="Approvals" Icon="clipboard-check" />
            <SidebarNavItem Href="/finance/policy-decisions" Label="Policy" Icon="shield-check" />
            <SidebarNavItem Href="/finance/refunds-disputes" Label="Refunds" Icon="rotate-ccw" />
        }
    </SidebarSection>
}

<SidebarSection GroupId="system" Title="System" Icon="database">
    <SidebarNavItem Href="/admin/reference-data" Label="Reference Data" Icon="database" />
</SidebarSection>

@code {
    protected override async Task OnInitializedAsync()
    {
        ModuleNavigation.Initialize();
        ModuleNavigation.OnChanged += OnModuleNavigationChanged;
        await ModuleNavigation.EnsureLoadedAsync();
    }

    private void OnModuleNavigationChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private bool AnyWalletFinanceFeatureEnabled() =>
        WalletFeatureEnabled(TenantModuleFeatureKeys.Wallets)
        || WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsDeposits)
        || WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsWithdrawals)
        || WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsTransfers)
        || WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsBatch)
        || WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsReconciliation)
        || WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsPolicy)
        || WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsWebhooks)
        || WalletFeatureEnabled(TenantModuleFeatureKeys.WalletsReporting);

    private bool WalletFeatureEnabled(string featureKey) =>
        ModuleNavigation.IsFeatureEnabled(featureKey);

    public void Dispose()
    {
        ModuleNavigation.OnChanged -= OnModuleNavigationChanged;
    }
}
