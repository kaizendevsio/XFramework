@page "/"
@using XFramework.Domain.Shared.DataContext
@implements IDisposable

<PageTitle>Dashboard - Control Panel</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else
{
<div class="space-y-6">
    <div class="space-y-1">
        <h2 class="text-2xl font-bold tracking-tight">Dashboard</h2>
        <p class="text-sm text-muted-foreground">XFramework Control Panel — Identity Server &amp; Wallets Administration</p>
    </div>

    @if (_error is not null)
    {
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertTitle>Database Error</BbAlertTitle>
            <BbAlertDescription>@_error</BbAlertDescription>
        </BbAlert>
    }

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Users</BbCardTitle>
                <BbCardDescription>Total registered users</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <BbTypographyH2>@_userCount</BbTypographyH2>
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Active Sessions</BbCardTitle>
                <BbCardDescription>Currently active sessions</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <BbTypographyH2>@_sessionCount</BbTypographyH2>
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Wallets</BbCardTitle>
                <BbCardDescription>Total wallets created</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <BbTypographyH2>@_walletCount</BbTypographyH2>
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Tenants</BbCardTitle>
                <BbCardDescription>Total tenants</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <BbTypographyH2>@_tenantCount</BbTypographyH2>
            </BbCardContent>
        </BbCard>
    </div>
</div>
}

@code {
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private ILogger<Dashboard> Logger { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;

    private bool _loading = true;
    private long _userCount;
    private long _sessionCount;
    private long _walletCount;
    private long _tenantCount;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        TenantFilter.OnChanged += OnTenantFilterChanged;
        await LoadStats();
    }

    private void OnTenantFilterChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadStats();
            StateHasChanged();
        });
    }

    private async Task LoadStats()
    {
        _loading = true;
        _error = null;
        try
        {
            var usersQuery = DataContext.Query<IdentityInformation>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => !x.IsDeleted);

            var sessionsQuery = DataContext.Query<Session>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => !x.IsDeleted);

            var walletsQuery = DataContext.Query<Wallet>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => !x.IsDeleted);

            var tenantsQuery = DataContext.Query<Tenant>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => !x.IsDeleted);

            if (TenantFilter.SelectedTenantId is Guid tenantId)
            {
                usersQuery = usersQuery.Where(x => x.TenantId == tenantId);
                sessionsQuery = sessionsQuery.Where(x => x.TenantId == tenantId);
                walletsQuery = walletsQuery.Where(x => x.TenantId == tenantId);
                tenantsQuery = tenantsQuery.Where(x => x.Id == tenantId);
            }

            _userCount = await usersQuery.CountAsync();
            var sessions = await sessionsQuery.ToListAsync();
            _sessionCount = sessions.LongCount(x => x.Status == CurrentSessionState.Active);
            _walletCount = await walletsQuery.CountAsync();
            _tenantCount = await tenantsQuery.CountAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load dashboard stats");
            _error = $"Failed to load stats: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantFilterChanged;
    }
}
