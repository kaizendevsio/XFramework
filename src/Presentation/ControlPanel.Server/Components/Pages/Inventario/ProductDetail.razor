    private string GetVariationTypeName(ProductVariation variation)
    {
        if (variation.ProductVariationTypeId is { } typeId &&
            _variationTypes.FirstOrDefault(x => x.Id == typeId) is { } type)
        {
            return type.Name ?? type.Id.ToString()[..8];
        }

        return variation.VariationType ?? "";
    }

