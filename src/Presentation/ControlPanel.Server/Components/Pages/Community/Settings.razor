@page "/community/settings"
@using XFramework.Domain.Shared.DataContext
@implements IDisposable

<PageTitle>Community Settings - Control Panel</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_access.HasTenant)
{
    <BbAlert>
        <BbAlertTitle>Select a Tenant</BbAlertTitle>
        <BbAlertDescription>Choose a tenant in the sidebar to manage Community settings.</BbAlertDescription>
    </BbAlert>
}
else
{
    <FadeInContent>
        <div class="space-y-6">
            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <div>
                    <BbTypographyH3>Community Settings</BbTypographyH3>
                    <BbTypographyMuted>@_access.TenantName - registry-backed module configuration</BbTypographyMuted>
                </div>
                <div class="flex items-center gap-2">
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@LoadData">
                        <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                        Refresh
                    </BbButton>
                    <BbButton OnClick="@SaveSettings" Disabled="@_saving">
                        @if (_saving)
                        {
                            <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                        }
                        Save Settings
                    </BbButton>
                </div>
            </div>

            @if (!_access.CanUseCommunity)
            {
                <BbAlert Variant="AlertVariant.Warning">
                    <BbAlertTitle>Community Module Disabled</BbAlertTitle>
                    <BbAlertDescription>These settings are stored for the selected tenant, but Community APIs remain gated until the tenant module feature is enabled.</BbAlertDescription>
                </BbAlert>
            }

            <BbCard>
                <BbCardHeader>
                    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                        <div>
                            <BbCardTitle>Registry Settings</BbCardTitle>
                            <BbCardDescription>Keys are stored as tenant-scoped RegistryConfiguration records.</BbCardDescription>
                        </div>
                        <BbButton Variant="ButtonVariant.Outline" OnClick="@ResetFormToDefaults">
                            <LucideIcon Name="rotate-ccw" class="mr-2 h-4 w-4" />
                            Defaults
                        </BbButton>
                    </div>
                </BbCardHeader>
                <BbCardContent>
                    <div class="space-y-5">
                        @foreach (var row in _rows)
                        {
                            <div class="grid gap-3 border-b border-border pb-4 last:border-b-0 md:grid-cols-[minmax(12rem,1fr)_18rem_8rem] md:items-end">
                                <div>
                                    <div class="font-medium">@row.Definition.Label</div>
                                    <div class="text-sm text-muted-foreground">@row.Definition.Description</div>
                                    <div class="mt-1 font-mono text-xs text-muted-foreground">@row.Definition.Key</div>
                                </div>
                                @if (row.Definition.InputKind == CommunitySettingInputKind.Boolean)
                                {
                                    <BbFormFieldSelect TValue="string" @bind-Value="row.Value" Label="Value">
                                        <BbSelectItem Value="@("true")">True</BbSelectItem>
                                        <BbSelectItem Value="@("false")">False</BbSelectItem>
                                    </BbFormFieldSelect>
                                }
                                else
                                {
                                    <BbFormFieldInput TValue="string" @bind-Value="row.Value" Label="Value" />
                                }
                                <div class="text-sm text-muted-foreground">
                                    @(string.IsNullOrWhiteSpace(row.Definition.Unit) ? "Value" : row.Definition.Unit)
                                </div>
                            </div>
                        }
                    </div>
                </BbCardContent>
            </BbCard>

            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Existing Community Registry Entries</BbCardTitle>
                    <BbCardDescription>@_communityConfigs.Count stored key(s) with the community prefix</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataGrid Items="@_communityConfigs" ShowPagination="true" InitialPageSize="20">
                        <Columns>
                            <BbDataGridPropertyColumn Property="@(x => x.Key)" Title="Key" Sortable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.Value)" Title="Value" />
                            <BbDataGridPropertyColumn Property="@(x => x.Unit)" Title="Unit" />
                            <BbDataGridTemplateColumn Title="Enabled">
                                <ChildContent Context="item">
                                    <StatusBadge Text="@(item.IsEnabled ? "Enabled" : "Disabled")"
                                                 Status="@(item.IsEnabled ? "active" : "inactive")" />
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.ModifiedAt)" Title="Modified" Sortable="true" />
                        </Columns>
                    </BbDataGrid>
                </BbCardContent>
            </BbCard>
        </div>
    </FadeInContent>
}

@code {
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private CommunityControlPanelAccessService AccessService { get; set; } = default!;

    private static readonly Guid CommunitySettingsGroupSystemReferenceId =
        Guid.Parse("4e763322-b6c0-4609-8fd8-92f81425ccf0");

    private static readonly IReadOnlyList<CommunitySettingDefinition> SettingDefinitions =
    [
        new("community.identities.allowPublicSearch", "Public identity search", "Allow community identities to appear in public search results.", "true", null, CommunitySettingInputKind.Boolean),
        new("community.content.requireModeration", "Require content moderation", "Require new content to be reviewed before it is treated as published.", "false", null, CommunitySettingInputKind.Boolean),
        new("community.content.maxTextLength", "Maximum content length", "Maximum text length accepted by Community content workflows.", "5000", "characters", CommunitySettingInputKind.Number),
        new("community.content.maxFilesPerPost", "Maximum files per post", "Maximum number of files that may be attached to one content item.", "4", "files", CommunitySettingInputKind.Number),
        new("community.connections.allowBlocking", "Allow blocking", "Allow identities to create block relationships.", "true", null, CommunitySettingInputKind.Boolean),
        new("community.notifications.enabled", "Community notifications", "Enable notification creation for Community workflows.", "true", null, CommunitySettingInputKind.Boolean),
        new("community.notifications.digestWindowMinutes", "Notification digest window", "Window used by digest-style notification aggregation.", "15", "minutes", CommunitySettingInputKind.Number)
    ];

    private CommunityControlPanelAccessState _access = new(null, null, false, null);
    private List<CommunitySettingRow> _rows = [];
    private List<RegistryConfiguration> _communityConfigs = [];
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        TenantFilter.OnChanged += OnTenantFilterChanged;
        await LoadData();
    }

    private void OnTenantFilterChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _access = await AccessService.GetStateAsync(includeNotifications: true);
            _rows = [];
            _communityConfigs = [];

            if (_access.TenantId is not Guid tenantId)
            {
                return;
            }

            _communityConfigs = await DataContext.Query<RegistryConfiguration>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId)
                .OrderBy(x => x.Key)
                .Take(500)
                .ToListAsync();

            _communityConfigs = _communityConfigs
                .Where(x => x.Key.StartsWith("community.", StringComparison.OrdinalIgnoreCase))
                .ToList();

            var configByKey = _communityConfigs.ToDictionary(x => x.Key, StringComparer.OrdinalIgnoreCase);
            _rows = SettingDefinitions
                .Select(definition =>
                {
                    configByKey.TryGetValue(definition.Key, out var config);
                    return new CommunitySettingRow(definition, config?.Value ?? definition.DefaultValue);
                })
                .ToList();
        }
        catch (Exception ex)
        {
            ToastService.Show($"Failed to load Community settings: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetFormToDefaults()
    {
        foreach (var row in _rows)
        {
            row.Value = row.Definition.DefaultValue;
        }
    }

    private async Task SaveSettings()
    {
        if (_access.TenantId is not Guid tenantId)
        {
            ToastService.Show("Select a tenant first.");
            return;
        }

        if (!ValidateRows())
        {
            return;
        }

        _saving = true;
        try
        {
            var groupId = await EnsureCommunityGroupId(tenantId);
            var existing = await DataContext.Query<RegistryConfiguration>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId)
                .Take(500)
                .ToListAsync();
            var existingByKey = existing.ToDictionary(x => x.Key, StringComparer.OrdinalIgnoreCase);

            foreach (var row in _rows)
            {
                var value = string.IsNullOrWhiteSpace(row.Value)
                    ? row.Definition.DefaultValue
                    : row.Value.Trim();

                if (existingByKey.TryGetValue(row.Definition.Key, out var config))
                {
                    config.Value = value;
                    config.Unit = row.Definition.Unit;
                    config.GroupId = groupId;
                    config.IsEnabled = true;
                    config.ModifiedAt = DateTime.UtcNow;
                    DataContext.Update(config);
                }
                else
                {
                    DataContext.Add(new RegistryConfiguration
                    {
                        Id = Guid.NewGuid(),
                        TenantId = tenantId,
                        Key = row.Definition.Key,
                        Value = value,
                        Unit = row.Definition.Unit,
                        GroupId = groupId,
                        IsEnabled = true,
                        CreatedAt = DateTime.UtcNow
                    });
                }
            }

            var result = await DataContext.SaveChangesAsync();
            if (result.IsSuccess)
            {
                ToastService.Show("Community settings saved.");
                await LoadData();
            }
            else
            {
                ToastService.Show($"Failed to save settings: {result.Message}");
            }
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error saving settings: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<Guid> EnsureCommunityGroupId(Guid tenantId)
    {
        var group = await DataContext.Query<RegistryConfigurationGroup>()
            .IgnoreQueryFilters()
            .NoCache()
            .Where(x =>
                x.TenantId == tenantId &&
                x.SystemReferenceId == CommunitySettingsGroupSystemReferenceId &&
                x.IsDeleted == false)
            .FirstOrDefaultAsync();

        if (group is not null)
        {
            return group.Id;
        }

        var groupId = Guid.NewGuid();
        DataContext.Add(new RegistryConfigurationGroup
        {
            Id = groupId,
            TenantId = tenantId,
            Name = "Community",
            Description = "Community control panel settings",
            SystemReferenceId = CommunitySettingsGroupSystemReferenceId,
            IsEnabled = true,
            CreatedAt = DateTime.UtcNow
        });

        return groupId;
    }

    private bool ValidateRows()
    {
        foreach (var row in _rows)
        {
            if (row.Definition.InputKind == CommunitySettingInputKind.Boolean &&
                row.Value is not ("true" or "false"))
            {
                ToastService.Show($"{row.Definition.Label} must be true or false.");
                return false;
            }

            if (row.Definition.InputKind == CommunitySettingInputKind.Number &&
                (!int.TryParse(row.Value, out var value) || value < 0))
            {
                ToastService.Show($"{row.Definition.Label} must be a non-negative number.");
                return false;
            }
        }

        return true;
    }

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantFilterChanged;
    }

    private sealed record CommunitySettingDefinition(
        string Key,
        string Label,
        string Description,
        string DefaultValue,
        string? Unit,
        CommunitySettingInputKind InputKind);

    private sealed class CommunitySettingRow(CommunitySettingDefinition definition, string value)
    {
        public CommunitySettingDefinition Definition { get; } = definition;
        public string Value { get; set; } = value;
    }

    private enum CommunitySettingInputKind
    {
        Boolean,
        Number
    }
}
