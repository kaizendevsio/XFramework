@page "/community/identities"
@using XFramework.Domain.Shared.DataContext
@implements IDisposable

<PageTitle>Community Identities - Control Panel</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_access.HasTenant)
{
    <BbAlert>
        <BbAlertTitle>Select a Tenant</BbAlertTitle>
        <BbAlertDescription>Choose a tenant in the sidebar to review Community identities.</BbAlertDescription>
    </BbAlert>
}
else if (!_access.CanUseCommunity)
{
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Community Module Disabled</BbAlertTitle>
        <BbAlertDescription>Enable the Community module for this tenant before reviewing identities.</BbAlertDescription>
    </BbAlert>
}
else
{
    <FadeInContent>
        <div class="space-y-6">
            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <div>
                    <BbTypographyH3>Community Identities</BbTypographyH3>
                    <BbTypographyMuted>@_access.TenantName - admin moderation overview</BbTypographyMuted>
                </div>
                <BbButton Variant="ButtonVariant.Outline" OnClick="@LoadData">
                    <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                    Refresh
                </BbButton>
            </div>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
                <BbCard>
                    <BbCardHeader>
                        <BbCardTitle>Total</BbCardTitle>
                        <BbCardDescription>Loaded identities</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_items.Count</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader>
                        <BbCardTitle>Active</BbCardTitle>
                        <BbCardDescription>Status is active</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_activeCount</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader>
                        <BbCardTitle>Suspended</BbCardTitle>
                        <BbCardDescription>Status is suspended</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_suspendedCount</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader>
                        <BbCardTitle>Disabled</BbCardTitle>
                        <BbCardDescription>Moderation disabled</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_disabledCount</BbTypographyH2></BbCardContent>
                </BbCard>
            </div>

            <BbCard>
                <BbCardHeader>
                    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                        <div>
                            <BbCardTitle>Identity Records</BbCardTitle>
                            <BbCardDescription>@FilteredItems.Count identity record(s)</BbCardDescription>
                        </div>
                        <div class="grid w-full gap-2 md:w-auto md:grid-cols-[18rem_12rem]">
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_search"
                                              Label="Search"
                                              Placeholder="Handle, alias, or credential" />
                            <BbFormFieldSelect TValue="string"
                                               @bind-Value="_statusFilter"
                                               Label="Status"
                                               Placeholder="All statuses">
                                <BbSelectItem Value="@("all")">All statuses</BbSelectItem>
                                @foreach (var status in Enum.GetValues<CommunityIdentityStatus>())
                                {
                                    var statusValue = ((int)status).ToString();
                                    <BbSelectItem Value="@statusValue">@status.ToString()</BbSelectItem>
                                }
                            </BbFormFieldSelect>
                        </div>
                    </div>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataGrid Items="@FilteredItems" ShowPagination="true" InitialPageSize="20"
                                OnRowClick="@((CommunityIdentity item) => Navigation.NavigateTo($"/community/identities/{item.Id}"))"
                                Class="cursor-pointer">
                        <Columns>
                            <BbDataGridTemplateColumn Title="Identity" Sortable="true">
                                <ChildContent Context="item">
                                    <div>
                                        <div class="font-medium">@(item.HandleName ?? item.Alias ?? "Unnamed identity")</div>
                                        <div class="text-xs text-muted-foreground">@GetCredentialLabel(item.CredentialId)</div>
                                    </div>
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Type">
                                <ChildContent Context="item">@(item.Type?.Name ?? GetTypeName(item.TypeId))</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Status">
                                <ChildContent Context="item">
                                    <StatusBadge Text="@GetIdentityStatusText(item.Status)" Status="@GetIdentityStatusKey(item.Status)" />
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Enabled">
                                <ChildContent Context="item">
                                    <StatusBadge Text="@(item.IsEnabled ? "Enabled" : "Disabled")"
                                                 Status="@(item.IsEnabled ? "active" : "inactive")" />
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.LastActive)" Title="Last Active" Sortable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" />
                            <BbDataGridTemplateColumn Title="Actions">
                                <ChildContent Context="item">
                                    <div class="flex items-center gap-1">
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                                  OnClick="@(() => Navigation.NavigateTo($"/community/identities/{item.Id}"))">
                                            <LucideIcon Name="eye" class="h-4 w-4" />
                                        </BbButton>
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                                  OnClick="@(() => ToggleEnabled(item))">
                                            <LucideIcon Name="@(item.IsEnabled ? "ban" : "check")" class="h-4 w-4" />
                                        </BbButton>
                                    </div>
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                        </Columns>
                    </BbDataGrid>
                </BbCardContent>
            </BbCard>
        </div>
    </FadeInContent>
}

@code {
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private CommunityControlPanelAccessService AccessService { get; set; } = default!;

    private CommunityControlPanelAccessState _access = new(null, null, false, null);
    private List<CommunityIdentity> _items = [];
    private Dictionary<Guid, string> _credentialLabels = [];
    private Dictionary<Guid, string> _typeNames = [];
    private bool _loading = true;
    private string _search = "";
    private string _statusFilter = "all";
    private int _activeCount;
    private int _suspendedCount;
    private int _disabledCount;

    private List<CommunityIdentity> FilteredItems
    {
        get
        {
            var items = _items.AsEnumerable();

            if (int.TryParse(_statusFilter, out var status))
            {
                items = items.Where(x => x.Status == status);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var search = _search.Trim();
                items = items.Where(x =>
                    Contains(x.HandleName, search) ||
                    Contains(x.Alias, search) ||
                    Contains(x.Tagline, search) ||
                    Contains(GetCredentialLabel(x.CredentialId), search));
            }

            return items.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        TenantFilter.OnChanged += OnTenantFilterChanged;
        await LoadData();
    }

    private void OnTenantFilterChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _access = await AccessService.GetStateAsync();
            _items = [];
            _credentialLabels = [];
            _typeNames = [];

            if (!_access.CanUseCommunity || _access.TenantId is not Guid tenantId)
            {
                return;
            }

            _items = await DataContext.Query<CommunityIdentity>()
                .IgnoreQueryFilters()
                .NoCache()
                .Include(x => x.Type)
                .Where(x => x.TenantId == tenantId)
                .OrderByDescending(x => x.CreatedAt)
                .Take(250)
                .ToListAsync();

            var types = await DataContext.Query<CommunityIdentityType>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId)
                .OrderBy(x => x.Name)
                .Take(100)
                .ToListAsync();
            _typeNames = types.ToDictionary(x => x.Id, x => x.Name);

            var credentials = await DataContext.Query<IdentityCredential>()
                .IgnoreQueryFilters()
                .NoCache()
                .Include(x => x.IdentityInfo)
                .Where(x => x.TenantId == tenantId)
                .OrderByDescending(x => x.CreatedAt)
                .Take(500)
                .ToListAsync();
            _credentialLabels = credentials.ToDictionary(x => x.Id, BuildCredentialLabel);

            _activeCount = _items.Count(x => x.Status == (int)CommunityIdentityStatus.Active);
            _suspendedCount = _items.Count(x => x.Status == (int)CommunityIdentityStatus.Suspended);
            _disabledCount = _items.Count(x => !x.IsEnabled);
        }
        catch (Exception ex)
        {
            ToastService.Show($"Failed to load Community identities: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ToggleEnabled(CommunityIdentity item)
    {
        try
        {
            var fresh = await DataContext.Query<CommunityIdentity>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == item.Id)
                .FirstOrDefaultAsync();

            if (fresh is null || fresh.TenantId != _access.TenantId)
            {
                ToastService.Show("Identity not found in the selected tenant.");
                return;
            }

            fresh.IsEnabled = !fresh.IsEnabled;
            fresh.ModifiedAt = DateTime.UtcNow;
            DataContext.Update(fresh);
            var result = await DataContext.SaveChangesAsync();

            if (result.IsSuccess)
            {
                ToastService.Show(fresh.IsEnabled ? "Identity enabled." : "Identity disabled.");
                await LoadData();
            }
            else
            {
                ToastService.Show($"Failed to update identity: {result.Message}");
            }
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error updating identity: {ex.Message}");
        }
    }

    private string GetCredentialLabel(Guid credentialId) =>
        _credentialLabels.TryGetValue(credentialId, out var label)
            ? label
            : $"{credentialId.ToString()[..8]}...";

    private string GetTypeName(Guid typeId) =>
        _typeNames.TryGetValue(typeId, out var name)
            ? name
            : $"{typeId.ToString()[..8]}...";

    private static string BuildCredentialLabel(IdentityCredential credential)
    {
        var displayName = credential.IdentityInfo?.FullName;
        if (string.IsNullOrWhiteSpace(displayName))
        {
            displayName = credential.IdentityInfo?.IdentityName;
        }

        var username = credential.UserName ?? credential.UserAlias;
        return string.IsNullOrWhiteSpace(username)
            ? displayName ?? credential.Id.ToString()[..8]
            : $"{displayName ?? "Credential"} ({username})";
    }

    private static string GetIdentityStatusText(int status) =>
        Enum.IsDefined(typeof(CommunityIdentityStatus), status)
            ? ((CommunityIdentityStatus)status).ToString()
            : status.ToString();

    private static string GetIdentityStatusKey(int status) => (CommunityIdentityStatus)status switch
    {
        CommunityIdentityStatus.Active => "active",
        CommunityIdentityStatus.Suspended => "suspended",
        CommunityIdentityStatus.Inactive => "inactive",
        _ => "inactive"
    };

    private static bool Contains(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantFilterChanged;
    }
}
