@page "/lookups/exchange-rates"

<PageTitle>Exchange Rates - Control Panel</PageTitle>

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <BbTypography Variant="TypographyVariant.H3">Exchange Rates</BbTypography>
    </div>

    <BbDataGrid Items="@_items" ShowPagination="true" InitialPageSize="20">
        <BbDataGridPropertyColumn Property="@(x => x.SourceCurrencyTypeId)" Title="Source Currency ID" Sortable="true" />
        <BbDataGridPropertyColumn Property="@(x => x.TargetCurrencyTypeId)" Title="Target Currency ID" Sortable="true" />
        <BbDataGridPropertyColumn Property="@(x => x.Value)" Title="Value" Sortable="true" />
        <BbDataGridPropertyColumn Property="@(x => x.Fee)" Title="Fee" Sortable="true" />
        <BbDataGridPropertyColumn Property="@(x => x.EffectivityDate)" Title="Effectivity Date" Sortable="true" />
        <BbDataGridPropertyColumn Property="@(x => x.ExpiryDate)" Title="Expiry Date" Sortable="true" />
    </BbDataGrid>
</div>

@code {
    [Inject] private IDataContext DataContext { get; set; } = default!;

    private List<ExchangeRate> _items = [];

    protected override async Task OnInitializedAsync()
    {
        _items = await DataContext.Query<ExchangeRate>().OrderByDescending(x => x.CreatedAt).ToListAsync();
    }
}
