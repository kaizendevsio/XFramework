@page "/lookups/session-types"

<PageTitle>Session Types - Control Panel</PageTitle>

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <BbTypography Variant="TypographyVariant.H3">Session Types</BbTypography>
    </div>

    <BbDataGrid Items="@_items" ShowPagination="true" InitialPageSize="20">
        <Columns>
            <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Reference ID" Sortable="true" />
        </Columns>
    </BbDataGrid>
</div>

@code {
    [Inject] private IDataContext DataContext { get; set; } = default!;

    private List<SessionType> _items = [];

    protected override async Task OnInitializedAsync()
    {
        _items = await DataContext.Query<SessionType>().OrderByDescending(x => x.CreatedAt).ToListAsync();
    }
}
