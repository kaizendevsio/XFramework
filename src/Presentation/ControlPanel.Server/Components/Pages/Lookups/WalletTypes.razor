@page "/lookups/wallet-types"

<PageTitle>Wallet Types - Control Panel</PageTitle>

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <BbTypographyH3>Wallet Types</BbTypographyH3>
    </div>

    @if (_loading)
    {
        <CenteredSpinner />
    }
    else
    {
    <BbDataGrid Items="@_items" ShowPagination="true" InitialPageSize="20">
        <Columns>
            <BbDataGridPropertyColumn Property="@(x => x.Code)" Title="Code" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.Desc)" Title="Description" />
            <BbDataGridPropertyColumn Property="@(x => x.Type)" Title="Type" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.MinTransferRule)" Title="Min Transfer" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.MaxTransferRule)" Title="Max Transfer" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Reference ID" Sortable="true" />
        </Columns>
    </BbDataGrid>
    }
</div>

@code {
    [Inject] private IWalletsServiceWrapper WalletsWrapper { get; set; } = default!;

    private List<global::Wallets.Domain.Shared.Contracts.WalletType> _items = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var response = await WalletsWrapper.WalletType.GetList(100, 1);
            _items = response?.Response?.Items?.ToList() ?? [];
        }
        finally
        {
            _loading = false;
        }
    }
}
