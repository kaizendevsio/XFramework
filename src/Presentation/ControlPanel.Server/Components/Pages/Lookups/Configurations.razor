@page "/lookups/configurations"

<PageTitle>Configurations - Control Panel</PageTitle>

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <BbTypographyH3>Configurations</BbTypographyH3>
        <BbButton OnClick="@OpenCreateDialog">
            <LucideIcon Name="plus" class="h-4 w-4 mr-1" />
            Add Configuration
        </BbButton>
    </div>

    @if (_loading)
    {
        <CenteredSpinner />
    }
    else
    {
    <BbDataGrid Items="@_items" ShowPagination="true" InitialPageSize="20">
        <Columns>
            <BbDataGridPropertyColumn Property="@(x => x.Key)" Title="Key" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.Value)" Title="Value" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.Unit)" Title="Unit" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.GroupId)" Title="Group ID" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" />
            <BbDataGridTemplateColumn Title="Actions">
                <ChildContent Context="item">
                    <div class="flex items-center gap-2">
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                  OnClick="@(() => OpenEditDialog(item))">
                            Edit
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                  OnClick="@(() => OpenDeleteDialog(item))">
                            Delete
                        </BbButton>
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
    }
</div>

<BbDialog Open="@_showFormDialog" OpenChanged="@(v => _showFormDialog = v)">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>@(_isEditing ? "Edit Configuration" : "Add Configuration")</BbDialogTitle>
            <BbDialogDescription>@(_isEditing ? "Update the configuration entry." : "Create a new configuration entry.")</BbDialogDescription>
        </BbDialogHeader>
        <div class="space-y-4 py-4">
            <BbFormFieldInput TValue="string"
                              @bind-Value="_formKey"
                              Label="Key"
                              Placeholder="Configuration key"
                              Required="true" />
            <BbFormFieldInput TValue="string"
                              @bind-Value="_formValue"
                              Label="Value"
                              Placeholder="Configuration value" />
            <BbFormFieldInput TValue="string"
                              @bind-Value="_formUnit"
                              Label="Unit"
                              Placeholder="Unit (optional)" />
            <BbFormFieldInput TValue="string"
                              @bind-Value="_formGroupId"
                              Label="Group ID"
                              Placeholder="Group ID" />
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _showFormDialog = false)">Cancel</BbButton>
            <BbButton OnClick="@SaveConfiguration">@(_isEditing ? "Update" : "Create")</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<ConfirmDeleteDialog Open="@_showDeleteDialog" OpenChanged="@(v => _showDeleteDialog = v)"
                     Message="@($"This will permanently delete the configuration \"{_deleteTarget?.Key}\".")"
                     OnConfirm="@DeleteConfiguration" />

@code {
    [Inject] private ControlPanel.Server.Services.AdminDbContext Db { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    private List<RegistryConfiguration> _items = [];
    private bool _loading = true;
    private bool _showFormDialog;
    private bool _showDeleteDialog;
    private bool _isEditing;
    private RegistryConfiguration? _editTarget;
    private RegistryConfiguration? _deleteTarget;

    private string _formKey = "";
    private string _formValue = "";
    private string _formUnit = "";
    private string _formGroupId = "";

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _items = await Db.Query<RegistryConfiguration>().OrderByDescending(x => x.CreatedAt).ToListAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCreateDialog()
    {
        _isEditing = false;
        _editTarget = null;
        _formKey = "";
        _formValue = "";
        _formUnit = "";
        _formGroupId = "";
        _showFormDialog = true;
    }

    private void OpenEditDialog(RegistryConfiguration config)
    {
        _isEditing = true;
        _editTarget = config;
        _formKey = config.Key;
        _formValue = config.Value ?? "";
        _formUnit = config.Unit ?? "";
        _formGroupId = config.GroupId.ToString();
        _showFormDialog = true;
    }

    private void OpenDeleteDialog(RegistryConfiguration config)
    {
        _deleteTarget = config;
        _showDeleteDialog = true;
    }

    private async Task SaveConfiguration()
    {
        if (string.IsNullOrWhiteSpace(_formKey)) return;

        if (_isEditing && _editTarget is not null)
        {
            var fresh = await Db.Query<RegistryConfiguration>()
                .Where(x => x.Id == _editTarget.Id).FirstOrDefaultAsync();
            if (fresh is null) return;

            fresh.Key = _formKey;
            fresh.Value = _formValue;
            fresh.Unit = string.IsNullOrWhiteSpace(_formUnit) ? null : _formUnit;
            fresh.GroupId = Guid.TryParse(_formGroupId, out var gid) ? gid : fresh.GroupId;
            Db.Update(fresh);
        }
        else
        {
            var config = new RegistryConfiguration
            {
                Id = Guid.NewGuid(),
                Key = _formKey,
                Value = _formValue,
                Unit = string.IsNullOrWhiteSpace(_formUnit) ? null : _formUnit,
                GroupId = Guid.TryParse(_formGroupId, out var gid) ? gid : Guid.Empty,
                CreatedAt = DateTime.UtcNow
            };
            Db.Add(config);
        }

        var result = await Db.SaveAsync();
        if (!result.Success)
        {
            ToastService.Show($"Error: {result.Error}");
            return;
        }

        _showFormDialog = false;
        _items = await Db.Query<RegistryConfiguration>().OrderByDescending(x => x.CreatedAt).ToListAsync();
    }

    private async Task DeleteConfiguration()
    {
        if (_deleteTarget is not null)
        {
            Db.Remove(_deleteTarget);
            var result = await Db.SaveAsync();
            ToastService.Show(result.Success ? "Configuration deleted." : $"Error: {result.Error}");
            _showDeleteDialog = false;
            _deleteTarget = null;
            _items = await Db.Query<RegistryConfiguration>().OrderByDescending(x => x.CreatedAt).ToListAsync();
        }
    }
}
