@page "/lookups/role-types"

<PageTitle>Role Types - Control Panel</PageTitle>

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <BbTypography Variant="TypographyVariant.H3">Role Types</BbTypography>
    </div>

    <BbDataGrid Items="@_items" ShowPagination="true" InitialPageSize="20">
        <Columns>
            <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.RoleLevel)" Title="Role Level" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.GroupId)" Title="Group ID" Sortable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Reference ID" Sortable="true" />
        </Columns>
    </BbDataGrid>
</div>

@code {
    [Inject] private ControlPanel.Server.Services.AdminDbContext Db { get; set; } = default!;

    private List<IdentityRoleType> _items = [];

    protected override async Task OnInitializedAsync()
    {
        _items = await Db.Query<IdentityRoleType>().OrderByDescending(x => x.CreatedAt).ToListAsync();
    }
}
