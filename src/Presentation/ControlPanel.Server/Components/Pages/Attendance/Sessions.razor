@page "/attendance/sessions"
@using XFramework.Domain.Shared.BusinessObjects
@implements IDisposable

<PageTitle>Attendance Sessions - Control Panel</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_hasTenant)
{
    <ModuleUnavailable ModuleName="Attendance" RequiresTenant="true" />
}
else if (!_moduleEnabled)
{
    <ModuleUnavailable ModuleName="Attendance" />
}
else
{
    <FadeInContent>
        <div class="space-y-6">
            <div class="xf-page-header">
                <div>
                    <BbTypographyH3>Attendance Sessions</BbTypographyH3>
                    <BbTypographyMuted>Create and monitor concrete attendance windows.</BbTypographyMuted>
                </div>
                <div class="xf-page-actions">
                    <BbButton OnClick="@OpenCreateDialog" Disabled="@(_contextOptions.Count == 0)">
                        <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                        Create Session
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@Reload">
                        <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                        Refresh
                    </BbButton>
                </div>
            </div>

            <BbCard>
                <BbCardHeader>
                    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                        <div>
                            <BbCardTitle>Session Filters</BbCardTitle>
                            <BbCardDescription>@_sessions.Count session(s) loaded</BbCardDescription>
                        </div>
                        <div class="grid w-full gap-3 md:w-auto md:grid-cols-[20rem_18rem_12rem]">
                            <XfEntityPicker TItem="AttendanceContextOption"
                                            Label="Context"
                                            Value="@SelectedContextPickerValue"
                                            ValueChanged="@OnContextFilterChanged"
                                            Items="@_contextOptions"
                                            ValueSelector="@(item => item.Id.ToString())"
                                            TextSelector="@(item => item.Label)"
                                            SearchTextSelector="@(item => $"{item.Label} {item.ContextType}")"
                                            AdvancedColumns="@ContextAdvancedColumns"
                                            AdvancedFilters="@ContextAdvancedFilters"
                                            AdvancedSearchScope="Searches attendance context code, name, type, and active state."
                                            Placeholder="All contexts"
                                            SearchPlaceholder="Search contexts..."
                                            EmptyMessage="No attendance contexts found."
                                            AllowClear="true"
                                            ClearText="All contexts"
                                            ShowCreate="false"
                                            AdvancedSearchTitle="Find Attendance Context"
                                            AdvancedSearchDescription="Filter sessions by attendance context." />
                            <div class="xf-form-field">
                                <BbLabel>Date Range</BbLabel>
                                <BbDateRangePicker Value="@_dateRange"
                                                   ValueChanged="@OnDateRangeChanged"
                                                   ShowPresets="true"
                                                   DateFormat="yyyy-MM-dd"
                                                   Placeholder="Select date range" />
                            </div>
                            <BbFormFieldSelect TValue="string" @bind-Value="_statusFilter" Label="Status">
                                <BbSelectItem Value="@AllStatusesValue">All statuses</BbSelectItem>
                                @foreach (var status in Enum.GetValues<AttendanceSessionStatus>())
                                {
                                    <BbSelectItem Value="@status.ToString()">@AttendanceControlPanelReadService.FormatEnumLabel(status)</BbSelectItem>
                                }
                            </BbFormFieldSelect>
                        </div>
                    </div>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataGrid Items="@FilteredSessions"
                                ShowPagination="true"
                                InitialPageSize="20"
                                ShowSearch="true"
                                SearchPlaceholder="Search sessions..."
                                OnRowClick="@((AttendanceSessionRow item) => OpenSessionDetail(item.Id))"
                                Class="cursor-pointer">
                        <Columns>
                            <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" Filterable="true" />
                            <BbDataGridTemplateColumn Title="Code" Sortable="true" Filterable="true" FilterBy="@(item => item.Code ?? string.Empty)">
                                <ChildContent Context="item">@(item.Code ?? "N/A")</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.ContextName)" Title="Context" Sortable="true" Filterable="true" />
                            <BbDataGridTemplateColumn Title="Status" Sortable="true" Filterable="true" FilterBy="@(item => item.Status.ToString())">
                                <ChildContent Context="item">
                                    <StatusBadge Text="@AttendanceControlPanelReadService.FormatEnumLabel(item.Status)"
                                                 Status="@AttendanceControlPanelReadService.StatusKey(item.Status)" />
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.StartsAt)" Title="Starts" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.EndsAt)" Title="Ends" Sortable="true" Filterable="true" />
                            <BbDataGridPropertyColumn Property="@(x => x.TimeZoneId)" Title="Time Zone" Filterable="true" />
                            <BbDataGridTemplateColumn Title="Actions">
                                <ChildContent Context="item">
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Open session" OnClick="@(() => OpenSessionDetail(item.Id))">
                                        <LucideIcon Name="eye" class="h-4 w-4" />
                                    </BbButton>
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                        </Columns>
                        <EmptyTemplate>
                            <BbEmpty Title="No attendance sessions" Description="Create a session or adjust the filters." />
                        </EmptyTemplate>
                    </BbDataGrid>
                </BbCardContent>
            </BbCard>
        </div>
    </FadeInContent>
}

<BbDialog Open="@_createDialogOpen" OpenChanged="@(value => _createDialogOpen = value)">
    <BbDialogContent TrapFocus="false" Class="xf-dialog-wide">
        <BbDialogHeader>
            <BbDialogTitle>Create Attendance Session</BbDialogTitle>
            <BbDialogDescription>Sessions define the attendance window for a context.</BbDialogDescription>
        </BbDialogHeader>
        <div class="grid gap-4 py-4">
            <XfEntityPicker TItem="AttendanceContextOption"
                            Label="Context"
                            Value="@_form.ContextId"
                            ValueChanged="@(value => _form.ContextId = value ?? string.Empty)"
                            Items="@_contextOptions"
                            ValueSelector="@(item => item.Id.ToString())"
                            TextSelector="@(item => item.Label)"
                            SearchTextSelector="@(item => $"{item.Label} {item.ContextType}")"
                            AdvancedColumns="@ContextAdvancedColumns"
                            AdvancedFilters="@ContextAdvancedFilters"
                            AdvancedSearchScope="Searches attendance context code, name, type, and active state."
                            Placeholder="Select context"
                            SearchPlaceholder="Search contexts..."
                            EmptyMessage="No attendance contexts found."
                            ShowCreate="false"
                            AdvancedSearchTitle="Find Attendance Context"
                            AdvancedSearchDescription="Select the context that owns this session." />
            <div class="grid gap-3 md:grid-cols-2">
                <BbFormFieldInput TValue="string" @bind-Value="_form.Name" Label="Name" Required="true" />
                <BbFormFieldInput TValue="string" @bind-Value="_form.Code" Label="Code" />
            </div>
            <div class="grid gap-3 md:grid-cols-2">
                <div class="xf-form-field">
                    <BbLabel>Starts At</BbLabel>
                    <input type="datetime-local"
                           class="xf-datetime-input"
                           value="@_form.StartsAt"
                           @oninput="@((ChangeEventArgs e) => _form.StartsAt = e.Value?.ToString() ?? string.Empty)" />
                </div>
                <div class="xf-form-field">
                    <BbLabel>Ends At</BbLabel>
                    <input type="datetime-local"
                           class="xf-datetime-input"
                           value="@_form.EndsAt"
                           @oninput="@((ChangeEventArgs e) => _form.EndsAt = e.Value?.ToString() ?? string.Empty)" />
                </div>
            </div>
            <div class="grid gap-3 md:grid-cols-2">
                <div class="xf-form-field">
                    <BbLabel>Time Zone</BbLabel>
                    <BbCombobox TValue="string"
                                 Value="@_form.TimeZoneId"
                                 ValueChanged="@(value => _form.TimeZoneId = value ?? "UTC")"
                                 Options="@_timeZoneOptions"
                                 Placeholder="UTC"
                                 SearchPlaceholder="Search time zones..."
                                 EmptyMessage="No time zone found."
                                 MatchTriggerWidth="true" />
                </div>
                <BbFormFieldSelect TValue="string" @bind-Value="_form.Status" Label="Status">
                    @foreach (var status in Enum.GetValues<AttendanceSessionStatus>())
                    {
                        <BbSelectItem Value="@status.ToString()">@AttendanceControlPanelReadService.FormatEnumLabel(status)</BbSelectItem>
                    }
                </BbFormFieldSelect>
            </div>
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _createDialogOpen = false)">Cancel</BbButton>
            <BbButton OnClick="@CreateSession" Disabled="@_saving">
                @if (_saving)
                {
                    <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                }
                Create
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private const string AllStatusesValue = "all";

    [Parameter, SupplyParameterFromQuery(Name = "contextId")] public Guid? ContextId { get; set; }

    [Inject] private AttendanceControlPanelReadService AttendanceReadService { get; set; } = default!;
    [Inject] private IAttendanceServiceWrapper Attendance { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private TenantModuleNavigationService ModuleNavigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private RequestMetadata RequestMetadata { get; set; } = default!;
    [Inject] private ILogger<Sessions> Logger { get; set; } = default!;

    private readonly SessionForm _form = new();
    private List<AttendanceSessionRow> _sessions = [];
    private List<AttendanceContextOption> _contextOptions = [];
    private List<SelectOption<string>> _timeZoneOptions = [];
    private DateRange _dateRange = DateRange.Create(DateTime.UtcNow.Date.AddDays(-7), DateTime.UtcNow.Date.AddDays(30));
    private string _selectedContextId = string.Empty;
    private string _statusFilter = AllStatusesValue;
    private bool _loading = true;
    private bool _hasTenant;
    private bool _moduleEnabled;
    private bool _createDialogOpen;
    private bool _saving;

    private string? SelectedContextPickerValue => string.IsNullOrWhiteSpace(_selectedContextId) ? null : _selectedContextId;
    private List<AttendanceSessionRow> FilteredSessions => _sessions.ToList();

    private IReadOnlyList<XfEntityPickerColumn<AttendanceContextOption>> ContextAdvancedColumns =>
    [
        new("Context", x => x.Label),
        new("Type", x => AttendanceControlPanelReadService.FormatEnumLabel(x.ContextType)),
        new("Status", x => x.IsActive ? "Active" : "Inactive")
    ];

    private IReadOnlyList<XfEntityPickerFilter<AttendanceContextOption>> ContextAdvancedFilters =>
    [
        new("type", "Type", BuildDistinctFilterOptions(_contextOptions, x => x.ContextType.ToString()), x => x.ContextType.ToString(), "All types"),
        new("active", "Status", ActiveFilterOptions, x => x.IsActive ? "true" : "false", "All statuses")
    ];

    private static readonly IReadOnlyList<XfEntityPickerFilterOption> ActiveFilterOptions =
    [
        new("true", "Active"),
        new("false", "Inactive")
    ];

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        ModuleNavigation.OnChanged += OnTenantChanged;
        _timeZoneOptions = TimeZoneInfo.GetSystemTimeZones()
            .Select(zone => new SelectOption<string>(zone.Id, zone.Id))
            .Prepend(new SelectOption<string>("UTC", "UTC"))
            .DistinctBy(x => x.Value)
            .ToList();
    }

    protected override async Task OnParametersSetAsync()
    {
        _selectedContextId = ContextId?.ToString() ?? string.Empty;
        await Reload();
    }

    private void OnTenantChanged() => _ = InvokeAsync(Reload);

    private async Task Reload()
    {
        _loading = true;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _moduleEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Attendance);
            _sessions = [];
            _contextOptions = [];

            if (!_hasTenant || !_moduleEnabled)
            {
                return;
            }

            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load attendance sessions.");
            ToastService.Error("Attendance sessions could not be loaded.", "Attendance");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        var tenantId = TenantFilter.SelectedTenantId!.Value;
        _contextOptions = (await AttendanceReadService.LoadContextOptionsAsync(tenantId)).ToList();
        await LoadSessions();
    }

    private async Task LoadSessions()
    {
        if (TenantFilter.SelectedTenantId is not Guid tenantId)
        {
            _sessions = [];
            return;
        }

        var contextId = Guid.TryParse(_selectedContextId, out var parsedContextId) ? parsedContextId : (Guid?)null;
        var status = Enum.TryParse<AttendanceSessionStatus>(_statusFilter, out var parsedStatus) ? parsedStatus : (AttendanceSessionStatus?)null;
        var fromUtc = DateTime.SpecifyKind(_dateRange.Start.Date, DateTimeKind.Utc);
        var toUtc = DateTime.SpecifyKind(_dateRange.End.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc);

        _sessions = (await AttendanceReadService.LoadSessionRowsAsync(tenantId, contextId, fromUtc, toUtc, status)).ToList();
    }

    private async Task OnContextFilterChanged(string? value)
    {
        _selectedContextId = value ?? string.Empty;
        await LoadSessions();
    }

    private async Task OnDateRangeChanged(DateRange range)
    {
        _dateRange = range;
        await LoadSessions();
    }

    private async Task OpenCreateDialog()
    {
        _form.Reset();
        _form.ContextId = _selectedContextId;
        var now = DateTime.Now;
        _form.StartsAt = now.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
        _form.EndsAt = now.AddHours(1).ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
        _createDialogOpen = true;
        await Task.CompletedTask;
    }

    private async Task CreateSession()
    {
        if (TenantFilter.SelectedTenantId is not Guid tenantId)
        {
            ToastService.Warning("Select a tenant before creating a session.", "Validation");
            return;
        }

        if (!Guid.TryParse(_form.ContextId, out var contextId))
        {
            ToastService.Warning("Select an attendance context.", "Validation");
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            ToastService.Warning("Session name is required.", "Validation");
            return;
        }

        if (!DateTime.TryParse(_form.StartsAt, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var startsAt)
            || !DateTime.TryParse(_form.EndsAt, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var endsAt))
        {
            ToastService.Warning("Choose valid start and end times.", "Validation");
            return;
        }

        if (endsAt <= startsAt)
        {
            ToastService.Warning("Session end time must be after the start time.", "Validation");
            return;
        }

        if (!Enum.TryParse<AttendanceSessionStatus>(_form.Status, out var status))
        {
            ToastService.Warning("Select a valid session status.", "Validation");
            return;
        }

        _saving = true;
        try
        {
            var response = await Attendance.CreateAttendanceSession(new CreateAttendanceSessionRequest
            {
                TenantId = tenantId,
                ContextId = contextId,
                Name = _form.Name.Trim(),
                Code = NullIfEmpty(_form.Code),
                StartsAt = startsAt.ToUniversalTime(),
                EndsAt = endsAt.ToUniversalTime(),
                TimeZoneId = string.IsNullOrWhiteSpace(_form.TimeZoneId) ? "UTC" : _form.TimeZoneId,
                Status = status,
                Metadata = BuildMetadata(tenantId)
            });

            if (response.IsSuccess)
            {
                ToastService.Success("Attendance session created.", "Attendance");
                _createDialogOpen = false;
                await LoadSessions();
            }
            else
            {
                Logger.LogWarning("Attendance session creation failed with status {StatusCode}", response.HttpStatusCode);
                ToastService.Error("Attendance session could not be created.", "Attendance");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Attendance session creation failed.");
            ToastService.Error("Attendance session could not be created.", "Attendance");
        }
        finally
        {
            _saving = false;
        }
    }

    private void OpenSessionDetail(Guid sessionId) => Navigation.NavigateTo($"/attendance/sessions/{sessionId}");

    private RequestMetadata BuildMetadata(Guid tenantId) => new()
    {
        TenantId = tenantId,
        CredentialId = RequestMetadata.CredentialId,
        SessionId = RequestMetadata.SessionId,
        RequestId = Guid.NewGuid(),
        Name = RequestMetadata.Name ?? "ControlPanel",
        DeviceName = RequestMetadata.DeviceName,
        DeviceAgent = RequestMetadata.DeviceAgent,
        IpAddress = RequestMetadata.IpAddress
    };

    private static IReadOnlyList<XfEntityPickerFilterOption> BuildDistinctFilterOptions<TItem>(
        IEnumerable<TItem> items,
        Func<TItem, string?> selector) =>
        items
            .Select(selector)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Order(StringComparer.OrdinalIgnoreCase)
            .Select(value => new XfEntityPickerFilterOption(value!, value!))
            .ToArray();

    private static string? NullIfEmpty(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantChanged;
        ModuleNavigation.OnChanged -= OnTenantChanged;
    }

    private sealed class SessionForm
    {
        public string ContextId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public string StartsAt { get; set; } = string.Empty;
        public string EndsAt { get; set; } = string.Empty;
        public string TimeZoneId { get; set; } = "UTC";
        public string Status { get; set; } = AttendanceSessionStatus.Scheduled.ToString();

        public void Reset()
        {
            ContextId = string.Empty;
            Name = string.Empty;
            Code = string.Empty;
            StartsAt = string.Empty;
            EndsAt = string.Empty;
            TimeZoneId = "UTC";
            Status = AttendanceSessionStatus.Scheduled.ToString();
        }
    }
}
