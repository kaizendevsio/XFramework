@page "/messaging/users/{CredentialId:guid}"
@implements IDisposable

<PageTitle>Messaging User Detail - Control Panel</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (_guard is { IsEnabled: false })
{
    <div class="space-y-4">
        <BbAlert Variant="@(_guard.HasSelectedTenant ? AlertVariant.Warning : AlertVariant.Info)">
            <BbAlertTitle>@_guard.Title</BbAlertTitle>
            <BbAlertDescription>@_guard.Description</BbAlertDescription>
        </BbAlert>
        @if (_guard.TenantId is Guid tenantId)
        {
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => Navigation.NavigateTo($"/identity/tenants/{tenantId}/modules"))">
                <LucideIcon Name="blocks" class="mr-2 h-4 w-4" />
                Tenant Modules
            </BbButton>
        }
    </div>
}
else if (_credential is null)
{
    <div class="space-y-4">
        <BbButton Variant="ButtonVariant.Ghost" OnClick="@GoBack">
            <LucideIcon Name="arrow-left" class="mr-2 h-4 w-4" />
            Back to Messaging Users
        </BbButton>
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertTitle>Messaging User Not Found</BbAlertTitle>
            <BbAlertDescription>No credential was found for the selected tenant.</BbAlertDescription>
        </BbAlert>
    </div>
}
else
{
    <FadeInContent>
        <div class="space-y-6">
            <div class="xf-page-header">
                <div class="flex items-center gap-4">
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" OnClick="@GoBack" AriaLabel="Back to Messaging users">
                        <LucideIcon Name="arrow-left" class="h-4 w-4" />
                    </BbButton>
                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <BbTypographyH3>@_credential.DisplayName</BbTypographyH3>
                            <StatusBadge Text="@(_credential.IsOnline ? "Online" : "Offline")"
                                         Status="@(_credential.IsOnline ? "online" : "inactive")" />
                            <StatusBadge Text="@(_credential.IsEnabled ? "Enabled" : "Disabled")"
                                         Status="@(_credential.IsEnabled ? "active" : "inactive")" />
                        </div>
                        <BbTypographyMuted>@_credential.UserName - Credential @ShortId(_credential.Id)</BbTypographyMuted>
                    </div>
                </div>
                <div class="xf-page-actions">
                    @if (_credential.IdentityInfoId is Guid identityInfoId)
                    {
                        <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => Navigation.NavigateTo($"/identity/users/{identityInfoId}"))">
                            <LucideIcon Name="id-card" class="mr-2 h-4 w-4" />
                            Identity
                        </BbButton>
                    }
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@LoadData">
                        <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                        Refresh
                    </BbButton>
                </div>
            </div>

            @if (_error is not null)
            {
                <BbAlert Variant="AlertVariant.Danger">
                    <BbAlertTitle>Messaging User Query Error</BbAlertTitle>
                    <BbAlertDescription>@_error</BbAlertDescription>
                </BbAlert>
            }

            <div class="xf-summary-grid xf-summary-grid-4">
                <BbCard>
                    <BbCardHeader><BbCardTitle>Threads</BbCardTitle><BbCardDescription>Memberships</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_summary.ThreadCount</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader><BbCardTitle>Messages</BbCardTitle><BbCardDescription>Authored previews</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_summary.MessageCount</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader><BbCardTitle>Muted</BbCardTitle><BbCardDescription>Muted memberships</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_summary.MutedThreadCount</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader><BbCardTitle>Blocks</BbCardTitle><BbCardDescription>Block relationships</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_summary.BlockRelationshipCount</BbTypographyH2></BbCardContent>
                </BbCard>
            </div>

            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Identity And Presence</BbCardTitle>
                    <BbCardDescription>Read-only IdentityServer credential context for Messaging review.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <div class="xf-detail-field-grid-wide">
                        <div class="space-y-1">
                            <BbTypographyMuted>Identity</BbTypographyMuted>
                            <BbTypographyLarge>@_credential.IdentityLabel</BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Alias</BbTypographyMuted>
                            <BbTypographyLarge>@(_credential.UserAlias ?? "N/A")</BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Last Seen</BbTypographyMuted>
                            <BbTypographyLarge>@FormatDate(_credential.LastSeen)</BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Online Since</BbTypographyMuted>
                            <BbTypographyLarge>@FormatDate(_credential.OnlineSince)</BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Device</BbTypographyMuted>
                            <BbTypographyLarge>@(_credential.Device ?? "N/A")</BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Last Activity</BbTypographyMuted>
                            <BbTypographyLarge>@(_credential.LastActivityType ?? "N/A")</BbTypographyLarge>
                        </div>
                    </div>
                </BbCardContent>
            </BbCard>

            <BbTabs DefaultValue="threads">
                <BbTabsList>
                    <BbTabsTrigger Value="threads">Threads (@_threadRows.Count)</BbTabsTrigger>
                    <BbTabsTrigger Value="messages">Messages (@_messageRows.Count)</BbTabsTrigger>
                    <BbTabsTrigger Value="controls">Controls (@(_inviteRows.Count + _blockRows.Count))</BbTabsTrigger>
                </BbTabsList>

                <BbTabsContent Value="threads" Class="xf-fade-in">
                    <BbCard>
                        <BbCardHeader>
                            <BbCardTitle>Thread Memberships</BbCardTitle>
                            <BbCardDescription>Threads where this credential is currently a member.</BbCardDescription>
                        </BbCardHeader>
                        <BbCardContent>
                            @if (_threadRows.Count == 0)
                            {
                                <BbAlert Variant="AlertVariant.Info">This user does not have Messaging thread memberships.</BbAlert>
                            }
                            else
                            {
                                <BbDataGrid Items="@_threadRows" ShowPagination="true" InitialPageSize="10"
                                            OnRowClick="@((MessagingAdminUserThreadRow row) => Navigation.NavigateTo($"/messaging/threads/{row.ThreadId}"))"
                                            Class="cursor-pointer">
                                    <Columns>
                                        <BbDataGridTemplateColumn Title="Thread" Sortable="true" Filterable="true" FilterBy="@(row => row.ThreadName)">
                                            <ChildContent Context="row">
                                                <div>
                                                    <div class="font-medium">@row.ThreadName</div>
                                                    <div class="text-xs text-muted-foreground">@row.ThreadType</div>
                                                </div>
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridPropertyColumn Property="@(row => row.Role)" Title="Role" Sortable="true" Filterable="true" />
                                        <BbDataGridTemplateColumn Title="Muted" Sortable="true" Filterable="true" FilterBy="@(row => row.IsMuted)">
                                            <ChildContent Context="row">
                                                <StatusBadge Text="@(row.IsMuted ? "Muted" : "Audible")"
                                                             Status="@(row.IsMuted ? "pending" : "active")" />
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridTemplateColumn Title="Archived" Sortable="true" Filterable="true" FilterBy="@(row => row.IsArchived)">
                                            <ChildContent Context="row">
                                                <StatusBadge Text="@(row.IsArchived ? "Archived" : "Active")"
                                                             Status="@(row.IsArchived ? "inactive" : "active")" />
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridPropertyColumn Property="@(row => row.LastSeenAt)" Title="Member Seen" Sortable="true" Filterable="true" />
                                        <BbDataGridPropertyColumn Property="@(row => row.JoinedAt)" Title="Joined" Sortable="true" Filterable="true" />
                                        <BbDataGridTemplateColumn Title="Actions">
                                            <ChildContent Context="row">
                                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="View thread"
                                                          OnClick="@(() => Navigation.NavigateTo($"/messaging/threads/{row.ThreadId}"))">
                                                    <LucideIcon Name="messages-square" class="h-4 w-4" />
                                                </BbButton>
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                    </Columns>
                                </BbDataGrid>
                            }
                        </BbCardContent>
                    </BbCard>
                </BbTabsContent>

                <BbTabsContent Value="messages" Class="xf-fade-in">
                    <BbCard>
                        <BbCardHeader>
                            <BbCardTitle>Recent Authored Messages</BbCardTitle>
                            <BbCardDescription>Message text is truncated for tenant admin review.</BbCardDescription>
                        </BbCardHeader>
                        <BbCardContent>
                            @if (_messageRows.Count == 0)
                            {
                                <BbAlert Variant="AlertVariant.Info">No authored messages were found in the loaded data.</BbAlert>
                            }
                            else
                            {
                                <BbDataGrid Items="@_messageRows" ShowPagination="true" InitialPageSize="10">
                                    <Columns>
                                        <BbDataGridTemplateColumn Title="Thread" Sortable="true" Filterable="true" FilterBy="@(row => row.ThreadName)">
                                            <ChildContent Context="row">
                                                <BbButton Variant="ButtonVariant.Ghost" OnClick="@(() => Navigation.NavigateTo($"/messaging/threads/{row.ThreadId}"))">
                                                    @row.ThreadName
                                                </BbButton>
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridPropertyColumn Property="@(row => row.Preview)" Title="Message" Sortable="true" Filterable="true" />
                                        <BbDataGridTemplateColumn Title="Reply" Sortable="true" Filterable="true" FilterBy="@(row => row.HasParent)">
                                            <ChildContent Context="row">
                                                <StatusBadge Text="@(row.HasParent ? "Reply" : "Root")"
                                                             Status="@(row.HasParent ? "pending" : "active")" />
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridPropertyColumn Property="@(row => row.MentionCount)" Title="Mentions" Sortable="true" Filterable="true" />
                                        <BbDataGridPropertyColumn Property="@(row => row.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
                                    </Columns>
                                </BbDataGrid>
                            }
                        </BbCardContent>
                    </BbCard>
                </BbTabsContent>

                <BbTabsContent Value="controls" Class="xf-fade-in">
                    <div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
                        <BbCard>
                            <BbCardHeader>
                                <BbCardTitle>Invites</BbCardTitle>
                                <BbCardDescription>Thread invites involving this user.</BbCardDescription>
                            </BbCardHeader>
                            <BbCardContent>
                                @if (_inviteRows.Count == 0)
                                {
                                    <BbAlert Variant="AlertVariant.Info">No invites found for this user.</BbAlert>
                                }
                                else
                                {
                                    <BbDataGrid Items="@_inviteRows" ShowPagination="true" InitialPageSize="10">
                                        <Columns>
                                            <BbDataGridPropertyColumn Property="@(row => row.ThreadName)" Title="Thread" Sortable="true" Filterable="true" />
                                            <BbDataGridTemplateColumn Title="Status" Sortable="true" Filterable="true" FilterBy="@(row => row.StatusText)">
                                                <ChildContent Context="row">
                                                    <StatusBadge Text="@row.StatusText" Status="@row.StatusKey" />
                                                </ChildContent>
                                            </BbDataGridTemplateColumn>
                                            <BbDataGridPropertyColumn Property="@(row => row.InvitedBy)" Title="Invited By" Sortable="true" Filterable="true" />
                                            <BbDataGridPropertyColumn Property="@(row => row.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
                                        </Columns>
                                    </BbDataGrid>
                                }
                            </BbCardContent>
                        </BbCard>

                        <BbCard>
                            <BbCardHeader>
                                <BbCardTitle>Blocks</BbCardTitle>
                                <BbCardDescription>1:1 DM block relationships involving this user.</BbCardDescription>
                            </BbCardHeader>
                            <BbCardContent>
                                @if (_blockRows.Count == 0)
                                {
                                    <BbAlert Variant="AlertVariant.Info">No block relationships found for this user.</BbAlert>
                                }
                                else
                                {
                                    <BbDataGrid Items="@_blockRows" ShowPagination="true" InitialPageSize="10">
                                        <Columns>
                                            <BbDataGridPropertyColumn Property="@(row => row.Direction)" Title="Direction" Sortable="true" Filterable="true" />
                                            <BbDataGridPropertyColumn Property="@(row => row.OtherCredential)" Title="Other User" Sortable="true" Filterable="true" />
                                            <BbDataGridTemplateColumn Title="Status" Sortable="true" Filterable="true" FilterBy="@(row => row.IsEnabled)">
                                                <ChildContent Context="row">
                                                    <StatusBadge Text="@(row.IsEnabled ? "Active" : "Inactive")"
                                                                 Status="@(row.IsEnabled ? "active" : "inactive")" />
                                                </ChildContent>
                                            </BbDataGridTemplateColumn>
                                            <BbDataGridPropertyColumn Property="@(row => row.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
                                        </Columns>
                                    </BbDataGrid>
                                }
                            </BbCardContent>
                        </BbCard>
                    </div>
                </BbTabsContent>
            </BbTabs>
        </div>
    </FadeInContent>
}

@code {
    [Parameter] public Guid CredentialId { get; set; }

    [Inject] private MessagingControlPanelGuard Guard { get; set; } = default!;
    [Inject] private MessagingControlPanelReadService ReadService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    private MessagingControlPanelGuardResult? _guard;
    private MessagingAdminCredentialContext? _credential;
    private MessagingAdminUserDetailSummary _summary = new();
    private List<MessagingAdminUserThreadRow> _threadRows = [];
    private List<MessagingAdminUserMessageRow> _messageRows = [];
    private List<MessagingAdminUserInviteRow> _inviteRows = [];
    private List<MessagingAdminUserBlockRow> _blockRows = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        TenantFilter.OnChanged += OnTenantFilterChanged;
        await LoadData();
    }

    private void OnTenantFilterChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    private async Task LoadData()
    {
        _loading = true;
        _error = null;
        _credential = null;
        _summary = new();
        _threadRows = [];
        _messageRows = [];
        _inviteRows = [];
        _blockRows = [];

        try
        {
            _guard = await Guard.GetCurrentTenantStateAsync();
            if (!_guard.IsEnabled || _guard.TenantId is not Guid tenantId)
            {
                return;
            }

            var detail = await ReadService.GetUserDetailAsync(tenantId, CredentialId);
            if (detail is null)
            {
                return;
            }

            _credential = detail.Credential;
            _summary = detail.Summary;
            _threadRows = detail.Threads;
            _messageRows = detail.Messages;
            _inviteRows = detail.Invites;
            _blockRows = detail.Blocks;
        }
        catch
        {
            _error = "Messaging user detail could not be loaded. Check service health and tenant access.";
            ToastService.Error("Messaging user detail could not be loaded.", "User Detail Unavailable");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatDate(DateTime? value) =>
        value is null || value == default ? "N/A" : value.Value.ToString("g");

    private static string ShortId(Guid value) => value.ToString()[..8];

    private void GoBack() => Navigation.NavigateTo("/messaging/users");

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantFilterChanged;
    }
}
