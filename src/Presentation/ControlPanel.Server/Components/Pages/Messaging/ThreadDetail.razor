@page "/messaging/threads/{Id:guid}"
@using XFramework.Domain.Shared.DataContext
@implements IDisposable

<PageTitle>Messaging Thread Detail - Control Panel</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (_guard is { IsEnabled: false })
{
    <div class="space-y-4">
        <BbButton Variant="ButtonVariant.Ghost" OnClick="@GoBack">
            <LucideIcon Name="arrow-left" class="mr-2 h-4 w-4" />
            Back to Threads
        </BbButton>
        <BbAlert Variant="@(_guard.HasSelectedTenant ? AlertVariant.Warning : AlertVariant.Info)">
            <BbAlertTitle>@_guard.Title</BbAlertTitle>
            <BbAlertDescription>@_guard.Description</BbAlertDescription>
        </BbAlert>
    </div>
}
else if (_thread is null)
{
    <div class="space-y-4">
        <BbButton Variant="ButtonVariant.Ghost" OnClick="@GoBack">
            <LucideIcon Name="arrow-left" class="mr-2 h-4 w-4" />
            Back to Threads
        </BbButton>
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertTitle>Thread Not Found</BbAlertTitle>
            <BbAlertDescription>No messaging thread was found with the specified ID for the selected tenant.</BbAlertDescription>
        </BbAlert>
    </div>
}
else if (_outsideTenantContext)
{
    <div class="space-y-4">
        <BbButton Variant="ButtonVariant.Ghost" OnClick="@GoBack">
            <LucideIcon Name="arrow-left" class="mr-2 h-4 w-4" />
            Back to Threads
        </BbButton>
        <BbAlert>
            <BbAlertTitle>Thread Outside Active Tenant</BbAlertTitle>
            <BbAlertDescription>Switch to the thread's tenant to view this record.</BbAlertDescription>
        </BbAlert>
    </div>
}
else
{
    <FadeInContent>
        <div class="space-y-6">
            <div class="xf-page-header">
                <div class="flex items-start gap-3">
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Back to threads" OnClick="@GoBack">
                        <LucideIcon Name="arrow-left" class="h-4 w-4" />
                    </BbButton>
                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <BbTypographyH3>@DisplayThreadName(_thread)</BbTypographyH3>
                            <StatusBadge Text="@(_thread.IsEnabled ? "Enabled" : "Disabled")"
                                         Status="@(_thread.IsEnabled ? "active" : "inactive")" />
                        </div>
                        <BbTypographyMuted>ID: @ShortId(_thread.Id) - Type: @(_thread.Type?.Name ?? "N/A")</BbTypographyMuted>
                    </div>
                </div>
                <div class="xf-page-actions">
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => Navigation.NavigateTo("/messaging/operations"))">
                        <LucideIcon Name="radio-tower" class="mr-2 h-4 w-4" />
                        Operations
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => Navigation.NavigateTo("/messaging/moderation"))">
                        <LucideIcon Name="shield-alert" class="mr-2 h-4 w-4" />
                        Moderation
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@LoadData">
                        <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                        Refresh
                    </BbButton>
                </div>
            </div>

            @if (_error is not null)
            {
                <BbAlert Variant="AlertVariant.Danger">
                    <BbAlertTitle>Messaging Query Error</BbAlertTitle>
                    <BbAlertDescription>@_error</BbAlertDescription>
                </BbAlert>
            }

            <div class="xf-summary-grid xf-summary-grid-4">
                <BbCard>
                    <BbCardHeader><BbCardTitle>Members</BbCardTitle><BbCardDescription>Active memberships</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_members.Count</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader><BbCardTitle>Messages</BbCardTitle><BbCardDescription>Loaded recent messages</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_messages.Count</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader><BbCardTitle>Muted</BbCardTitle><BbCardDescription>Muted memberships</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_members.Count(x => x.IsMuted)</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader><BbCardTitle>Archived</BbCardTitle><BbCardDescription>Archived memberships</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_members.Count(x => x.IsArchived)</BbTypographyH2></BbCardContent>
                </BbCard>
            </div>

            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Thread Context</BbCardTitle>
                    <BbCardDescription>@(string.IsNullOrWhiteSpace(_thread.Description) ? "No description" : _thread.Description)</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <div class="xf-detail-field-grid-wide">
                        <div class="space-y-1">
                            <BbTypographyMuted>Name</BbTypographyMuted>
                            <BbTypographyLarge>@DisplayThreadName(_thread)</BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Type</BbTypographyMuted>
                            <BbTypographyLarge>@(_thread.Type?.Name ?? _thread.TypeId.ToString()[..8])</BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Created</BbTypographyMuted>
                            <BbTypographyLarge>@_thread.CreatedAt.ToString("g")</BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Modified</BbTypographyMuted>
                            <BbTypographyLarge>@(_thread.ModifiedAt?.ToString("g") ?? "N/A")</BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Last Message</BbTypographyMuted>
                            <BbTypographyLarge>@(_messages.FirstOrDefault()?.CreatedAt.ToString("g") ?? "No loaded messages")</BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Tenant</BbTypographyMuted>
                            <BbTypographyLarge>@(_guard?.TenantName ?? _thread.TenantId.ToString()[..8])</BbTypographyLarge>
                        </div>
                    </div>
                </BbCardContent>
            </BbCard>

            <BbTabs DefaultValue="members">
                <BbTabsList>
                    <BbTabsTrigger Value="members">Members (@_memberRows.Count)</BbTabsTrigger>
                    <BbTabsTrigger Value="messages">Messages (@_messageRows.Count)</BbTabsTrigger>
                </BbTabsList>

                <BbTabsContent Value="members" Class="xf-fade-in">
                    <BbCard>
                        <BbCardHeader>
                            <BbCardTitle>Thread Members</BbCardTitle>
                            <BbCardDescription>Review users linked to this thread.</BbCardDescription>
                        </BbCardHeader>
                        <BbCardContent>
                            @if (_memberRows.Count == 0)
                            {
                                <BbAlert Variant="AlertVariant.Info">No members found for this thread.</BbAlert>
                            }
                            else
                            {
                                <BbDataGrid Items="@_memberRows" ShowPagination="true" InitialPageSize="20"
                                            OnRowClick="@((ThreadMemberRow row) => Navigation.NavigateTo($"/messaging/users/{row.CredentialId}"))"
                                            Class="cursor-pointer">
                                    <Columns>
                                        <BbDataGridTemplateColumn Title="User" Sortable="true" Filterable="true" FilterBy="@(row => row.DisplayName)">
                                            <ChildContent Context="row">
                                                <div>
                                                    <div class="font-medium">@row.DisplayName</div>
                                                    <div class="text-xs text-muted-foreground">@ShortId(row.CredentialId)</div>
                                                </div>
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridPropertyColumn Property="@(row => row.Alias)" Title="Alias" Sortable="true" Filterable="true" />
                                        <BbDataGridPropertyColumn Property="@(row => row.Group)" Title="Group" Sortable="true" Filterable="true" />
                                        <BbDataGridPropertyColumn Property="@(row => row.Role)" Title="Role" Sortable="true" Filterable="true" />
                                        <BbDataGridTemplateColumn Title="Muted" Sortable="true" Filterable="true" FilterBy="@(row => row.IsMuted)">
                                            <ChildContent Context="row">
                                                <StatusBadge Text="@(row.IsMuted ? "Muted" : "Audible")"
                                                             Status="@(row.IsMuted ? "pending" : "active")" />
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridTemplateColumn Title="Archived" Sortable="true" Filterable="true" FilterBy="@(row => row.IsArchived)">
                                            <ChildContent Context="row">
                                                <StatusBadge Text="@(row.IsArchived ? "Archived" : "Active")"
                                                             Status="@(row.IsArchived ? "inactive" : "active")" />
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridPropertyColumn Property="@(row => row.LastSeenAt)" Title="Last Seen" Sortable="true" Filterable="true" />
                                        <BbDataGridPropertyColumn Property="@(row => row.CreatedAt)" Title="Joined" Sortable="true" Filterable="true" />
                                        <BbDataGridTemplateColumn Title="Actions">
                                            <ChildContent Context="row">
                                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="View Messaging user"
                                                          OnClick="@(() => Navigation.NavigateTo($"/messaging/users/{row.CredentialId}"))">
                                                    <LucideIcon Name="user" class="h-4 w-4" />
                                                </BbButton>
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                    </Columns>
                                </BbDataGrid>
                            }
                        </BbCardContent>
                    </BbCard>
                </BbTabsContent>

                <BbTabsContent Value="messages" Class="xf-fade-in">
                    <BbCard>
                        <BbCardHeader>
                            <BbCardTitle>Recent Messages</BbCardTitle>
                            <BbCardDescription>Latest loaded messages for this thread, scoped to this tenant.</BbCardDescription>
                        </BbCardHeader>
                        <BbCardContent>
                            @if (_messageRows.Count == 0)
                            {
                                <BbAlert Variant="AlertVariant.Info">No messages found for this thread.</BbAlert>
                            }
                            else
                            {
                                <BbDataGrid Items="@_messageRows" ShowPagination="true" InitialPageSize="20">
                                    <Columns>
                                        <BbDataGridTemplateColumn Title="Message" Sortable="true" Filterable="true" FilterBy="@(row => row.Preview)">
                                            <ChildContent Context="row">
                                                <div>
                                                    <div>@row.Preview</div>
                                                    <div class="mt-1 font-mono text-xs text-muted-foreground">@ShortId(row.MessageId)</div>
                                                </div>
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridTemplateColumn Title="Author" Sortable="true" Filterable="true" FilterBy="@(row => row.Author)">
                                            <ChildContent Context="row">
                                                <BbButton Variant="ButtonVariant.Ghost" OnClick="@(() => Navigation.NavigateTo($"/messaging/users/{row.CredentialId}"))">
                                                    @row.Author
                                                </BbButton>
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridTemplateColumn Title="Reply" Sortable="true" Filterable="true" FilterBy="@(row => row.IsReply)">
                                            <ChildContent Context="row">
                                                <StatusBadge Text="@(row.IsReply ? "Reply" : "Root")"
                                                             Status="@(row.IsReply ? "pending" : "active")" />
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridPropertyColumn Property="@(row => row.MentionCount)" Title="Mentions" Sortable="true" Filterable="true" />
                                        <BbDataGridPropertyColumn Property="@(row => row.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
                                    </Columns>
                                </BbDataGrid>
                            }
                        </BbCardContent>
                    </BbCard>
                </BbTabsContent>
            </BbTabs>
        </div>
    </FadeInContent>
}

@code {
    [Parameter] public Guid Id { get; set; }

    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private MessagingControlPanelGuard Guard { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    private MessagingControlPanelGuardResult? _guard;
    private MessageThread? _thread;
    private List<MessageThreadMember> _members = [];
    private List<Message> _messages = [];
    private List<ThreadMemberRow> _memberRows = [];
    private List<ThreadMessageRow> _messageRows = [];
    private bool _loading = true;
    private bool _outsideTenantContext;
    private string? _error;
    private Guid? _loadedId;

    protected override async Task OnInitializedAsync()
    {
        TenantFilter.OnChanged += OnTenantFilterChanged;
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadData();
    }

    private void OnTenantFilterChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    private async Task LoadData()
    {
        _loading = true;
        _error = null;
        _outsideTenantContext = false;
        _thread = null;
        _members = [];
        _messages = [];
        _memberRows = [];
        _messageRows = [];

        try
        {
            _guard = await Guard.GetCurrentTenantStateAsync();
            if (!_guard.IsEnabled || _guard.TenantId is not Guid tenantId)
            {
                return;
            }

            _thread = await DataContext.Query<MessageThread>()
                .IgnoreQueryFilters()
                .NoCache()
                .Include(x => x.Type)
                .Where(x => x.Id == Id)
                .FirstOrDefaultAsync();

            _outsideTenantContext = _thread is not null && _thread.TenantId != tenantId;
            if (_thread is null || _outsideTenantContext)
            {
                return;
            }

            _members = await DataContext.Query<MessageThreadMember>()
                .IgnoreQueryFilters()
                .NoCache()
                .Include(x => x.Credential)
                .Include(x => x.Group)
                .Where(x => x.TenantId == tenantId)
                .Where(x => x.MessageThreadId == Id)
                .Where(x => !x.IsDeleted)
                .OrderBy(x => x.CreatedAt)
                .Take(200)
                .ToListAsync();

            _messages = await DataContext.Query<Message>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId)
                .Where(x => x.MessageThreadId == Id)
                .Where(x => !x.IsDeleted)
                .OrderByDescending(x => x.CreatedAt)
                .Take(100)
                .ToListAsync();

            var memberMap = _members.ToDictionary(x => x.Id);
            _memberRows = _members.Select(CreateMemberRow).ToList();
            _messageRows = _messages
                .Select(message => CreateMessageRow(message, memberMap.GetValueOrDefault(message.MessageThreadMemberId)))
                .ToList();
        }
        catch
        {
            _error = "Messaging thread detail could not be loaded. Check service health and tenant access.";
            ToastService.Error("Messaging thread detail could not be loaded.", "Thread Unavailable");
        }
        finally
        {
            _loading = false;
        }
    }

    private ThreadMemberRow CreateMemberRow(MessageThreadMember member) =>
        new(
            member.Id,
            member.CredentialId,
            GetCredentialLabel(member.Credential),
            string.IsNullOrWhiteSpace(member.Alias) ? "N/A" : member.Alias,
            member.Group is not null && !string.IsNullOrWhiteSpace(member.Group.Alias) ? member.Group.Alias : member.GroupId.ToString()[..8],
            string.IsNullOrWhiteSpace(member.Role) ? MessageThreadMemberRoles.Member : member.Role,
            member.IsMuted,
            member.IsArchived,
            member.LastSeenAt,
            member.CreatedAt);

    private ThreadMessageRow CreateMessageRow(Message message, MessageThreadMember? member) =>
        new(
            message.Id,
            message.MessageThreadMemberId,
            member?.CredentialId ?? Guid.Empty,
            member is null ? message.MessageThreadMemberId.ToString()[..8] : GetMemberLabel(member),
            Truncate(message.Text, 160),
            message.ParentMessageId.HasValue,
            CountMentions(message.MentionedCredentialIdsJson),
            message.CreatedAt);

    private static string DisplayThreadName(MessageThread thread) =>
        string.IsNullOrWhiteSpace(thread.Name) ? ShortId(thread.Id) : thread.Name;

    private static string GetMemberLabel(MessageThreadMember member)
    {
        if (!string.IsNullOrWhiteSpace(member.Alias))
        {
            return member.Alias;
        }

        return GetCredentialLabel(member.Credential);
    }

    private static string GetCredentialLabel(IdentityCredential? credential)
    {
        if (credential is null)
        {
            return "Unknown credential";
        }

        return credential.UserName
            ?? credential.UserAlias
            ?? credential.Id.ToString()[..8];
    }

    private static int CountMentions(string? mentionedCredentialIdsJson)
    {
        if (string.IsNullOrWhiteSpace(mentionedCredentialIdsJson))
        {
            return 0;
        }

        try
        {
            return JsonSerializer.Deserialize<List<Guid>>(mentionedCredentialIdsJson)?.Count ?? 0;
        }
        catch
        {
            return 0;
        }
    }

    private static string Truncate(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "N/A";
        }

        return value.Length <= maxLength ? value : $"{value[..maxLength]}...";
    }

    private static string ShortId(Guid value) => value.ToString()[..8];

    private void GoBack() => Navigation.NavigateTo("/messaging/threads");

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantFilterChanged;
    }

    private sealed record ThreadMemberRow(
        Guid MemberId,
        Guid CredentialId,
        string DisplayName,
        string Alias,
        string Group,
        string Role,
        bool IsMuted,
        bool IsArchived,
        DateTime? LastSeenAt,
        DateTime CreatedAt);

    private sealed record ThreadMessageRow(
        Guid MessageId,
        Guid MemberId,
        Guid CredentialId,
        string Author,
        string Preview,
        bool IsReply,
        int MentionCount,
        DateTime CreatedAt);
}
