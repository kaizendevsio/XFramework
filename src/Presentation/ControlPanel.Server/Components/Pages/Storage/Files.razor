@page "/storage/files"

<PageTitle>File Storage - Control Panel</PageTitle>

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <BbTypography Variant="TypographyVariant.H3">File Storage</BbTypography>
    </div>

    <BbCard>
        <BbCardHeader>
            <BbCardTitle>File Management</BbCardTitle>
            <BbCardDescription>Browse, upload, and manage stored files.</BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            <BbTypography Variant="TypographyVariant.Muted">
                File management is coming soon. This feature will allow you to browse, upload, and manage files stored in the system.
            </BbTypography>
        </BbCardContent>
    </BbCard>
</div>
