@page "/finance/deposit-requests"
@using System.Globalization
@using XFramework.Domain.Shared.Contracts
@using XFramework.Domain.Shared.DataContext
@implements IDisposable

<PageTitle>Deposit Requests - Control Panel</PageTitle>

<div class="space-y-4">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
            <BbTypographyH3>Deposit Requests</BbTypographyH3>
            <BbTypographyMuted>Inspect deposit requests and hand off approvals to the Wallets workflow.</BbTypographyMuted>
        </div>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@LoadData">
            <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
            Refresh
        </BbButton>
    </div>

    @if (_loading)
    {
        <CenteredSpinner />
    }
    else if (!_hasTenant)
    {
        <ModuleUnavailable ModuleName="Wallets" RequiresTenant="true" />
    }
    else if (!_moduleEnabled)
    {
        <ModuleUnavailable ModuleName="Wallets" />
    }
    else
    {
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Create Deposit Request</BbCardTitle>
                <BbCardDescription>Submit cash-in requests through the Wallets deposit workflow.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                    <BbFormFieldCombobox TValue="string"
                                          @bind-Value="_createCredentialId"
                                          Options="@_credentialOptions"
                                          Label="Credential"
                                          Placeholder="Select credential"
                                          SearchPlaceholder="Search users or credentials..."
                                          EmptyMessage="No credentials found."
                                          MatchTriggerWidth="true"
                                          Required="true" />
                    <BbFormFieldSelect TValue="string" @bind-Value="_createWalletId" Label="Existing Wallet">
                        <BbSelectItem Value="@NoSelectionValue">Create or resolve by wallet type</BbSelectItem>
                        @foreach (var wallet in _wallets)
                        {
                            <BbSelectItem Value="@wallet.Id.ToString()">@BuildWalletLabel(wallet)</BbSelectItem>
                        }
                    </BbFormFieldSelect>
                    <BbFormFieldSelect TValue="string" @bind-Value="_createWalletTypeId" Label="Wallet Type">
                        <BbSelectItem Value="@NoSelectionValue">Use selected wallet</BbSelectItem>
                        @foreach (var walletType in _walletTypes)
                        {
                            <BbSelectItem Value="@walletType.Id.ToString()">@(walletType.Name) (@walletType.Code)</BbSelectItem>
                        }
                    </BbFormFieldSelect>
                    <BbFormFieldSelect TValue="string" @bind-Value="_createCurrencyId" Label="Currency">
                        <BbSelectItem Value="@NoSelectionValue">Default wallet currency</BbSelectItem>
                        @foreach (var currency in _currencies)
                        {
                            <BbSelectItem Value="@currency.Id.ToString()">@BuildCurrencyLabel(currency)</BbSelectItem>
                        }
                    </BbFormFieldSelect>
                    <BbFormFieldSelect TValue="string" @bind-Value="_createGatewayId" Label="Gateway">
                        <BbSelectItem Value="@NoSelectionValue">Select gateway</BbSelectItem>
                        @foreach (var gateway in _gateways)
                        {
                            <BbSelectItem Value="@gateway.Id.ToString()">@BuildGatewayLabel(gateway)</BbSelectItem>
                        }
                    </BbFormFieldSelect>
                    <BbFormFieldInput TValue="decimal" @bind-Value="_createAmount" Label="Amount" />
                    <BbFormFieldInput TValue="decimal" @bind-Value="_createRequestedFee" Label="Requested Fee" />
                    <BbFormFieldInput TValue="string" @bind-Value="_createExternalReference" Label="External Reference" Placeholder="Optional provider/reference id" />
                    <BbFormFieldInput TValue="string" @bind-Value="_createAddress" Label="Address" Placeholder="Optional source address" />
                    <BbFormFieldInput TValue="string" @bind-Value="_createRemarks" Label="Remarks" Placeholder="Cash-in note" />
                </div>
                <div class="mt-4">
                    <BbButton OnClick="@CreateDeposit" Disabled="@_acting">
                        @if (_acting)
                        {
                            <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                        }
                        <LucideIcon Name="circle-plus" class="mr-2 h-4 w-4" />
                        Create Deposit
                    </BbButton>
                </div>
            </BbCardContent>
        </BbCard>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
            <BbCard>
                <BbCardContent>
                    <div class="space-y-1 pt-4">
                        <BbTypographyMuted>Pending</BbTypographyMuted>
                        <BbTypographyH3>@_pendingCount</BbTypographyH3>
                    </div>
                </BbCardContent>
            </BbCard>
            <BbCard>
                <BbCardContent>
                    <div class="space-y-1 pt-4">
                        <BbTypographyMuted>Approved</BbTypographyMuted>
                        <BbTypographyH3>@_approvedCount</BbTypographyH3>
                    </div>
                </BbCardContent>
            </BbCard>
            <BbCard>
                <BbCardContent>
                    <div class="space-y-1 pt-4">
                        <BbTypographyMuted>Rejected</BbTypographyMuted>
                        <BbTypographyH3>@_rejectedCount</BbTypographyH3>
                    </div>
                </BbCardContent>
            </BbCard>
            <BbCard>
                <BbCardContent>
                    <div class="space-y-1 pt-4">
                        <BbTypographyMuted>Total Amount</BbTypographyMuted>
                        <BbTypographyH3>@_totalAmount.ToString("N2")</BbTypographyH3>
                    </div>
                </BbCardContent>
            </BbCard>
        </div>

        <BbDataGrid Items="@_items" ShowPagination="true" InitialPageSize="20">
            <Columns>
                <BbDataGridTemplateColumn Title="Credential">
                    <ChildContent Context="item">
                        <span class="font-mono text-xs">@ShortId(item.CredentialId)</span>
                    </ChildContent>
                </BbDataGridTemplateColumn>
                <BbDataGridPropertyColumn Property="@(x => x.Amount)" Title="Amount" Sortable="true" />
                <BbDataGridPropertyColumn Property="@(x => x.ConvenienceFee)" Title="Convenience Fee" Sortable="true" />
                <BbDataGridPropertyColumn Property="@(x => x.SystemFee)" Title="System Fee" Sortable="true" />
                <BbDataGridTemplateColumn Title="Workflow">
                    <ChildContent Context="item">
                        <StatusBadge Text="@item.WorkflowStatus.ToString()" Status="@GetWorkflowStatusCategory(item.WorkflowStatus)" />
                    </ChildContent>
                </BbDataGridTemplateColumn>
                <BbDataGridTemplateColumn Title="Status">
                    <ChildContent Context="item">
                        <StatusBadge Text="@GetDepositStatusText(item.DepositStatus)" Status="@GetDepositStatusCategory(item.DepositStatus)" />
                    </ChildContent>
                </BbDataGridTemplateColumn>
                <BbDataGridPropertyColumn Property="@(x => x.ReferenceNo)" Title="Reference No" Sortable="true" />
                <BbDataGridPropertyColumn Property="@(x => x.Address)" Title="Address" />
                <BbDataGridPropertyColumn Property="@(x => x.ExpiryDate)" Title="Expiry Date" Sortable="true" />
                <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" />
                <BbDataGridTemplateColumn Title="Actions">
                    <ChildContent Context="item">
                        <div class="flex flex-wrap gap-1">
                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => ApproveDeposit(item))" Disabled="@_acting">
                                Approve
                            </BbButton>
                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Destructive" OnClick="@(() => RejectDeposit(item))" Disabled="@_acting">
                                Reject
                            </BbButton>
                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => SettleDeposit(item))" Disabled="@_acting">
                                Settle
                            </BbButton>
                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => FailDeposit(item))" Disabled="@_acting">
                                Fail
                            </BbButton>
                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => CancelDeposit(item))" Disabled="@_acting">
                                Cancel
                            </BbButton>
                        </div>
                    </ChildContent>
                </BbDataGridTemplateColumn>
            </Columns>
        </BbDataGrid>
    }
</div>

@code {
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private TenantModuleNavigationService ModuleNavigation { get; set; } = default!;
    [Inject] private WalletsAdminBackendContractService WalletsAdminContracts { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    private const string NoSelectionValue = "__none";

    private List<DepositRequest> _items = [];
    private List<Wallet> _wallets = [];
    private List<global::Wallets.Domain.Shared.Contracts.WalletType> _walletTypes = [];
    private List<global::Wallets.Domain.Shared.Contracts.CurrencyType> _currencies = [];
    private List<PaymentGateway> _gateways = [];
    private List<SelectOption<string>> _credentialOptions = [];
    private Dictionary<Guid, string> _credentialLabels = [];
    private bool _loading = true;
    private bool _acting;
    private bool _hasTenant;
    private bool _moduleEnabled;
    private int _pendingCount;
    private int _approvedCount;
    private int _rejectedCount;
    private decimal _totalAmount;
    private string _createCredentialId = "";
    private string _createWalletId = NoSelectionValue;
    private string _createWalletTypeId = NoSelectionValue;
    private string _createCurrencyId = NoSelectionValue;
    private string _createGatewayId = NoSelectionValue;
    private string _createExternalReference = "";
    private string _createAddress = "";
    private string _createRemarks = "";
    private decimal _createAmount;
    private decimal _createRequestedFee;

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        ModuleNavigation.OnChanged += OnTenantChanged;
    }

    protected override async Task OnInitializedAsync() => await LoadData();

    private void OnTenantChanged() => _ = InvokeAsync(LoadData);

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _moduleEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.WalletsDeposits);
            _items = [];
            ResetCreateOptions();
            ResetSummary();

            if (!_hasTenant || !_moduleEnabled)
            {
                return;
            }

            var tenantId = TenantFilter.SelectedTenantId!.Value;
            _items = await DataContext.Query<DepositRequest>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                .OrderByDescending(x => x.CreatedAt)
                .Take(200)
                .ToListAsync();

            await LoadCreateOptions(tenantId);

            _pendingCount = _items.Count(x => x.DepositStatus == 0);
            _approvedCount = _items.Count(x => x.DepositStatus == 1);
            _rejectedCount = _items.Count(x => x.DepositStatus == 2);
            _totalAmount = _items.Sum(x => x.Amount ?? 0);
        }
        catch (Exception ex)
        {
            _items = [];
            ResetCreateOptions();
            ResetSummary();
            ToastService.Show($"Failed to load deposit requests: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCreateOptions(Guid tenantId)
    {
        var credentials = (await DataContext.Query<IdentityCredential>()
                .IgnoreQueryFilters()
                .NoCache()
                .Include(x => x.IdentityInfo)
                .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                .Take(250)
                .ToListAsync())
            .OrderBy(GetCredentialSortText)
            .ToList();

        _credentialOptions = credentials
            .Select(x => new SelectOption<string>(x.Id.ToString(), BuildCredentialLabel(x)))
            .ToList();
        _credentialLabels = credentials.ToDictionary(x => x.Id, BuildCredentialLabel);

        _wallets = await DataContext.Query<Wallet>()
            .IgnoreQueryFilters()
            .NoCache()
            .Include(x => x.WalletType)
            .Where(x => x.TenantId == tenantId && !x.IsDeleted)
            .OrderBy(x => x.AccountNumber)
            .Take(250)
            .ToListAsync();
        _wallets = _wallets
            .Where(x => x.Status != WalletStatus.Closed)
            .ToList();

        _walletTypes = await DataContext.Query<global::Wallets.Domain.Shared.Contracts.WalletType>()
            .IgnoreQueryFilters()
            .NoCache()
            .Where(x => x.TenantId == tenantId && !x.IsDeleted)
            .OrderBy(x => x.Name)
            .Take(100)
            .ToListAsync();

        _currencies = await DataContext.Query<global::Wallets.Domain.Shared.Contracts.CurrencyType>()
            .IgnoreQueryFilters()
            .NoCache()
            .Where(x => !x.IsDeleted)
            .OrderBy(x => x.CurrencyIsoCode3)
            .Take(100)
            .ToListAsync();
        _currencies = _currencies
            .Where(x => x.TenantId == tenantId || x.TenantId == Guid.Empty)
            .ToList();

        await LoadPaymentGateways(tenantId);
    }

    private async Task LoadPaymentGateways(Guid tenantId)
    {
        try
        {
            _gateways = await DataContext.Query<PaymentGateway>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => !x.IsDeleted)
                .OrderBy(x => x.Name)
                .Take(100)
                .ToListAsync();
            _gateways = _gateways
                .Where(x => x.TenantId == tenantId || x.TenantId == Guid.Empty)
                .ToList();
        }
        catch (InvalidOperationException ex) when (IsMissingPaymentGatewayWrapper(ex))
        {
            _gateways = [];
        }
    }

    private async Task CreateDeposit()
    {
        if (_createAmount <= 0)
        {
            ToastService.Show("Enter a deposit amount greater than zero.");
            return;
        }

        if (_createRequestedFee < 0)
        {
            ToastService.Show("Requested fee cannot be negative.");
            return;
        }

        if (!Guid.TryParse(_createGatewayId, out var gatewayId))
        {
            ToastService.Show("Select a payment gateway.");
            return;
        }

        var wallet = Guid.TryParse(_createWalletId, out var parsedWalletId)
            ? _wallets.FirstOrDefault(x => x.Id == parsedWalletId)
            : null;
        var credentialText = _createCredentialId;
        if (wallet is not null && string.IsNullOrWhiteSpace(credentialText))
        {
            credentialText = wallet.CredentialId.ToString();
            _createCredentialId = credentialText;
        }

        if (!Guid.TryParse(credentialText, out var credentialId))
        {
            ToastService.Show("Select a credential for the deposit request.");
            return;
        }

        if (wallet is not null && wallet.CredentialId != credentialId)
        {
            ToastService.Show("Selected wallet does not belong to the selected credential.");
            return;
        }

        var walletId = wallet?.Id;
        var walletTypeId = Guid.TryParse(_createWalletTypeId, out var parsedWalletTypeId)
            ? parsedWalletTypeId
            : wallet?.WalletTypeId;
        if (!walletId.HasValue && !walletTypeId.HasValue)
        {
            ToastService.Show("Select an existing wallet or wallet type.");
            return;
        }

        var currencyId = Guid.TryParse(_createCurrencyId, out var parsedCurrencyId)
            ? parsedCurrencyId
            : (Guid?)null;

        _acting = true;
        try
        {
            var result = await WalletsAdminContracts.CreateDepositAsync(new CreateDepositWorkflowRequest
            {
                CredentialId = credentialId,
                WalletId = walletId,
                WalletTypeId = walletTypeId,
                CurrencyId = currencyId,
                GatewayId = gatewayId,
                Amount = _createAmount,
                RequestedFee = PositiveOrNull(_createRequestedFee),
                Address = string.IsNullOrWhiteSpace(_createAddress) ? null : _createAddress.Trim(),
                Remarks = string.IsNullOrWhiteSpace(_createRemarks) ? null : _createRemarks.Trim(),
                ExternalReference = string.IsNullOrWhiteSpace(_createExternalReference) ? null : _createExternalReference.Trim(),
                IdempotencyKey = $"control-panel-deposit:{Guid.NewGuid():N}"
            });

            ToastService.Show(result.IsSuccess ? "Deposit request created." : result.Message ?? "Deposit request creation failed.");
            if (result.IsSuccess)
            {
                ResetCreateForm();
                await LoadData();
            }
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task ApproveDeposit(DepositRequest item) =>
        await RunUnsupportedAction(() => WalletsAdminContracts.ApproveDepositAsync(item.Id), "Deposit approval");

    private async Task RejectDeposit(DepositRequest item) =>
        await RunUnsupportedAction(() => WalletsAdminContracts.RejectDepositAsync(item.Id), "Deposit rejection");

    private async Task SettleDeposit(DepositRequest item) =>
        await RunUnsupportedAction(() => WalletsAdminContracts.SettleDepositAsync(item.Id), "Deposit settlement");

    private async Task FailDeposit(DepositRequest item) =>
        await RunUnsupportedAction(() => WalletsAdminContracts.FailDepositAsync(item.Id), "Deposit failure");

    private async Task CancelDeposit(DepositRequest item) =>
        await RunUnsupportedAction(() => WalletsAdminContracts.CancelDepositAsync(item.Id), "Deposit cancellation");

    private async Task RunUnsupportedAction(Func<Task<CmdResponse>> action, string label)
    {
        _acting = true;
        try
        {
            var result = await action();
            ToastService.Show(result.IsSuccess ? $"{label} submitted." : result.Message ?? $"{label} is not available.");
            await LoadData();
        }
        finally
        {
            _acting = false;
        }
    }

    private void ResetSummary()
    {
        _pendingCount = 0;
        _approvedCount = 0;
        _rejectedCount = 0;
        _totalAmount = 0;
    }

    private void ResetCreateOptions()
    {
        _wallets = [];
        _walletTypes = [];
        _currencies = [];
        _gateways = [];
        _credentialOptions = [];
        _credentialLabels = [];
    }

    private void ResetCreateForm()
    {
        _createCredentialId = "";
        _createWalletId = NoSelectionValue;
        _createWalletTypeId = NoSelectionValue;
        _createCurrencyId = NoSelectionValue;
        _createGatewayId = NoSelectionValue;
        _createExternalReference = "";
        _createAddress = "";
        _createRemarks = "";
        _createAmount = 0;
        _createRequestedFee = 0;
    }

    private static decimal? PositiveOrNull(decimal value) => value > 0 ? value : null;

    private static string GetDepositStatusText(short? status) => status switch
    {
        0 => "Pending",
        1 => "Approved",
        2 => "Rejected",
        3 => "Expired",
        _ => "Unknown"
    };

    private static string GetDepositStatusCategory(short? status) => status switch
    {
        0 => "pending",
        1 => "approved",
        2 => "failed",
        3 => "expired",
        _ => "inactive"
    };

    private static string GetWorkflowStatusCategory(WalletWorkflowStatus status) => status switch
    {
        WalletWorkflowStatus.PendingValidation or WalletWorkflowStatus.PendingApproval or WalletWorkflowStatus.Settling => "pending",
        WalletWorkflowStatus.Approved => "approved",
        WalletWorkflowStatus.Completed => "active",
        WalletWorkflowStatus.Rejected or WalletWorkflowStatus.Failed or WalletWorkflowStatus.Cancelled => "failed",
        WalletWorkflowStatus.Expired => "expired",
        _ => "inactive"
    };

    private string BuildWalletLabel(Wallet wallet)
    {
        var account = string.IsNullOrWhiteSpace(wallet.AccountNumber)
            ? wallet.Id.ToString()[..8]
            : wallet.AccountNumber;
        var credential = _credentialLabels.TryGetValue(wallet.CredentialId, out var label)
            ? label
            : wallet.CredentialId.ToString()[..8];
        var type = wallet.WalletType?.Code
            ?? (wallet.WalletTypeId.HasValue ? wallet.WalletTypeId.Value.ToString()[..8] : "No type");

        return $"{account} - {credential} - {type} - {wallet.AvailableBalance.ToString("N2", CultureInfo.CurrentCulture)}";
    }

    private static string BuildCurrencyLabel(global::Wallets.Domain.Shared.Contracts.CurrencyType currency) =>
        string.IsNullOrWhiteSpace(currency.CurrencyIsoCode3)
            ? currency.Name ?? currency.Id.ToString()[..8]
            : $"{currency.CurrencyIsoCode3} - {currency.Name}";

    private static string BuildGatewayLabel(PaymentGateway gateway) =>
        string.IsNullOrWhiteSpace(gateway.Name)
            ? gateway.Id.ToString()[..8]
            : $"{gateway.Name} - {gateway.ServiceCharge.ToString("N2", CultureInfo.CurrentCulture)}";

    private static bool IsMissingPaymentGatewayWrapper(Exception ex) =>
        ex.Message.Contains("PaymentGateway", StringComparison.OrdinalIgnoreCase)
        && ex.Message.Contains("service wrapper", StringComparison.OrdinalIgnoreCase);

    private static string GetCredentialSortText(IdentityCredential credential) =>
        credential.IdentityInfo?.FullName
        ?? credential.IdentityInfo?.IdentityName
        ?? credential.UserName
        ?? credential.UserAlias
        ?? credential.Id.ToString();

    private static string BuildCredentialLabel(IdentityCredential credential)
    {
        var displayName = credential.IdentityInfo?.FullName;
        if (string.IsNullOrWhiteSpace(displayName))
        {
            displayName = credential.IdentityInfo?.IdentityName;
        }

        if (string.IsNullOrWhiteSpace(displayName))
        {
            displayName = credential.UserName ?? credential.UserAlias ?? "Unnamed user";
        }

        var credentialName = credential.UserName ?? credential.UserAlias;
        var suffix = string.IsNullOrWhiteSpace(credentialName)
            ? credential.Id.ToString()[..8]
            : $"{credentialName} - {credential.Id.ToString()[..8]}";

        return $"{displayName} ({suffix})";
    }

    private static string ShortId(Guid id) => id.ToString()[..8];

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantChanged;
        ModuleNavigation.OnChanged -= OnTenantChanged;
    }
}
