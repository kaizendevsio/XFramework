@page "/finance/batch"
@using System.Globalization
@using XFramework.Domain.Shared.DataContext
@implements IDisposable

<PageTitle>Batch Operations - Control Panel</PageTitle>

<div class="space-y-4">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
            <BbTypographyH3>Batch Operations</BbTypographyH3>
            <BbTypographyMuted>Submit ledger-backed batch wallet operations and inspect recent batch activity.</BbTypographyMuted>
        </div>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@LoadData">
            <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
            Refresh
        </BbButton>
    </div>

    @if (_loading)
    {
        <CenteredSpinner />
    }
    else if (!_hasTenant)
    {
        <ModuleUnavailable ModuleName="Wallets" RequiresTenant="true" />
    }
    else if (!_moduleEnabled)
    {
        <ModuleUnavailable ModuleName="Wallets" />
    }
    else
    {
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Submit Batch Item</BbCardTitle>
                <BbCardDescription>Runs through the Wallets batch ledger API with tenant and actor context.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                    <BbFormFieldSelect TValue="string" @bind-Value="_operation" Label="Operation">
                        <BbSelectItem Value="@BatchIncrement">Increment</BbSelectItem>
                        <BbSelectItem Value="@BatchDecrement">Decrement</BbSelectItem>
                        <BbSelectItem Value="@BatchTransfer">Transfer</BbSelectItem>
                    </BbFormFieldSelect>
                    <BbFormFieldSelect TValue="string" @bind-Value="_sourceWalletId" Label="@SourceWalletLabel">
                        <BbSelectItem Value="@NoSelectionValue">Select wallet</BbSelectItem>
                        @foreach (var wallet in _wallets)
                        {
                            <BbSelectItem Value="@wallet.Id.ToString()">@BuildWalletLabel(wallet)</BbSelectItem>
                        }
                    </BbFormFieldSelect>
                    @if (_operation == BatchTransfer)
                    {
                        <BbFormFieldSelect TValue="string" @bind-Value="_destinationWalletId" Label="Destination Wallet">
                            <BbSelectItem Value="@NoSelectionValue">Select wallet</BbSelectItem>
                            @foreach (var wallet in _wallets)
                            {
                                <BbSelectItem Value="@wallet.Id.ToString()">@BuildWalletLabel(wallet)</BbSelectItem>
                            }
                        </BbFormFieldSelect>
                    }
                    <BbFormFieldInput TValue="decimal" @bind-Value="_amount" Label="Amount" />
                    <BbFormFieldInput TValue="decimal" @bind-Value="_fee" Label="Fee" />
                    <BbFormFieldSelect TValue="string" @bind-Value="_onHold" Label="Hold">
                        <BbSelectItem Value="false">No</BbSelectItem>
                        <BbSelectItem Value="true">Yes</BbSelectItem>
                    </BbFormFieldSelect>
                    <BbFormFieldInput TValue="string" @bind-Value="_referenceNumber" Label="Reference" Placeholder="Optional batch reference" />
                </div>
                <div class="mt-4 flex flex-wrap gap-2">
                    <BbButton OnClick="@SubmitBatch" Disabled="@(_acting || _wallets.Count == 0)">
                        @if (_acting)
                        {
                            <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                        }
                        <LucideIcon Name="play" class="mr-2 h-4 w-4" />
                        Submit
                    </BbButton>
                    @if (!string.IsNullOrWhiteSpace(_lastOutcome))
                    {
                        <BbBadge Variant="BadgeVariant.Outline">@_lastOutcome</BbBadge>
                    }
                </div>
            </BbCardContent>
        </BbCard>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            <BbCard>
                <BbCardContent>
                    <div class="space-y-1 pt-4">
                        <BbTypographyMuted>Wallets</BbTypographyMuted>
                        <BbTypographyH3>@_wallets.Count</BbTypographyH3>
                    </div>
                </BbCardContent>
            </BbCard>
            <BbCard>
                <BbCardContent>
                    <div class="space-y-1 pt-4">
                        <BbTypographyMuted>Batch Operations</BbTypographyMuted>
                        <BbTypographyH3>@_batchOperations.Count</BbTypographyH3>
                    </div>
                </BbCardContent>
            </BbCard>
            <BbCard>
                <BbCardContent>
                    <div class="space-y-1 pt-4">
                        <BbTypographyMuted>Latest</BbTypographyMuted>
                        <BbTypographyLarge>@(_latest?.ToString("g") ?? "N/A")</BbTypographyLarge>
                    </div>
                </BbCardContent>
            </BbCard>
        </div>

        <BbDataGrid Items="@_batchOperations" ShowPagination="true" InitialPageSize="20">
            <Columns>
                <BbDataGridPropertyColumn Property="@(x => x.Id)" Title="Operation" />
                <BbDataGridPropertyColumn Property="@(x => x.Status)" Title="Status" Sortable="true" />
                <BbDataGridPropertyColumn Property="@(x => x.ReferenceNumber)" Title="Reference" />
                <BbDataGridPropertyColumn Property="@(x => x.ActorCredentialId)" Title="Actor" />
                <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" />
            </Columns>
        </BbDataGrid>
    }
</div>

@code {
    private const string NoSelectionValue = "__none__";
    private const string BatchIncrement = "increment";
    private const string BatchDecrement = "decrement";
    private const string BatchTransfer = "transfer";

    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private TenantModuleNavigationService ModuleNavigation { get; set; } = default!;
    [Inject] private WalletsAdminBackendContractService WalletsAdminContracts { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    private List<Wallet> _wallets = [];
    private List<WalletOperation> _batchOperations = [];
    private bool _loading = true;
    private bool _acting;
    private bool _hasTenant;
    private bool _moduleEnabled;
    private DateTime? _latest;
    private string? _lastOutcome;
    private string _operation = BatchIncrement;
    private string _sourceWalletId = NoSelectionValue;
    private string _destinationWalletId = NoSelectionValue;
    private string _onHold = "false";
    private string _referenceNumber = "";
    private decimal _amount;
    private decimal _fee;

    private string SourceWalletLabel => _operation == BatchTransfer ? "Source Wallet" : "Wallet";

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        ModuleNavigation.OnChanged += OnTenantChanged;
    }

    protected override async Task OnInitializedAsync() => await LoadData();

    private void OnTenantChanged() => _ = InvokeAsync(LoadData);

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _moduleEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.WalletsBatch);
            _wallets = [];
            _batchOperations = [];
            _latest = null;

            if (!_hasTenant || !_moduleEnabled)
            {
                return;
            }

            var tenantId = TenantFilter.SelectedTenantId!.Value;
            _wallets = await DataContext.Query<Wallet>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                .OrderByDescending(x => x.CreatedAt)
                .Take(250)
                .ToListAsync();
            _wallets = _wallets
                .Where(x => x.Status != WalletStatus.Closed)
                .ToList();

            _batchOperations = await DataContext.Query<WalletOperation>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId && !x.IsDeleted && x.OperationType == WalletOperationType.Batch)
                .OrderByDescending(x => x.CreatedAt)
                .Take(100)
                .ToListAsync();

            _latest = _batchOperations.Count == 0 ? null : _batchOperations.Max(x => x.CreatedAt);
        }
        catch (Exception ex)
        {
            _wallets = [];
            _batchOperations = [];
            _latest = null;
            ToastService.Show($"Failed to load batch operations: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SubmitBatch()
    {
        if (!Guid.TryParse(_sourceWalletId, out var sourceWalletId))
        {
            ToastService.Show("Select a wallet.");
            return;
        }

        if (_amount <= 0 || _fee < 0)
        {
            ToastService.Show("Amount must be greater than zero and fee cannot be negative.");
            return;
        }

        var sourceWallet = _wallets.FirstOrDefault(x => x.Id == sourceWalletId);
        if (sourceWallet is null)
        {
            ToastService.Show("Selected wallet is not available.");
            return;
        }

        _acting = true;
        try
        {
            var referenceNumber = string.IsNullOrWhiteSpace(_referenceNumber)
                ? $"cp-batch-{Guid.NewGuid():N}"
                : _referenceNumber.Trim();

            var response = _operation switch
            {
                BatchIncrement => await WalletsAdminContracts.BatchIncrementAsync(new BatchIncrementWalletRequest
                {
                    Requests =
                    [
                        new BatchIncrementRequest
                        {
                            WalletId = sourceWallet.Id,
                            WalletTypeId = sourceWallet.WalletTypeId ?? Guid.Empty,
                            CredentialId = sourceWallet.CredentialId,
                            Amount = _amount,
                            Fee = _fee,
                            OnHold = bool.Parse(_onHold),
                            ReferenceNumber = referenceNumber,
                            Remarks = "ControlPanel batch increment"
                        }
                    ]
                }),
                BatchDecrement => await WalletsAdminContracts.BatchDecrementAsync(new BatchDecrementWalletRequest
                {
                    Requests =
                    [
                        new BatchDecrementRequest
                        {
                            WalletId = sourceWallet.Id,
                            CredentialId = sourceWallet.CredentialId,
                            Amount = _amount,
                            Fee = _fee,
                            OnHold = bool.Parse(_onHold),
                            ReferenceNumber = referenceNumber,
                            Remarks = "ControlPanel batch decrement"
                        }
                    ]
                }),
                BatchTransfer => await SubmitBatchTransfer(sourceWallet, referenceNumber),
                _ => new CmdResponse
                {
                    HttpStatusCode = System.Net.HttpStatusCode.BadRequest,
                    Message = "Unknown batch operation."
                }
            };

            if (response.IsSuccess)
            {
                _lastOutcome = $"{_operation} accepted";
                ToastService.Show(response.Message ?? $"Batch {_operation} submitted.");
                await LoadData();
                return;
            }

            ToastService.Show(response.Message ?? "Batch operation failed.");
        }
        catch (Exception ex)
        {
            ToastService.Show($"Batch operation failed: {ex.Message}");
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task<CmdResponse> SubmitBatchTransfer(Wallet sourceWallet, string referenceNumber)
    {
        if (!Guid.TryParse(_destinationWalletId, out var destinationWalletId))
        {
            return new CmdResponse
            {
                HttpStatusCode = System.Net.HttpStatusCode.BadRequest,
                Message = "Select a destination wallet."
            };
        }

        var destinationWallet = _wallets.FirstOrDefault(x => x.Id == destinationWalletId);
        if (destinationWallet is null)
        {
            return new CmdResponse
            {
                HttpStatusCode = System.Net.HttpStatusCode.BadRequest,
                Message = "Selected destination wallet is not available."
            };
        }

        return await WalletsAdminContracts.BatchTransferAsync(new BatchTransferWalletRequest
        {
            Requests =
            [
                new BatchTransferRequest
                {
                    FromWalletId = sourceWallet.Id,
                    ToWalletId = destinationWallet.Id,
                    FromCredentialId = sourceWallet.CredentialId,
                    ToCredentialId = destinationWallet.CredentialId,
                    Amount = _amount,
                    Fee = _fee,
                    ReferenceNumber = referenceNumber,
                    Remarks = "ControlPanel batch transfer"
                }
            ]
        });
    }

    private static string BuildWalletLabel(Wallet wallet)
    {
        var balance = wallet.Balance.ToString("N2", CultureInfo.InvariantCulture);
        return $"{wallet.AccountNumber ?? wallet.Id.ToString()[..8]} - {wallet.CredentialId.ToString()[..8]} - {balance}";
    }

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantChanged;
        ModuleNavigation.OnChanged -= OnTenantChanged;
    }
}
