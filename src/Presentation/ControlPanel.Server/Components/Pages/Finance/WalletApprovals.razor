@page "/finance/wallet-approvals"
@using global::Wallets.Domain.Shared.Enums
@using XFramework.Domain.Shared.BusinessObjects
@using XFramework.Domain.Shared.DataContext
@implements IDisposable

<PageTitle>Wallet Approvals - Control Panel</PageTitle>

<div class="space-y-4">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
            <BbTypographyH3>Wallet Approvals</BbTypographyH3>
            <BbTypographyMuted>Review maker-checker requests for sensitive wallet operations.</BbTypographyMuted>
        </div>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@LoadData">
            <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
            Refresh
        </BbButton>
    </div>

    @if (_loading)
    {
        <CenteredSpinner />
    }
    else if (!_hasTenant)
    {
        <ModuleUnavailable ModuleName="Wallets" RequiresTenant="true" />
    }
    else if (!_moduleEnabled)
    {
        <ModuleUnavailable ModuleName="Wallets" />
    }
    else
    {
        <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
            <BbCard>
                <BbCardContent>
                    <div class="space-y-1 pt-4">
                        <BbTypographyMuted>Pending</BbTypographyMuted>
                        <BbTypographyH3>@_pendingCount</BbTypographyH3>
                    </div>
                </BbCardContent>
            </BbCard>
            <BbCard>
                <BbCardContent>
                    <div class="space-y-1 pt-4">
                        <BbTypographyMuted>Approved</BbTypographyMuted>
                        <BbTypographyH3>@_approvedCount</BbTypographyH3>
                    </div>
                </BbCardContent>
            </BbCard>
            <BbCard>
                <BbCardContent>
                    <div class="space-y-1 pt-4">
                        <BbTypographyMuted>Rejected</BbTypographyMuted>
                        <BbTypographyH3>@_rejectedCount</BbTypographyH3>
                    </div>
                </BbCardContent>
            </BbCard>
            <BbCard>
                <BbCardContent>
                    <div class="space-y-1 pt-4">
                        <BbTypographyMuted>Requested Amount</BbTypographyMuted>
                        <BbTypographyH3>@_totalAmount.ToString("N2")</BbTypographyH3>
                    </div>
                </BbCardContent>
            </BbCard>
        </div>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Approval Queue</BbCardTitle>
                <BbCardDescription>@_items.Count approval request(s) loaded</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <BbDataGrid Items="@_items" ShowPagination="true" InitialPageSize="20">
                    <Columns>
                        <BbDataGridTemplateColumn Title="Operation" Sortable="true">
                            <ChildContent Context="item">
                                <BbBadge Variant="BadgeVariant.Outline">@item.OperationType</BbBadge>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Status" Sortable="true">
                            <ChildContent Context="item">
                                <StatusBadge Text="@item.Status.ToString()" Status="@GetStatusCategory(item.Status)" />
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Wallet">
                            <ChildContent Context="item">
                                @if (item.WalletId is Guid walletId)
                                {
                                    <BbButton Variant="ButtonVariant.Link" Size="ButtonSize.Small" OnClick="@(() => NavigationManager.NavigateTo($"/finance/wallets/{walletId}"))">
                                        @(item.Wallet?.AccountNumber ?? walletId.ToString()[..8])
                                    </BbButton>
                                }
                                else
                                {
                                    <span class="text-muted-foreground">None</span>
                                }
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Amount" Sortable="true">
                            <ChildContent Context="item">
                                @(item.Amount?.ToString("N2") ?? "-")
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Reason">
                            <ChildContent Context="item">
                                <span title="@item.Reason">@(Trim(item.Reason, 44))</span>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridPropertyColumn Property="@(x => x.RequestedAt)" Title="Requested" Sortable="true" />
                        <BbDataGridPropertyColumn Property="@(x => x.DecidedAt)" Title="Decided" Sortable="true" />
                        <BbDataGridTemplateColumn Title="Actions">
                            <ChildContent Context="item">
                                <div class="flex flex-wrap gap-1">
                                    @if (item.Status == WalletApprovalStatus.Pending)
                                    {
                                        <BbButton Size="ButtonSize.Small" OnClick="@(() => Approve(item))" Disabled="@_acting">
                                            Approve
                                        </BbButton>
                                        <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Destructive" OnClick="@(() => Reject(item))" Disabled="@_acting">
                                            Reject
                                        </BbButton>
                                    }
                                    else
                                    {
                                        <span class="text-muted-foreground text-xs">No action</span>
                                    }
                                </div>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                    </Columns>
                </BbDataGrid>
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private TenantModuleNavigationService ModuleNavigation { get; set; } = default!;
    [Inject] private WalletsAdminBackendContractService WalletsAdminContracts { get; set; } = default!;

    private List<WalletApprovalRequest> _items = [];
    private bool _loading = true;
    private bool _acting;
    private bool _hasTenant;
    private bool _moduleEnabled;
    private int _pendingCount;
    private int _approvedCount;
    private int _rejectedCount;
    private decimal _totalAmount;

    protected override async Task OnInitializedAsync()
    {
        TenantFilter.OnChanged += OnTenantChanged;
        await LoadData();
    }

    private void OnTenantChanged() => _ = InvokeAsync(LoadData);

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            await ModuleNavigation.EnsureLoadedAsync();
            _hasTenant = TenantFilter.SelectedTenantId is Guid;
            _moduleEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.WalletsPolicy);
            _items = [];
            ResetSummary();

            if (!_hasTenant || !_moduleEnabled)
            {
                return;
            }

            var tenantId = TenantFilter.SelectedTenantId!.Value;
            _items = await DataContext.Query<WalletApprovalRequest>()
                .IgnoreQueryFilters()
                .NoCache()
                .Include(x => x.Wallet)
                .Where(x => x.TenantId == tenantId && !x.IsDeleted)
                .OrderByDescending(x => x.RequestedAt)
                .Take(250)
                .ToListAsync();

            _pendingCount = _items.Count(x => x.Status == WalletApprovalStatus.Pending);
            _approvedCount = _items.Count(x => x.Status == WalletApprovalStatus.Approved);
            _rejectedCount = _items.Count(x => x.Status == WalletApprovalStatus.Rejected);
            _totalAmount = _items.Where(x => x.Status == WalletApprovalStatus.Pending).Sum(x => x.Amount ?? 0);
        }
        catch (Exception ex)
        {
            _items = [];
            ResetSummary();
            ToastService.Show($"Failed to load wallet approvals: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task Approve(WalletApprovalRequest item) =>
        await RunDecision(() => WalletsAdminContracts.ApproveWalletApprovalAsync(item.Id), "Approval");

    private async Task Reject(WalletApprovalRequest item) =>
        await RunDecision(() => WalletsAdminContracts.RejectWalletApprovalAsync(item.Id), "Rejection");

    private async Task RunDecision(Func<Task<CmdResponse>> action, string label)
    {
        _acting = true;
        try
        {
            var result = await action();
            ToastService.Show(result.IsSuccess ? $"{label} submitted." : result.Message ?? $"{label} failed.");
            await LoadData();
        }
        finally
        {
            _acting = false;
        }
    }

    private void ResetSummary()
    {
        _pendingCount = 0;
        _approvedCount = 0;
        _rejectedCount = 0;
        _totalAmount = 0;
    }

    private static string GetStatusCategory(WalletApprovalStatus status) => status switch
    {
        WalletApprovalStatus.Pending => "pending",
        WalletApprovalStatus.Approved => "approved",
        WalletApprovalStatus.Rejected => "failed",
        _ => "inactive"
    };

    private static string Trim(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        return value.Length <= maxLength ? value : $"{value[..maxLength]}...";
    }

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantChanged;
    }
}
