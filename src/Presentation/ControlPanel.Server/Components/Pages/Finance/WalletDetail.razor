@page "/finance/wallets/{Id:guid}"
@using System.Globalization
@using global::Wallets.Domain.Shared.Enums
@using global::Wallets.Integration.Drivers
@using XFramework.Domain.Shared.BusinessObjects
@using XFramework.Domain.Shared.DataContext
@implements IDisposable

<PageTitle>Wallet Detail - Control Panel</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (_wallet is null)
{
    <BbTypographyMuted>Wallet not found.</BbTypographyMuted>
}
else if (_outsideTenantContext)
{
    <div class="space-y-4">
        <BbButton Variant="ButtonVariant.Ghost" OnClick="@GoBack">
            <LucideIcon Name="arrow-left" class="mr-2 h-4 w-4" />
            Back to Wallets
        </BbButton>
        <BbAlert>
            <BbAlertTitle>Wallet Outside Active Tenant</BbAlertTitle>
            <BbAlertDescription>Switch to All Tenants or the wallet's tenant to view this record.</BbAlertDescription>
        </BbAlert>
    </div>
}
else
{
    <FadeInContent>
    <div class="space-y-6">
        @* Header *@
        <div class="flex items-center gap-4">
            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                      OnClick="@GoBack">
                <LucideIcon Name="arrow-left" class="h-4 w-4" />
            </BbButton>
            <div class="flex-1">
                <BbTypographyH3>
                    Wallet: @(_wallet.AccountNumber ?? _wallet.Id.ToString()[..8] + "...")
                </BbTypographyH3>
                <BbTypographyMuted>
                    ID: @_wallet.Id &mdash; Type: @(_wallet.WalletType?.Name ?? "N/A")
                </BbTypographyMuted>
            </div>
            <div class="flex items-center gap-2">
                @if (_wallet.Status == WalletStatus.Active)
                {
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@FreezeWallet">
                        <LucideIcon Name="lock" class="mr-2 h-4 w-4" />
                        Freeze Wallet
                    </BbButton>
                }
                else if (_wallet.Status == WalletStatus.Frozen)
                {
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@UnfreezeWallet">
                        <LucideIcon Name="lock-open" class="mr-2 h-4 w-4" />
                        Unfreeze Wallet
                    </BbButton>
                }
                @if (_wallet.Status != WalletStatus.Closed)
                {
                    <BbButton Variant="ButtonVariant.Destructive" OnClick="@(() => _showCloseDialog = true)">
                        <LucideIcon Name="x" class="mr-2 h-4 w-4" />
                        Close Wallet
                    </BbButton>
                }
            </div>
        </div>

        @* Wallet Summary Card *@
        <BbCard>
            <BbCardHeader>
                <div class="flex items-center justify-between">
                    <div>
                        <BbCardTitle>Wallet Summary</BbCardTitle>
                        <BbCardDescription>
                            Credential: <span class="font-mono">@_wallet.CredentialId</span>
                        </BbCardDescription>
                    </div>
                    <StatusBadge Text="@_wallet.Status.ToString()" Status="@GetStatusKey(_wallet.Status)" />
                </div>
            </BbCardHeader>
            <BbCardContent>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
                    <BbCard>
                        <BbCardContent>
                            <div class="space-y-1 pt-4">
                                <BbTypographyMuted>Balance</BbTypographyMuted>
                                <BbTypographyH3>@_wallet.Balance.ToString("N2")</BbTypographyH3>
                            </div>
                        </BbCardContent>
                    </BbCard>
                    <BbCard>
                        <BbCardContent>
                            <div class="space-y-1 pt-4">
                                <BbTypographyMuted>Available Balance</BbTypographyMuted>
                                <BbTypographyH3 Class="@(_wallet.AvailableBalance < 0 ? "text-red-500" : "")">
                                    @_wallet.AvailableBalance.ToString("N2")
                                </BbTypographyH3>
                            </div>
                        </BbCardContent>
                    </BbCard>
                    <BbCard>
                        <BbCardContent>
                            <div class="space-y-1 pt-4">
                                <BbTypographyMuted>Debit On Hold</BbTypographyMuted>
                                <BbTypographyH3 Class="@(_wallet.DebitOnHoldBalance > 0 ? "text-yellow-600" : "")">
                                    @_wallet.DebitOnHoldBalance.ToString("N2")
                                </BbTypographyH3>
                            </div>
                        </BbCardContent>
                    </BbCard>
                    <BbCard>
                        <BbCardContent>
                            <div class="space-y-1 pt-4">
                                <BbTypographyMuted>Credit On Hold</BbTypographyMuted>
                                <BbTypographyH3 Class="@(_wallet.CreditOnHoldBalance > 0 ? "text-yellow-600" : "")">
                                    @_wallet.CreditOnHoldBalance.ToString("N2")
                                </BbTypographyH3>
                            </div>
                        </BbCardContent>
                    </BbCard>
                </div>

                <div class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-4">
                    <div class="space-y-1">
                        <BbTypographyMuted>Total Balance</BbTypographyMuted>
                        <BbTypographyLarge>@(_wallet.TotalBalance?.ToString("N2") ?? "N/A")</BbTypographyLarge>
                    </div>
                    <div class="space-y-1">
                        <BbTypographyMuted>Transferable Balance</BbTypographyMuted>
                        <BbTypographyLarge>@_wallet.TransferableBalance.ToString("N2")</BbTypographyLarge>
                    </div>
                    <div class="space-y-1">
                        <BbTypographyMuted>Account Number</BbTypographyMuted>
                        <BbTypographyLarge>@(_wallet.AccountNumber ?? "N/A")</BbTypographyLarge>
                    </div>
                    <div class="space-y-1">
                        <BbTypographyMuted>Created</BbTypographyMuted>
                        <BbTypographyLarge>@_wallet.CreatedAt.ToString("g")</BbTypographyLarge>
                    </div>
                </div>
            </BbCardContent>
        </BbCard>

        @* Admin Operations *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Admin Operations</BbCardTitle>
                <BbCardDescription>Directly manage wallet funds. All operations are logged as transactions.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <BbTabs DefaultValue="add-funds">
                    <BbTabsList>
                        <BbTabsTrigger Value="add-funds">Add Funds</BbTabsTrigger>
                        <BbTabsTrigger Value="withdraw-funds">Withdraw Funds</BbTabsTrigger>
                        <BbTabsTrigger Value="adjust-balance">Adjust Balance</BbTabsTrigger>
                    </BbTabsList>

                    <BbTabsContent Value="add-funds" Class="xf-fade-in">
                        <div class="grid gap-4 py-4 md:grid-cols-3">
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_addFundsAmount"
                                              Label="Amount"
                                              Placeholder="0.00"
                                              Required="true" />
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_addFundsRef"
                                              Label="Reference Number"
                                              Placeholder="REF-001" />
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_addFundsRemarks"
                                              Label="Remarks"
                                              Placeholder="Admin credit" />
                        </div>
                        <BbButton OnClick="@AddFunds" Disabled="@_isProcessing">
                            @if (_isProcessing)
                            {
                                <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                            }
                            <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                            Add Funds
                        </BbButton>
                    </BbTabsContent>

                    <BbTabsContent Value="withdraw-funds" Class="xf-fade-in">
                        <div class="grid gap-4 py-4 md:grid-cols-3">
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_withdrawAmount"
                                              Label="Amount"
                                              Placeholder="0.00"
                                              Required="true" />
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_withdrawRef"
                                              Label="Reference Number"
                                              Placeholder="REF-001" />
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_withdrawRemarks"
                                              Label="Remarks"
                                              Placeholder="Admin debit" />
                        </div>
                        <BbButton Variant="ButtonVariant.Destructive" OnClick="@WithdrawFunds" Disabled="@_isProcessing">
                            @if (_isProcessing)
                            {
                                <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                            }
                            <LucideIcon Name="minus" class="mr-2 h-4 w-4" />
                            Withdraw Funds
                        </BbButton>
                    </BbTabsContent>

                    <BbTabsContent Value="adjust-balance" Class="xf-fade-in">
                        <BbAlert Variant="AlertVariant.Warning" class="mb-4">
                            <BbAlertTitle>Warning</BbAlertTitle>
                            <BbAlertDescription>
                                Balance adjustment posts the difference through the wallet operation workflow and records a transaction.
                            </BbAlertDescription>
                        </BbAlert>
                        <div class="grid gap-4 py-4 md:grid-cols-2">
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_adjustBalance"
                                              Label="New Balance"
                                              Placeholder="0.00"
                                              Required="true" />
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_adjustRemarks"
                                              Label="Remarks"
                                              Placeholder="Admin balance adjustment" />
                        </div>
                        <BbButton Variant="ButtonVariant.Outline" OnClick="@AdjustBalance" Disabled="@_isProcessing">
                            @if (_isProcessing)
                            {
                                <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                            }
                            <LucideIcon Name="settings" class="mr-2 h-4 w-4" />
                            Apply Adjustment
                        </BbButton>
                    </BbTabsContent>
                </BbTabs>
            </BbCardContent>
        </BbCard>

        @* Transaction History *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Transaction History</BbCardTitle>
                <BbCardDescription>@_transactions.Count transaction(s) recorded for this wallet</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <BbDataGrid Items="@_transactions" ShowPagination="true" InitialPageSize="20">
                    <Columns>
                        <BbDataGridTemplateColumn Title="Amount" Sortable="true">
                            <ChildContent Context="item">
                                <span class="font-semibold @(item.TransactionType == TransactionType.Credit ? "text-green-600" : "text-red-600")">
                                    @(item.TransactionType == TransactionType.Credit ? "+" : "")@item.Amount.ToString("N2")
                                </span>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Type">
                            <ChildContent Context="item">
                                @if (item.TransactionType == TransactionType.Credit)
                                {
                                    <BbBadge Variant="BadgeVariant.Default">Credit</BbBadge>
                                }
                                else if (item.TransactionType == TransactionType.Debit)
                                {
                                    <BbBadge Variant="BadgeVariant.Destructive">Debit</BbBadge>
                                }
                                else
                                {
                                    <BbBadge Variant="BadgeVariant.Secondary">Unknown</BbBadge>
                                }
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Fee" Sortable="true">
                            <ChildContent Context="item">
                                @if (item.TransactionFee > 0)
                                {
                                    <span class="text-yellow-600">@item.TransactionFee.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted-foreground">0.00</span>
                                }
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Held">
                            <ChildContent Context="item">
                                <BbBadge Variant="@(item.Held ? BadgeVariant.Outline : BadgeVariant.Secondary)">
                                    @(item.Held ? "Held" : "No")
                                </BbBadge>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Released">
                            <ChildContent Context="item">
                                <BbBadge Variant="@(item.Released ? BadgeVariant.Default : BadgeVariant.Secondary)">
                                    @(item.Released ? "Released" : "No")
                                </BbBadge>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Reference">
                            <ChildContent Context="item">
                                <span class="font-mono text-xs">@(item.ReferenceNumber ?? "N/A")</span>
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Remarks">
                            <ChildContent Context="item">
                                @if (!string.IsNullOrEmpty(item.Remarks))
                                {
                                    <span title="@item.Remarks">
                                        @(item.Remarks.Length > 30 ? item.Remarks[..30] + "..." : item.Remarks)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted-foreground">--</span>
                                }
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridTemplateColumn Title="Running Balance" Sortable="true">
                            <ChildContent Context="item">
                                @(item.RunningBalance?.ToString("N2") ?? "N/A")
                            </ChildContent>
                        </BbDataGridTemplateColumn>
                        <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" />
                    </Columns>
                </BbDataGrid>
            </BbCardContent>
        </BbCard>

        @* Wallet Rules *@
        <BbCard>
            <BbCardHeader>
                <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <div>
                        <BbCardTitle>Wallet Rules</BbCardTitle>
                        <BbCardDescription>Transfer and balance rules configured for this wallet</BbCardDescription>
                    </div>
                    @if (!_editingRules)
                    {
                        <BbButton Variant="ButtonVariant.Outline" OnClick="@StartEditRules">
                            <LucideIcon Name="settings" class="mr-2 h-4 w-4" />
                            Edit Rules
                        </BbButton>
                    }
                </div>
            </BbCardHeader>
            <BbCardContent>
                @if (_editingRules)
                {
                    <div class="space-y-4">
                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_rulesMinTransfer"
                                              Label="Min Transfer Rule"
                                              Placeholder="No minimum" />
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_rulesMaxTransfer"
                                              Label="Max Transfer Rule"
                                              Placeholder="No maximum" />
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_rulesBondBalance"
                                              Label="Bond Balance Rule"
                                              Placeholder="Not set" />
                            <BbFormFieldInput TValue="string"
                                              @bind-Value="_rulesMaintainingBalance"
                                              Label="Maintaining Balance Rule"
                                              Placeholder="Not set" />
                        </div>
                        <div class="flex flex-wrap items-center justify-end gap-2">
                            <BbButton Variant="ButtonVariant.Outline" OnClick="@CancelEditRules" Disabled="@_savingRules">
                                <LucideIcon Name="x" class="mr-2 h-4 w-4" />
                                Cancel
                            </BbButton>
                            <BbButton OnClick="@SaveRules" Disabled="@_savingRules">
                                @if (_savingRules)
                                {
                                    <LucideIcon Name="loader-2" class="mr-2 h-4 w-4 animate-spin" />
                                }
                                else
                                {
                                    <LucideIcon Name="save" class="mr-2 h-4 w-4" />
                                }
                                Save Rules
                            </BbButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
                        <div class="space-y-1">
                            <BbTypographyMuted>Min Transfer Rule</BbTypographyMuted>
                            <BbTypographyLarge>
                                @(_wallet.MinTransferRule?.ToString("N2") ?? "Not set")
                            </BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Max Transfer Rule</BbTypographyMuted>
                            <BbTypographyLarge>
                                @(_wallet.MaxTransferRule?.ToString("N2") ?? "Not set")
                            </BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Bond Balance Rule</BbTypographyMuted>
                            <BbTypographyLarge>
                                @(_wallet.BondBalanceRule?.ToString("N2") ?? "Not set")
                            </BbTypographyLarge>
                        </div>
                        <div class="space-y-1">
                            <BbTypographyMuted>Maintaining Balance Rule</BbTypographyMuted>
                            <BbTypographyLarge>
                                @(_wallet.MaintainingBalanceRule?.ToString("N2") ?? "Not set")
                            </BbTypographyLarge>
                        </div>
                    </div>
                }
            </BbCardContent>
        </BbCard>
    </div>
    </FadeInContent>
}

@* Close Wallet Confirmation Dialog *@
<BbDialog Open="@_showCloseDialog" OpenChanged="@(v => _showCloseDialog = v)">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>Close Wallet</BbDialogTitle>
            <BbDialogDescription>
                Are you sure you want to close this wallet? This action cannot be easily undone.
                @if (_wallet?.Balance > 0)
                {
                    <span class="mt-2 block font-semibold text-red-500">
                        Warning: This wallet still has a balance of @_wallet.Balance.ToString("N2").
                    </span>
                }
            </BbDialogDescription>
        </BbDialogHeader>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _showCloseDialog = false)">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="@CloseWallet">
                Confirm Close
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Parameter] public Guid Id { get; set; }
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Inject] private NavigationHistoryService NavigationHistory { get; set; } = default!;
    [Inject] private IWalletsServiceWrapper WalletsService { get; set; } = default!;
    [Inject] private RequestMetadata RequestMetadata { get; set; } = default!;

    private Wallet? _wallet;
    private List<WalletTransaction> _transactions = [];
    private bool _loading = true;
    private bool _isProcessing;
    private bool _showCloseDialog;
    private bool _outsideTenantContext;

    // Add Funds form
    private string _addFundsAmount = "";
    private string _addFundsRef = "";
    private string _addFundsRemarks = "";

    // Withdraw Funds form
    private string _withdrawAmount = "";
    private string _withdrawRef = "";
    private string _withdrawRemarks = "";

    // Adjust Balance form
    private string _adjustBalance = "";
    private string _adjustRemarks = "";
    private Guid? _loadedId;
    private bool _editingRules;
    private bool _savingRules;
    private string _rulesMinTransfer = "";
    private string _rulesMaxTransfer = "";
    private string _rulesBondBalance = "";
    private string _rulesMaintainingBalance = "";

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantFilterChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await ReloadWalletDetail();
    }

    private void OnTenantFilterChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await ReloadWalletDetail();
            StateHasChanged();
        });
    }

    private async Task ReloadWalletDetail()
    {
        _loading = true;
        try
        {
            _transactions = [];
            await LoadWallet();
            if (_wallet is not null && !_outsideTenantContext)
            {
                await LoadTransactions();
            }
        }
        catch (Exception ex)
        {
            ToastService.Show($"Failed to load wallet: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadWallet()
    {
        _outsideTenantContext = false;
        _wallet = await DataContext.Query<Wallet>()
            .IgnoreQueryFilters()
            .NoCache()
            .Include(x => x.WalletType)
            .Where(x => x.Id == Id && !x.IsDeleted)
            .FirstOrDefaultAsync();
        _outsideTenantContext = _wallet is not null
            && TenantFilter.SelectedTenantId is Guid tenantId
            && tenantId != _wallet.TenantId;
    }

    private async Task LoadTransactions()
    {
        if (_wallet is null)
        {
            _transactions = [];
            return;
        }

        var walletTenantId = _wallet.TenantId;
        _transactions = await DataContext.Query<WalletTransaction>()
            .IgnoreQueryFilters()
            .NoCache()
            .Where(x => x.WalletId == Id && x.TenantId == walletTenantId && !x.IsDeleted)
            .OrderByDescending(x => x.CreatedAt)
            .Take(100)
            .ToListAsync();
    }

    private string GetStatusKey(WalletStatus status) => status switch
    {
        WalletStatus.Active => "active",
        WalletStatus.Frozen => "frozen",
        WalletStatus.Suspended => "suspended",
        WalletStatus.Closed => "closed",
        _ => "inactive"
    };

    private async Task GoBack()
    {
        if (!NavigationHistory.CanGoBack)
        {
            NavigationManager.NavigateTo("/finance/wallets");
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("history.back");
        }
        catch (JSException)
        {
            NavigationManager.NavigateTo(NavigationHistory.PreviousUri ?? "/finance/wallets", replace: true);
        }
        catch (InvalidOperationException)
        {
            NavigationManager.NavigateTo(NavigationHistory.PreviousUri ?? "/finance/wallets", replace: true);
        }
    }

    private void StartEditRules()
    {
        if (_wallet is null)
        {
            return;
        }

        _rulesMinTransfer = FormatRuleInput(_wallet.MinTransferRule);
        _rulesMaxTransfer = FormatRuleInput(_wallet.MaxTransferRule);
        _rulesBondBalance = FormatRuleInput(_wallet.BondBalanceRule);
        _rulesMaintainingBalance = FormatRuleInput(_wallet.MaintainingBalanceRule);
        _editingRules = true;
    }

    private void CancelEditRules()
    {
        _editingRules = false;
    }

    private async Task SaveRules()
    {
        if (!TryParseRule(_rulesMinTransfer, "Min transfer rule", out var minTransfer, out var error)
            || !TryParseRule(_rulesMaxTransfer, "Max transfer rule", out var maxTransfer, out error)
            || !TryParseRule(_rulesBondBalance, "Bond balance rule", out var bondBalance, out error)
            || !TryParseRule(_rulesMaintainingBalance, "Maintaining balance rule", out var maintainingBalance, out error))
        {
            ToastService.Show(error);
            return;
        }

        if (minTransfer is not null && maxTransfer is not null && minTransfer > maxTransfer)
        {
            ToastService.Show("Min transfer rule cannot be greater than max transfer rule.");
            return;
        }

        _savingRules = true;
        try
        {
            ToastService.Show("Wallet rule changes require the backend policy workflow and were not saved.");
            _editingRules = false;
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error updating wallet rules: {ex.Message}");
        }
        finally
        {
            _savingRules = false;
        }
    }

    private static string FormatRuleInput(decimal? value) =>
        value?.ToString("0.##", CultureInfo.InvariantCulture) ?? "";

    private RequestMetadata BuildCommandMetadata(Guid tenantId) => new()
    {
        TenantId = tenantId,
        CredentialId = RequestMetadata.CredentialId,
        SessionId = RequestMetadata.SessionId,
        RequestId = Guid.NewGuid(),
        Name = RequestMetadata.Name ?? "ControlPanel",
        DeviceName = RequestMetadata.DeviceName,
        DeviceAgent = RequestMetadata.DeviceAgent,
        IpAddress = RequestMetadata.IpAddress
    };

    private static bool TryParseRule(string value, string label, out decimal? parsed, out string error)
    {
        parsed = null;
        error = "";

        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        if (!decimal.TryParse(value, NumberStyles.Number, CultureInfo.CurrentCulture, out var rule)
            && !decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out rule))
        {
            error = $"{label} must be a valid number.";
            return false;
        }

        if (rule < 0)
        {
            error = $"{label} cannot be negative.";
            return false;
        }

        parsed = rule;
        return true;
    }

    private async Task AddFunds()
    {
        if (!decimal.TryParse(_addFundsAmount, out var amount) || amount <= 0)
        {
            ToastService.Show("Please enter a valid positive amount.");
            return;
        }

        _isProcessing = true;
        try
        {
            var fresh = await DataContext.Query<Wallet>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id && !x.IsDeleted)
                .FirstOrDefaultAsync();

            if (fresh is null)
            {
                ToastService.Show("Wallet not found.");
                return;
            }

            if (!TryGetWalletTypeId(fresh, out var walletTypeId))
            {
                return;
            }

            var response = await WalletsService.IncrementWallet(new IncrementWalletRequest
            {
                WalletId = Id,
                CredentialId = fresh.CredentialId,
                Amount = amount,
                WalletTypeId = walletTypeId,
                ReferenceNumber = string.IsNullOrWhiteSpace(_addFundsRef) ? null : _addFundsRef.Trim(),
                Remarks = string.IsNullOrWhiteSpace(_addFundsRemarks) ? "Admin credit" : _addFundsRemarks.Trim(),
                IdempotencyKey = $"controlpanel-add-{Guid.NewGuid():N}",
                Metadata = BuildCommandMetadata(fresh.TenantId)
            });

            if (response.IsSuccess)
            {
                ToastService.Show($"Added {amount:N2} to wallet.");
                _addFundsAmount = "";
                _addFundsRef = "";
                _addFundsRemarks = "";
                await LoadWallet();
                await LoadTransactions();
            }
            else
            {
                ToastService.Show($"Failed to add funds: {response.Message}");
            }
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error adding funds: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task WithdrawFunds()
    {
        if (!decimal.TryParse(_withdrawAmount, out var amount) || amount <= 0)
        {
            ToastService.Show("Please enter a valid positive amount.");
            return;
        }

        _isProcessing = true;
        try
        {
            var fresh = await DataContext.Query<Wallet>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id && !x.IsDeleted)
                .FirstOrDefaultAsync();

            if (fresh is null)
            {
                ToastService.Show("Wallet not found.");
                return;
            }

            if (!TryGetWalletTypeId(fresh, out var walletTypeId))
            {
                return;
            }

            if (fresh.AvailableBalance < amount)
            {
                ToastService.Show($"Insufficient balance. Available: {fresh.AvailableBalance:N2}, requested: {amount:N2}");
                return;
            }

            var response = await WalletsService.DecrementWallet(new DecrementWalletRequest
            {
                WalletId = Id,
                CredentialId = fresh.CredentialId,
                Amount = amount,
                WalletTypeId = walletTypeId,
                ReferenceNumber = string.IsNullOrWhiteSpace(_withdrawRef) ? null : _withdrawRef.Trim(),
                Remarks = string.IsNullOrWhiteSpace(_withdrawRemarks) ? "Admin debit" : _withdrawRemarks.Trim(),
                IdempotencyKey = $"controlpanel-withdraw-{Guid.NewGuid():N}",
                Metadata = BuildCommandMetadata(fresh.TenantId)
            });

            if (response.IsSuccess)
            {
                ToastService.Show($"Withdrew {amount:N2} from wallet.");
                _withdrawAmount = "";
                _withdrawRef = "";
                _withdrawRemarks = "";
                await LoadWallet();
                await LoadTransactions();
            }
            else
            {
                ToastService.Show($"Failed to withdraw funds: {response.Message}");
            }
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error withdrawing funds: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task AdjustBalance()
    {
        if (!decimal.TryParse(_adjustBalance, out var newBalance))
        {
            ToastService.Show("Please enter a valid balance amount.");
            return;
        }

        _isProcessing = true;
        try
        {
            // Fetch fresh wallet state
            var fresh = await DataContext.Query<Wallet>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id && !x.IsDeleted)
                .FirstOrDefaultAsync();

            if (fresh is null)
            {
                ToastService.Show("Wallet not found.");
                return;
            }

            if (!TryGetWalletTypeId(fresh, out var walletTypeId))
            {
                return;
            }

            var difference = newBalance - fresh.Balance;
            if (difference == 0)
            {
                ToastService.Show("Balance is already at the requested amount.");
                return;
            }

            var referenceNumber = $"ADJ-{DateTime.UtcNow:yyyyMMddHHmmss}";
            var remarks = string.IsNullOrWhiteSpace(_adjustRemarks)
                ? $"Admin balance adjustment: {fresh.Balance:N2} -> {newBalance:N2}"
                : _adjustRemarks.Trim();

            var response = difference > 0
                ? await WalletsService.IncrementWallet(new IncrementWalletRequest
                {
                    WalletId = Id,
                    CredentialId = fresh.CredentialId,
                    WalletTypeId = walletTypeId,
                    Amount = difference,
                    ReferenceNumber = referenceNumber,
                    Remarks = remarks,
                    IdempotencyKey = $"controlpanel-adjust-{Guid.NewGuid():N}",
                    Metadata = BuildCommandMetadata(fresh.TenantId)
                })
                : await WalletsService.DecrementWallet(new DecrementWalletRequest
                {
                    WalletId = Id,
                    CredentialId = fresh.CredentialId,
                    WalletTypeId = walletTypeId,
                    Amount = Math.Abs(difference),
                    ReferenceNumber = referenceNumber,
                    Remarks = remarks,
                    IdempotencyKey = $"controlpanel-adjust-{Guid.NewGuid():N}",
                    Metadata = BuildCommandMetadata(fresh.TenantId)
                });

            if (response.IsSuccess)
            {
                ToastService.Show($"Balance adjustment submitted for {newBalance:N2}.");
                _adjustBalance = "";
                _adjustRemarks = "";
                await LoadWallet();
                await LoadTransactions();
            }
            else
            {
                ToastService.Show($"Failed to adjust balance: {response.Message}");
            }
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error adjusting balance: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private bool TryGetWalletTypeId(Wallet wallet, out Guid walletTypeId)
    {
        if (wallet.WalletTypeId is Guid value && value != Guid.Empty)
        {
            walletTypeId = value;
            return true;
        }

        walletTypeId = Guid.Empty;
        ToastService.Show("This wallet has no wallet type. Assign a wallet type before submitting money operations.");
        return false;
    }

    private async Task FreezeWallet()
    {
        try
        {
            var fresh = await DataContext.Query<Wallet>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id && !x.IsDeleted)
                .FirstOrDefaultAsync();

            if (fresh is null)
            {
                ToastService.Show("Wallet not found.");
                return;
            }

            if (fresh.Status != WalletStatus.Active)
            {
                ToastService.Show($"Cannot freeze. Wallet status is {fresh.Status}.");
                return;
            }

            var response = await WalletsService.FreezeWallet(new FreezeWalletRequest
            {
                WalletId = Id,
                Metadata = BuildCommandMetadata(fresh.TenantId)
            });

            if (response.IsSuccess)
            {
                ToastService.Show("Wallet frozen successfully.");
                await LoadWallet();
            }
            else
            {
                ToastService.Show($"Failed to freeze wallet: {response.Message}");
            }
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error freezing wallet: {ex.Message}");
        }
    }

    private async Task UnfreezeWallet()
    {
        try
        {
            var fresh = await DataContext.Query<Wallet>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id && !x.IsDeleted)
                .FirstOrDefaultAsync();

            if (fresh is null)
            {
                ToastService.Show("Wallet not found.");
                return;
            }

            if (fresh.Status != WalletStatus.Frozen)
            {
                ToastService.Show($"Cannot unfreeze. Wallet status is {fresh.Status}.");
                return;
            }

            var response = await WalletsService.UnfreezeWallet(new UnfreezeWalletRequest
            {
                WalletId = Id,
                Metadata = BuildCommandMetadata(fresh.TenantId)
            });

            if (response.IsSuccess)
            {
                ToastService.Show("Wallet unfrozen successfully.");
                await LoadWallet();
            }
            else
            {
                ToastService.Show($"Failed to unfreeze wallet: {response.Message}");
            }
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error unfreezing wallet: {ex.Message}");
        }
    }

    private async Task CloseWallet()
    {
        try
        {
            var fresh = await DataContext.Query<Wallet>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id && !x.IsDeleted)
                .FirstOrDefaultAsync();

            if (fresh is null)
            {
                ToastService.Show("Wallet not found.");
                return;
            }

            if (fresh.Status == WalletStatus.Closed)
            {
                ToastService.Show("Wallet is already closed.");
                _showCloseDialog = false;
                return;
            }

            ToastService.Show("Closing wallets requires the backend close-wallet workflow and was not applied.");
            _showCloseDialog = false;
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error closing wallet: {ex.Message}");
        }
    }

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantFilterChanged;
    }
