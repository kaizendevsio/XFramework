@page "/identity/credentials"

<PageTitle>Credentials - Control Panel</PageTitle>

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <BbTypographyH3>Credentials</BbTypographyH3>
    </div>

    @if (_loading)
    {
        <CenteredSpinner />
    }
    else
    {
    <BbDataGrid Items="@_credentials" ShowPagination="true" InitialPageSize="20" ShowSearch="true" SearchPlaceholder="Search credentials...">
        <Columns>
            <BbDataGridTemplateColumn Title="Avatar" Filterable="true" FilterBy="@(item => GetAvatarFilter(item))">
                <ChildContent Context="item">
                    <BbAvatar class="h-8 w-8">
                        @if (!string.IsNullOrWhiteSpace(item.AvatarUrl))
                        {
                            <BbAvatarImage Src="@item.AvatarUrl" Alt="@($"{GetCredentialLabel(item)} avatar")" />
                        }
                        <BbAvatarFallback>@GetCredentialInitials(item)</BbAvatarFallback>
                    </BbAvatar>
                </ChildContent>
            </BbDataGridTemplateColumn>
            <BbDataGridPropertyColumn Property="@(x => x.UserName)" Title="Username" Sortable="true" Filterable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.UserAlias)" Title="Alias" Sortable="true" Filterable="true" />
            <BbDataGridTemplateColumn Title="Identity" Filterable="true" FilterBy="@(item => GetIdentityLabel(item))">
                <ChildContent Context="item">
                    @GetIdentityLabel(item)
                </ChildContent>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn Title="Online" Filterable="true" FilterBy="@(item => GetOnlineLabel(item))">
                <ChildContent Context="item">
                    <StatusBadge Text="@(item.IsOnline ? "Online" : "Offline")"
                                 Status="@(item.IsOnline ? "online" : "inactive")" />
                </ChildContent>
            </BbDataGridTemplateColumn>
            <BbDataGridPropertyColumn Property="@(x => x.LastSeen)" Title="Last Seen" Sortable="true" Filterable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.Device)" Title="Device" Filterable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.Location)" Title="Location" Filterable="true" />
            <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
            <BbDataGridTemplateColumn Title="Actions">
                <ChildContent Context="item">
                    <div class="flex items-center gap-1">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                  OnClick="@(() => OpenAvatarDialog(item))">
                            <LucideIcon Name="image-up" class="h-4 w-4" />
                        </BbButton>
                        @if (HasAvatar(item))
                        {
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                      Disabled="@_saving"
                                      OnClick="@(() => RemoveCredentialAvatar(item))">
                                <LucideIcon Name="image-off" class="h-4 w-4 text-destructive" />
                            </BbButton>
                        }
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                  OnClick="@(() => Navigation.NavigateTo($"/identity/users/{item.IdentityInfoId}"))">
                            <LucideIcon Name="eye" class="h-4 w-4" />
                        </BbButton>
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <BbEmpty Title="No credentials" Description="No credentials found for the selected tenant." />
        </EmptyTemplate>
    </BbDataGrid>
    }
</div>

<BbDialog Open="@_avatarDialogOpen" OpenChanged="@(v => _avatarDialogOpen = v)">
    <BbDialogContent TrapFocus="false">
        <BbDialogHeader>
            <BbDialogTitle>Credential Avatar</BbDialogTitle>
            <BbDialogDescription>Upload a PNG, JPEG, or WebP image for this credential.</BbDialogDescription>
        </BbDialogHeader>
        @if (_avatarCredential is not null)
        {
            <div class="grid gap-4 py-4">
                <div class="flex items-center gap-3">
                    <BbAvatar class="h-10 w-10">
                        @if (!string.IsNullOrWhiteSpace(_avatarCredential.AvatarUrl))
                        {
                            <BbAvatarImage Src="@_avatarCredential.AvatarUrl" Alt="@($"{GetCredentialLabel(_avatarCredential)} avatar")" />
                        }
                        <BbAvatarFallback>@GetCredentialInitials(_avatarCredential)</BbAvatarFallback>
                    </BbAvatar>
                    <div>
                        <BbTypographySmall>@GetCredentialLabel(_avatarCredential)</BbTypographySmall>
                        <BbTypographyMuted>@GetIdentityLabel(_avatarCredential)</BbTypographyMuted>
                    </div>
                </div>
                <div class="space-y-2">
                    <BbLabel>Avatar image</BbLabel>
                    <BbFileUpload Files="@_avatarFiles"
                                  FilesChanged="@OnAvatarFilesChanged"
                                  Multiple="false"
                                  Accept="@AvatarAccept"
                                  MaxFileSize="@CredentialAvatarPolicy.MaxFileSizeBytes"
                                  MaxFileCount="1"
                                  ShowPreview="false"
                                  Disabled="@_saving" />
                    <BbTypographyMuted>PNG, JPEG, or WebP. Maximum size is 5 MB.</BbTypographyMuted>
                </div>
            </div>
        }
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@CloseAvatarDialog">Cancel</BbButton>
            <BbButton OnClick="@UploadCredentialAvatar" Disabled="@_saving">
                @(_saving ? "Uploading..." : "Upload")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Inject] private global::XFramework.Domain.Shared.DataContext.IDataContext DataContext { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private IIdentityServerServiceWrapper IdentityServer { get; set; } = default!;

    private List<IdentityCredential> _credentials = [];
    private bool _loading = true;
    private bool _saving;
    private bool _avatarDialogOpen;
    private IdentityCredential? _avatarCredential;
    private List<FileUploadItem> _avatarFiles = [];
    private const string AvatarAccept = "image/png,image/jpeg,image/webp";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var query = DataContext.Query<IdentityCredential>()
                .Include(x => x.IdentityInfo);
            if (TenantFilter.SelectedTenantId is { } tenantId)
            {
                query = query.Where(x => x.TenantId == tenantId);
            }

            _credentials = (await query.Take(100).ToListAsync())
                .OrderByDescending(x => x.CreatedAt)
                .ToList();
        }
        catch
        {
            _credentials = [];
            ToastService.Error("Credentials could not be loaded.", "Load failed");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetIdentityLabel(IdentityCredential credential)
    {
        var identity = credential.IdentityInfo;
        if (!string.IsNullOrWhiteSpace(identity?.FullName))
            return identity.FullName;

        if (!string.IsNullOrWhiteSpace(identity?.IdentityName))
            return identity.IdentityName;

        return "Unknown identity";
    }

    private static string GetOnlineLabel(IdentityCredential credential) =>
        credential.IsOnline ? "Online" : "Offline";

    private static string GetCredentialLabel(IdentityCredential credential)
    {
        if (!string.IsNullOrWhiteSpace(credential.UserName))
            return credential.UserName;

        if (!string.IsNullOrWhiteSpace(credential.UserAlias))
            return credential.UserAlias;

        return credential.Id.ToString()[..8];
    }

    private static string GetCredentialInitials(IdentityCredential credential)
    {
        var label = GetCredentialLabel(credential);
        var parts = label
            .Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();

        return label.Length >= 2
            ? label[..2].ToUpperInvariant()
            : label.ToUpperInvariant();
    }

    private static string GetAvatarFilter(IdentityCredential credential) =>
        HasAvatar(credential) ? "Has avatar" : "No avatar";

    private static bool HasAvatar(IdentityCredential credential) =>
        credential.AvatarStorageFileId.HasValue || !string.IsNullOrWhiteSpace(credential.AvatarUrl);

    private void OpenAvatarDialog(IdentityCredential credential)
    {
        _avatarCredential = credential;
        _avatarFiles = [];
        _avatarDialogOpen = true;
    }

    private void CloseAvatarDialog()
    {
        _avatarDialogOpen = false;
        _avatarCredential = null;
        _avatarFiles = [];
    }

    private void OnAvatarFilesChanged()
    {
        StateHasChanged();
    }

    private async Task UploadCredentialAvatar()
    {
        if (_avatarCredential is null)
            return;

        var uploadItem = _avatarFiles.FirstOrDefault();
        var file = uploadItem?.File;
        if (file is null)
        {
            ToastService.Warning("Choose an image file.", "Missing image");
            return;
        }

        if (!CredentialAvatarPolicy.IsAllowedContentType(file.ContentType))
        {
            ToastService.Warning("Use a PNG, JPEG, or WebP image.", "Unsupported image");
            return;
        }

        if (file.Size > CredentialAvatarPolicy.MaxFileSizeBytes)
        {
            ToastService.Warning("Avatar image must be 5 MB or smaller.", "Image too large");
            return;
        }

        _saving = true;
        try
        {
            await using var stream = file.OpenReadStream(CredentialAvatarPolicy.MaxFileSizeBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var result = await IdentityServer.UploadCredentialAvatar(new UploadCredentialAvatarRequest
            {
                CredentialId = _avatarCredential.Id,
                FileName = file.Name,
                ContentType = file.ContentType,
                FileBytes = buffer.ToArray(),
                Metadata = CreateMetadata(_avatarCredential.TenantId)
            });

            if (result.IsSuccess)
            {
                ToastService.Success("Credential avatar uploaded.", "Avatar saved");
                CloseAvatarDialog();
                await LoadData();
            }
            else
            {
                ToastService.Error("Credential avatar could not be uploaded.", "Upload failed");
            }
        }
        catch
        {
            ToastService.Error("Credential avatar could not be uploaded.", "Upload failed");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RemoveCredentialAvatar(IdentityCredential credential)
    {
        _saving = true;
        try
        {
            var result = await IdentityServer.RemoveCredentialAvatar(new RemoveCredentialAvatarRequest
            {
                CredentialId = credential.Id,
                Metadata = CreateMetadata(credential.TenantId)
            });

            if (result.IsSuccess)
            {
                ToastService.Success("Credential avatar removed.", "Avatar removed");
                await LoadData();
            }
            else
            {
                ToastService.Error("Credential avatar could not be removed.", "Remove failed");
            }
        }
        catch
        {
            ToastService.Error("Credential avatar could not be removed.", "Remove failed");
        }
        finally
        {
            _saving = false;
        }
    }

    private static RequestMetadata CreateMetadata(Guid? tenantId) => new()
    {
        TenantId = tenantId,
        RequestId = Guid.NewGuid(),
        Name = "ControlPanel",
        DeviceName = "ControlPanel",
        DeviceAgent = "ControlPanel",
        IpAddress = "ControlPanel"
    };
}
