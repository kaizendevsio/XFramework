@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string? Section { get; set; }

    [Inject] private global::XFramework.Domain.Shared.DataContext.IDataContext DataContext { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private TenantFilterService TenantFilter { get; set; } = default!;
    [Inject] private TenantModuleNavigationService ModuleNavigation { get; set; } = default!;
    [Inject] private AttendanceControlPanelReadService AttendanceReadService { get; set; } = default!;
    [Inject] private IIdentityServerServiceWrapper IdentityServer { get; set; } = default!;

    // Main data
    private IdentityInformation? _user;
    private List<IdentityCredential> _credentials = [];
    private List<IdentityRole> _roles = [];
    private List<IdentityContact> _contacts = [];
    private List<IdentityAddress> _addresses = [];
    private List<Session> _sessions = [];
    private List<AuthorizationLog> _authLogs = [];
    private List<Wallet> _wallets = [];
    private List<AttendanceUserParticipationRow> _attendanceParticipations = [];
    private List<AttendanceUserRecordRow> _attendanceRecords = [];

    // Lookup data
    private List<IdentityRoleType> _roleTypes = [];
    private List<IdentityContactType> _contactTypes = [];
    private List<IdentityContactGroup> _contactGroups = [];

    // State
    private bool _loading = true;
    private bool _saving;
    private bool _outsideTenantContext;
    private bool _attendanceModuleEnabled;
    private Guid? _loadedId;
    private string _attendanceCredentialFilter = AllAttendanceCredentialsValue;
    private string CurrentSection => NormalizeSection(Section);

    // Editable form
    private EditableForm<IdentityInformation>? _editableForm;
    private string? _editFirstName;
    private string? _editMiddleName;
    private string? _editLastName;
    private string? _editSuffix;
    private string? _editIdentityName;
    private string? _editBirthDate;
    private string? _editGender;
    private string? _editCivilStatus;
    private string? _editIsVerified;

    // Select options
    private List<SelectOption<string>> _genderOptions = Enum.GetValues<Gender>().Select(g => new SelectOption<string>(g.ToString(), g.ToString())).ToList();
    private List<SelectOption<string>> _civilStatusOptions = Enum.GetValues<CivilStatus>().Select(cs => new SelectOption<string>(cs.ToString(), cs.ToString())).ToList();
    private List<SelectOption<string>> CredentialOptions =>
        _credentials.Select(x => new SelectOption<string>(x.Id.ToString(), GetCredentialLabel(x))).ToList();
    private List<SelectOption<string>> RoleTypeOptions =>
        _roleTypes.Select(x => new SelectOption<string>(x.Id.ToString(), GetRoleTypeLabel(x))).ToList();
    private List<SelectOption<string>> ContactTypeOptions =>
        _contactTypes.Select(x => new SelectOption<string>(x.Id.ToString(), GetContactTypeLabel(x))).ToList();
    private const string AllAttendanceCredentialsValue = "all";
    private static readonly DateTime NoRoleExpirationUtc = new(9999, 12, 31, 23, 59, 59, DateTimeKind.Utc);

    // Create Credential dialog
    private bool _createCredDialogOpen;
    private CredentialForm _credForm = new();

    // Assign Role dialog
    private bool _assignRoleDialogOpen;
    private RoleForm _roleForm = new();

    // Remove Role dialog
    private bool _removeRoleDialogOpen;
    private IdentityRole? _removingRole;

    // Contact dialog
    private bool _contactDialogOpen;
    private ContactForm _contactForm = new();

    // Address dialog
    private bool _addressDialogOpen;
    private AddressForm _addressForm = new();

    protected override void OnInitialized()
    {
        TenantFilter.OnChanged += OnTenantFilterChanged;
        ModuleNavigation.OnChanged += OnTenantFilterChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var normalizedSection = NormalizeSection(Section);
        if (ShouldCanonicalizeSection(normalizedSection))
        {
            Navigation.NavigateTo(GetSectionHref(normalizedSection), replace: true);
        }

        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await ReloadAllData();
    }

    private bool ShouldCanonicalizeSection(string normalizedSection) =>
        Section is not null
        && (!string.Equals(Section, normalizedSection, StringComparison.OrdinalIgnoreCase)
            || normalizedSection == "summary");

    private string GetSectionHref(string section) =>
        section == "summary" ? $"/identity/users/{Id}" : $"/identity/users/{Id}/{section}";

    private static string NormalizeSection(string? section)
    {
        if (string.IsNullOrWhiteSpace(section) || section.Equals("info", StringComparison.OrdinalIgnoreCase))
        {
            return "summary";
        }

        var normalized = section.ToLowerInvariant();
        return normalized is "summary"
            or "credentials"
            or "roles"
            or "contacts"
            or "addresses"
            or "sessions"
            or "auth-logs"
            or "attendance"
            or "wallets"
            ? normalized
            : "summary";
    }

    private void OnTenantFilterChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await ReloadAllData();
            StateHasChanged();
        });
    }

    private async Task ReloadAllData()
    {
        _loading = true;
        try
        {
            _outsideTenantContext = false;
            await ModuleNavigation.EnsureLoadedAsync();
            _attendanceModuleEnabled = ModuleNavigation.IsFeatureEnabled(TenantModuleFeatureKeys.Attendance);
            _user = await DataContext.Query<IdentityInformation>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id)
                .FirstOrDefaultAsync();

            if (_user is null)
            {
                ClearChildData();
                return;
            }
            _outsideTenantContext = TenantFilter.SelectedTenantId is Guid tenantId && tenantId != _user.TenantId;
            if (_outsideTenantContext)
            {
                ClearChildData();
                return;
            }

            SyncEditFields();
            await LoadCredentials();
            await LoadRoles();
            await LoadContacts();
            await LoadAddresses();
            await LoadSessions();
            await LoadAuthLogs();
            await LoadWallets();
            await LoadAttendance();
            await LoadLookups();
        }
        catch
        {
            ToastService.Error("The user data could not be loaded.", "Load failed");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ClearChildData()
    {
        _credentials = [];
        _roles = [];
        _contacts = [];
        _addresses = [];
        _sessions = [];
        _authLogs = [];
        _wallets = [];
        _attendanceParticipations = [];
        _attendanceRecords = [];
    }

    private async Task LoadCredentials()
    {
        try
        {
            _credentials = (await DataContext.Query<IdentityCredential>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(x => x.IdentityInfoId == Id)
                    .OrderByDescending(x => x.CreatedAt)
                    .Take(100)
                    .ToListAsync())
                .ToList();
        }
        catch { _credentials = []; }
    }

    private async Task LoadRoles()
    {
        try
        {
            var credentialIds = _credentials.Select(c => c.Id).ToList();
            _roles = [];
            foreach (var credId in credentialIds)
            {
                var roles = await DataContext.Query<IdentityRole>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(x => x.CredentialId == credId)
                    .Include(x => x.Type)
                    .OrderByDescending(x => x.CreatedAt)
                    .Take(100)
                    .ToListAsync();
                _roles.AddRange(roles);
            }
            _roles = _roles.OrderByDescending(x => x.CreatedAt).ToList();
        }
        catch { _roles = []; }
    }

    private async Task LoadContacts()
    {
        try
        {
            var credentialIds = _credentials.Select(c => c.Id).ToList();
            _contacts = [];
            foreach (var credId in credentialIds)
            {
                var contacts = await DataContext.Query<IdentityContact>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(x => x.CredentialId == credId)
                    .Include(x => x.Type)
                    .OrderByDescending(x => x.CreatedAt)
                    .Take(100)
                    .ToListAsync();
                _contacts.AddRange(contacts);
            }
            _contacts = _contacts.OrderByDescending(x => x.CreatedAt).ToList();
        }
        catch { _contacts = []; }
    }

    private async Task LoadAddresses()
    {
        try
        {
            _addresses = (await DataContext.Query<IdentityAddress>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(x => x.IdentityInfoId == Id)
                    .OrderByDescending(x => x.CreatedAt)
                    .Take(100)
                    .ToListAsync())
                .ToList();
        }
        catch { _addresses = []; }
    }

    private async Task LoadSessions()
    {
        try
        {
            var credentialIds = _credentials.Select(c => c.Id).ToList();
            _sessions = [];
            foreach (var credId in credentialIds)
            {
                var sessions = await DataContext.Query<Session>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(x => x.CredentialId == credId)
                    .Include(x => x.SessionType)
                    .OrderByDescending(x => x.CreatedAt)
                    .Take(100)
                    .ToListAsync();
                _sessions.AddRange(sessions);
            }
            _sessions = _sessions.OrderByDescending(x => x.CreatedAt).ToList();
        }
        catch { _sessions = []; }
    }

    private async Task LoadAuthLogs()
    {
        try
        {
            var credentialIds = _credentials.Select(c => c.Id).ToList();
            _authLogs = [];
            foreach (var credId in credentialIds)
            {
                var authLogs = await DataContext.Query<AuthorizationLog>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(x => x.CredentialId == credId)
                    .OrderByDescending(x => x.CreatedAt)
                    .Take(100)
                    .ToListAsync();
                _authLogs.AddRange(authLogs);
            }
            _authLogs = _authLogs.OrderByDescending(x => x.CreatedAt).ToList();
        }
        catch { _authLogs = []; }
    }

    private async Task LoadWallets()
    {
        try
        {
            var credentialIds = _credentials.Select(c => c.Id).ToList();
            _wallets = [];
            foreach (var credId in credentialIds)
            {
                var wallets = await DataContext.Query<Wallet>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .Where(x => x.CredentialId == credId)
                    .OrderByDescending(x => x.CreatedAt)
                    .Take(100)
                    .ToListAsync();
                _wallets.AddRange(wallets);
            }
            _wallets = _wallets.OrderByDescending(x => x.CreatedAt).ToList();
        }
        catch { _wallets = []; }
    }

    private async Task LoadAttendance()
    {
        try
        {
            if (_user is null
                || TenantFilter.SelectedTenantId is not Guid tenantId
                || !_attendanceModuleEnabled)
            {
                _attendanceParticipations = [];
                _attendanceRecords = [];
                return;
            }

            _attendanceParticipations = (await AttendanceReadService.LoadUserParticipationRowsAsync(tenantId, Id)).ToList();

            Guid? credentialId = Guid.TryParse(_attendanceCredentialFilter, out var parsedCredentialId)
                ? parsedCredentialId
                : null;

            _attendanceRecords = (await AttendanceReadService.LoadUserRecordRowsAsync(tenantId, Id, credentialId)).ToList();
        }
        catch
        {
            _attendanceParticipations = [];
            _attendanceRecords = [];
        }
    }

    private async Task OnAttendanceCredentialFilterChanged(string value)
    {
        _attendanceCredentialFilter = string.IsNullOrWhiteSpace(value) ? AllAttendanceCredentialsValue : value;
        await LoadAttendance();
    }

    private async Task LoadLookups()
    {
        try
        {
            _roleTypes = (await DataContext.Query<IdentityRoleType>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .OrderBy(x => x.Name)
                    .Take(100)
                    .ToListAsync())
                .ToList();

            _contactTypes = (await DataContext.Query<IdentityContactType>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .OrderBy(x => x.Name)
                    .Take(100)
                    .ToListAsync())
                .ToList();

            _contactGroups = (await DataContext.Query<IdentityContactGroup>()
                    .IgnoreQueryFilters()
                    .NoCache()
                    .OrderBy(x => x.Name)
                    .Take(100)
                    .ToListAsync())
                .ToList();
        }
        catch { /* lookups may fail */ }
    }

    // ─── Edit User ────────────────────────────────────────────────────

    private void SyncEditFields()
    {
        if (_user is null) return;
        _editFirstName = _user.FirstName;
        _editMiddleName = _user.MiddleName;
        _editLastName = _user.LastName;
        _editSuffix = _user.Suffix;
        _editIdentityName = _user.IdentityName;
        _editBirthDate = _user.BirthDate?.ToString("yyyy-MM-dd") ?? "";
        _editGender = _user.Gender?.ToString() ?? "";
        _editCivilStatus = _user.CivilStatus?.ToString() ?? "";
        _editIsVerified = _user.IsVerified.ToString().ToLower();
    }

    private void DiscardUserEdit() => SyncEditFields();

    private async Task SaveUserEdit()
    {
        _saving = true;
        try
        {
            var fresh = await DataContext.Query<IdentityInformation>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == Id)
                .FirstOrDefaultAsync();

            if (fresh is null)
            {
                ToastService.Warning("User was not found.", "User unavailable");
                return;
            }

            fresh.FirstName = _editFirstName;
            fresh.MiddleName = _editMiddleName;
            fresh.LastName = _editLastName;
            fresh.Suffix = _editSuffix;
            fresh.IdentityName = _editIdentityName;
            fresh.BirthDate = DateOnly.TryParse(_editBirthDate, out var d) ? d : null;
            fresh.Gender = Enum.TryParse<Gender>(_editGender, out var g) ? g : null;
            fresh.CivilStatus = Enum.TryParse<CivilStatus>(_editCivilStatus, out var cs) ? cs : null;
            fresh.IsVerified = _editIsVerified == "true";
            fresh.ModifiedAt = DateTime.UtcNow;

            DataContext.Update(fresh);
            var result = await DataContext.SaveChangesAsync();

            if (result.IsSuccess)
            {
                ToastService.Success("User updated successfully.", "User saved");
                _user = fresh;
                SyncEditFields();
                _editableForm?.ExitEditMode();
            }
            else
            {
                ToastService.Error("User could not be updated.", "Save failed");
            }
        }
        catch
        {
            ToastService.Error("User could not be updated.", "Save failed");
        }
        finally
        {
            _saving = false;
        }
    }

