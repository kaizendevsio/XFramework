@page "/identity/users/{Id:guid}"
@page "/identity/users/{Id:guid}/{Section}"
@using global::Wallets.Domain.Shared.Enums
@implements IDisposable

<PageTitle>User Detail - Control Panel</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (_user is null)
{
    <div class="space-y-4">
        <BbButton Variant="ButtonVariant.Ghost" OnClick="@(() => Navigation.NavigateTo("/identity/users"))">
            <LucideIcon Name="arrow-left" class="mr-2 h-4 w-4" />
            Back to Users
        </BbButton>
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertTitle>User Not Found</BbAlertTitle>
            <BbAlertDescription>No user found with the specified ID.</BbAlertDescription>
        </BbAlert>
    </div>
}
else if (_outsideTenantContext)
{
    <div class="space-y-4">
        <BbButton Variant="ButtonVariant.Ghost" OnClick="@(() => Navigation.NavigateTo("/identity/users"))">
            <LucideIcon Name="arrow-left" class="mr-2 h-4 w-4" />
            Back to Users
        </BbButton>
        <BbAlert>
            <BbAlertTitle>User Outside Active Tenant</BbAlertTitle>
            <BbAlertDescription>Switch to All Tenants or the user's tenant to view this record.</BbAlertDescription>
        </BbAlert>
    </div>
}
else
{
    <FadeInContent>
    <div class="space-y-6">
        <!-- Header -->
        <div class="xf-page-header">
            <div class="flex items-center gap-4">
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                          OnClick="@(() => Navigation.NavigateTo("/identity/users"))">
                    <LucideIcon Name="arrow-left" class="h-4 w-4" />
                </BbButton>
                <div>
                    <div class="flex items-center gap-2">
                        <BbTypographyH3>@(_user.FullName ?? "Unnamed User")</BbTypographyH3>
                        <StatusBadge Text="@(_user.IsVerified ? "Verified" : "Unverified")"
                                     Status="@(_user.IsVerified ? "active" : "inactive")" />
                        <StatusBadge Text="@(_user.IsEnabled ? "Enabled" : "Disabled")"
                                     Status="@(_user.IsEnabled ? "active" : "inactive")" />
                    </div>
                    <BbTypographyMuted>@(_user.IdentityName ?? "No identity name") &mdash; ID: @_user.Id.ToString()[..8]...</BbTypographyMuted>
                </div>
            </div>
            <div class="xf-page-actions">
                <BbButton Variant="ButtonVariant.Outline" OnClick="@ReloadAllData">
                    <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                    Refresh
                </BbButton>
            </div>
        </div>

        @switch (CurrentSection)
        {
            case "summary":
                <div class="xf-fade-in">
                <EditableForm @ref="_editableForm" TModel="IdentityInformation" Model="_user"
                              OnSave="SaveUserEdit" OnDiscard="DiscardUserEdit"
                              Saving="_saving" Title="User Information">
                    <div class="xf-detail-field-grid">
                        <EditableField Label="First Name" @bind-Value="_editFirstName" />
                        <EditableField Label="Middle Name" @bind-Value="_editMiddleName" />
                        <EditableField Label="Last Name" @bind-Value="_editLastName" />
                        <EditableField Label="Suffix" @bind-Value="_editSuffix" />
                        <EditableField Label="Identity Name" @bind-Value="_editIdentityName" />
                        <EditableField Label="Birth Date" @bind-Value="_editBirthDate"
                                       DisplayValue="@(_user.BirthDate?.ToString("yyyy-MM-dd") ?? "N/A")"
                                       Placeholder="YYYY-MM-DD" />
                        <EditableField Label="Gender" @bind-Value="_editGender"
                                       FieldType="EditableFieldType.Select"
                                       Options="_genderOptions"
                                       DisplayValue="@(_user.Gender?.ToString() ?? "N/A")" />
                        <EditableField Label="Civil Status" @bind-Value="_editCivilStatus"
                                       FieldType="EditableFieldType.Select"
                                       Options="_civilStatusOptions"
                                       DisplayValue="@(_user.CivilStatus?.ToString() ?? "N/A")" />
                        <EditableField Label="Verified" @bind-Value="_editIsVerified"
                                       FieldType="EditableFieldType.Switch"
                                       DisplayValue="@(_user.IsVerified ? "Verified" : "Unverified")" />
                        <EditableField Label="Created" DisplayValue="@_user.CreatedAt.ToString("g")" ReadOnly="true" />
                    </div>
                </EditableForm>
                </div>
                break;

            case "credentials":
                <div class="xf-fade-in">
                <BbCard>
                    <BbCardHeader>
                        <div class="flex items-center justify-between">
                            <BbCardTitle>Credentials</BbCardTitle>
                            <BbButton Size="ButtonSize.Small" OnClick="@OpenCreateCredentialDialog">
                                <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                                Add Credential
                            </BbButton>
                        </div>
                    </BbCardHeader>
                    <BbCardContent>
                        <BbDataGrid Items="@_credentials" ShowPagination="true" InitialPageSize="10" ShowSearch="true" SearchPlaceholder="Search credentials...">
                            <Columns>
                                <BbDataGridPropertyColumn Property="@(x => x.UserName)" Title="Username" Sortable="true" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.UserAlias)" Title="Alias" Sortable="true" Filterable="true" />
                                <BbDataGridTemplateColumn Title="Online" Filterable="true" FilterBy="@(cred => GetCredentialOnlineFilter(cred))">
                                    <ChildContent Context="cred">
                                        <StatusBadge Text="@(cred.IsOnline ? "Online" : "Offline")"
                                                     Status="@(cred.IsOnline ? "online" : "inactive")" />
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="Last Seen">
                                    <ChildContent Context="cred">
                                        @(cred.LastSeen == default ? "Never" : cred.LastSeen.ToString("g"))
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridPropertyColumn Property="@(x => x.Device)" Title="Device" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.Location)" Title="Location" Filterable="true" />
                                <BbDataGridTemplateColumn Title="Status" Filterable="true" FilterBy="@(cred => GetEnabledFilter(cred.IsEnabled))">
                                    <ChildContent Context="cred">
                                        <StatusBadge Text="@(cred.IsEnabled ? "Enabled" : "Disabled")"
                                                     Status="@(cred.IsEnabled ? "active" : "inactive")" />
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
                            </Columns>
                            <EmptyTemplate>
                                <BbEmpty Title="No credentials" Description="No credentials are linked to this user." />
                            </EmptyTemplate>
                        </BbDataGrid>
                    </BbCardContent>
                </BbCard>
                </div>
                break;

            case "roles":
                <div class="xf-fade-in">
                <BbCard>
                    <BbCardHeader>
                        <div class="flex items-center justify-between">
                            <BbCardTitle>Assigned Roles</BbCardTitle>
                            <BbButton Size="ButtonSize.Small" OnClick="@OpenAssignRoleDialog">
                                <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                                Assign Role
                            </BbButton>
                        </div>
                    </BbCardHeader>
                    <BbCardContent>
                        <BbDataGrid Items="@_roles" ShowPagination="true" InitialPageSize="10" ShowSearch="true" SearchPlaceholder="Search roles...">
                            <Columns>
                                <BbDataGridTemplateColumn Title="Role Type" Sortable="true" Filterable="true" FilterBy="@(role => GetRoleTypeColumnFilter(role))">
                                    <ChildContent Context="role">
                                        @(role.Type?.Name ?? "Unknown role type")
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="Credential" Filterable="true" FilterBy="@(role => GetCredentialLabelById(role.CredentialId))">
                                    <ChildContent Context="role">
                                        @{
                                            var roleCred = _credentials.FirstOrDefault(c => c.Id == role.CredentialId);
                                        }
                                        <span class="text-sm">@(roleCred is null ? "Unknown credential" : GetCredentialLabel(roleCred))</span>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="Level">
                                    <ChildContent Context="role">
                                        @(role.Type?.RoleLevel?.ToString() ?? "N/A")
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="Expiration" Sortable="true">
                                    <ChildContent Context="role">
                                        @{
                                            var hasNoExpiration = IsRoleExpirationUnlimited(role.RoleExpiration);
                                            var isExpired = !hasNoExpiration && role.RoleExpiration < DateTime.UtcNow;
                                        }
                                        <span class="@(isExpired ? "text-destructive" : "")">
                                            @(hasNoExpiration ? "No expiration" : role.RoleExpiration.ToLocalTime().ToString("g"))
                                            @if (isExpired)
                                            {
                                                <span class="ml-1 text-xs">(expired)</span>
                                            }
                                        </span>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
                                <BbDataGridTemplateColumn Title="Actions">
                                    <ChildContent Context="role">
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                                  OnClick="@(() => OpenRemoveRoleDialog(role))">
                                            <LucideIcon Name="trash-2" class="h-4 w-4 text-destructive" />
                                        </BbButton>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                            </Columns>
                            <EmptyTemplate>
                                <BbEmpty Title="No assigned roles" Description="No roles are assigned to this user's credentials." />
                            </EmptyTemplate>
                        </BbDataGrid>
                    </BbCardContent>
                </BbCard>
                </div>
                break;

            case "contacts":
                <div class="xf-fade-in">
                <BbCard>
                    <BbCardHeader>
                        <div class="flex items-center justify-between">
                            <BbCardTitle>Contacts</BbCardTitle>
                            <BbButton Size="ButtonSize.Small" OnClick="@OpenCreateContactDialog">
                                <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                                Add Contact
                            </BbButton>
                        </div>
                    </BbCardHeader>
                    <BbCardContent>
                        <BbDataGrid Items="@_contacts" ShowPagination="true" InitialPageSize="10" ShowSearch="true" SearchPlaceholder="Search contacts...">
                            <Columns>
                                <BbDataGridPropertyColumn Property="@(x => x.Value)" Title="Value" Sortable="true" Filterable="true" />
                                <BbDataGridTemplateColumn Title="Type" Filterable="true" FilterBy="@(contact => GetContactTypeColumnFilter(contact))">
                                    <ChildContent Context="contact">
                                        @(contact.Type?.Name ?? "N/A")
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="Credential" Filterable="true" FilterBy="@(contact => GetCredentialLabelById(contact.CredentialId))">
                                    <ChildContent Context="contact">
                                        @{
                                            var contactCred = _credentials.FirstOrDefault(c => c.Id == contact.CredentialId);
                                        }
                                        <span class="text-sm">@(contactCred is null ? "Unknown credential" : GetCredentialLabel(contactCred))</span>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
                                <BbDataGridTemplateColumn Title="Actions">
                                    <ChildContent Context="contact">
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                                  OnClick="@(() => Navigation.NavigateTo($"/identity/contacts/{contact.Id}"))">
                                            <LucideIcon Name="external-link" class="mr-1 h-3 w-3" />
                                            View
                                        </BbButton>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                            </Columns>
                            <EmptyTemplate>
                                <BbEmpty Title="No contacts" Description="No contact records are linked to this user." />
                            </EmptyTemplate>
                        </BbDataGrid>
                    </BbCardContent>
                </BbCard>
                </div>
                break;

            case "addresses":
                <div class="xf-fade-in">
                <BbCard>
                    <BbCardHeader>
                        <div class="flex items-center justify-between">
                            <BbCardTitle>Addresses</BbCardTitle>
                            <BbButton Size="ButtonSize.Small" OnClick="@OpenCreateAddressDialog">
                                <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                                Add Address
                            </BbButton>
                        </div>
                    </BbCardHeader>
                    <BbCardContent>
                        <BbDataGrid Items="@_addresses" ShowPagination="true" InitialPageSize="10" ShowSearch="true" SearchPlaceholder="Search addresses...">
                            <Columns>
                                <BbDataGridPropertyColumn Property="@(x => x.UnitNumber)" Title="Unit" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.Street)" Title="Street" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.Building)" Title="Building" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.Subdivision)" Title="Subdivision" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.ConsolidatedName)" Title="Full Address" Filterable="true" />
                                <BbDataGridTemplateColumn Title="Default" Filterable="true" FilterBy="@(addr => GetDefaultAddressFilter(addr))">
                                    <ChildContent Context="addr">
                                        <StatusBadge Text="@(addr.DefaultAddress == true ? "Default" : "No")"
                                                     Status="@(addr.DefaultAddress == true ? "active" : "inactive")" />
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
                                <BbDataGridTemplateColumn Title="Actions">
                                    <ChildContent Context="addr">
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                                  OnClick="@(() => Navigation.NavigateTo($"/identity/addresses/{addr.Id}"))">
                                            <LucideIcon Name="external-link" class="mr-1 h-3 w-3" />
                                            View
                                        </BbButton>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                            </Columns>
                            <EmptyTemplate>
                                <BbEmpty Title="No addresses" Description="No address records are linked to this user." />
                            </EmptyTemplate>
                        </BbDataGrid>
                    </BbCardContent>
                </BbCard>
                </div>
                break;

            case "sessions":
                <div class="xf-fade-in">
                <BbCard>
                    <BbCardHeader>
                        <BbCardTitle>Sessions</BbCardTitle>
                    </BbCardHeader>
                    <BbCardContent>
                        <BbDataGrid Items="@_sessions" ShowPagination="true" InitialPageSize="10" ShowSearch="true" SearchPlaceholder="Search sessions...">
                            <Columns>
                                <BbDataGridTemplateColumn Title="Credential" Filterable="true" FilterBy="@(session => GetCredentialLabelById(session.CredentialId))">
                                    <ChildContent Context="session">
                                        @{
                                            var sessCred = _credentials.FirstOrDefault(c => c.Id == session.CredentialId);
                                        }
                                        <span class="text-sm">@(sessCred is null ? "Unknown credential" : GetCredentialLabel(sessCred))</span>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="Status" Filterable="true" FilterBy="@(session => session.Status.ToString())">
                                    <ChildContent Context="session">
                                        @{
                                            var sessStatusText = session.Status.ToString();
                                            var sessStatusKey = session.Status switch
                                            {
                                                CurrentSessionState.Active => "active",
                                                CurrentSessionState.Inactive => "inactive",
                                                CurrentSessionState.Expired => "expired",
                                                CurrentSessionState.Suspended => "suspended",
                                                _ => "inactive"
                                            };
                                        }
                                        <StatusBadge Text="@sessStatusText" Status="@sessStatusKey" />
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="Session Type" Filterable="true" FilterBy="@(session => GetSessionTypeLabel(session))">
                                    <ChildContent Context="session">
                                        @GetSessionTypeLabel(session)
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="Expires At" Sortable="true">
                                    <ChildContent Context="session">
                                        @(session.ExpiresAt?.ToString("g") ?? "N/A")
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" Filterable="true" />
                                <BbDataGridTemplateColumn Title="Actions">
                                    <ChildContent Context="session">
                                        @if (session.Status == CurrentSessionState.Active)
                                        {
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                                      OnClick="@(() => TerminateSession(session))">
                                                Terminate
                                            </BbButton>
                                        }
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                            </Columns>
                            <EmptyTemplate>
                                <BbEmpty Title="No sessions" Description="No sessions are linked to this user's credentials." />
                            </EmptyTemplate>
                        </BbDataGrid>
                    </BbCardContent>
                </BbCard>
                </div>
                break;

            case "auth-logs":
                <div class="xf-fade-in">
                <BbCard>
                    <BbCardHeader>
                        <BbCardTitle>Authorization Logs</BbCardTitle>
                    </BbCardHeader>
                    <BbCardContent>
                        <BbDataGrid Items="@_authLogs" ShowPagination="true" InitialPageSize="20" ShowSearch="true" SearchPlaceholder="Search authorization logs...">
                            <Columns>
                                <BbDataGridTemplateColumn Title="Credential" Filterable="true" FilterBy="@(log => GetCredentialLabelById(log.CredentialId))">
                                    <ChildContent Context="log">
                                        @{
                                            var logCred = _credentials.FirstOrDefault(c => c.Id == log.CredentialId);
                                        }
                                        <span class="text-sm">@(logCred is null ? "Unknown credential" : GetCredentialLabel(logCred))</span>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="Result" Filterable="true" FilterBy="@(log => GetAuthorizationLogResultFilter(log))">
                                    <ChildContent Context="log">
                                        <StatusBadge Text="@(log.IsSuccess == true ? "Success" : log.IsSuccess == false ? "Failed" : "Unknown")"
                                                     Status="@(log.IsSuccess == true ? "success" : log.IsSuccess == false ? "failed" : "inactive")" />
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridPropertyColumn Property="@(x => x.Ipaddress)" Title="IP Address" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.LoginSource)" Title="Source" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.DeviceName)" Title="Device" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.DeviceAgent)" Title="Agent" Filterable="true" />
                                <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Time" Sortable="true" Filterable="true" />
                            </Columns>
                            <EmptyTemplate>
                                <BbEmpty Title="No authorization logs" Description="No authorization logs are linked to this user's credentials." />
                            </EmptyTemplate>
                        </BbDataGrid>
                    </BbCardContent>
                </BbCard>
                </div>
                break;

            case "attendance":
                <div class="xf-fade-in">
                @if (TenantFilter.SelectedTenantId is not Guid)
                {
                    <ModuleUnavailable ModuleName="Attendance" RequiresTenant="true" />
                }
                else if (!_attendanceModuleEnabled)
                {
                    <ModuleUnavailable ModuleName="Attendance" />
                }
                else
                {
                    <div class="space-y-6">
                        <BbCard>
                            <BbCardHeader>
                                <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                                    <div>
                                        <BbCardTitle>Attendance</BbCardTitle>
                                        <BbCardDescription>Read-only attendance participation and session records across this user's credentials.</BbCardDescription>
                                    </div>
                                    <div class="w-full md:w-80">
                                        <BbFormFieldSelect TValue="string"
                                                           Value="@_attendanceCredentialFilter"
                                                           ValueChanged="@OnAttendanceCredentialFilterChanged"
                                                           Label="Credential">
                                            <BbSelectItem Value="@AllAttendanceCredentialsValue">All credentials</BbSelectItem>
                                            @foreach (var credential in _credentials)
                                            {
                                                <BbSelectItem Value="@credential.Id.ToString()">@GetCredentialLabel(credential)</BbSelectItem>
                                            }
                                        </BbFormFieldSelect>
                                    </div>
                                </div>
                            </BbCardHeader>
                            <BbCardContent>
                                <BbDataGrid Items="@_attendanceParticipations"
                                            ShowPagination="true"
                                            InitialPageSize="10"
                                            ShowSearch="true"
                                            SearchPlaceholder="Search participation...">
                                    <Columns>
                                        <BbDataGridPropertyColumn Property="@(x => x.ContextName)" Title="Context" Sortable="true" Filterable="true" />
                                        <BbDataGridTemplateColumn Title="Type" Sortable="true" Filterable="true" FilterBy="@(item => item.ContextType.ToString())">
                                            <ChildContent Context="item">@AttendanceControlPanelReadService.FormatEnumLabel(item.ContextType)</ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridPropertyColumn Property="@(x => x.CredentialLabel)" Title="Credential" Sortable="true" Filterable="true" />
                                        <BbDataGridPropertyColumn Property="@(x => x.DisplayName)" Title="Display Name" Sortable="true" Filterable="true" />
                                        <BbDataGridPropertyColumn Property="@(x => x.ReferenceCode)" Title="Reference" Sortable="true" Filterable="true" />
                                        <BbDataGridTemplateColumn Title="Status" Filterable="true" FilterBy="@(item => item.IsActive ? "Active" : "Inactive")">
                                            <ChildContent Context="item">
                                                <StatusBadge Text="@(item.IsActive ? "Active" : "Inactive")" Status="@(item.IsActive ? "active" : "inactive")" />
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridPropertyColumn Property="@(x => x.StartedAt)" Title="Started" Sortable="true" Filterable="true" />
                                        <BbDataGridTemplateColumn Title="Ended" Sortable="true" Filterable="true" FilterBy="@(item => FormatNullableDateFilter(item.EndedAt))">
                                            <ChildContent Context="item">@FormatNullableDateDisplay(item.EndedAt)</ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridTemplateColumn Title="Actions">
                                            <ChildContent Context="item">
                                                <BbButton Variant="ButtonVariant.Outline"
                                                          Size="ButtonSize.Small"
                                                          OnClick="@(() => Navigation.NavigateTo($"/attendance/sessions?contextId={item.ContextId}"))">
                                                    <LucideIcon Name="external-link" class="mr-1 h-3 w-3" />
                                                    Sessions
                                                </BbButton>
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                    </Columns>
                                    <EmptyTemplate>
                                        <BbEmpty Title="No attendance participation" Description="This user is not linked to attendance contexts through the selected credentials." />
                                    </EmptyTemplate>
                                </BbDataGrid>
                            </BbCardContent>
                        </BbCard>

                        <BbCard>
                            <BbCardHeader>
                                <BbCardTitle>Attendance Records</BbCardTitle>
                                <BbCardDescription>@_attendanceRecords.Count record(s) loaded for the selected credential filter.</BbCardDescription>
                            </BbCardHeader>
                            <BbCardContent>
                                <BbDataGrid Items="@_attendanceRecords"
                                            ShowPagination="true"
                                            InitialPageSize="20"
                                            ShowSearch="true"
                                            SearchPlaceholder="Search attendance records...">
                                    <Columns>
                                        <BbDataGridPropertyColumn Property="@(x => x.SessionName)" Title="Session" Sortable="true" Filterable="true" />
                                        <BbDataGridPropertyColumn Property="@(x => x.ContextName)" Title="Context" Sortable="true" Filterable="true" />
                                        <BbDataGridPropertyColumn Property="@(x => x.CredentialLabel)" Title="Credential" Sortable="true" Filterable="true" />
                                        <BbDataGridTemplateColumn Title="Status" Sortable="true" Filterable="true" FilterBy="@(item => item.Status.ToString())">
                                            <ChildContent Context="item">
                                                <StatusBadge Text="@AttendanceControlPanelReadService.FormatEnumLabel(item.Status)"
                                                             Status="@AttendanceControlPanelReadService.StatusKey(item.Status)" />
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridPropertyColumn Property="@(x => x.StartsAt)" Title="Starts" Sortable="true" Filterable="true" />
                                        <BbDataGridTemplateColumn Title="Check In" Sortable="true" Filterable="true" FilterBy="@(item => FormatNullableDateFilter(item.FirstCheckInAt))">
                                            <ChildContent Context="item">@FormatNullableDateDisplay(item.FirstCheckInAt)</ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridTemplateColumn Title="Check Out" Sortable="true" Filterable="true" FilterBy="@(item => FormatNullableDateFilter(item.LastCheckOutAt))">
                                            <ChildContent Context="item">@FormatNullableDateDisplay(item.LastCheckOutAt)</ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridTemplateColumn Title="Manual" Filterable="true" FilterBy="@(item => item.IsManual ? "Manual" : "System")">
                                            <ChildContent Context="item">
                                                <StatusBadge Text="@(item.IsManual ? "Manual" : "System")" Status="@(item.IsManual ? "manual-adjusted" : "inactive")" />
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                        <BbDataGridTemplateColumn Title="Actions">
                                            <ChildContent Context="item">
                                                <BbButton Variant="ButtonVariant.Outline"
                                                          Size="ButtonSize.Small"
                                                          OnClick="@(() => Navigation.NavigateTo($"/attendance/sessions/{item.SessionId}"))">
                                                    <LucideIcon Name="external-link" class="mr-1 h-3 w-3" />
                                                    Session
                                                </BbButton>
                                            </ChildContent>
                                        </BbDataGridTemplateColumn>
                                    </Columns>
                                    <EmptyTemplate>
                                        <BbEmpty Title="No attendance records" Description="No attendance records are linked to the selected credentials." />
                                    </EmptyTemplate>
                                </BbDataGrid>
                            </BbCardContent>
                        </BbCard>
                    </div>
                }
                </div>
                break;

            case "wallets":
                <div class="xf-fade-in">
                <BbCard>
                    <BbCardHeader>
                        <BbCardTitle>Wallets</BbCardTitle>
                    </BbCardHeader>
                    <BbCardContent>
                        <BbDataGrid Items="@_wallets" ShowPagination="true" InitialPageSize="10" ShowSearch="true" SearchPlaceholder="Search wallets...">
                            <Columns>
                                <BbDataGridPropertyColumn Property="@(x => x.AccountNumber)" Title="Account Number" Sortable="true" Filterable="true" />
                                <BbDataGridTemplateColumn Title="Credential" Filterable="true" FilterBy="@(wallet => GetCredentialLabelById(wallet.CredentialId))">
                                    <ChildContent Context="wallet">
                                        @{
                                            var walCred = _credentials.FirstOrDefault(c => c.Id == wallet.CredentialId);
                                        }
                                        <span class="text-sm">@(walCred is null ? "Unknown credential" : GetCredentialLabel(walCred))</span>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="Balance" Sortable="true">
                                    <ChildContent Context="wallet">
                                        <span class="font-mono">@wallet.Balance.ToString("N2")</span>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="Available" Sortable="true">
                                    <ChildContent Context="wallet">
                                        <span class="font-mono">@wallet.AvailableBalance.ToString("N2")</span>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="On Hold (Debit)">
                                    <ChildContent Context="wallet">
                                        <span class="font-mono text-muted-foreground">@wallet.DebitOnHoldBalance.ToString("N2")</span>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="Status" Filterable="true" FilterBy="@(wallet => wallet.Status.ToString())">
                                    <ChildContent Context="wallet">
                                        @{
                                            var walStatusText = wallet.Status.ToString();
                                            var walStatusKey = wallet.Status switch
                                            {
                                                WalletStatus.Active => "active",
                                                WalletStatus.Frozen => "frozen",
                                                WalletStatus.Suspended => "suspended",
                                                WalletStatus.Closed => "closed",
                                                _ => "inactive"
                                            };
                                        }
                                        <StatusBadge Text="@walStatusText" Status="@walStatusKey" />
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                                <BbDataGridTemplateColumn Title="Actions">
                                    <ChildContent Context="wallet">
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                                  OnClick="@(() => Navigation.NavigateTo($"/finance/wallets/{wallet.Id}"))">
                                            <LucideIcon Name="external-link" class="mr-1 h-3 w-3" />
                                            View
                                        </BbButton>
                                    </ChildContent>
                                </BbDataGridTemplateColumn>
                            </Columns>
                            <EmptyTemplate>
                                <BbEmpty Title="No wallets" Description="No wallets are linked to this user's credentials." />
                            </EmptyTemplate>
                        </BbDataGrid>
                    </BbCardContent>
                </BbCard>
                </div>
                break;
        }
    </div>
    </FadeInContent>
}

