@page "/admin/reference-data"
@using ControlPanel.Server.Services

<PageTitle>Reference Data - Control Panel</PageTitle>

<div class="space-y-4">
    <div>
        <h2 class="text-2xl font-bold tracking-tight">Reference Data</h2>
        <p class="text-sm text-muted-foreground">System lookup tables and reference types. These are shared across tenants.</p>
    </div>

    @if (_loading)
    {
        <CenteredSpinner />
    }
    else
    {
    <BbTabs DefaultValue="role-types" OnValueChange="@(v => _activeTab = v ?? "role-types")">
        <BbTabsList>
            <BbTabsTrigger Value="role-types">Role Types</BbTabsTrigger>
            <BbTabsTrigger Value="role-type-groups">Role Groups</BbTabsTrigger>
            <BbTabsTrigger Value="contact-types">Contact Types</BbTabsTrigger>
            <BbTabsTrigger Value="contact-groups">Contact Groups</BbTabsTrigger>
            <BbTabsTrigger Value="address-types">Address Types</BbTabsTrigger>
            <BbTabsTrigger Value="verification-types">Verification Types</BbTabsTrigger>
            <BbTabsTrigger Value="session-types">Session Types</BbTabsTrigger>
            <BbTabsTrigger Value="wallet-types">Wallet Types</BbTabsTrigger>
            <BbTabsTrigger Value="currency-types">Currency Types</BbTabsTrigger>
            <BbTabsTrigger Value="exchange-rates">Exchange Rates</BbTabsTrigger>
        </BbTabsList>

        @* ── Role Types ── *@
        <BbTabsContent Value="role-types">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Role Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Role Type
                </BbButton>
            </div>
            <BbDataGrid Items="@_roleTypes" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.RoleLevel)" Title="Level" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name ?? "", "", "", (item.RoleLevel ?? 0).ToString(), item.SystemReferenceId.ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name ?? ""))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Role Type Groups ── *@
        <BbTabsContent Value="role-type-groups">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Role Groups</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Role Group
                </BbButton>
            </div>
            <BbDataGrid Items="@_roleTypeGroups" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.Description)" Title="Description" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name, item.Description, "", "", item.SystemReferenceId.ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Contact Types ── *@
        <BbTabsContent Value="contact-types">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Contact Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Contact Type
                </BbButton>
            </div>
            <BbDataGrid Items="@_contactTypes" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name ?? "", "", "", "", item.SystemReferenceId.ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name ?? ""))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Contact Groups ── *@
        <BbTabsContent Value="contact-groups">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Contact Groups</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Contact Group
                </BbButton>
            </div>
            <BbDataGrid Items="@_contactGroups" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name, "", "", "", item.SystemReferenceId.ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Address Types ── *@
        <BbTabsContent Value="address-types">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Address Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Address Type
                </BbButton>
            </div>
            <BbDataGrid Items="@_addressTypes" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name ?? "", "", "", "", item.SystemReferenceId.ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name ?? ""))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Verification Types ── *@
        <BbTabsContent Value="verification-types">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Verification Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Verification Type
                </BbButton>
            </div>
            <BbDataGrid Items="@_verificationTypes" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.DefaultExpiry)" Title="Default Expiry" />
                    <BbDataGridPropertyColumn Property="@(x => x.Priority)" Title="Priority" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name ?? "", "", "", "", item.SystemReferenceId.ToString(), (item.DefaultExpiry ?? 0).ToString(), (item.Priority ?? 0).ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name ?? ""))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Session Types ── *@
        <BbTabsContent Value="session-types">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Session Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Session Type
                </BbButton>
            </div>
            <BbDataGrid Items="@_sessionTypes" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name ?? "", "", "", "", item.SystemReferenceId.ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name ?? ""))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Wallet Types ── *@
        <BbTabsContent Value="wallet-types">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Wallet Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Wallet Type
                </BbButton>
            </div>
            <BbDataGrid Items="@_walletTypes" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Code)" Title="Code" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.Desc)" Title="Description" />
                    <BbDataGridPropertyColumn Property="@(x => x.MinTransferRule)" Title="Min Transfer" />
                    <BbDataGridPropertyColumn Property="@(x => x.MaxTransferRule)" Title="Max Transfer" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditWalletType(item))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Currency Types ── *@
        <BbTabsContent Value="currency-types">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Currency Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Currency Type
                </BbButton>
            </div>
            <BbDataGrid Items="@_currencyTypes" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.CurrencyIsoCode3)" Title="ISO Code" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.Description)" Title="Description" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditCurrencyType(item))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name ?? ""))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Exchange Rates ── *@
        <BbTabsContent Value="exchange-rates">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Exchange Rates</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Exchange Rate
                </BbButton>
            </div>
            <BbDataGrid Items="@_exchangeRates" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.SourceCurrencyTypeId)" Title="Source Currency" />
                    <BbDataGridPropertyColumn Property="@(x => x.TargetCurrencyTypeId)" Title="Target Currency" />
                    <BbDataGridPropertyColumn Property="@(x => x.Value)" Title="Rate" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.Fee)" Title="Fee" />
                    <BbDataGridPropertyColumn Property="@(x => x.EffectivityDate)" Title="Effective" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.ExpiryDate)" Title="Expires" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditExchangeRate(item))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, $"Rate {item.Value}"))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>
    </BbTabs>
    }
</div>

@* ── Create / Edit Dialog ── *@
<BbDialog Open="@_dialogOpen" OpenChanged="@(v => _dialogOpen = v)">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>@(_isEditing ? "Edit" : "Add") @TabDisplayName</BbDialogTitle>
            <BbDialogDescription>@(_isEditing ? "Update the record below." : "Fill in the details to create a new record.")</BbDialogDescription>
        </BbDialogHeader>
        <div class="space-y-4 py-4">
            @switch (_activeTab)
            {
                case "role-types":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formName"
                                      Label="Name"
                                      Placeholder="Role type name"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formLevel"
                                      Label="Level"
                                      Placeholder="Numeric role level (e.g. 1)" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formSystemRef"
                                      Label="System Reference ID"
                                      Placeholder="GUID (leave empty for auto-generated)" />
                    break;

                case "role-type-groups":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formName"
                                      Label="Name"
                                      Placeholder="Group name"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formDescription"
                                      Label="Description"
                                      Placeholder="Group description" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formSystemRef"
                                      Label="System Reference ID"
                                      Placeholder="GUID (leave empty for auto-generated)" />
                    break;

                case "contact-types":
                case "contact-groups":
                case "address-types":
                case "session-types":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formName"
                                      Label="Name"
                                      Placeholder="Type name"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formSystemRef"
                                      Label="System Reference ID"
                                      Placeholder="GUID (leave empty for auto-generated)" />
                    break;

                case "verification-types":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formName"
                                      Label="Name"
                                      Placeholder="Verification type name"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formDefaultExpiry"
                                      Label="Default Expiry (seconds)"
                                      Placeholder="e.g. 3600" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formPriority"
                                      Label="Priority"
                                      Placeholder="e.g. 1" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formSystemRef"
                                      Label="System Reference ID"
                                      Placeholder="GUID (leave empty for auto-generated)" />
                    break;

                case "wallet-types":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formCode"
                                      Label="Code"
                                      Placeholder="Short code (e.g. PHP)"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formName"
                                      Label="Name"
                                      Placeholder="Wallet type name"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formDescription"
                                      Label="Description"
                                      Placeholder="Description" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formMinTransfer"
                                      Label="Min Transfer"
                                      Placeholder="e.g. 0.01" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formMaxTransfer"
                                      Label="Max Transfer"
                                      Placeholder="e.g. 100000" />
                    break;

                case "currency-types":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formName"
                                      Label="Name"
                                      Placeholder="Currency name (e.g. Philippine Peso)"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formCurrencyCode"
                                      Label="Currency ISO Code"
                                      Placeholder="3-letter ISO code (e.g. PHP)" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formDescription"
                                      Label="Description"
                                      Placeholder="Description" />
                    break;

                case "exchange-rates":
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formSourceCurrency"
                                      Label="Source Currency Type ID"
                                      Placeholder="GUID of source currency"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formTargetCurrency"
                                      Label="Target Currency Type ID"
                                      Placeholder="GUID of target currency"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formValue"
                                      Label="Rate"
                                      Placeholder="Exchange rate value"
                                      Required="true" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formFee"
                                      Label="Fee"
                                      Placeholder="Transaction fee" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formEffectivity"
                                      Label="Effectivity Date"
                                      Placeholder="YYYY-MM-DD HH:mm" />
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="_formExpiry"
                                      Label="Expiry Date"
                                      Placeholder="YYYY-MM-DD HH:mm" />
                    break;
            }
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _dialogOpen = false)">Cancel</BbButton>
            <BbButton OnClick="@SaveRecord">@(_isEditing ? "Update" : "Create")</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@* ── Delete Confirmation Dialog ── *@
<ConfirmDeleteDialog Open="@_deleteDialogOpen"
                     OpenChanged="@(v => _deleteDialogOpen = v)"
                     Message="@($"This will permanently delete \"{_deleteName}\". This action cannot be undone.")"
                     OnConfirm="@ConfirmDelete" />

@code {
    [Inject] private AdminDbContext Db { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    private bool _loading = true;
    private bool _dialogOpen;
    private bool _deleteDialogOpen;
    private bool _isEditing;
    private string _activeTab = "role-types";

    // Generic form fields
    private Guid _editingId;
    private string _formName = "";
    private string _formDescription = "";
    private string _formCode = "";
    private string _formLevel = "";
    private string _formSystemRef = "";
    private string _formPriority = "";
    private string _formDefaultExpiry = "";
    private string _formMinTransfer = "";
    private string _formMaxTransfer = "";
    private string _formCurrencyCode = "";
    private string _formValue = "";
    private string _formFee = "";
    private string _formSourceCurrency = "";
    private string _formTargetCurrency = "";
    private string _formEffectivity = "";
    private string _formExpiry = "";

    // Delete state
    private string _deleteName = "";
    private object? _deleteTarget;

    // Data lists
    private List<IdentityRoleType> _roleTypes = [];
    private List<IdentityRoleTypeGroup> _roleTypeGroups = [];
    private List<IdentityContactType> _contactTypes = [];
    private List<IdentityContactGroup> _contactGroups = [];
    private List<IdentityAddressType> _addressTypes = [];
    private List<IdentityVerificationType> _verificationTypes = [];
    private List<SessionType> _sessionTypes = [];
    private List<global::Wallets.Domain.Shared.Contracts.WalletType> _walletTypes = [];
    private List<global::Wallets.Domain.Shared.Contracts.CurrencyType> _currencyTypes = [];
    private List<ExchangeRate> _exchangeRates = [];

    private string TabDisplayName => _activeTab switch
    {
        "role-types" => "Role Type",
        "role-type-groups" => "Role Group",
        "contact-types" => "Contact Type",
        "contact-groups" => "Contact Group",
        "address-types" => "Address Type",
        "verification-types" => "Verification Type",
        "session-types" => "Session Type",
        "wallet-types" => "Wallet Type",
        "currency-types" => "Currency Type",
        "exchange-rates" => "Exchange Rate",
        _ => "Record"
    };

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            await LoadAllData();
        }
        catch { /* Non-critical - empty tabs are fine */ }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAllData()
    {
        _roleTypes = await Db.Query<IdentityRoleType>().OrderBy(x => x.Name).ToListAsync();
        _roleTypeGroups = await Db.Query<IdentityRoleTypeGroup>().OrderBy(x => x.Name).ToListAsync();
        _contactTypes = await Db.Query<IdentityContactType>().OrderBy(x => x.Name).ToListAsync();
        _contactGroups = await Db.Query<IdentityContactGroup>().OrderBy(x => x.Name).ToListAsync();
        _addressTypes = await Db.Query<IdentityAddressType>().OrderBy(x => x.Name).ToListAsync();
        _verificationTypes = await Db.Query<IdentityVerificationType>().OrderBy(x => x.Name).ToListAsync();
        _sessionTypes = await Db.Query<SessionType>().OrderBy(x => x.Name).ToListAsync();
        _walletTypes = await Db.Query<global::Wallets.Domain.Shared.Contracts.WalletType>().OrderBy(x => x.Name).ToListAsync();
        _currencyTypes = await Db.Query<global::Wallets.Domain.Shared.Contracts.CurrencyType>().OrderBy(x => x.Name).ToListAsync();
        _exchangeRates = await Db.Query<ExchangeRate>().OrderByDescending(x => x.CreatedAt).ToListAsync();
    }

    private async Task ReloadActiveTab()
    {
        try
        {
            switch (_activeTab)
            {
                case "role-types":
                    _roleTypes = await Db.Query<IdentityRoleType>().OrderBy(x => x.Name).ToListAsync();
                    break;
                case "role-type-groups":
                    _roleTypeGroups = await Db.Query<IdentityRoleTypeGroup>().OrderBy(x => x.Name).ToListAsync();
                    break;
                case "contact-types":
                    _contactTypes = await Db.Query<IdentityContactType>().OrderBy(x => x.Name).ToListAsync();
                    break;
                case "contact-groups":
                    _contactGroups = await Db.Query<IdentityContactGroup>().OrderBy(x => x.Name).ToListAsync();
                    break;
                case "address-types":
                    _addressTypes = await Db.Query<IdentityAddressType>().OrderBy(x => x.Name).ToListAsync();
                    break;
                case "verification-types":
                    _verificationTypes = await Db.Query<IdentityVerificationType>().OrderBy(x => x.Name).ToListAsync();
                    break;
                case "session-types":
                    _sessionTypes = await Db.Query<SessionType>().OrderBy(x => x.Name).ToListAsync();
                    break;
                case "wallet-types":
                    _walletTypes = await Db.Query<global::Wallets.Domain.Shared.Contracts.WalletType>().OrderBy(x => x.Name).ToListAsync();
                    break;
                case "currency-types":
                    _currencyTypes = await Db.Query<global::Wallets.Domain.Shared.Contracts.CurrencyType>().OrderBy(x => x.Name).ToListAsync();
                    break;
                case "exchange-rates":
                    _exchangeRates = await Db.Query<ExchangeRate>().OrderByDescending(x => x.CreatedAt).ToListAsync();
                    break;
            }
        }
        catch { /* reload failure is non-critical */ }
    }

