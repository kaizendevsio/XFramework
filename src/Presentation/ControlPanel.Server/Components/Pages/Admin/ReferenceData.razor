    // ── Delete Helpers ──

    private void OpenDeleteDialog(object target, string displayName)
    {
        _deleteTarget = target;
        _deleteName = displayName;
        _deleteDialogOpen = true;
    }

    private async Task ConfirmDelete()
    {
        if (_deleteTarget is null) return;

        Db.Remove(_deleteTarget);
        var result = await Db.SaveAsync();
        ToastService.Show(result.Success ? $"{TabDisplayName} deleted." : $"Error: {result.Error}");
        _deleteDialogOpen = false;
        _deleteTarget = null;
        _deleteName = "";
        await ReloadActiveTab();
    }

