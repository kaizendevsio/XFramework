    private async Task SaveExchangeRate()
    {
        if (!Guid.TryParse(_formSourceCurrency, out var sourceId) || !Guid.TryParse(_formTargetCurrency, out var targetId))
        {
            ToastService.Show("Source and Target Currency IDs must be valid GUIDs.");
            return;
        }

        if (!decimal.TryParse(_formValue, out var rate))
        {
            ToastService.Show("Rate must be a valid number.");
            return;
        }

        if (_isEditing)
        {
            var entity = await Db.Query<ExchangeRate>().FirstOrDefaultAsync(x => x.Id == _editingId);
            if (entity is null) { ToastService.Show("Record not found."); return; }
            entity.SourceCurrencyTypeId = sourceId;
            entity.TargetCurrencyTypeId = targetId;
            entity.Value = rate;
            entity.Fee = decimal.TryParse(_formFee, out var fee) ? fee : entity.Fee;
            entity.EffectivityDate = DateTime.TryParse(_formEffectivity, out var eff) ? eff : entity.EffectivityDate;
            entity.ExpiryDate = DateTime.TryParse(_formExpiry, out var exp) ? exp : entity.ExpiryDate;
            entity.ModifiedAt = DateTime.UtcNow;
            Db.Update(entity);
        }
        else
        {
            Db.Add(new ExchangeRate
            {
                Id = Guid.NewGuid(),
                SourceCurrencyTypeId = sourceId,
                TargetCurrencyTypeId = targetId,
                Value = rate,
                Fee = decimal.TryParse(_formFee, out var fee) ? fee : null,
                EffectivityDate = DateTime.TryParse(_formEffectivity, out var eff) ? eff : null,
                ExpiryDate = DateTime.TryParse(_formExpiry, out var exp) ? exp : null,
                CreatedAt = DateTime.UtcNow,
                IsEnabled = true
            });
        }
        await PersistAndClose();
    }

    private async Task PersistAndClose()
    {
        var result = await Db.SaveAsync();
        if (!result.Success)
        {
            ToastService.Show($"Error: {result.Error}");
            return;
        }

        ToastService.Show(_isEditing ? $"{TabDisplayName} updated." : $"{TabDisplayName} created.");
        _dialogOpen = false;
        await ReloadActiveTab();
    }
