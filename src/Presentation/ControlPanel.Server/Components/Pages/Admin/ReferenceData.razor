    private async Task SaveRecord()
    {
        switch (_activeTab)
        {
            case "role-types":
                await SaveRoleType();
                break;
            case "role-type-groups":
                await SaveRoleTypeGroup();
                break;
            case "contact-types":
                await SaveContactType();
                break;
            case "contact-groups":
                await SaveContactGroup();
                break;
            case "address-types":
                await SaveAddressType();
                break;
            case "verification-types":
                await SaveVerificationType();
                break;
            case "session-types":
                await SaveSessionType();
                break;
            case "wallet-types":
                await SaveWalletType();
                break;
            case "currency-types":
                await SaveCurrencyType();
                break;
            case "exchange-rates":
                await SaveExchangeRate();
                break;
        }
    }

    private Guid ParseSystemRef() =>
        Guid.TryParse(_formSystemRef, out var id) ? id : Guid.NewGuid();

    private async Task SaveRoleType()
    {
        if (string.IsNullOrWhiteSpace(_formName)) { ToastService.Show("Name is required."); return; }

        if (_isEditing)
        {
            var entity = await Db.Query<IdentityRoleType>().FirstOrDefaultAsync(x => x.Id == _editingId);
            if (entity is null) { ToastService.Show("Record not found."); return; }
            entity.Name = _formName;
            entity.RoleLevel = short.TryParse(_formLevel, out var lv) ? lv : entity.RoleLevel;
            entity.SystemReferenceId = ParseSystemRef();
            entity.ModifiedAt = DateTime.UtcNow;
            Db.Update(entity);
        }
        else
        {
            Db.Add(new IdentityRoleType
            {
                Id = Guid.NewGuid(),
                Name = _formName,
                RoleLevel = short.TryParse(_formLevel, out var lv) ? lv : null,
                SystemReferenceId = ParseSystemRef(),
                CreatedAt = DateTime.UtcNow,
                IsEnabled = true
            });
        }
        await PersistAndClose();
    }

