    private async Task PersistAndClose<T>(T entity) where T : class
    {
        if (!await PrepareEntityForPersistence(entity))
        {
            return;
        }

        if (_isEditing)
        {
            DataContext.Update(entity);
        }
        else
        {
            DataContext.Add(entity);
        }

        var result = await DataContext.SaveChangesAsync();
        if (!result.IsSuccess)
        {
            ToastService.Show($"Error: {result.Message}");
            return;
        }

        ToastService.Show(_isEditing ? $"{TabDisplayName} updated." : $"{TabDisplayName} created.");
        _dialogOpen = false;
        await ReloadActiveTab();
    }

    private async Task<bool> PrepareEntityForPersistence<T>(T entity) where T : class
    {
        if (entity is not BaseModel model)
        {
            return true;
        }

        var tenantId = await ResolveReferenceTenantId();
        if (tenantId is null)
        {
            ToastService.Show("Create or select a tenant before adding reference data.");
            return false;
        }

        model.TenantId = tenantId.Value;
        if (model.ConcurrencyStamp == Guid.Empty)
        {
            model.ConcurrencyStamp = Guid.NewGuid();
        }

        if (entity is IHasSystemReferenceId systemReference && systemReference.SystemReferenceId == Guid.Empty)
        {
            systemReference.SystemReferenceId = ParseSystemRef();
        }

        return true;
    }

    private async Task<Guid?> ResolveReferenceTenantId()
    {
        if (TenantFilter.SelectedTenantId is Guid selectedTenantId)
        {
            return selectedTenantId;
        }

        var tenant = await DataContext.Query<Tenant>()
            .IgnoreQueryFilters()
            .NoCache()
            .Where(x => !x.IsDeleted)
            .OrderBy(x => x.Name)
            .Take(1)
            .FirstOrDefaultAsync();

        return tenant?.Id;
    }
