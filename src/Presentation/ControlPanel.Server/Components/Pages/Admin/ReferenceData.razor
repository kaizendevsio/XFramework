    private async Task SaveRoleType()
    {
        var name = _formName.Trim();
        if (string.IsNullOrWhiteSpace(name)) { ToastService.Show("Name is required."); return; }

        if (!Guid.TryParse(_formGroupId, out var groupId) || groupId == Guid.Empty)
        {
            ToastService.Show("Role group is required.");
            return;
        }

        if (_isEditing)
        {
            var entity = new IdentityRoleType
            {
                Id = _editingId,
                Name = name,
                RoleLevel = short.TryParse(_formLevel, out var lv) ? lv : null,
                GroupId = groupId,
                SystemReferenceId = ParseSystemRef(),
                ModifiedAt = DateTime.UtcNow
            };
            await PersistAndClose(entity);
        }
        else
        {
            var entity = new IdentityRoleType
            {
                Id = Guid.NewGuid(),
                Name = name,
                RoleLevel = short.TryParse(_formLevel, out var lv) ? lv : null,
                GroupId = groupId,
                SystemReferenceId = ParseSystemRef(),
                CreatedAt = DateTime.UtcNow,
                IsEnabled = true
            };
            await PersistAndClose(entity);
        }
    }

