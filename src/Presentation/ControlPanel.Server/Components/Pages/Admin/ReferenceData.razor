@page "/admin/reference-data"
@using XFramework.Domain.Shared.Contracts.Base
@using XFramework.Domain.Shared.DataContext

<PageTitle>Reference Data - Control Panel</PageTitle>

<div class="space-y-4">
    <div>
        <h2 class="text-2xl font-bold tracking-tight">Reference Data</h2>
        <p class="text-sm text-muted-foreground">System lookup tables and reference types. These are shared across tenants.</p>
    </div>

    @if (_loading)
    {
        <CenteredSpinner />
    }
    else
    {
    <FadeInContent>
    <BbTabs DefaultValue="role-types"
            Orientation="BlazorBlueprint.Primitives.Tabs.TabsOrientation.Vertical"
            OnValueChange="@OnReferenceCategoryChanged"
            Class="reference-data-layout">
        <div class="reference-data-sidebar">
            <div class="space-y-2">
                <BbLabel For="reference-category-search">Categories</BbLabel>
                <input id="reference-category-search"
                       class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm text-foreground transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                       value="@_categorySearch"
                       @oninput="OnCategorySearchInput"
                       placeholder="Search reference data" />
            </div>
            <nav class="reference-data-nav" aria-label="Reference data categories">
                @foreach (var group in VisibleCategoryGroups)
                {
                    <section class="reference-data-group-section" aria-labelledby="@($"reference-data-group-{group.Key.Replace(" ", "-").ToLowerInvariant()}")">
                        <div id="@($"reference-data-group-{group.Key.Replace(" ", "-").ToLowerInvariant()}")"
                             class="reference-data-group-label">
                            @group.Key
                        </div>
                        <BbTabsList Class="reference-data-group-list" Responsive="false">
                            @foreach (var category in group)
                            {
                                <BbTabsTrigger Value="@category.Value"
                                               Label="@category.Label"
                                               Class="reference-data-trigger">
                                    @category.Label
                                </BbTabsTrigger>
                            }
                        </BbTabsList>
                    </section>
                }
            </nav>
        </div>

        <div class="reference-data-content">
        @if (_activeTabLoading)
        {
            <CenteredSpinner />
        }
        else
        {

        @* ── Role Types ── *@
        <BbTabsContent Value="role-types" Class="xf-fade-in">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Role Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Role Type
                </BbButton>
            </div>
            <BbDataGrid Items="@_roleTypes" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.RoleLevel)" Title="Level" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name ?? "", "", "", (item.RoleLevel ?? 0).ToString(), item.SystemReferenceId.ToString(), groupId: item.GroupId.ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name ?? ""))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Role Type Groups ── *@
        <BbTabsContent Value="role-type-groups" Class="xf-fade-in">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Role Groups</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Role Group
                </BbButton>
            </div>
            <BbDataGrid Items="@_roleTypeGroups" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.Description)" Title="Description" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name, item.Description, "", "", item.SystemReferenceId.ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Contact Types ── *@
        <BbTabsContent Value="contact-types" Class="xf-fade-in">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Contact Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Contact Type
                </BbButton>
            </div>
            <BbDataGrid Items="@_contactTypes" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name ?? "", "", "", "", item.SystemReferenceId.ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name ?? ""))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Contact Groups ── *@
        <BbTabsContent Value="contact-groups" Class="xf-fade-in">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Contact Groups</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Contact Group
                </BbButton>
            </div>
            <BbDataGrid Items="@_contactGroups" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name, "", "", "", item.SystemReferenceId.ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Address Types ── *@
        <BbTabsContent Value="address-types" Class="xf-fade-in">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Address Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Address Type
                </BbButton>
            </div>
            <BbDataGrid Items="@_addressTypes" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name ?? "", "", "", "", item.SystemReferenceId.ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name ?? ""))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Verification Types ── *@
        <BbTabsContent Value="verification-types" Class="xf-fade-in">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Verification Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Verification Type
                </BbButton>
            </div>
            <BbDataGrid Items="@_verificationTypes" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.DefaultExpiry)" Title="Default Expiry" />
                    <BbDataGridPropertyColumn Property="@(x => x.Priority)" Title="Priority" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name ?? "", "", "", "", item.SystemReferenceId.ToString(), (item.DefaultExpiry ?? 0).ToString(), (item.Priority ?? 0).ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name ?? ""))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Session Types ── *@
        <BbTabsContent Value="session-types" Class="xf-fade-in">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Session Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Session Type
                </BbButton>
            </div>
            <BbDataGrid Items="@_sessionTypes" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.SystemReferenceId)" Title="System Ref" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditDialog(item.Id, item.Name ?? "", "", "", "", item.SystemReferenceId.ToString()))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name ?? ""))">
                                    Delete
                                </BbButton>
                            </div>
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </BbTabsContent>

        @* ── Wallet Types ── *@
        <BbTabsContent Value="wallet-types" Class="xf-fade-in">
            <div class="flex items-center justify-between mb-4">
                <BbTypographyH3>Wallet Types</BbTypographyH3>
                <BbButton OnClick="@(() => OpenAddDialog())">
                    <LucideIcon Name="plus" class="mr-2 h-4 w-4" />
                    Add Wallet Type
                </BbButton>
            </div>
            <BbDataGrid Items="@_walletTypes" ShowPagination="true" InitialPageSize="20">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(x => x.Code)" Title="Code" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.Name)" Title="Name" Sortable="true" />
                    <BbDataGridPropertyColumn Property="@(x => x.Desc)" Title="Description" />
                    <BbDataGridPropertyColumn Property="@(x => x.MinTransferRule)" Title="Min Transfer" />
                    <BbDataGridPropertyColumn Property="@(x => x.MaxTransferRule)" Title="Max Transfer" />
                    <BbDataGridTemplateColumn Title="Actions">
                        <ChildContent Context="item">
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenEditWalletType(item))">
                                    Edit
                                </BbButton>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                          OnClick="@(() => OpenDeleteDialog(item, item.Name))">
