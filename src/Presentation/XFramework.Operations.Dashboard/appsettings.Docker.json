{
  "JwtOptions": {
    "ValidAudience": "xframework",
    "ValidIssuer": "xframework",
    "GenerationId": "local-development-g1",
    "SigningPublicKeyPath": ".data/identity/user-jwt-public-key.pem",
    "AccessTokenLifespan": "00:30:00",
    "RefreshTokenLifespan": "00:30:00"
  },
  "BoltConfiguration": {
    "ClientName": "XFramework.Operations.Dashboard",
    "ServerUrls": [
      "ws://bolt-hub:8080/bolt/ws"
    ],
    "RequireSecureTransport": false,
    "RpcTimeoutSeconds": 30
  },
  "Seq": {
    "Url": "http://seq:80"
  },
  "OpenTelemetry": {
    "Exporters": {
      "OTLP": {
        "Enabled": false
      }
    }
  }
}
