{
  "JwtOptions": {
    "ValidAudience": "xframework",
    "ValidIssuer": "xframework",
    "Secret": "CHANGE_ME_JWT_SECRET_USE_ENVIRONMENT",
    "AccessTokenLifespan": "00:30:00",
    "RefreshTokenLifespan": "00:30:00"
  },
  "BoltConfiguration": {
    "ClientName": "XFramework.Operations.Dashboard",
    "ServerUrls": [
      "wss://bolt-hub:8443/bolt/ws"
    ],
    "RpcTimeoutSeconds": 30
  },
  "Seq": {
    "Url": "http://seq:80"
  },
  "Jaeger": {
    "QueryUrl": "http://jaeger:16686"
  },
  "OpenTelemetry": {
    "Exporters": {
      "OTLP": {
        "Enabled": true,
        "Endpoint": "http://jaeger:4317"
      }
    }
  }
}
