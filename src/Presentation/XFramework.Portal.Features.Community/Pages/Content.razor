@page "/community/content"
@using XFramework.Domain.Shared.DataContext
@implements IDisposable

<PageTitle>Community Content - Portal</PageTitle>

@if (_loading)
{
    <CenteredSpinner />
}
else if (!_access.HasTenant)
{
    <BbAlert>
        <BbAlertTitle>Select a Tenant</BbAlertTitle>
        <BbAlertDescription>Choose a tenant in the sidebar to review Community content.</BbAlertDescription>
    </BbAlert>
}
else if (!_access.CanUseCommunity)
{
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Community Module Disabled</BbAlertTitle>
        <BbAlertDescription>Enable the Community module for this tenant before reviewing content.</BbAlertDescription>
    </BbAlert>
}
else
{
    <FadeInContent>
        <div class="space-y-6">
            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <div>
                    <BbTypographyH3>Community Content</BbTypographyH3>
                    <BbTypographyMuted>@_access.TenantName - read and moderation overview</BbTypographyMuted>
                </div>
                <BbButton Variant="ButtonVariant.Outline" OnClick="@LoadData">
                    <LucideIcon Name="refresh-cw" class="mr-2 h-4 w-4" />
                    Refresh
                </BbButton>
            </div>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
                <BbCard>
                    <BbCardHeader><BbCardTitle>Total</BbCardTitle><BbCardDescription>Loaded content</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_items.Count</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader><BbCardTitle>Published</BbCardTitle><BbCardDescription>Enabled records</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_publishedCount</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader><BbCardTitle>Hidden</BbCardTitle><BbCardDescription>Disabled records</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_hiddenCount</BbTypographyH2></BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardHeader><BbCardTitle>Comments</BbCardTitle><BbCardDescription>Has parent content</BbCardDescription></BbCardHeader>
                    <BbCardContent><BbTypographyH2>@_commentCount</BbTypographyH2></BbCardContent>
                </BbCard>
            </div>

            <BbCard>
                <BbCardHeader>
                    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                        <div>
                            <BbCardTitle>Content Records</BbCardTitle>
                            <BbCardDescription>@FilteredItems.Count item(s)</BbCardDescription>
                        </div>
                        <div class="grid w-full gap-2 md:w-auto md:grid-cols-[18rem_12rem]">
                            <BbFormFieldInput TValue="string" @bind-Value="_search" Label="Search" Placeholder="Title, body, or author" />
                            <BbFormFieldSelect TValue="string" @bind-Value="_visibilityFilter" Label="Visibility">
                                <BbSelectItem Value="@("all")">All</BbSelectItem>
                                <BbSelectItem Value="@("visible")">Published</BbSelectItem>
                                <BbSelectItem Value="@("hidden")">Hidden</BbSelectItem>
                            </BbFormFieldSelect>
                        </div>
                    </div>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataGrid Items="@FilteredItems" ShowPagination="true" InitialPageSize="20"
                                OnRowClick="@((CommunityContent item) => Navigation.NavigateTo($"/community/content/{item.Id}"))"
                                Class="cursor-pointer">
                        <Columns>
                            <BbDataGridTemplateColumn Title="Content" Sortable="true">
                                <ChildContent Context="item">
                                    <div>
                                        <div class="font-medium">@(item.Title ?? Truncate(item.Text, 72))</div>
                                        <div class="text-xs text-muted-foreground">@Truncate(item.Text, 96)</div>
                                    </div>
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Author">
                                <ChildContent Context="item">@GetIdentityLabel(item.SocialMediaIdentityId)</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Type">
                                <ChildContent Context="item">@(item.Type?.Name ?? GetTypeName(item.TypeId))</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Reactions">
                                <ChildContent Context="item">@GetReactionCount(item.Id)</ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridTemplateColumn Title="Status">
                                <ChildContent Context="item">
                                    <StatusBadge Text="@(item.IsEnabled ? "Published" : "Hidden")"
                                                 Status="@(item.IsEnabled ? "active" : "inactive")" />
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                            <BbDataGridPropertyColumn Property="@(x => x.CreatedAt)" Title="Created" Sortable="true" />
                            <BbDataGridTemplateColumn Title="Actions">
                                <ChildContent Context="item">
                                    <div class="flex items-center gap-1">
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                                  OnClick="@(() => Navigation.NavigateTo($"/community/content/{item.Id}"))">
                                            <LucideIcon Name="eye" class="h-4 w-4" />
                                        </BbButton>
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                                  OnClick="@(() => ToggleEnabled(item))">
                                            <LucideIcon Name="@(item.IsEnabled ? "eye-off" : "eye")" class="h-4 w-4" />
                                        </BbButton>
                                    </div>
                                </ChildContent>
                            </BbDataGridTemplateColumn>
                        </Columns>
                    </BbDataGrid>
                </BbCardContent>
            </BbCard>
        </div>
    </FadeInContent>
}

@code {
    [Inject] private IDataContext DataContext { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private IPortalTenantContext TenantFilter { get; set; } = default!;
    [Inject] private CommunityPortalAccessService AccessService { get; set; } = default!;

    private CommunityPortalAccessState _access = new(null, null, false, null);
    private List<CommunityContent> _items = [];
    private Dictionary<Guid, string> _identityLabels = [];
    private Dictionary<Guid, string> _typeNames = [];
    private Dictionary<Guid, int> _reactionCounts = [];
    private bool _loading = true;
    private string _search = "";
    private string _visibilityFilter = "all";
    private int _publishedCount;
    private int _hiddenCount;
    private int _commentCount;

    private List<CommunityContent> FilteredItems
    {
        get
        {
            var items = _items.AsEnumerable();

            if (_visibilityFilter == "visible")
            {
                items = items.Where(x => x.IsEnabled);
            }
            else if (_visibilityFilter == "hidden")
            {
                items = items.Where(x => !x.IsEnabled);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var search = _search.Trim();
                items = items.Where(x =>
                    Contains(x.Title, search) ||
                    Contains(x.Text, search) ||
                    Contains(GetIdentityLabel(x.SocialMediaIdentityId), search));
            }

            return items.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        TenantFilter.OnChanged += OnTenantFilterChanged;
        await LoadData();
    }

    private void OnTenantFilterChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _access = await AccessService.GetStateAsync();
            _items = [];
            _identityLabels = [];
            _typeNames = [];
            _reactionCounts = [];

            if (!_access.CanUseCommunity || _access.TenantId is not Guid tenantId)
            {
                return;
            }

            _items = await DataContext.Query<CommunityContent>()
                .IgnoreQueryFilters()
                .NoCache()
                .Include(x => x.Type)
                .Where(x => x.TenantId == tenantId)
                .OrderByDescending(x => x.CreatedAt)
                .Take(250)
                .ToListAsync();

            var identities = await DataContext.Query<CommunityIdentity>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId)
                .OrderBy(x => x.HandleName)
                .Take(500)
                .ToListAsync();
            _identityLabels = identities.ToDictionary(x => x.Id, BuildIdentityLabel);

            var types = await DataContext.Query<CommunityContentType>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId)
                .OrderBy(x => x.Name)
                .Take(100)
                .ToListAsync();
            _typeNames = types.ToDictionary(x => x.Id, x => x.Name);

            var reactions = await DataContext.Query<CommunityContentReaction>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.TenantId == tenantId)
                .OrderByDescending(x => x.CreatedAt)
                .Take(1000)
                .ToListAsync();
            _reactionCounts = reactions
                .GroupBy(x => x.ContentId)
                .ToDictionary(x => x.Key, x => x.Count());

            _publishedCount = _items.Count(x => x.IsEnabled);
            _hiddenCount = _items.Count(x => !x.IsEnabled);
            _commentCount = _items.Count(x => x.ParentContentId is not null);
        }
        catch (Exception ex)
        {
            ToastService.Show($"Failed to load Community content: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ToggleEnabled(CommunityContent item)
    {
        try
        {
            var fresh = await DataContext.Query<CommunityContent>()
                .IgnoreQueryFilters()
                .NoCache()
                .Where(x => x.Id == item.Id)
                .FirstOrDefaultAsync();

            if (fresh is null || fresh.TenantId != _access.TenantId)
            {
                ToastService.Show("Content was not found in the selected tenant.");
                return;
            }

            fresh.IsEnabled = !fresh.IsEnabled;
            fresh.ModifiedAt = DateTime.UtcNow;
            DataContext.Update(fresh);
            var result = await DataContext.SaveChangesAsync();

            if (result.IsSuccess)
            {
                ToastService.Show(fresh.IsEnabled ? "Content published." : "Content hidden.");
                await LoadData();
            }
            else
            {
                ToastService.Show($"Failed to update content: {result.Message}");
            }
        }
        catch (Exception ex)
        {
            ToastService.Show($"Error updating content: {ex.Message}");
        }
    }

    private int GetReactionCount(Guid contentId) =>
        _reactionCounts.TryGetValue(contentId, out var count) ? count : 0;

    private string GetIdentityLabel(Guid identityId) =>
        _identityLabels.TryGetValue(identityId, out var label)
            ? label
            : $"{identityId.ToString()[..8]}...";

    private string GetTypeName(Guid typeId) =>
        _typeNames.TryGetValue(typeId, out var name) ? name : $"{typeId.ToString()[..8]}...";

    private static string BuildIdentityLabel(CommunityIdentity identity) =>
        identity.HandleName ?? identity.Alias ?? $"{identity.Id.ToString()[..8]}...";

    private static string Truncate(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Untitled";
        }

        return value.Length <= maxLength ? value : $"{value[..maxLength]}...";
    }

    private static bool Contains(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    public void Dispose()
    {
        TenantFilter.OnChanged -= OnTenantFilterChanged;
    }
}
