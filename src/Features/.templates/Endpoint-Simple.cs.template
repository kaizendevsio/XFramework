namespace Features.{EntityName}.{Action};

/// <summary>
/// {Action} {EntityName} endpoint
/// Simple endpoint that delegates to service layer
/// </summary>
public static class Endpoint
{
    public record Request(/* Add parameters here */);
    
    public record Response(/* Add response properties here */);
    
    public static async Task<Results<Ok<Response>, NotFound, BadRequest>> Handle(
        [AsParameters] Request request,
        {EntityName}Service service,
        CancellationToken ct)
    {
        // Call service method
        var result = await service.{Action}Async(/* parameters */, ct);
        
        if (!result.IsSuccess)
        {
            return TypedResults.BadRequest();
        }
        
        // Map to response DTO
        var response = new Response(/* map from result.Data */);
        
        return TypedResults.Ok(response);
    }
    
    public static void MapEndpoint(IEndpointRouteBuilder app)
    {
        app.Map{HttpMethod}("/api/{route}", Handle)
           .WithName("{Action}{EntityName}")
           .WithTags("{EntityName}")
           .RequireAuthorization();
           // .CacheOutput(policy => policy.Expire(TimeSpan.FromMinutes(5))); // Add for GET operations
    }
}

