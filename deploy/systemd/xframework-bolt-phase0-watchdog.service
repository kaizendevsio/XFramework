[Unit]
Description=XFramework Bolt Phase 0 fail-closed deployment watchdog
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=github-runner
Group=github-runner
SupplementaryGroups=docker
ExecStart=/usr/local/sbin/xframework-bolt-phase0-watchdog
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Atomic env replacement and its adjacent lock require write access to this parent.
ReadWritePaths=/home/github-runner/xframework-deploy /opt/xframework
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
# 4 x 900s recovery stages + 130s fail-closed stop verification + 470s margin.
TimeoutStartSec=4200

[Install]
WantedBy=multi-user.target
